## cinclude '<ngtcp2/ngtcp2_crypto_ossl.h>'
## cinclude '<openssl/ssl.h>'
local SSL <cimport,nodecl> = @record{}
local SSL_CTX <cimport,nodecl> = @record{}
local SSL_METHOD <cimport,nodecl> = @record{}
local EVP_PKEY <cimport,nodecl> = @record{}
local ngtcp2_crypto_ossl_ctx <cimport,nodecl> = @record{}
local TLSEXT_cert_type_rpk: cuchar <cimport,nodecl>
local function TLS_method(): *SSL_METHOD <cimport,nodecl> end
local function SSL_CTX_new(method: *SSL_METHOD): *SSL_CTX <cimport,nodecl> end
local function SSL_CTX_free(ctx: *SSL_CTX) <cimport,nodecl> end
local function SSL_CTX_use_PrivateKey(ctx: *SSL_CTX, pkey: *EVP_PKEY): cint <cimport,nodecl> end
local function SSL_CTX_set1_server_cert_type(ctx: *SSL_CTX, values: *cuchar, n: csize): cint <cimport,nodecl> end
local function SSL_CTX_set1_client_cert_type(ctx: *SSL_CTX, values: *cuchar, n: csize): cint <cimport,nodecl> end
local function SSL_new(ctx: *SSL_CTX): *SSL <cimport,nodecl> end
local function SSL_free(ssl: *SSL) <cimport,nodecl> end
local function EVP_PKEY_new_raw_private_key_ex(ctx: pointer, name: cstring, properties: cstring,
    bytes: *cuchar, n: csize): *EVP_PKEY <cimport,nodecl> end
local function EVP_PKEY_new_raw_public_key_ex(ctx: pointer, name: cstring, properties: cstring,
    bytes: *cuchar, n: csize): *EVP_PKEY <cimport,nodecl> end
local function EVP_PKEY_free(key: *EVP_PKEY) <cimport,nodecl> end
local function ngtcp2_crypto_ossl_ctx_new(out: **ngtcp2_crypto_ossl_ctx, ssl: *SSL): cint <cimport,nodecl> end
local function ngtcp2_crypto_ossl_ctx_del(ctx: *ngtcp2_crypto_ossl_ctx) <cimport,nodecl> end
local function ngtcp2_crypto_ossl_configure_client_session(ssl: *SSL): cint <cimport,nodecl> end

