local ngtcp2_callbacks <cimport,nodecl> = @record{
  client_initial: pointer, recv_crypto_data: pointer, encrypt: pointer, decrypt: pointer, hp_mask: pointer,
  recv_retry: pointer, rand: pointer, update_key: pointer, delete_crypto_aead_ctx: pointer,
  delete_crypto_cipher_ctx: pointer, version_negotiation: pointer, get_new_connection_id2: pointer,
  get_path_challenge_data2: pointer, recv_datagram: pointer, ack_datagram: pointer
}
local ngtcp2_crypto_conn_ref <cimport,nodecl> = @record{get_conn: pointer, user_data: pointer}
local X509_STORE_CTX <cimport,nodecl> = @record{}
