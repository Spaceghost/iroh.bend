require 'C.stdlib'
require 'C.string'

local iroh_datagram_in4 <cimport,nodecl> = @record{s_addr: uint32}
local iroh_datagram_ipv4 <cimport,nodecl> = @record{
  sin_family: cushort, sin_port: cushort, sin_addr: iroh_datagram_in4, sin_zero: [8]cuchar
}
local iroh_datagram_ipv6 <cimport,nodecl> = @record{sin6_family: cushort, sin6_port: cushort, sin6_flowinfo: uint32,
  sin6_addr: [16]cuchar, sin6_scope_id: uint32}
local iroh_datagram_address <cimport,nodecl> = @record{ss_family: cushort, padding: [118]cuchar, alignment: uint64}
## cdefine 'iroh_datagram_iovec struct iovec'
## cdefine 'iroh_datagram_message struct msghdr'
## cdefine 'iroh_datagram_control struct cmsghdr'
## cdefine 'iroh_datagram_pktinfo4 struct in_pktinfo'
## cdefine 'iroh_datagram_pktinfo6 struct in6_pktinfo'
local iroh_datagram_iovec <cimport,nodecl> = @record{iov_base: pointer, iov_len: csize}
local iroh_datagram_message <cimport,nodecl> = @record{
  msg_name: pointer, msg_namelen: cuint, msg_iov: *iroh_datagram_iovec, msg_iovlen: csize,
  msg_control: pointer, msg_controllen: csize, msg_flags: cint
}
local iroh_datagram_control <cimport,nodecl> = @record{cmsg_len: csize, cmsg_level: cint, cmsg_type: cint}
local iroh_datagram_pktinfo4 <cimport,nodecl> = @record{ipi_ifindex: cint, ipi_spec_dst: iroh_datagram_in4, ipi_addr: iroh_datagram_in4}
local iroh_datagram_pktinfo6 <cimport,nodecl> = @record{ipi6_addr: [16]cuchar, ipi6_ifindex: cuint}
local ngtcp2_conn <cimport,nodecl> = @record{}
local ngtcp2_cid <cimport,nodecl> = @record{datalen: csize, data: [20]cuchar}
local ngtcp2_stateless_reset_token <cimport,nodecl> = @record{data: [16]cuchar}
local ngtcp2_addr <cimport,nodecl> = @record{addr: pointer, addrlen: cuint}
## cdefine 'iroh_datagram_local_path local'
local ngtcp2_path <cimport,nodecl> = @record{
  iroh_datagram_local_path: ngtcp2_addr, remote: ngtcp2_addr, user_data: pointer
}
local ngtcp2_settings <cimport,nodecl> = @record{initial_ts: uint64}
