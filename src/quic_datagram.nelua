local iroh_dgram_QuicStreamFin: uint32 <cimport,nodecl>
local iroh_dgram_QuicStreamBytes: uint32 <cimport,nodecl>
local iroh_dgram_DatagramConnection: uint32 <cimport,nodecl>
local iroh_dgram_Con: uint32 <cimport,nodecl>
