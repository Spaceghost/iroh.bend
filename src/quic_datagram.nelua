##[[
for _, name in ipairs{'start_quic_datagram','step_quic_datagram','write_quic_datagram','start_quic_migration','start_quic_path_migration','quic_migration_status',
    'monitor_quic_path','quic_path_timing','quic_millis',
    'read_quic_datagram','quic_datagram_acks','drop_quic_datagram','DatagramConnection',
    'open_quic_stream','accept_quic_stream','queue_quic_stream','flush_quic_stream','read_quic_stream',
    'take_quic_session','start_quic_resume','drop_quic_session','write_early_datagram','quic_resumption_status',
    'QuicSession','open_early_quic_stream','bind_resumable_quic','bind_shared_quic','bind_quic_identity','bind_dual_quic_identity','quic_remote_id','try_accept_shared_quic','close_shared_quic','QuicDatagramListener',
    'drop_quic_stream','QuicStreamPending','QuicStreamFin','QuicStreamBytes','Con','Nil','Unit','Some','None'} do
  cinclude(string.format(
    '#ifdef CID(%s)\n#define iroh_dgram_%s CID(%s)\n#else\n#define iroh_dgram_%s UINT32_MAX\n#endif',
    name,name,name,name))
end
]]
