local iroh_dgram_accept_quic_stream: uint32 <cimport,nodecl>
local iroh_dgram_queue_quic_stream: uint32 <cimport,nodecl>
local iroh_dgram_flush_quic_stream: uint32 <cimport,nodecl>
local iroh_dgram_read_quic_stream: uint32 <cimport,nodecl>
local iroh_dgram_drop_quic_stream: uint32 <cimport,nodecl>
