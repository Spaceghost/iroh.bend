local Env <cimport,nodecl> = @record{mem: *[0]uint64}
local IoWork <cimport,nodecl> = @record{}
local Term = @uint64
local Effect = @function(Env,*[0]Term,*IoWork): Term
local function io_eff(tag: uint32, run: Effect) <cimport,nodecl> end
local function io_tick(): uint64 <cimport,nodecl> end
local function io_cstr(e: Env, term: Term, size: *uint64): cstring <cimport,nodecl> end
local function io_nul(s: cstring, size: uint64): boolean <cimport,nodecl> end
local function io_done(e: Env, value: Term): Term <cimport,nodecl> end
local function io_fail(e: Env, code: uint32, msg: cstring): Term <cimport,nodecl> end
local function io_tup(e: Env, a: Term, b: Term): Term <cimport,nodecl> end
local function io_box(e: Env, tag: uint64, value: Term): Term <cimport,nodecl> end
local function io_list(e: Env, bytes: cstring, size: uint64): Term <cimport,nodecl> end
local function term_pak(tag: uint64, value: uint64): Term <cimport,nodecl> end
local function term_aux(t: Term): uint64 <cimport,nodecl> end
local function term_loc(t: Term): uint64 <cimport,nodecl> end
local function term_tag(t: Term): uint64 <cimport,nodecl> end
local function term_peek(mem: *[0]Term, t: Term): uint64 <cimport,nodecl> end
local function ctr_take(e: Env, t: Term, size: uint32, fields: *Term): uint64 <cimport,nodecl> end
local function cls_fit(size: uint32): uint32 <cimport,nodecl> end
local function spare_free(e: Env, class: uint32, loc: uint64) <cimport,nodecl> end
local TAG_PAK: uint64 <cimport,nodecl>
local TAG_CTR: uint64 <cimport,nodecl>
local EIO: uint32 <cimport,nodecl>
local EBADF: uint32 <cimport,nodecl>
local EINVAL: uint32 <cimport,nodecl>
local EACCES: uint32 <cimport,nodecl>
local EMSGSIZE: uint32 <cimport,nodecl>
local ENOTSUP: uint32 <cimport,nodecl>
local ENOMEM: uint32 <cimport,nodecl>
local EINTR: cint <cimport,nodecl>
local ECONNREFUSED: cint <cimport,nodecl>
local EHOSTUNREACH: cint <cimport,nodecl>
local ENETUNREACH: cint <cimport,nodecl>
local SOCK_CLOEXEC: cint <cimport,nodecl>
local NGTCP2_ERR_CRYPTO: cint <cimport,nodecl>
local NGTCP2_ERR_DRAINING: cint <cimport,nodecl>
local NGTCP2_ERR_DISCARD_PKT: cint <cimport,nodecl>
local NGTCP2_ERR_INVALID_ARGUMENT: cint <cimport,nodecl>

local EALREADY: uint32 <cimport,nodecl>
local EPIPE: uint32 <cimport,nodecl>
local ECONNRESET: uint32 <cimport,nodecl>
local NGTCP2_STREAM_DATA_FLAG_FIN: uint32 <cimport,nodecl>
local NGTCP2_STREAM_CLOSE_FLAG_APP_ERROR_CODE_SET: uint32 <cimport,nodecl>
local NGTCP2_WRITE_STREAM_FLAG_FIN: uint32 <cimport,nodecl>
local NGTCP2_ERR_STREAM_ID_BLOCKED: cint <cimport,nodecl>
local NGTCP2_ERR_STREAM_DATA_BLOCKED: cint <cimport,nodecl>
local NGTCP2_ERR_STREAM_SHUT_WR: cint <cimport,nodecl>
local NGTCP2_ERR_STREAM_NOT_FOUND: cint <cimport,nodecl>

local PACKET_CAPACITY <comptime> = 1500
local DATAGRAM_FRAME_LIMIT <comptime> = 65535
-- Iroh's default receive budget includes metadata, even for empty payloads.
local INBOX_BUDGET <comptime> = 1250000
local DATAGRAM_OVERHEAD <comptime> = 32
local Datagram = @record{next: pointer, size: csize}
local STREAM_WINDOW <comptime> = 65536
local STREAM_COUNT <comptime> = 16
local Stream = @record{
  next: pointer, id: int64, handle: uint32,
  rx: *[0]cuchar, rx_head: csize, rx_end: csize, rx_total: uint64,
  tx: *[0]cuchar, tx_size: csize, tx_sent: csize, tx_offset: uint64,
  announced: boolean, had_open_callback: boolean, rx_fin: boolean, rx_reset: boolean,
  tx_fin: boolean, tx_fin_sent: boolean, early: boolean, early_rejected: boolean, closed: boolean, aborted: boolean, discarded: boolean
}
local CID_SIZE <comptime> = 8
local MAX_PENDING <comptime> = 64
local ACCEPT_TIMEOUT <comptime> = 10000000000
local Listener = @record{
  next: pointer, id: uint32, fd: cint, ipv4_fd: cint,
  local_addr: iroh_datagram_address, local_size: cuint,
  ipv4_addr: iroh_datagram_address, ipv4_size: cuint, dispatch_ipv4: boolean, wildcard: boolean,
  ctx: *SSL_CTX, expected_key: *EVP_PKEY, alpn: [256]cuchar, alpn_size: cuint,
  refs: uint32, pending: uint32, stopped: boolean, resumable: boolean
}
local Session = @record{
  next: pointer, id: uint32, tls: *SSL_SESSION, context: *SSL_CTX,
  local_key: [32]cuchar, peer: [32]cuchar, alpn: [255]cuchar, alpn_size: cuint,
  parameters: [256]cuchar, parameters_size: csize
}
local Connection = @record{
  next: pointer,
  id: uint32,
  fd: cint,
  engine: *ngtcp2_conn,
  ssl: *SSL,
  tls: *ngtcp2_crypto_ossl_ctx,
  expected_key: *EVP_PKEY,
  ref: ngtcp2_crypto_conn_ref,
  remote_addr: iroh_datagram_address,
  local_addr: iroh_datagram_address,
  remote_size: cuint,
  local_size: cuint,
  candidate_fd: cint,
  candidate_addr: iroh_datagram_address,
  candidate_size: cuint,
  candidate_peer: iroh_datagram_address,
  candidate_peer_size: cuint,
  migration_state: uint32,
  path_monitor: boolean,
  last_path_input: uint64,
  path_packets_received: uint64,
  confirmed: boolean,
  output: [PACKET_CAPACITY]cuchar,
  output_path: ngtcp2_path,
  output_local_addr: iroh_datagram_address,
  output_remote_addr: iroh_datagram_address,
  output_size: csize,
  output_early: boolean,
  inbox_first: *Datagram,
  inbox_last: *Datagram,
  inbox_size: csize,
  acknowledgments: uint32,
  datagram_id: uint64,
  streams: *Stream,
  pin_status: cint,
  failed: boolean,
  listener: *Listener,
  original_id: ngtcp2_cid,
  accepted: boolean,
  accept_deadline: uint64,
  read_failure: cint,
  saved_session: *Session,
  resume_attempted: boolean,
  early_attempted: boolean,
  early_accepted: boolean
}
local connections: *Connection
local listeners: *Listener
local sessions: *Session
local next_session_id: uint32 = 1
local next_listener_id: uint32 = 1
local next_id: uint32 = 1
local next_stream_handle: uint32 = 1

local function quic_from_ref(ref: *ngtcp2_crypto_conn_ref): *ngtcp2_conn
  return ((@*Connection)(ref.user_data)).engine
end

local function verify_peer(store: *X509_STORE_CTX, data: pointer): cint
  local ssl = (@*SSL)(X509_STORE_CTX_get_ex_data(store,SSL_get_ex_data_X509_STORE_CTX_idx()))
  if ssl == nilptr then return 0 end
  local ref = (@*ngtcp2_crypto_conn_ref)(SSL_get_app_data(ssl))
  if ref == nilptr then return 0 end
  local conn = (@*Connection)(ref.user_data)
  local expected = conn.expected_key
  if conn.listener ~= nilptr then expected = conn.listener.expected_key end
  local key = X509_STORE_CTX_get0_rpk(store)
  if key ~= nilptr and EVP_PKEY_is_a(key,'ED25519') == 1 and
      ((expected ~= nilptr and EVP_PKEY_eq(key,expected) == 1) or
       (expected == nilptr and conn.listener ~= nilptr)) then
    conn.pin_status = 1
    X509_STORE_CTX_set_error(store,X509_V_OK)
    return 1
  end
  conn.pin_status = -1
  X509_STORE_CTX_set_error(store,X509_V_ERR_APPLICATION_VERIFICATION)
  return 0
end

local function quic_random(out: *cuchar, size: csize, context: pointer)
  -- ngtcp2 uses this callback for non-cryptographic random values.
  if RAND_bytes(out,(@cint)(size)) ~= 1 then C.memset(out,0,size) end
end

local function new_connection_id(engine: *ngtcp2_conn, cid: *ngtcp2_cid,
    token: *ngtcp2_stateless_reset_token, size: csize, user: pointer): cint
  if RAND_bytes(&cid.data[0],(@cint)(size)) ~= 1 or RAND_bytes(&token.data[0],16) ~= 1 then
    return NGTCP2_ERR_CALLBACK_FAILURE
  end
  cid.datalen = size
  return 0
end

local function datagram_data(item: *Datagram): *cuchar
  return &((@*[0]cuchar)(item))[#Datagram]
end

local function pop_datagram(conn: *Connection)
  local item = conn.inbox_first
  conn.inbox_first = (@*Datagram)(item.next)
  if conn.inbox_first == nilptr then conn.inbox_last = nilptr end
  conn.inbox_size = conn.inbox_size - (item.size + DATAGRAM_OVERHEAD)
  C.free(item)
end

local function receive_datagram(engine: *ngtcp2_conn, flags: uint32, bytes: *cuchar,
    size: csize, user: pointer): cint
  local conn = (@*Connection)(user)
  if size > DATAGRAM_FRAME_LIMIT then return NGTCP2_ERR_CALLBACK_FAILURE end
  local item = (@*Datagram)(C.malloc(#Datagram + size))
  if item == nilptr then return 0 end
  item.next = nilptr
  item.size = size
  if size ~= 0 then C.memcpy(datagram_data(item),bytes,size) end
  local occupied = size + DATAGRAM_OVERHEAD
  while conn.inbox_size + occupied > INBOX_BUDGET do pop_datagram(conn) end
  if conn.inbox_last == nilptr then
    conn.inbox_first = item
  else
    conn.inbox_last.next = item
  end
  conn.inbox_last = item
  conn.inbox_size = conn.inbox_size + occupied
  return 0
end

local function ack_datagram(engine: *ngtcp2_conn, id: uint64, user: pointer): cint
  local conn = (@*Connection)(user)
  conn.acknowledgments = conn.acknowledgments + 1
  return 0
end

local function stream_by_id(conn: *Connection, id: int64): *Stream
  local stream = conn.streams
  while stream ~= nilptr and stream.id ~= id do stream = (@*Stream)(stream.next) end
  return stream
end

local function stream_by_handle(conn: *Connection, handle: Term): *Stream
  local stream = conn.streams
  while stream ~= nilptr do
    if stream.handle == handle and not stream.discarded then return stream end
    stream = (@*Stream)(stream.next)
  end
  return nilptr
end

local function add_stream(conn: *Connection, id: int64): *Stream
  if next_stream_handle == 0 then return nilptr end
  local stream = (@*Stream)(C.calloc(1,#Stream))
  if stream == nilptr then return nilptr end
  stream.id = id
  stream.handle = next_stream_handle
  next_stream_handle = next_stream_handle + 1
  stream.next = conn.streams
  conn.streams = stream
  return stream
end

local function remove_stream(conn: *Connection, stream: *Stream)
  if conn.streams == stream then
    conn.streams = (@*Stream)(stream.next)
  else
    local prior = conn.streams
    while prior.next ~= stream do prior = (@*Stream)(prior.next) end
    prior.next = stream.next
  end
  C.free(stream.rx)
  C.free(stream.tx)
  C.free(stream)
end

local function peer_stream(conn: *Connection, id: int64): *Stream
  local stream = stream_by_id(conn,id)
  if stream == nilptr and ngtcp2_conn_is_local_stream2(conn.engine,id) == 0 then stream = add_stream(conn,id) end
  return stream
end

local function stream_opened(engine: *ngtcp2_conn, id: int64, user: pointer): cint
  local stream = peer_stream((@*Connection)(user),id)
  if stream == nilptr then return NGTCP2_ERR_CALLBACK_FAILURE end
  stream.had_open_callback = true
  return 0
end

local function return_stream_credit(conn: *Connection, stream: *Stream)
  -- ngtcp2 already returns credit for implicitly opened streams.
  if stream.had_open_callback then
    if (stream.id & 2) ~= 0 then
      ngtcp2_conn_extend_max_streams_uni(conn.engine,1)
    else
      ngtcp2_conn_extend_max_streams_bidi(conn.engine,1)
    end
  end
end

local function stream_received(engine: *ngtcp2_conn, flags: uint32, id: int64, offset: uint64,
    data: *cuchar, size: csize, user: pointer, stream_user: pointer): cint
  local stream = peer_stream((@*Connection)(user),id)
  if stream == nilptr then return NGTCP2_ERR_CALLBACK_FAILURE end
  if stream.discarded then return 0 end
  local buffered = stream.rx_end - stream.rx_head
  if offset ~= stream.rx_total or size > STREAM_WINDOW - buffered then return NGTCP2_ERR_CALLBACK_FAILURE end
  if size > 0 then
    if stream.rx == nilptr then
      stream.rx = (@*[0]cuchar)(C.malloc(STREAM_WINDOW))
      if stream.rx == nilptr then return NGTCP2_ERR_CALLBACK_FAILURE end
    end
    if stream.rx_end + size > STREAM_WINDOW then
      C.memmove(&stream.rx[0],&stream.rx[stream.rx_head],buffered)
      stream.rx_head = 0
      stream.rx_end = buffered
    end
    C.memcpy(&stream.rx[stream.rx_end],data,size)
    stream.rx_end = stream.rx_end + size
    stream.rx_total = stream.rx_total + size
  end
  stream.rx_fin = (flags & NGTCP2_STREAM_DATA_FLAG_FIN) ~= 0
  return 0
end

local function stream_acknowledged(engine: *ngtcp2_conn, id: int64, offset: uint64, size: uint64,
    user: pointer, stream_user: pointer): cint
  local stream = stream_by_id((@*Connection)(user),id)
  if stream ~= nilptr and stream.tx ~= nilptr and stream.tx_sent == stream.tx_size and
      offset + size >= stream.tx_offset + stream.tx_size and
      (stream.tx_size ~= 0 or (stream.tx_fin_sent and size == 0)) then
    stream.tx_offset = stream.tx_offset + stream.tx_size
    C.free(stream.tx)
    stream.tx = nilptr
  end
  return 0
end

local function stream_reset(engine: *ngtcp2_conn, id: int64, final_size: uint64, app_code: uint64,
    user: pointer, stream_user: pointer): cint
  local stream = peer_stream((@*Connection)(user),id)
  if stream ~= nilptr then stream.rx_reset = true end
  return 0
end

local function stream_closed(engine: *ngtcp2_conn, flags: uint32, id: int64, app_code: uint64,
    user: pointer, stream_user: pointer): cint
  local conn = (@*Connection)(user)
  local stream = stream_by_id(conn,id)
  if stream ~= nilptr then
    stream.closed = true
    stream.aborted = (flags & NGTCP2_STREAM_CLOSE_FLAG_APP_ERROR_CODE_SET) ~= 0
    C.free(stream.tx)
    stream.tx = nilptr
    if stream.discarded then
      return_stream_credit(conn,stream)
      remove_stream(conn,stream)
    end
  end
  return 0
end

local function connection_path(conn: *Connection): ngtcp2_path
  return {
    iroh_datagram_local_path = {addr = &conn.local_addr, addrlen = conn.local_size},
    remote = {addr = &conn.remote_addr, addrlen = conn.remote_size}
  }
end

local function packet_path(conn: *Connection): *ngtcp2_path
  if conn.listener == nilptr and conn.migration_state == 0 then return nilptr end
  conn.output_path = {
    iroh_datagram_local_path = {addr = &conn.output_local_addr},
    remote = {addr = &conn.output_remote_addr}
  }
  return &conn.output_path
end

local function numeric_address(host: cstring, port: cushort, out: *iroh_datagram_address): cuint
  local ipv4 = (@*iroh_datagram_ipv4)(out)
  if inet_pton(AF_INET,host,&ipv4.sin_addr) == 1 then
    ipv4.sin_family = (@cushort)(AF_INET)
    ipv4.sin_port = htons(port)
    return #iroh_datagram_ipv4
  end
  local ipv6 = (@*iroh_datagram_ipv6)(out)
  if inet_pton(AF_INET6,host,&ipv6.sin6_addr) == 1 then
    ipv6.sin6_family = (@cushort)(AF_INET6)
    ipv6.sin6_port = htons(port)
    return #iroh_datagram_ipv6
  end
  errno = (@cint)(EINVAL)
  return 0
end

local function address_port(addr: *iroh_datagram_address): cushort
  if addr.ss_family == AF_INET then return ntohs(((@*iroh_datagram_ipv4)(addr)).sin_port) end
  return ntohs(((@*iroh_datagram_ipv6)(addr)).sin6_port)
end

local function concrete_address(addr: *iroh_datagram_address): boolean
  if addr.ss_family == AF_INET then return ((@*iroh_datagram_ipv4)(addr)).sin_addr.s_addr ~= 0 end
  local zero: [16]cuchar
  return C.memcmp(&(((@*iroh_datagram_ipv6)(addr)).sin6_addr),&zero[0],16) ~= 0
end

local function same_address(left: *iroh_datagram_address, right: *iroh_datagram_address): boolean
  if left.ss_family ~= right.ss_family then return false end
  if left.ss_family == AF_INET then
    local a = (@*iroh_datagram_ipv4)(left)
    local b = (@*iroh_datagram_ipv4)(right)
    return a.sin_port == b.sin_port and a.sin_addr.s_addr == b.sin_addr.s_addr
  end
  local a = (@*iroh_datagram_ipv6)(left)
  local b = (@*iroh_datagram_ipv6)(right)
  return a.sin6_port == b.sin6_port and a.sin6_scope_id == b.sin6_scope_id and
    C.memcmp(&a.sin6_addr,&b.sin6_addr,16) == 0
end

local function same_path(path: *ngtcp2_path, local_addr: *iroh_datagram_address,
    peer: *iroh_datagram_address): boolean
  return same_address(local_addr,(@*iroh_datagram_address)(path.iroh_datagram_local_path.addr)) and
    same_address(peer,(@*iroh_datagram_address)(path.remote.addr))
end

local function confirm_handshake(engine: *ngtcp2_conn, user: pointer): cint
  local conn = (@*Connection)(user)
  conn.confirmed = true
  return 0
end

local function migration_validated(engine: *ngtcp2_conn, flags: uint32, path: *ngtcp2_path,
    fallback: *ngtcp2_path, result: cint, user: pointer): cint
  local conn = (@*Connection)(user)
  if conn.listener == nilptr and conn.migration_state == 1 and
      same_path(path,&conn.candidate_addr,&conn.candidate_peer) then
    conn.migration_state = result == NGTCP2_PATH_VALIDATION_RESULT_SUCCESS and 2 or 3
  end
  return 0
end

local function udp_socket(addr: *iroh_datagram_address): cint
  return socket((@cint)(addr.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
end

local function open_udp(conn: *Connection, host: cstring, port: cushort): boolean
  conn.remote_size = numeric_address(host,port,&conn.remote_addr)
  if conn.remote_size == 0 then return false end
  conn.fd = udp_socket(&conn.remote_addr)
  conn.local_size = #iroh_datagram_address
  return conn.fd >= 0 and connect(conn.fd,&conn.remote_addr,conn.remote_size) == 0 and
    getsockname(conn.fd,&conn.local_addr,&conn.local_size) == 0
end

local function authenticated_pin(conn: *Connection): boolean
  if conn.listener ~= nilptr and conn.listener.expected_key == nilptr then
    -- OpenSSL retains the authenticated raw key in the resumed session.
    local key = SSL_get0_peer_rpk(conn.ssl)
    if key == nilptr or EVP_PKEY_is_a(key,'ED25519') ~= 1 then return false end
  end
  local allowed = conn.resume_attempted or (conn.listener ~= nilptr and conn.listener.resumable)
  return conn.pin_status == 1 or (conn.pin_status == 0 and allowed and SSL_session_reused(conn.ssl) == 1)
end

local function free_session(session: *Session)
  if session ~= nilptr then
    SSL_SESSION_free(session.tls)
    SSL_CTX_free(session.context)
    C.free(session)
  end
end

local function public_key(key: *EVP_PKEY, out: *cuchar): boolean
  local size: csize = 32
  return key ~= nilptr and EVP_PKEY_get_raw_public_key(key,out,&size) == 1 and size == 32
end

local function capture_session(ssl: *SSL, ticket: *SSL_SESSION): cint
  local ref = (@*ngtcp2_crypto_conn_ref)(SSL_get_app_data(ssl))
  if ref == nilptr then return 0 end
  local conn = (@*Connection)(ref.user_data)
  if not authenticated_pin(conn) or ngtcp2_conn_get_remote_transport_params2(conn.engine) == nilptr then return 0 end
  local session = (@*Session)(C.calloc(1,#Session))
  if session == nilptr then return 0 end
  local alpn: *cuchar
  SSL_get0_alpn_selected(ssl,&alpn,&session.alpn_size)
  local size = ngtcp2_conn_encode_0rtt_transport_params2(conn.engine,&session.parameters[0],#session.parameters)
  if alpn == nilptr or session.alpn_size == 0 or session.alpn_size > #session.alpn or size <= 0 or
      not public_key(SSL_get_privatekey(ssl),&session.local_key[0]) or
      not public_key(conn.expected_key,&session.peer[0]) then
    free_session(session)
    return 0
  end
  C.memcpy(&session.alpn[0],alpn,session.alpn_size)
  session.parameters_size = (@csize)(size)
  local context = SSL_get_SSL_CTX(ssl)
  if SSL_CTX_up_ref(context) ~= 1 then
    free_session(session)
    return 0
  end
  session.context = context
  -- Closing the connection can invalidate its own TLS session object.
  session.tls = SSL_SESSION_dup(ticket)
  if session.tls == nilptr then
    free_session(session)
    return 0
  end
  free_session(conn.saved_session)
  conn.saved_session = session
  return 0
end

local function handshake_done(engine: *ngtcp2_conn, user: pointer): cint
  local conn = (@*Connection)(user)
  if not conn.early_attempted then return 0 end
  conn.early_accepted = SSL_get_early_data_status(conn.ssl) == SSL_EARLY_DATA_ACCEPTED
  if conn.early_accepted then return 0 end
  if ngtcp2_conn_tls_early_data_rejected(engine) ~= 0 then return NGTCP2_ERR_CALLBACK_FAILURE end
  if conn.output_early then
    conn.output_size = 0
    conn.output_early = false
  end
  local stream = conn.streams
  while stream ~= nilptr do
    local next = (@*Stream)(stream.next)
    if stream.early then
      if stream.discarded then
        remove_stream(conn,stream)
      else
        -- ngtcp2 discarded the stream and may reuse its wire ID for 1-RTT.
        stream.id = -1
        stream.early_rejected = true
        stream.closed = true
        stream.aborted = true
        C.free(stream.tx)
        stream.tx = nilptr
      end
    end
    stream = next
  end
  return 0
end

local function create_tls_ctx(seed: *cuchar, mode: cint): *SSL_CTX
  local key = EVP_PKEY_new_raw_private_key_ex(nilptr,'ED25519',nilptr,seed,32)
  if key == nilptr then return nilptr end
  defer EVP_PKEY_free(key) end
  local ctx = SSL_CTX_new(TLS_method())
  if ctx == nilptr then return nilptr end
  local raw_key = TLSEXT_cert_type_rpk
  if SSL_CTX_use_PrivateKey(ctx,key) ~= 1 or SSL_CTX_set1_server_cert_type(ctx,&raw_key,1) ~= 1 or
      SSL_CTX_set1_client_cert_type(ctx,&raw_key,1) ~= 1 then
    SSL_CTX_free(ctx)
    return nilptr
  end
  SSL_CTX_set_verify(ctx,mode,nilptr)
  SSL_CTX_set_cert_verify_callback(ctx,(@pointer)(verify_peer),nilptr)
  return ctx
end

local function setup_ssl(conn: *Connection, ctx: *SSL_CTX, alpn: *cuchar, size: cuint): boolean
  conn.ssl = SSL_new(ctx)
  if conn.ssl == nilptr then return false end
  conn.ref = {get_conn = (@pointer)(quic_from_ref), user_data = conn}
  if SSL_set_app_data(conn.ssl,&conn.ref) ~= 1 or ngtcp2_crypto_ossl_ctx_new(&conn.tls,conn.ssl) ~= 0 then
    return false
  end
  if conn.listener ~= nilptr then
    SSL_set_accept_state(conn.ssl)
    return ngtcp2_crypto_ossl_configure_server_session(conn.ssl) == 0 and
      (not conn.listener.resumable or SSL_set_quic_tls_early_data_enabled(conn.ssl,1) == 1)
  end
  SSL_set_connect_state(conn.ssl)
  return SSL_set_alpn_protos(conn.ssl,alpn,size) == 0 and ngtcp2_crypto_ossl_configure_client_session(conn.ssl) == 0
end

local function open_tls(conn: *Connection, seed: *cuchar, peer: *cuchar, alpn: *cuchar, size: cuint): boolean
  local ctx = create_tls_ctx(seed,SSL_VERIFY_PEER)
  if ctx == nilptr then return false end
  defer SSL_CTX_free(ctx) end
  SSL_CTX_set_session_cache_mode(ctx,SSL_SESS_CACHE_CLIENT | SSL_SESS_CACHE_NO_INTERNAL_STORE)
  SSL_CTX_sess_set_new_cb(ctx,(@pointer)(capture_session))
  conn.expected_key = EVP_PKEY_new_raw_public_key_ex(nilptr,'ED25519',nilptr,peer,32)
  return conn.expected_key ~= nilptr and setup_ssl(conn,ctx,alpn,size)
end

local function select_alpn(ssl: *SSL, out: **cuchar, outlen: *cuchar, offered: *cuchar,
    offered_size: cuint, arg: pointer): cint
  local listener = (@*Listener)(arg)
  if SSL_select_next_proto(out,outlen,&listener.alpn[0],listener.alpn_size,
      offered,offered_size) ~= OPENSSL_NPN_NEGOTIATED then return SSL_TLSEXT_ERR_ALERT_FATAL end
  return SSL_TLSEXT_ERR_OK
end

local function open_engine(conn: *Connection, initial: *ngtcp2_pkt_hd, now: uint64): cint
  local callbacks: ngtcp2_callbacks = {
    client_initial = initial == nilptr and ngtcp2_crypto_client_initial_cb or nilptr,
    recv_client_initial = initial ~= nilptr and ngtcp2_crypto_recv_client_initial_cb or nilptr,
    recv_crypto_data = ngtcp2_crypto_recv_crypto_data_cb,
    encrypt = ngtcp2_crypto_encrypt_cb, decrypt = ngtcp2_crypto_decrypt_cb, hp_mask = ngtcp2_crypto_hp_mask_cb,
    recv_retry = ngtcp2_crypto_recv_retry_cb, rand = (@pointer)(quic_random), update_key = ngtcp2_crypto_update_key_cb,
    delete_crypto_aead_ctx = ngtcp2_crypto_delete_crypto_aead_ctx_cb,
    delete_crypto_cipher_ctx = ngtcp2_crypto_delete_crypto_cipher_ctx_cb,
    version_negotiation = ngtcp2_crypto_version_negotiation_cb, get_new_connection_id2 = (@pointer)(new_connection_id),
    get_path_challenge_data2 = ngtcp2_crypto_get_path_challenge_data2_cb,
    recv_datagram = (@pointer)(receive_datagram), ack_datagram = (@pointer)(ack_datagram),
    stream_open = (@pointer)(stream_opened), recv_stream_data = (@pointer)(stream_received),
    acked_stream_data_offset = (@pointer)(stream_acknowledged), stream_reset = (@pointer)(stream_reset),
    stream_close = (@pointer)(stream_closed), handshake_completed = (@pointer)(handshake_done),
    handshake_confirmed = (@pointer)(confirm_handshake), path_validation = (@pointer)(migration_validated)
  }
  local scid: ngtcp2_cid = {datalen = CID_SIZE}
  if RAND_bytes(&scid.data[0],CID_SIZE) ~= 1 then return NGTCP2_ERR_CALLBACK_FAILURE end
  local settings: ngtcp2_settings
  ngtcp2_settings_default(&settings)
  settings.initial_ts = now
  local params: ngtcp2_transport_params
  ngtcp2_transport_params_default(&params)
  params.max_datagram_frame_size = DATAGRAM_FRAME_LIMIT
  params.initial_max_data = STREAM_WINDOW * STREAM_COUNT
  params.initial_max_stream_data_bidi_local = STREAM_WINDOW
  params.initial_max_stream_data_bidi_remote = STREAM_WINDOW
  params.initial_max_stream_data_uni = STREAM_WINDOW
  params.initial_max_streams_bidi = STREAM_COUNT
  params.initial_max_streams_uni = STREAM_COUNT
  local path = connection_path(conn)
  local status: cint
  if initial ~= nilptr then
    params.original_dcid = initial.dcid
    params.original_dcid_present = 1
    conn.original_id = initial.dcid
    status = ngtcp2_conn_server_new(&conn.engine,&initial.scid,&scid,&path,initial.version,
      &callbacks,&settings,&params,nilptr,conn)
  else
    local dcid: ngtcp2_cid = {datalen = CID_SIZE}
    if RAND_bytes(&dcid.data[0],CID_SIZE) ~= 1 then return NGTCP2_ERR_CALLBACK_FAILURE end
    status = ngtcp2_conn_client_new(&conn.engine,&dcid,&scid,&path,NGTCP2_PROTO_VER_V1,
      &callbacks,&settings,&params,nilptr,conn)
  end
  if status == 0 then ngtcp2_conn_set_tls_native_handle(conn.engine,conn.tls) end
  return status
end

local function release_listener(listener: *Listener)
  listener.refs = listener.refs - 1
  if listener.refs == 0 then
    SSL_CTX_free(listener.ctx)
    EVP_PKEY_free(listener.expected_key)
    if listener.fd >= 0 then close(listener.fd) end
    if listener.ipv4_fd >= 0 then close(listener.ipv4_fd) end
    C.free(listener)
  end
end

local function destroy(conn: *Connection)
  if conn.engine ~= nilptr then ngtcp2_conn_del(conn.engine) end
  if conn.ssl ~= nilptr then SSL_set_app_data(conn.ssl,nilptr) end
  if conn.tls ~= nilptr then ngtcp2_crypto_ossl_ctx_del(conn.tls) end
  SSL_free(conn.ssl)
  EVP_PKEY_free(conn.expected_key)
  if conn.listener ~= nilptr then
    if not conn.accepted then conn.listener.pending = conn.listener.pending - 1 end
    release_listener(conn.listener)
  elseif conn.fd >= 0 then
    close(conn.fd)
  end
  if conn.listener == nilptr and conn.candidate_fd >= 0 then close(conn.candidate_fd) end
  free_session(conn.saved_session)
  while conn.inbox_first ~= nilptr do pop_datagram(conn) end
  while conn.streams ~= nilptr do remove_stream(conn,conn.streams) end
  C.free(conn)
end

local function handle_id(e: Env, handle: Term, tag: uint32): uint64
  if term_aux(handle) ~= tag then return 0 end
  if term_tag(handle) == TAG_PAK then return term_loc(handle) end
  if term_tag(handle) == TAG_CTR then return e.mem[term_peek(e.mem,handle)] end
  return 0
end

local function find(e: Env, handle: Term): *Connection
  local id = handle_id(e,handle,iroh_dgram_DatagramConnection)
  local conn = connections
  while conn ~= nilptr and conn.id ~= id do conn = (@*Connection)(conn.next) end
  return conn
end

local function find_listener(e: Env, handle: Term): *Listener
  local id = handle_id(e,handle,iroh_dgram_QuicDatagramListener)
  local listener = listeners
  while listener ~= nilptr and listener.id ~= id do listener = (@*Listener)(listener.next) end
  return listener
end

local function register_connection(conn: *Connection)
  conn.next = connections
  conn.id = next_id
  next_id = next_id + 1
  connections = conn
end

local function remove_connection(conn: *Connection)
  if connections == conn then
    connections = (@*Connection)(conn.next)
  else
    local prior = connections
    while prior.next ~= conn do prior = (@*Connection)(prior.next) end
    prior.next = conn.next
  end
  destroy(conn)
end

local function unpack(e: Env, item: Term, out: *cuchar, limit: csize): isize
  local size: csize = 0
  local dst = (@*[0]cuchar)(out)
  local valid = true
  local oversized = false
  while term_aux(item) == iroh_dgram_Con do
    local fields: [2]Term
    spare_free(e,cls_fit(2),ctr_take(e,item,2,&fields[0]))
    local byte = fields[0]
    if byte > 255 then
      valid = false
    elseif size >= limit then
      oversized = true
    else
      dst[size] = (@cuchar)(byte)
      size = size + 1
    end
    item = fields[1]
  end
  if not valid or term_aux(item) ~= iroh_dgram_Nil then return -1 end
  if oversized then return -2 end
  return (@isize)(size)
end

local QuicConfig = @record{seed: [32]cuchar, peer: [32]cuchar, alpn: [256]cuchar, size: cuint}

local function unpack_alpn(e: Env, value: Term, config: *QuicConfig): boolean
  local size = unpack(e,value,&config.alpn[1],255)
  if size <= 0 then return false end
  config.alpn[0] = (@cuchar)(size)
  config.size = (@cuint)(size + 1)
  return true
end

local function unpack_config(e: Env, args: *[0]Term, config: *QuicConfig): boolean
  return unpack(e,args[2],&config.seed[0],32) == 32 and
    unpack(e,args[3],&config.peer[0],32) == 32 and unpack_alpn(e,args[4],config)
end

local function owns_ticket(config: *QuicConfig, ticket: *Session): boolean
  if config.size ~= ticket.alpn_size + 1 or C.memcmp(&config.alpn[1],&ticket.alpn[0],ticket.alpn_size) ~= 0 or
      C.memcmp(&config.peer[0],&ticket.peer[0],32) ~= 0 then return false end
  local key = EVP_PKEY_new_raw_private_key_ex(nilptr,'ED25519',nilptr,&config.seed[0],32)
  if key == nilptr then return false end
  defer EVP_PKEY_free(key) end
  local id: [32]cuchar
  return public_key(key,&id[0]) and C.memcmp(&id[0],&ticket.local_key[0],32) == 0
end

local function pop_session(e: Env, handle: Term): *Session
  local id = handle_id(e,handle,iroh_dgram_QuicSession)
  local current = sessions
  local previous: *Session
  while current ~= nilptr and current.id ~= id do
    previous = current
    current = (@*Session)(current.next)
  end
  if current ~= nilptr then
    if previous == nilptr then
      sessions = (@*Session)(current.next)
    else
      previous.next = current.next
    end
    current.next = nilptr
  end
  return current
end

local function open_resumed_tls(conn: *Connection, config: *QuicConfig, ticket: *Session, early: boolean): cstring
  conn.expected_key = EVP_PKEY_new_raw_public_key_ex(nilptr,'ED25519',nilptr,&config.peer[0],32)
  if conn.expected_key == nilptr or not setup_ssl(conn,ticket.context,&config.alpn[0],config.size) then
    return 'could not configure QUIC resumption TLS'
  end
  if SSL_SESSION_is_resumable(ticket.tls) ~= 1 or SSL_set_session(conn.ssl,ticket.tls) ~= 1 then
    return 'QUIC session ticket is no longer resumable'
  end
  conn.resume_attempted = true
  conn.early_attempted = early and SSL_SESSION_get_max_early_data(ticket.tls) ~= 0
  if conn.early_attempted and SSL_set_quic_tls_early_data_enabled(conn.ssl,1) ~= 1 then
    return 'could not enable QUIC early data'
  end
  return nilptr
end

local function start_client(e: Env, args: *[0]Term, ticket: *Session, early: boolean, resuming: boolean): Term
  local host_size: uint64
  local host = io_cstr(e,args[0],&host_size)
  defer C.free(host) end
  local config: QuicConfig
  if not unpack_config(e,args,&config) or args[1] == 0 or args[1] > 65535 or io_nul(host,host_size) then
    return io_fail(e,EINVAL,'invalid QUIC address, Ed25519 key, or ALPN')
  end
  if resuming and ticket == nilptr then return io_fail(e,EBADF,'QUIC session closed or already used') end
  if ticket ~= nilptr and not owns_ticket(&config,ticket) then
    return io_fail(e,EACCES,'QUIC session identity or ALPN does not match')
  end
  if next_id == 0 then return io_fail(e,ENOMEM,'QUIC connection handles exhausted') end
  local conn = (@*Connection)(C.calloc(1,#Connection))
  if conn == nilptr then return io_fail(e,ENOMEM,nilptr) end
  conn.fd = -1
  conn.candidate_fd = -1
  if not open_udp(conn,host,(@cushort)(args[1])) then
    local code = (@uint32)(errno)
    destroy(conn)
    return io_fail(e,code,nilptr)
  end
  if ticket == nilptr then
    if not open_tls(conn,&config.seed[0],&config.peer[0],&config.alpn[0],config.size) then
      destroy(conn)
      return io_fail(e,EIO,'could not configure QUIC raw public key TLS')
    end
  else
    local error = open_resumed_tls(conn,&config,ticket,early)
    if error ~= nilptr then
      destroy(conn)
      return io_fail(e,EIO,error)
    end
  end
  local status = open_engine(conn,nilptr,io_tick())
  if status == 0 and conn.early_attempted then
    status = ngtcp2_conn_decode_and_set_0rtt_transport_params(conn.engine,&ticket.parameters[0],ticket.parameters_size)
  end
  if status ~= 0 then
    destroy(conn)
    return io_fail(e,EIO,ngtcp2_strerror(status))
  end
  register_connection(conn)
  return io_done(e,term_pak(iroh_dgram_DatagramConnection,conn.id))
end

local function start_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,nilptr,false,false)
end

local function resume_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local ticket = pop_session(e,args[5])
  defer free_session(ticket) end
  return start_client(e,args,ticket,args[6] ~= 0,true)
end

local function drop_session_run(e: Env, args: *[0]Term, work: *IoWork): Term
  free_session(pop_session(e,args[0]))
  return term_pak(iroh_dgram_Unit,0)
end

local function authenticated(conn: *Connection): boolean
  return ngtcp2_conn_get_handshake_completed2(conn.engine) ~= 0 and authenticated_pin(conn)
end

local function migration_address(text: cstring, port: Term, addr: *iroh_datagram_address): cuint
  if port > 65535 then return 0 end
  local size = numeric_address(text,(@cushort)(port),addr)
  if size == 0 or not concrete_address(addr) then return 0 end
  return size
end

local function start_migration(e: Env, conn: *Connection, host: Term, port: Term,
    peer_host: Term, peer_port: Term, change_peer: boolean): Term
  if conn == nilptr or conn.failed then return io_fail(e,EBADF,'QUIC connection closed') end
  if conn.listener ~= nilptr then return io_fail(e,ENOTSUP,'only a QUIC dialer can initiate migration') end
  if conn.candidate_fd >= 0 then return io_fail(e,EALREADY,'QUIC migration already in progress') end
  if not conn.confirmed or not authenticated(conn) or conn.output_size ~= 0 then return io_done(e,0) end
  local local_addr: iroh_datagram_address
  local peer: iroh_datagram_address
  local peer_size: cuint
  if change_peer then
    local peer_length: uint64
    local peer_text = io_cstr(e,peer_host,&peer_length)
    defer C.free(peer_text) end
    if not io_nul(peer_text,peer_length) then peer_size = migration_address(peer_text,peer_port,&peer) end
    if peer_size == 0 or peer_port == 0 then return io_fail(e,EINVAL,'invalid QUIC destination address') end
  else
    peer = conn.remote_addr
    peer_size = conn.remote_size
  end
  local host_length: uint64
  local local_text = io_cstr(e,host,&host_length)
  defer C.free(local_text) end
  local automatic = host_length == 0 and port == 0
  local size: cuint
  if not io_nul(local_text,host_length) then size = migration_address(local_text,port,&local_addr) end
  if not automatic and (size == 0 or local_addr.ss_family ~= peer.ss_family) then
    return io_fail(e,EINVAL,'QUIC migration requires a concrete numeric IP matching the peer address family')
  end
  local fd = udp_socket(&peer)
  if fd < 0 then return io_fail(e,(@uint32)(errno),nilptr) end
  local bind_size = size
  size = #iroh_datagram_address
  if (not automatic and bind(fd,&local_addr,bind_size) ~= 0) or connect(fd,&peer,peer_size) ~= 0 or
      getsockname(fd,&local_addr,&size) ~= 0 then
    local code = (@uint32)(errno)
    close(fd)
    return io_fail(e,code,nilptr)
  end
  local path = connection_path(conn)
  path.iroh_datagram_local_path = {addr = &local_addr, addrlen = size}
  path.remote = {addr = &peer, addrlen = peer_size}
  local status = ngtcp2_conn_initiate_migration(conn.engine,&path,io_tick())
  if status ~= 0 then
    close(fd)
    if status == NGTCP2_ERR_CONN_ID_BLOCKED then return io_done(e,0) end
    if status == NGTCP2_ERR_INVALID_STATE then return io_fail(e,ENOTSUP,ngtcp2_strerror(status)) end
    if status == NGTCP2_ERR_INVALID_ARGUMENT then return io_fail(e,EINVAL,ngtcp2_strerror(status)) end
    conn.failed = true
    return io_fail(e,status == NGTCP2_ERR_NOMEM and ENOMEM or EIO,ngtcp2_strerror(status))
  end
  conn.candidate_fd = fd
  conn.candidate_addr = local_addr
  conn.candidate_size = size
  conn.candidate_peer = peer
  conn.candidate_peer_size = peer_size
  -- ngtcp2 can immediately reuse a path still in its validated path history.
  local current = ngtcp2_conn_get_path2(conn.engine)
  conn.migration_state = same_path(current,&local_addr,&peer) and 2 or 1
  return io_done(e,address_port(&local_addr))
end

local function start_migration_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],start_migration(e,find(e,args[0]),args[1],args[2],0,0,false))
end

local function start_path_migration_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],start_migration(e,find(e,args[0]),args[1],args[2],args[3],args[4],true))
end

local function migration_status_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn == nilptr or conn.failed then return io_tup(e,args[0],io_fail(e,EBADF,'QUIC connection closed')) end
  local state = conn.candidate_fd >= 0 and 1 or conn.migration_state
  return io_tup(e,args[0],io_done(e,state))
end

local function output_on_candidate(conn: *Connection): boolean
  return conn.listener == nilptr and conn.candidate_fd >= 0 and
    same_path(&conn.output_path,&conn.candidate_addr,&conn.candidate_peer)
end

-- Wildcard listeners use the packet destination as ngtcp2's local address
-- and select the same source address when replying.
local function send_from(fd: cint, path: *ngtcp2_path, bytes: pointer, size: csize): isize
  local source = (@*iroh_datagram_address)(path.iroh_datagram_local_path.addr)
  local buffer: [16]uint64 = {}
  local vector: iroh_datagram_iovec = {iov_base = bytes, iov_len = size}
  local message: iroh_datagram_message = {
    msg_name = path.remote.addr, msg_namelen = path.remote.addrlen,
    msg_iov = &vector, msg_iovlen = 1, msg_control = &buffer[0], msg_controllen = #buffer * #uint64,
  }
  local control = CMSG_FIRSTHDR(&message)
  if source.ss_family == AF_INET then
    local info = (@*iroh_datagram_pktinfo4)(CMSG_DATA(control))
    info.ipi_spec_dst = ((@*iroh_datagram_ipv4)(source)).sin_addr
    control.cmsg_level = IPPROTO_IP
    control.cmsg_type = IP_PKTINFO
    control.cmsg_len = CMSG_LEN(#iroh_datagram_pktinfo4)
    message.msg_controllen = CMSG_SPACE(#iroh_datagram_pktinfo4)
  else
    local ipv6 = (@*iroh_datagram_ipv6)(source)
    local info = (@*iroh_datagram_pktinfo6)(CMSG_DATA(control))
    C.memcpy(&info.ipi6_addr,&ipv6.sin6_addr,16)
    info.ipi6_ifindex = ipv6.sin6_scope_id
    control.cmsg_level = IPPROTO_IPV6
    control.cmsg_type = IPV6_PKTINFO
    control.cmsg_len = CMSG_LEN(#iroh_datagram_pktinfo6)
    message.msg_controllen = CMSG_SPACE(#iroh_datagram_pktinfo6)
  end
  return sendmsg(fd,&message,0)
end

local function send_packet(conn: *Connection, size: csize): isize
  local listener = conn.listener
  if listener ~= nilptr then
    if listener.wildcard then
      local fd = listener.fd
      if listener.ipv4_fd >= 0 and conn.output_local_addr.ss_family == AF_INET then fd = listener.ipv4_fd end
      return send_from(fd,&conn.output_path,&conn.output[0],size)
    end
    local remote = conn.output_path.remote
    return sendto(listener.fd,&conn.output[0],size,0,remote.addr,remote.addrlen)
  end
  if output_on_candidate(conn) then return send(conn.candidate_fd,&conn.output[0],size,0) end
  if conn.migration_state ~= 0 and not same_path(&conn.output_path,&conn.local_addr,&conn.remote_addr) then
    -- A response queued before validation can refer to an already retired socket.
    return (@isize)(size)
  end
  return send(conn.fd,&conn.output[0],size,0)
end

local function network_unreachable(code: cint): boolean
  return code == ECONNREFUSED or code == EHOSTUNREACH or code == ENETUNREACH
end

local function migration_can_lose(conn: *Connection, candidate: boolean): boolean
  if conn.candidate_fd < 0 then return conn.path_monitor end
  if conn.migration_state == 1 then return true end
  return (conn.migration_state == 2) ~= candidate
end

local function close_transport(conn: *Connection, error: cint)
  if error == NGTCP2_ERR_DRAINING then return end
  local err: ngtcp2_ccerr
  ngtcp2_ccerr_default(&err)
  if error == NGTCP2_ERR_CRYPTO then
    ngtcp2_ccerr_set_tls_alert(&err,ngtcp2_conn_get_tls_alert2(conn.engine),nilptr,0)
  elseif error < 0 then
    ngtcp2_ccerr_set_liberr(&err,error,nilptr,0)
  end
  local size = ngtcp2_conn_write_connection_close(conn.engine,packet_path(conn),nilptr,&conn.output[0],
    PACKET_CAPACITY,&err,io_tick())
  if size > 0 then send_packet(conn,(@csize)(size)) end
end

local function ingest(conn: *Connection, path: *ngtcp2_path, packet: *cuchar, size: csize, now: uint64)
  local info: ngtcp2_pkt_info = {}
  local status = ngtcp2_conn_read_pkt(conn.engine,path,&info,packet,size,now)
  if status < 0 and status ~= NGTCP2_ERR_DISCARD_PKT then
    close_transport(conn,status)
    conn.read_failure = status
    conn.failed = true
  end
end

local function server_connection(listener: *Listener, address: *iroh_datagram_address,
    address_size: cuint, destination: *iroh_datagram_address, destination_size: cuint,
    bytes: *cuchar, size: csize, now: uint64): *Connection
  if listener.stopped or listener.pending >= MAX_PENDING or next_id == 0 then return nilptr end
  local initial: ngtcp2_pkt_hd
  if ngtcp2_accept(&initial,bytes,size) ~= 0 or initial.version ~= NGTCP2_PROTO_VER_V1 then return nilptr end
  local conn = (@*Connection)(C.calloc(1,#Connection))
  if conn == nilptr then return nilptr end
  listener.refs = listener.refs + 1
  listener.pending = listener.pending + 1
  conn.listener = listener
  conn.candidate_fd = -1
  conn.local_addr = $destination
  conn.local_size = destination_size
  C.memcpy(&conn.remote_addr,address,#iroh_datagram_address)
  conn.remote_size = address_size
  conn.accept_deadline = now + ACCEPT_TIMEOUT
  if not setup_ssl(conn,listener.ctx,nilptr,0) or open_engine(conn,&initial,now) ~= 0 then
    destroy(conn)
    return nilptr
  end
  register_connection(conn)
  return conn
end

local function matches_cid(id: *ngtcp2_cid, packet: *ngtcp2_version_cid): boolean
  return id.datalen == packet.dcidlen and C.memcmp(&id.data[0],packet.dcid,packet.dcidlen) == 0
end

local function owns_cid(conn: *Connection, packet: *ngtcp2_version_cid, original_address: boolean): boolean
  -- The original destination ID routes retransmitted Initial packets.
  if original_address and packet.version ~= 0 and matches_cid(&conn.original_id,packet) then return true end
  local count = ngtcp2_conn_get_scid2(conn.engine,nilptr)
  if count == 0 then return false end
  local part: [16]ngtcp2_cid
  local ids = (@*[0]ngtcp2_cid)(&part[0])
  if count > 16 then
    ids = (@*[0]ngtcp2_cid)(C.malloc(count * #ngtcp2_cid))
    if ids == nilptr then return false end
  end
  defer if count > 16 then C.free(ids) end end
  ngtcp2_conn_get_scid2(conn.engine,&ids[0])
  for i = 0, < count do
    if matches_cid(&ids[i],packet) then return true end
  end
  return false
end

local function receive_at(fd: cint, bytes: pointer, capacity: csize, address: *iroh_datagram_address,
    address_size: *cuint, destination: *iroh_datagram_address): isize
  local buffer: [16]uint64 = {}
  local vector: iroh_datagram_iovec = {iov_base = bytes, iov_len = capacity}
  local message: iroh_datagram_message = {
    msg_name = address, msg_namelen = $address_size, msg_iov = &vector, msg_iovlen = 1,
    msg_control = &buffer[0], msg_controllen = #buffer * #uint64,
  }
  local received = recvmsg(fd,&message,0)
  if received <= 0 then return received end
  if (message.msg_flags & MSG_CTRUNC) ~= 0 then return 0 end
  local control = CMSG_FIRSTHDR(&message)
  if control == nilptr then return 0 end
  if destination.ss_family == AF_INET and control.cmsg_level == IPPROTO_IP and
      control.cmsg_type == IP_PKTINFO and control.cmsg_len >= CMSG_LEN(#iroh_datagram_pktinfo4) then
    local info = (@*iroh_datagram_pktinfo4)(CMSG_DATA(control))
    local ipv4 = (@*iroh_datagram_ipv4)(destination)
    ipv4.sin_addr = info.ipi_addr
  elseif destination.ss_family == AF_INET6 and control.cmsg_level == IPPROTO_IPV6 and
      control.cmsg_type == IPV6_PKTINFO and control.cmsg_len >= CMSG_LEN(#iroh_datagram_pktinfo6) then
    local info = (@*iroh_datagram_pktinfo6)(CMSG_DATA(control))
    local ipv6 = (@*iroh_datagram_ipv6)(destination)
    local octets = (@*[0]cuchar)(&info.ipi6_addr)
    C.memcpy(&ipv6.sin6_addr,&info.ipi6_addr,16)
    if octets[0] == 0xfe and (octets[1] & 0xc0) == 0x80 then ipv6.sin6_scope_id = info.ipi6_ifindex end
  else
    return 0
  end
  $address_size = message.msg_namelen
  return received
end

local function dispatch_on(listener: *Listener, fd: cint, bound: *iroh_datagram_address, local_size: cuint, now: uint64): cint
  local bytes: [65536]cuchar
  local address: iroh_datagram_address
  local address_size: cuint = #iroh_datagram_address
  local destination = $bound
  local received: isize
  if listener.wildcard then
    received = receive_at(fd,&bytes[0],#bytes,&address,&address_size,&destination)
  else
    received = recvfrom(fd,&bytes[0],#bytes,0,&address,&address_size)
  end
  if received < 0 then
    if errno == EAGAIN or errno == EINTR then return 0 end
    return errno
  end
  if received == 0 then return 0 end
  local size = (@csize)(received)
  local packet: ngtcp2_version_cid
  if ngtcp2_pkt_decode_version_cid(&packet,&bytes[0],size,CID_SIZE) ~= 0 or packet.dcidlen == 0 then return 0 end
  local path: ngtcp2_path = {
    iroh_datagram_local_path = {addr = &destination, addrlen = local_size},
    remote = {addr = &address, addrlen = address_size},
  }
  local conn = connections
  while conn ~= nilptr do
    if conn.listener == listener then
      local original_address = same_path(&path,&conn.local_addr,&conn.remote_addr)
      -- ngtcp2 authenticates short-header packets and validates the new path.
      local can_rebind = packet.version == 0 and authenticated(conn)
      if (original_address or can_rebind) and owns_cid(conn,&packet,original_address) then
        if not conn.failed then ingest(conn,&path,&bytes[0],size,now) end
        return 0
      end
    end
    conn = (@*Connection)(conn.next)
  end
  conn = server_connection(listener,&address,address_size,&destination,local_size,&bytes[0],size,now)
  if conn ~= nilptr then ingest(conn,&path,&bytes[0],size,now) end
  return 0
end

local function dispatch(listener: *Listener, now: uint64): cint
  if listener.ipv4_fd >= 0 then
    listener.dispatch_ipv4 = not listener.dispatch_ipv4
    if listener.dispatch_ipv4 then
      return dispatch_on(listener,listener.ipv4_fd,&listener.ipv4_addr,listener.ipv4_size,now)
    end
  end
  return dispatch_on(listener,listener.fd,&listener.local_addr,listener.local_size,now)
end

local function send_pending(conn: *Connection, now: uint64): cint
  if conn.output_size == 0 then return 0 end
  local size = send_packet(conn,conn.output_size)
  local lost = size < 0 and network_unreachable(errno) and migration_can_lose(conn,output_on_candidate(conn))
  if size == (@isize)(conn.output_size) or lost then
    conn.output_size = 0
    conn.output_early = false
    ngtcp2_conn_update_pkt_tx_time(conn.engine,now)
    return 0
  end
  if size >= 0 then return (@cint)(EIO) end
  if errno == EAGAIN or errno == EINTR then return 0 end
  return errno
end

local function settle_migration(conn: *Connection)
  if conn.listener ~= nilptr or conn.candidate_fd < 0 or conn.migration_state == 1 or conn.output_size ~= 0 then return end
  if conn.migration_state == 2 then
    close(conn.fd)
    conn.fd = conn.candidate_fd
    conn.local_addr = conn.candidate_addr
    conn.local_size = conn.candidate_size
    conn.remote_addr = conn.candidate_peer
    conn.remote_size = conn.candidate_peer_size
  else
    close(conn.candidate_fd)
  end
  conn.candidate_fd = -1
end

local function engine_error(e: Env, conn: *Connection, status: cint): Term
  conn.failed = true
  if conn.pin_status < 0 then return io_fail(e,EACCES,'QUIC peer endpoint key mismatch') end
  return io_fail(e,EIO,ngtcp2_strerror(status))
end

local function socket_error(e: Env, conn: *Connection, status: cint): Term
  conn.failed = true
  return io_fail(e,(@uint32)(status),nilptr)
end

local function closed(e: Env): Term
  return io_fail(e,EBADF,'QUIC connection closed')
end

local function advance(conn: *Connection, now: uint64): cint
  local error = send_pending(conn,now)
  if error ~= 0 or conn.output_size ~= 0 then return error end
  if ngtcp2_conn_get_expiry2(conn.engine) <= now then
    local status = ngtcp2_conn_handle_expiry(conn.engine,now)
    if status < 0 then return status end
  end
  local size = ngtcp2_conn_write_pkt(conn.engine,packet_path(conn),nilptr,&conn.output[0],PACKET_CAPACITY,now)
  if size < 0 then return (@cint)(size) end
  conn.output_size = (@csize)(size)
  return send_pending(conn,now)
end

local function read_client_packet(conn: *Connection, fd: cint, path: *ngtcp2_path, now: uint64): cint
  local incoming: [65536]cuchar
  local size = recv(fd,&incoming[0],#incoming,0)
  if size > 0 then
    ingest(conn,path,&incoming[0],(@csize)(size),now)
  elseif size < 0 and errno ~= EAGAIN and errno ~= EINTR then
    if not network_unreachable(errno) or not migration_can_lose(conn,fd == conn.candidate_fd) then
      return errno
    end
  end
  return 0
end

local function step(e: Env, conn: *Connection): Term
  if conn == nilptr or conn.failed then return closed(e) end
  local now = io_tick()
  if conn.listener ~= nilptr then
    local code = dispatch(conn.listener,now)
    if code ~= 0 then return socket_error(e,conn,code) end
  else
    local path = connection_path(conn)
    local code = read_client_packet(conn,conn.fd,&path,now)
    if code ~= 0 then return socket_error(e,conn,code) end
    if not conn.failed and conn.candidate_fd >= 0 then
      path.iroh_datagram_local_path = {addr = &conn.candidate_addr, addrlen = conn.candidate_size}
      path.remote = {addr = &conn.candidate_peer, addrlen = conn.candidate_peer_size}
      code = read_client_packet(conn,conn.candidate_fd,&path,now)
      if code ~= 0 then return socket_error(e,conn,code) end
    end
  end
  if conn.failed then return engine_error(e,conn,conn.read_failure) end
  local status = advance(conn,now)
  if status < 0 then return engine_error(e,conn,status) end
  if status > 0 then return socket_error(e,conn,status) end
  settle_migration(conn)
  return io_done(e,authenticated(conn) and 1 or 0)
end

local function step_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],step(e,find(e,args[0])))
end

local function monitor_path_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn == nilptr or conn.failed then return io_tup(e,args[0],closed(e)) end
  if conn.listener ~= nilptr or not authenticated(conn) then
    return io_tup(e,args[0],io_fail(e,ENOTSUP,'QUIC path monitoring requires an authenticated dialer'))
  end
  local interval = args[1]
  local disabled: uint64 = 0xffffffffffffffff
  ngtcp2_conn_set_keep_alive_timeout(conn.engine,interval == 0 and disabled or interval * 1000000)
  conn.path_monitor = interval ~= 0
  if conn.path_monitor then
    local info: ngtcp2_conn_info
    ngtcp2_conn_get_conn_info2(conn.engine,&info)
    conn.path_packets_received = info.pkt_recv
    conn.last_path_input = io_tick()
  end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_dgram_Unit,0)))
end

local function path_timing_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn == nilptr or conn.failed then return io_tup(e,args[0],closed(e)) end
  if not conn.path_monitor then
    return io_tup(e,args[0],io_fail(e,ENOTSUP,'QUIC path monitoring is disabled'))
  end
  local info: ngtcp2_conn_info
  ngtcp2_conn_get_conn_info2(conn.engine,&info)
  local now = io_tick()
  if info.pkt_recv ~= conn.path_packets_received then
    conn.path_packets_received = info.pkt_recv
    conn.last_path_input = now
  end
  local idle = (now - conn.last_path_input) // 1000000
  local duration = ngtcp2_conn_get_pto2(conn.engine)
  local pto = duration // 1000000 + (duration % 1000000 == 0 and 0 or 1)
  local timings = io_tup(e,idle > 0xffffffff and 0xffffffff or idle,pto > 0xffffffff and 0xffffffff or pto)
  return io_tup(e,args[0],io_done(e,timings))
end

local function millis_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return (@uint32)(io_tick() // 1000000)
end

local function early_status(conn: *Connection): uint32
  if not conn.early_attempted then return ENOTSUP end
  if ngtcp2_conn_get_handshake_completed2(conn.engine) ~= 0 then return EALREADY end
  return 0
end

local function write(e: Env, conn: *Connection, payload: Term, early: boolean): Term
  local bytes: [PACKET_CAPACITY]cuchar
  local size = unpack(e,payload,&bytes[0],PACKET_CAPACITY)
  if size == -2 then return io_fail(e,EMSGSIZE,'QUIC datagram exceeds packet capacity') end
  if size < 0 then return io_fail(e,EINVAL,'invalid QUIC datagram bytes') end
  if conn == nilptr or conn.failed then return closed(e) end
  if early then
    local code = early_status(conn)
    if code ~= 0 then return io_fail(e,code,'QUIC early data is unavailable') end
  elseif not authenticated(conn) then
    return io_done(e,0)
  end
  local transport = ngtcp2_conn_get_remote_transport_params2(conn.engine)
  if transport == nilptr then return io_done(e,0) end
  if transport.max_datagram_frame_size == 0 then return io_fail(e,ENOTSUP,'peer did not negotiate QUIC datagrams') end
  -- Reserve space for a short header, packet number, AEAD tag, and frame length.
  local limit = ngtcp2_conn_get_path_max_tx_udp_payload_size2(conn.engine)
  if limit > PACKET_CAPACITY then limit = PACKET_CAPACITY end
  local dcid = ngtcp2_conn_get_dcid2(conn.engine)
  local overhead: csize = early and 80 or dcid.datalen + 24
  if (@csize)(size) + overhead > limit then return io_fail(e,EMSGSIZE,'QUIC datagram exceeds path size') end
  local now = io_tick()
  local error = send_pending(conn,now)
  if error ~= 0 then return socket_error(e,conn,error) end
  if conn.output_size ~= 0 then return io_done(e,0) end
  local vec: ngtcp2_vec = {base = &bytes[0], len = (@csize)(size)}
  local accepted: cint = 0
  local written = ngtcp2_conn_writev_datagram(conn.engine,packet_path(conn),nilptr,&conn.output[0],PACKET_CAPACITY,
    &accepted,0,conn.datagram_id,&vec,1,now)
  if written == NGTCP2_ERR_INVALID_ARGUMENT then return io_fail(e,EMSGSIZE,'QUIC datagram exceeds negotiated size') end
  if written < 0 then return engine_error(e,conn,(@cint)(written)) end
  if accepted ~= 0 then conn.datagram_id = conn.datagram_id + 1 end
  conn.output_size = (@csize)(written)
  conn.output_early = early and accepted ~= 0
  error = send_pending(conn,now)
  if error ~= 0 then return socket_error(e,conn,error) end
  return io_done(e,(@Term)(accepted))
end

local function write_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write(e,find(e,args[0]),args[1],false))
end

local function early_datagram_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write(e,find(e,args[0]),args[1],true))
end

local function remote_id_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn == nilptr or conn.failed then return io_tup(e,args[0],closed(e)) end
  if not authenticated(conn) then
    return io_tup(e,args[0],io_fail(e,EAGAIN,'QUIC handshake is incomplete'))
  end
  local peer = conn.expected_key
  if conn.listener ~= nilptr then
    peer = conn.listener.expected_key
    if peer == nilptr then peer = SSL_get0_peer_rpk(conn.ssl) end
  end
  local key: [32]cuchar
  if not public_key(peer,&key[0]) then
    return io_tup(e,args[0],io_fail(e,EIO,'authenticated QUIC peer identity unavailable'))
  end
  return io_tup(e,args[0],io_done(e,io_list(e,(@cstring)(&key[0]),#key)))
end

local function take_session_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn == nilptr or conn.failed then return io_tup(e,args[0],closed(e)) end
  if conn.saved_session == nilptr or not authenticated(conn) then
    return io_tup(e,args[0],io_done(e,term_pak(iroh_dgram_None,0)))
  end
  if next_session_id == 0 then
    return io_tup(e,args[0],io_fail(e,ENOMEM,'QUIC session handles exhausted'))
  end
  local ticket = conn.saved_session
  conn.saved_session = nilptr
  ticket.id = next_session_id
  next_session_id = next_session_id + 1
  ticket.next = sessions
  sessions = ticket
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_dgram_Some,term_pak(iroh_dgram_QuicSession,ticket.id))))
end

local function resumption_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn == nilptr or conn.failed then return io_tup(e,args[0],closed(e)) end
  if not authenticated(conn) then return io_tup(e,args[0],io_done(e,term_pak(iroh_dgram_None,0))) end
  local early: Term = 0
  if conn.listener ~= nilptr and conn.listener.resumable then
    local status = SSL_get_early_data_status(conn.ssl)
    if status == SSL_EARLY_DATA_ACCEPTED then early = 1 end
    if status == SSL_EARLY_DATA_REJECTED then early = 2 end
  elseif conn.early_attempted then
    early = conn.early_accepted and 1 or 2
  end
  local value = io_tup(e,SSL_session_reused(conn.ssl) == 1 and 1 or 0,early)
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_dgram_Some,value)))
end

local function read_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn == nilptr or conn.failed then return io_tup(e,args[0],closed(e)) end
  local value = term_pak(iroh_dgram_None,0)
  if conn.inbox_first ~= nilptr and authenticated(conn) then
    local item = conn.inbox_first
    value = io_box(e,iroh_dgram_Some,io_list(e,(@cstring)(datagram_data(item)),item.size))
    pop_datagram(conn)
  end
  return io_tup(e,args[0],io_done(e,value))
end

local function acks_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  local result = conn ~= nilptr and io_done(e,conn.acknowledgments) or closed(e)
  return io_tup(e,args[0],result)
end

local function open_stream(e: Env, conn: *Connection, direction: Term, early: boolean): Term
  if conn == nilptr or conn.failed then return closed(e) end
  if direction > 1 then return io_fail(e,EINVAL,'invalid QUIC stream direction') end
  if early then
    local code = early_status(conn)
    if code ~= 0 then return io_fail(e,code,'QUIC early data is unavailable') end
  elseif not authenticated(conn) then
    return io_done(e,0)
  end
  local stream = add_stream(conn,-1)
  if stream == nilptr then return io_fail(e,ENOMEM,'could not allocate QUIC stream') end
  local status: cint
  if direction == 0 then
    status = ngtcp2_conn_open_bidi_stream(conn.engine,&stream.id,nilptr)
  else
    status = ngtcp2_conn_open_uni_stream(conn.engine,&stream.id,nilptr)
  end
  if status ~= 0 then
    remove_stream(conn,stream)
    if status == NGTCP2_ERR_STREAM_ID_BLOCKED then return io_done(e,0) end
    return engine_error(e,conn,status)
  end
  stream.early = early
  stream.announced = true
  return io_done(e,stream.handle)
end

local function open_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],open_stream(e,find(e,args[0]),args[1],false))
end

local function open_early_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],open_stream(e,find(e,args[0]),args[1],true))
end

local function accept_stream(e: Env, conn: *Connection, direction: Term): Term
  if conn == nilptr or conn.failed then return closed(e) end
  if direction > 1 then return io_fail(e,EINVAL,'invalid QUIC stream direction') end
  if not authenticated(conn) then return io_done(e,0) end
  local next: *Stream
  local stream = conn.streams
  while stream ~= nilptr do
    if not stream.announced and ((stream.id >> 1) & 1) == direction and
        (next == nilptr or stream.handle < next.handle) then
      next = stream
    end
    stream = (@*Stream)(stream.next)
  end
  if next == nilptr then return io_done(e,0) end
  next.announced = true
  return io_done(e,next.handle)
end

local function accept_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],accept_stream(e,find(e,args[0]),args[1]))
end

local function queue_stream(e: Env, conn: *Connection, handle: Term, data: Term, fin: Term): Term
  local bytes: [STREAM_WINDOW]cuchar
  local size = unpack(e,data,&bytes[0],STREAM_WINDOW)
  if size == -2 then return io_fail(e,EMSGSIZE,'QUIC stream write exceeds 64 KiB') end
  if size < 0 or fin > 1 then return io_fail(e,EINVAL,'invalid QUIC stream write') end
  if conn == nilptr or conn.failed then return closed(e) end
  local stream = stream_by_handle(conn,handle)
  if stream == nilptr then return io_fail(e,EBADF,'unknown QUIC stream') end
  if (stream.id & 2) ~= 0 and ngtcp2_conn_is_local_stream2(conn.engine,stream.id) == 0 or stream.tx_fin or stream.closed then
    return io_fail(e,EPIPE,'QUIC stream does not have an open send half')
  end
  if stream.tx ~= nilptr then return io_done(e,0) end
  if size == 0 and fin == 0 then return io_done(e,1) end
  stream.tx = (@*[0]cuchar)(C.malloc(size > 0 and (@csize)(size) or 1))
  if stream.tx == nilptr then return io_fail(e,ENOMEM,'could not allocate QUIC stream write') end
  if size > 0 then C.memcpy(&stream.tx[0],&bytes[0],(@csize)(size)) end
  stream.tx_size = (@csize)(size)
  stream.tx_sent = 0
  stream.tx_fin = fin ~= 0
  return io_done(e,1)
end

local function queue_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],queue_stream(e,find(e,args[0]),args[1],args[2],args[3]))
end

local function stream_flushed(stream: *Stream): boolean
  return stream.tx == nilptr or (stream.tx_sent == stream.tx_size and (not stream.tx_fin or stream.tx_fin_sent))
end

local function flush_stream(e: Env, conn: *Connection, handle: Term): Term
  if conn == nilptr or conn.failed then return closed(e) end
  local stream = stream_by_handle(conn,handle)
  if stream == nilptr then return io_fail(e,EBADF,'unknown QUIC stream') end
  if stream.aborted then return io_fail(e,EPIPE,'QUIC stream closed with an error') end
  local now = io_tick()
  local status = send_pending(conn,now)
  if status ~= 0 then return socket_error(e,conn,status) end
  if conn.output_size ~= 0 then return io_done(e,0) end
  if stream_flushed(stream) then return io_done(e,1) end
  local vec: ngtcp2_vec = {base = &stream.tx[stream.tx_sent], len = stream.tx_size - stream.tx_sent}
  local flags = stream.tx_fin and NGTCP2_WRITE_STREAM_FLAG_FIN or 0
  local consumed: isize = -1
  local written = ngtcp2_conn_writev_stream(conn.engine,packet_path(conn),nilptr,&conn.output[0],PACKET_CAPACITY,
    &consumed,flags,stream.id,&vec,1,now)
  if written == NGTCP2_ERR_STREAM_DATA_BLOCKED then return io_done(e,0) end
  if written == NGTCP2_ERR_STREAM_SHUT_WR or written == NGTCP2_ERR_STREAM_NOT_FOUND then
    return io_fail(e,EPIPE,'QUIC stream send half was closed by the peer')
  end
  if written < 0 then return engine_error(e,conn,(@cint)(written)) end
  if consumed >= 0 then
    stream.tx_sent = stream.tx_sent + (@csize)(consumed)
    if stream.tx_fin and stream.tx_sent == stream.tx_size then stream.tx_fin_sent = true end
  end
  conn.output_size = (@csize)(written)
  conn.output_early = stream.early and consumed >= 0 and ngtcp2_conn_get_handshake_completed2(conn.engine) == 0
  status = send_pending(conn,now)
  if status ~= 0 then return socket_error(e,conn,status) end
  return io_done(e,conn.output_size == 0 and stream_flushed(stream) and 1 or 0)
end

local function flush_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],flush_stream(e,find(e,args[0]),args[1]))
end

local function read_stream(e: Env, conn: *Connection, handle: Term, limit: Term): Term
  if conn == nilptr or conn.failed then return closed(e) end
  if limit == 0 then return io_fail(e,EINVAL,'QUIC stream read limit must be positive') end
  local stream = stream_by_handle(conn,handle)
  if stream == nilptr then return io_fail(e,EBADF,'unknown QUIC stream') end
  if stream.early_rejected then return io_fail(e,ECONNRESET,'QUIC early stream was rejected') end
  if not authenticated(conn) then return io_done(e,term_pak(iroh_dgram_QuicStreamPending,0)) end
  if (stream.id & 2) ~= 0 and ngtcp2_conn_is_local_stream2(conn.engine,stream.id) ~= 0 then return io_fail(e,EPIPE,'QUIC stream is send-only') end
  local size = stream.rx_end - stream.rx_head
  if size > 0 then
    if size > limit then size = (@csize)(limit) end
    local status = ngtcp2_conn_extend_max_stream_offset(conn.engine,stream.id,size)
    if status ~= 0 then return engine_error(e,conn,status) end
    ngtcp2_conn_extend_max_offset(conn.engine,size)
    local value = io_list(e,(@cstring)(&stream.rx[stream.rx_head]),size)
    stream.rx_head = stream.rx_head + size
    if stream.rx_head == stream.rx_end then
      stream.rx_head = 0
      stream.rx_end = 0
      if stream.rx_fin or stream.rx_reset then
        C.free(stream.rx)
        stream.rx = nilptr
      end
    end
    return io_done(e,io_box(e,iroh_dgram_QuicStreamBytes,value))
  end
  if stream.rx_reset or (stream.closed and stream.aborted and not stream.rx_fin) then
    return io_fail(e,ECONNRESET,'QUIC stream was reset by the peer')
  end
  return io_done(e,term_pak(stream.rx_fin and iroh_dgram_QuicStreamFin or iroh_dgram_QuicStreamPending,0))
end

local function read_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],read_stream(e,find(e,args[0]),args[1],args[2]))
end

local function release_stream(e: Env, conn: *Connection, handle: Term): Term
  if conn == nilptr or conn.failed then return closed(e) end
  local stream = stream_by_handle(conn,handle)
  if stream == nilptr then return io_fail(e,EBADF,'unknown QUIC stream') end
  ngtcp2_conn_extend_max_offset(conn.engine,stream.rx_end - stream.rx_head)
  if stream.closed then
    return_stream_credit(conn,stream)
    remove_stream(conn,stream)
  else
    stream.discarded = true
    C.free(stream.rx)
    stream.rx = nilptr
    local received_fin = stream.rx_fin or stream.rx_reset or (stream.id & 2) ~= 0 and ngtcp2_conn_is_local_stream2(conn.engine,stream.id) ~= 0
    local sent_fin = stream.tx_fin_sent or (stream.id & 2) ~= 0 and ngtcp2_conn_is_local_stream2(conn.engine,stream.id) == 0
    if not received_fin or not sent_fin then
      local status = ngtcp2_conn_shutdown_stream(conn.engine,0,stream.id,0)
      if status ~= 0 then return engine_error(e,conn,status) end
    end
  end
  return io_done(e,term_pak(iroh_dgram_Unit,0))
end

local function drop_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],release_stream(e,find(e,args[0]),args[1]))
end

local function configure_tickets(ctx: *SSL_CTX, resume: boolean): boolean
  if not resume then return SSL_CTX_set_num_tickets(ctx,0) == 1 end
  local id: [32]cuchar
  if RAND_bytes(&id[0],32) ~= 1 or SSL_CTX_set_session_id_context(ctx,&id[0],32) ~= 1 then return false end
  -- OpenSSL uses the internal cache to enforce single-use early-data tickets.
  SSL_CTX_set_session_cache_mode(ctx,SSL_SESS_CACHE_SERVER)
  SSL_CTX_sess_set_cache_size(ctx,1024)
  return SSL_CTX_set_max_early_data(ctx,0xffffffff) == 1 and SSL_CTX_set_num_tickets(ctx,2) == 1
end

local function bind_udp(fd: cint, address: *iroh_datagram_address, size: *cuint, bound_size: cuint, wildcard: boolean): boolean
  if fd < 0 then return false end
  if wildcard then
    local on: cint = 1
    if address.ss_family == AF_INET then
      if setsockopt(fd,IPPROTO_IP,IP_PKTINFO,&on,#cint) ~= 0 then return false end
    elseif setsockopt(fd,IPPROTO_IPV6,IPV6_V6ONLY,&on,#cint) ~= 0 or
        setsockopt(fd,IPPROTO_IPV6,IPV6_RECVPKTINFO,&on,#cint) ~= 0 then
      return false
    end
  end
  $size = #iroh_datagram_address
  return bind(fd,address,bound_size) == 0 and getsockname(fd,address,size) == 0
end

local function bind_listener(e: Env, args: *[0]Term, resume: boolean, discover_peer: boolean, dual: boolean): Term
  local host_size: uint64
  local host = io_cstr(e,args[0],&host_size)
  defer C.free(host) end
  local config: QuicConfig
  local configured: boolean
  if discover_peer then
    configured = unpack(e,args[2],&config.seed[0],32) == 32 and unpack_alpn(e,args[3],&config)
  else
    configured = unpack_config(e,args,&config)
  end
  if not configured or args[1] > 65535 or io_nul(host,host_size) then
    return io_fail(e,EINVAL,'invalid QUIC listen address, Ed25519 key, or ALPN')
  end
  if next_listener_id == 0 then return io_fail(e,ENOMEM,'QUIC listener handles exhausted') end
  local listener = (@*Listener)(C.calloc(1,#Listener))
  if listener == nilptr then return io_fail(e,ENOMEM,nilptr) end
  listener.refs = 1
  listener.fd = -1
  listener.ipv4_fd = -1
  local bound_size = numeric_address(host,(@cushort)(args[1]),&listener.local_addr)
  if bound_size == 0 then
    release_listener(listener)
    return io_fail(e,EINVAL,'QUIC listener requires a numeric IP address')
  end
  listener.wildcard = not concrete_address(&listener.local_addr)
  if dual and (not listener.wildcard or listener.local_addr.ss_family ~= AF_INET6) then
    release_listener(listener)
    return io_fail(e,EINVAL,'dual-stack QUIC listener requires the IPv6 wildcard address')
  end
  listener.fd = udp_socket(&listener.local_addr)
  if not bind_udp(listener.fd,&listener.local_addr,&listener.local_size,bound_size,listener.wildcard) then
    local code = (@uint32)(errno)
    release_listener(listener)
    return io_fail(e,code,nilptr)
  end
  if dual then
    local ipv4_size = numeric_address('0.0.0.0',address_port(&listener.local_addr),&listener.ipv4_addr)
    listener.ipv4_fd = udp_socket(&listener.ipv4_addr)
    if not bind_udp(listener.ipv4_fd,&listener.ipv4_addr,&listener.ipv4_size,ipv4_size,true) then
      local code = (@uint32)(errno)
      release_listener(listener)
      return io_fail(e,code,'could not bind IPv4 socket for the dual-stack QUIC listener')
    end
  end
  listener.ctx = create_tls_ctx(&config.seed[0],SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT)
  if not discover_peer then
    listener.expected_key = EVP_PKEY_new_raw_public_key_ex(nilptr,'ED25519',nilptr,&config.peer[0],32)
  end
  if listener.ctx == nilptr or (not discover_peer and listener.expected_key == nilptr) or
      not configure_tickets(listener.ctx,resume) then
    release_listener(listener)
    return io_fail(e,EIO,'could not configure QUIC listener TLS')
  end
  listener.resumable = resume
  listener.alpn_size = config.size
  C.memcpy(&listener.alpn[0],&config.alpn[0],config.size)
  SSL_CTX_set_alpn_select_cb(listener.ctx,(@pointer)(select_alpn),listener)
  listener.id = next_listener_id
  next_listener_id = next_listener_id + 1
  listener.next = listeners
  listeners = listener
  local handle = term_pak(iroh_dgram_QuicDatagramListener,listener.id)
  return io_done(e,io_tup(e,handle,address_port(&listener.local_addr)))
end

local function bind_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,false,false,false)
end

local function bind_resumable_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,true,false,false)
end

local function bind_identity_run(e: Env, args: *[0]Term, work: *IoWork): Term
  if args[4] > 1 then return io_fail(e,EINVAL,'invalid QUIC early-data setting') end
  return bind_listener(e,args,args[4] == 1,true,false)
end

local function bind_dual_identity_run(e: Env, args: *[0]Term, work: *IoWork): Term
  if args[4] > 1 then return io_fail(e,EINVAL,'invalid QUIC early-data setting') end
  return bind_listener(e,args,args[4] == 1,true,true)
end

local function try_accept(e: Env, listener: *Listener): Term
  if listener == nilptr then return io_fail(e,EBADF,'QUIC listener closed') end
  local now = io_tick()
  local code = dispatch(listener,now)
  if code ~= 0 then return io_fail(e,(@uint32)(code),nilptr) end
  local ready: *Connection
  local conn = connections
  while conn ~= nilptr do
    local next = (@*Connection)(conn.next)
    if conn.listener == listener and not conn.accepted then
      if conn.failed or now >= conn.accept_deadline or advance(conn,now) ~= 0 then
        remove_connection(conn)
      elseif authenticated(conn) and (ready == nilptr or conn.id < ready.id) then
        ready = conn
      end
    end
    conn = next
  end
  if ready == nilptr then return io_done(e,term_pak(iroh_dgram_None,0)) end
  ready.accepted = true
  listener.pending = listener.pending - 1
  local accepted = term_pak(iroh_dgram_DatagramConnection,ready.id)
  return io_done(e,io_box(e,iroh_dgram_Some,accepted))
end

local function accept_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],try_accept(e,find_listener(e,args[0])))
end

local function close_listener_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local listener = find_listener(e,args[0])
  if listener ~= nilptr then
    if listeners == listener then
      listeners = (@*Listener)(listener.next)
    else
      local prior = listeners
      while prior.next ~= listener do prior = (@*Listener)(prior.next) end
      prior.next = listener.next
    end
    listener.stopped = true
    local conn = connections
    while conn ~= nilptr do
      local next = (@*Connection)(conn.next)
      if conn.listener == listener and not conn.accepted then remove_connection(conn) end
      conn = next
    end
    release_listener(listener)
  end
  return term_pak(iroh_dgram_Unit,0)
end

local function drop_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find(e,args[0])
  if conn ~= nilptr then
    if not conn.failed then close_transport(conn,0) end
    if conn.listener ~= nilptr and conn.listener.resumable and authenticated(conn) and
        (not conn.failed or conn.read_failure == NGTCP2_ERR_DRAINING) then
      -- QUIC closes at the transport layer and does not send a TLS close_notify.
      SSL_set_shutdown(conn.ssl,SSL_SENT_SHUTDOWN | SSL_RECEIVED_SHUTDOWN)
    end
    remove_connection(conn)
  end
  return term_pak(iroh_dgram_Unit,0)
end

local function register_quic_datagram() <cexport,codename 'iroh_register_quic_datagram',cattribute 'constructor'>
  if iroh_dgram_start_quic_resume ~= 0xffffffff then io_eff(iroh_dgram_start_quic_resume,resume_run) end
  if iroh_dgram_take_quic_session ~= 0xffffffff then io_eff(iroh_dgram_take_quic_session,take_session_run) end
  if iroh_dgram_drop_quic_session ~= 0xffffffff then io_eff(iroh_dgram_drop_quic_session,drop_session_run) end
  if iroh_dgram_open_early_quic_stream ~= 0xffffffff then io_eff(iroh_dgram_open_early_quic_stream,open_early_stream_run) end
  if iroh_dgram_write_early_datagram ~= 0xffffffff then io_eff(iroh_dgram_write_early_datagram,early_datagram_run) end
  if iroh_dgram_quic_resumption_status ~= 0xffffffff then io_eff(iroh_dgram_quic_resumption_status,resumption_run) end
  if iroh_dgram_bind_resumable_quic ~= 0xffffffff then io_eff(iroh_dgram_bind_resumable_quic,bind_resumable_run) end
  if iroh_dgram_bind_quic_identity ~= 0xffffffff then io_eff(iroh_dgram_bind_quic_identity,bind_identity_run) end
  if iroh_dgram_bind_dual_quic_identity ~= 0xffffffff then
    io_eff(iroh_dgram_bind_dual_quic_identity,bind_dual_identity_run)
  end
  if iroh_dgram_quic_remote_id ~= 0xffffffff then io_eff(iroh_dgram_quic_remote_id,remote_id_run) end
  if iroh_dgram_bind_shared_quic ~= 0xffffffff then io_eff(iroh_dgram_bind_shared_quic,bind_run) end
  if iroh_dgram_try_accept_shared_quic ~= 0xffffffff then io_eff(iroh_dgram_try_accept_shared_quic,accept_run) end
  if iroh_dgram_close_shared_quic ~= 0xffffffff then io_eff(iroh_dgram_close_shared_quic,close_listener_run) end
  if iroh_dgram_start_quic_datagram ~= 0xffffffff then io_eff(iroh_dgram_start_quic_datagram,start_run) end
  if iroh_dgram_step_quic_datagram ~= 0xffffffff then io_eff(iroh_dgram_step_quic_datagram,step_run) end
  if iroh_dgram_start_quic_migration ~= 0xffffffff then io_eff(iroh_dgram_start_quic_migration,start_migration_run) end
  if iroh_dgram_start_quic_path_migration ~= 0xffffffff then io_eff(iroh_dgram_start_quic_path_migration,start_path_migration_run) end
  if iroh_dgram_quic_migration_status ~= 0xffffffff then io_eff(iroh_dgram_quic_migration_status,migration_status_run) end
  if iroh_dgram_monitor_quic_path ~= 0xffffffff then io_eff(iroh_dgram_monitor_quic_path,monitor_path_run) end
  if iroh_dgram_quic_path_timing ~= 0xffffffff then io_eff(iroh_dgram_quic_path_timing,path_timing_run) end
  if iroh_dgram_quic_millis ~= 0xffffffff then io_eff(iroh_dgram_quic_millis,millis_run) end
  if iroh_dgram_write_quic_datagram ~= 0xffffffff then io_eff(iroh_dgram_write_quic_datagram,write_run) end
  if iroh_dgram_read_quic_datagram ~= 0xffffffff then io_eff(iroh_dgram_read_quic_datagram,read_run) end
  if iroh_dgram_quic_datagram_acks ~= 0xffffffff then io_eff(iroh_dgram_quic_datagram_acks,acks_run) end
  if iroh_dgram_open_quic_stream ~= 0xffffffff then io_eff(iroh_dgram_open_quic_stream,open_stream_run) end
  if iroh_dgram_accept_quic_stream ~= 0xffffffff then io_eff(iroh_dgram_accept_quic_stream,accept_stream_run) end
  if iroh_dgram_queue_quic_stream ~= 0xffffffff then io_eff(iroh_dgram_queue_quic_stream,queue_stream_run) end
  if iroh_dgram_flush_quic_stream ~= 0xffffffff then io_eff(iroh_dgram_flush_quic_stream,flush_stream_run) end
  if iroh_dgram_read_quic_stream ~= 0xffffffff then io_eff(iroh_dgram_read_quic_stream,read_stream_run) end
  if iroh_dgram_drop_quic_stream ~= 0xffffffff then io_eff(iroh_dgram_drop_quic_stream,drop_stream_run) end
  if iroh_dgram_drop_quic_datagram ~= 0xffffffff then io_eff(iroh_dgram_drop_quic_datagram,drop_run) end
end
