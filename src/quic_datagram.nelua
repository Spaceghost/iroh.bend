local ngtcp2_version_cid <cimport,nodecl> = @record{version: uint32, dcid: *cuchar, dcidlen: csize}
local ngtcp2_transport_params <cimport,nodecl> = @record{
  max_datagram_frame_size: uint64, initial_max_data: uint64,
  initial_max_stream_data_bidi_local: uint64, initial_max_stream_data_bidi_remote: uint64,
  initial_max_stream_data_uni: uint64, initial_max_streams_bidi: uint64, initial_max_streams_uni: uint64,
  original_dcid: ngtcp2_cid, original_dcid_present: cuchar
}
local ngtcp2_pkt_info <cimport,nodecl> = @record{ecn: uint32}
local ngtcp2_conn_info <cimport,nodecl> = @record{pkt_recv: uint64}
local ngtcp2_ccerr <cimport,nodecl> = @record{}
local ngtcp2_vec <cimport,nodecl> = @record{base: *cuchar, len: csize}
local ngtcp2_callbacks <cimport,nodecl> = @record{
  client_initial: pointer, recv_client_initial: pointer, recv_crypto_data: pointer, encrypt: pointer, decrypt: pointer, hp_mask: pointer,
  recv_retry: pointer, rand: pointer, update_key: pointer, delete_crypto_aead_ctx: pointer,
