local iroh_dgram_bind_shared_quic: uint32 <cimport,nodecl>
local iroh_dgram_try_accept_shared_quic: uint32 <cimport,nodecl>
local iroh_dgram_close_shared_quic: uint32 <cimport,nodecl>
