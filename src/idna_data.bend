def sequence_page_group(group: U32, i: U32) -> String:
  match group:
    case 0:
      sequence_page_0(i)
    case 1:
      sequence_page_1(i)
    case 2:
      sequence_page_2(i)
    case _:
      sequence_page_3(i)

def sequence_page(+i: U32) -> String:
  sequence_page_group(U32.shrn(i,5n),U32.and(i,31))

