    case 14:
      mapping0_14(i)
    case 15:
      mapping0_15(i)
    case 16:
      mapping0_16(i)
    case _:
      mapping0_17(i)

def mapping0(+i: U32) -> String:
  mapping0_group(U32.shrn(i,5n),U32.and(i,31))

