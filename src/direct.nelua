local sockaddr_in <cimport,nodecl,codename 'iroh_sockaddr_in'> = @record{
  sin_family: uint16, sin_port: uint16, sin_addr: in_addr, sin_zero: [8]cuchar
}
local in6_addr <cimport,nodecl,codename 'iroh_in6_addr'> = @record{words: [4]uint32}
local sockaddr_in6 <cimport,nodecl,codename 'iroh_sockaddr_in6'> = @record{
  sin6_family: uint16, sin6_port: uint16, sin6_flowinfo: uint32,
  sin6_addr: in6_addr, sin6_scope_id: uint32
}
local Address = @record{family: cint, v4: sockaddr_in, v6: sockaddr_in6}
local socklen_t <cimport,nodecl> = @cuint
local SSL_STREAM_RESET_ARGS <cimport,nodecl> = @record{quic_error_code: uint64}
local SSL_CONN_CLOSE_INFO <cimport,nodecl> = @record{
  error_code: uint64, frame_type: uint64, reason: cstring, reason_len: csize, flags: uint32
}
local SSL_SHUTDOWN_EX_ARGS <cimport,nodecl> = @record{quic_error_code: uint64, quic_reason: cstring}

local AF_INET: cint <cimport,nodecl>
local AF_INET6: cint <cimport,nodecl>
local SOCK_DGRAM: cint <cimport,nodecl>
local IPPROTO_UDP: cint <cimport,nodecl>
local SSL_VERIFY_PEER: cint <cimport,nodecl>
local SSL_VERIFY_FAIL_IF_NO_PEER_CERT: cint <cimport,nodecl>
local TLSEXT_cert_type_rpk: cuchar <cimport,nodecl>
local SSL_DEFAULT_STREAM_MODE_NONE: uint32 <cimport,nodecl>
local SSL_ERROR_WANT_READ: cint <cimport,nodecl>
local SSL_ERROR_WANT_WRITE: cint <cimport,nodecl>
local SSL_STREAM_FLAG_NO_BLOCK: uint64 <cimport,nodecl>
local SSL_STREAM_FLAG_UNI: uint64 <cimport,nodecl>
local SSL_ACCEPT_STREAM_NO_BLOCK: uint64 <cimport,nodecl>
local SSL_SHUTDOWN_FLAG_NO_BLOCK: uint64 <cimport,nodecl>
local SSL_STREAM_TYPE_WRITE: cint <cimport,nodecl>
local SSL_ERROR_ZERO_RETURN: cint <cimport,nodecl>
local OPENSSL_NPN_NEGOTIATED: cint <cimport,nodecl>
local SSL_TLSEXT_ERR_ALERT_FATAL: cint <cimport,nodecl>
local SSL_TLSEXT_ERR_OK: cint <cimport,nodecl>
local X509_V_OK: cint <cimport,nodecl>
local X509_V_ERR_APPLICATION_VERIFICATION: cint <cimport,nodecl>
local EIO: uint32 <cimport,nodecl,cinclude '<errno.h>'>
local EINVAL: uint32 <cimport,nodecl,cinclude '<errno.h>'>
local EOVERFLOW: uint32 <cimport,nodecl,cinclude '<errno.h>'>

local function socket(domain: cint, kind: cint, protocol: cint): cint <cimport,nodecl> end
local function bind(fd: cint, addr: pointer, len: socklen_t): cint <cimport,nodecl> end
local function getsockname(fd: cint, addr: pointer, len: *socklen_t): cint <cimport,nodecl> end
local function close(fd: cint): cint <cimport,nodecl> end
local function htons(port: uint16): uint16 <cimport,nodecl> end
local function ntohs(port: uint16): uint16 <cimport,nodecl> end
local function inet_pton(family: cint, addr: cstring, out: pointer): cint <cimport,nodecl> end

local function OSSL_QUIC_server_method(): *SSL_METHOD <cimport,nodecl> end
local function OSSL_QUIC_client_method(): *SSL_METHOD <cimport,nodecl> end
local function SSL_CTX_new(method: *SSL_METHOD): *SSL_CTX <cimport,nodecl> end
local function SSL_CTX_free(ctx: *SSL_CTX) <cimport,nodecl> end
local function SSL_CTX_use_PrivateKey(ctx: *SSL_CTX, key: *EVP_PKEY): cint <cimport,nodecl> end
local function SSL_CTX_set1_server_cert_type(ctx: *SSL_CTX, types: *cuchar, n: csize): cint <cimport,nodecl> end
local function SSL_CTX_set1_client_cert_type(ctx: *SSL_CTX, types: *cuchar, n: csize): cint <cimport,nodecl> end
local function SSL_CTX_set_verify(ctx: *SSL_CTX, mode: cint, callback: pointer) <cimport,nodecl> end
local function SSL_CTX_set_cert_verify_callback(ctx: *SSL_CTX, callback: pointer, arg: pointer) <cimport,nodecl> end
local function SSL_CTX_set_alpn_select_cb(ctx: *SSL_CTX, callback: pointer, arg: pointer) <cimport,nodecl> end
local function SSL_select_next_proto(out: **cuchar, out_len: *cuchar, a: *cuchar, a_len: cuint,
    b: *cuchar, b_len: cuint): cint <cimport,nodecl> end
local function EVP_PKEY_new_raw_private_key_ex(ctx: pointer, kind: cstring, props: cstring,
    bytes: *cuchar, n: csize): *EVP_PKEY <cimport,nodecl> end
local function EVP_PKEY_new_raw_public_key_ex(ctx: pointer, kind: cstring, props: cstring,
    bytes: *cuchar, n: csize): *EVP_PKEY <cimport,nodecl> end
local function EVP_PKEY_free(key: *EVP_PKEY) <cimport,nodecl> end
local function EVP_PKEY_eq(a: *EVP_PKEY, b: *EVP_PKEY): cint <cimport,nodecl> end
local function X509_STORE_CTX_get0_rpk(ctx: *X509_STORE_CTX): *EVP_PKEY <cimport,nodecl> end
local function X509_STORE_CTX_set_error(ctx: *X509_STORE_CTX, err: cint) <cimport,nodecl> end
local function OPENSSL_cleanse(p: pointer, n: csize) <cimport,nodecl> end
local function SSL_free(ssl: *SSL) <cimport,nodecl> end
local function SSL_new(ctx: *SSL_CTX): *SSL <cimport,nodecl> end
local function SSL_new_listener(ctx: *SSL_CTX, flags: uint64): *SSL <cimport,nodecl> end
local function SSL_set_fd(ssl: *SSL, fd: cint): cint <cimport,nodecl> end
