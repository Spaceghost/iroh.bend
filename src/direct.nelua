local function SSL_new_stream(ssl: *SSL, flags: uint64): *SSL <cimport,nodecl> end
local function SSL_get0_peer_rpk(ssl: *SSL): *EVP_PKEY <cimport,nodecl> end
local function SSL_get_error(ssl: *SSL, value: cint): cint <cimport,nodecl> end
local function SSL_read_ex(ssl: *SSL, buf: pointer, len: csize, got: *csize): cint <cimport,nodecl> end
local function SSL_write_ex(ssl: *SSL, buf: pointer, len: csize, wrote: *csize): cint <cimport,nodecl> end
local function SSL_stream_conclude(ssl: *SSL, flags: uint64): cint <cimport,nodecl> end
local function SSL_shutdown(ssl: *SSL): cint <cimport,nodecl> end
local function SSL_shutdown_ex(ssl: *SSL, flags: uint64, args: *SSL_SHUTDOWN_EX_ARGS, n: csize): cint <cimport,nodecl> end
local function SSL_stream_reset(ssl: *SSL, args: *SSL_STREAM_RESET_ARGS, n: csize): cint <cimport,nodecl> end
local function SSL_set1_initial_peer_addr(ssl: *SSL, peer: *BIO_ADDR): cint <cimport,nodecl> end
local function SSL_set_alpn_protos(ssl: *SSL, protos: *cuchar, size: cuint): cint <cimport,nodecl> end
local function SSL_accept(ssl: *SSL): cint <cimport,nodecl> end
local function SSL_set_blocking_mode(ssl: *SSL, blocking: cint): cint <cimport,nodecl> end
local function SSL_get_stream_type(ssl: *SSL): cint <cimport,nodecl> end
local function SSL_handle_events(ssl: *SSL): cint <cimport,nodecl> end
local function SSL_get_conn_close_info(ssl: *SSL, info: *SSL_CONN_CLOSE_INFO, len: csize): cint <cimport,nodecl> end
local function ERR_clear_error() <cimport,nodecl> end
local function SSL_connect(ssl: *SSL): cint <cimport,nodecl> end
local function BIO_ADDR_new(): *BIO_ADDR <cimport,nodecl> end
local function BIO_ADDR_free(addr: *BIO_ADDR) <cimport,nodecl> end
local function BIO_ADDR_rawmake(addr: *BIO_ADDR, family: cint, ip: pointer, len: csize,
    port: uint16): cint <cimport,nodecl> end

local MAX_MESSAGE <comptime> = 1024 * 1024
local Direct = @record{
  next: pointer, id: uint32, fd: cint, ctx: *SSL_CTX, listener: *SSL,
  conn: *SSL, stream: *SSL, expected: *EVP_PKEY, alpn: [256]cuchar,
  alpn_len: cuint, refs: uint32, active: boolean, closing: boolean
}

-- Only the Bend event loop accesses the registry. Worker jobs exclusively own
-- their connection until they return it or free it.
local handles: pointer
local next_id: uint32 = 1
local function keep(state: *Direct): uint32
  if next_id == 0 then return 0 end
  state.id = next_id
  next_id = next_id + 1
  state.next = handles
  handles = state
  return state.id
end

-- Bend can keep the single U32 in the constructor term or materialize it
-- in a heap field, depending on the caller's specialization.
local function handle_id(e: Env, handle: Term, kind: uint32): uint32
  if term_aux(handle) ~= kind then return 0 end
  if term_tag(handle) == TAG_PAK then return (@uint32)(term_loc(handle)) end
  if term_tag(handle) == TAG_CTR then return (@uint32)(e.mem[term_peek(e.mem,handle)]) end
  return 0
end

local function take(e: Env, handle: Term, stream: boolean): *Direct
  local tag = iroh_tag_BoundUdp
  if stream then tag = iroh_tag_AcceptedStream end
  local id = handle_id(e,handle,tag)
  local slot = &handles
  while $slot ~= nilptr do
    local state = (@*Direct)($slot)
    if state.id == id and not state.active and (state.stream ~= nilptr) == stream then
      $slot = state.next
      return state
    end
    slot = &state.next
  end
  return nilptr
end

local function release(state: *Direct)
  if state == nilptr then return end
  state.refs = state.refs - 1
  if state.refs ~= 0 then return end
  SSL_free(state.stream)
  SSL_free(state.conn)
  SSL_free(state.listener)
  SSL_CTX_free(state.ctx)
  EVP_PKEY_free(state.expected)
  if state.fd >= 0 then close(state.fd) end
  C.free(state)
end

local function bytes(e: Env, value: Term, limit: csize, out: **cuchar, len: *csize): boolean
  local count: csize = 0
  local item = value
  while term_aux(item) == iroh_tag_Con do
    local pos = term_peek(e.mem, item)
    if count == limit or e.mem[pos] > 255 then return false end
    count = count + 1
    item = e.mem[pos + 1]
  end
  local size: uint64
  $out = (@*cuchar)(io_cbuf(e, value, &size, iroh_tag_Con))
  $len = (@csize)(size)
  return true
end

local function verify(store: *X509_STORE_CTX, arg: pointer): cint
  local key = X509_STORE_CTX_get0_rpk(store)
  if key ~= nilptr and EVP_PKEY_eq(key, (@*EVP_PKEY)(arg)) == 1 then
    X509_STORE_CTX_set_error(store, X509_V_OK)
    return 1
  end
  X509_STORE_CTX_set_error(store, X509_V_ERR_APPLICATION_VERIFICATION)
  return 0
end

local function select_alpn(ssl: *SSL, chosen: **cuchar, chosen_len: *cuchar,
    offered: *cuchar, offered_len: cuint, arg: pointer): cint
  local state = (@*Direct)(arg)
  if SSL_select_next_proto(chosen, chosen_len, &state.alpn[0], state.alpn_len,
      offered, offered_len) ~= OPENSSL_NPN_NEGOTIATED then
    return SSL_TLSEXT_ERR_ALERT_FATAL
  end
  return SSL_TLSEXT_ERR_OK
end

local function configure(secret: *cuchar, peer: *cuchar, alpn: *cuchar, alpn_len: csize,
    server: boolean): *Direct
  local state = (@*Direct)(C.calloc(1, #Direct))
  if state == nilptr then return nilptr end
  state.fd = -1
  state.refs = 1
  local identity = EVP_PKEY_new_raw_private_key_ex(nilptr, 'ED25519', nilptr, secret, 32)
  defer EVP_PKEY_free(identity) end
  state.expected = EVP_PKEY_new_raw_public_key_ex(nilptr, 'ED25519', nilptr, peer, 32)
  local method = OSSL_QUIC_client_method()
  if server then method = OSSL_QUIC_server_method() end
  state.ctx = SSL_CTX_new(method)
  local raw_key = TLSEXT_cert_type_rpk
  if identity == nilptr or state.expected == nilptr or state.ctx == nilptr or
      SSL_CTX_use_PrivateKey(state.ctx, identity) ~= 1 or
      SSL_CTX_set1_server_cert_type(state.ctx, &raw_key, 1) ~= 1 or
      SSL_CTX_set1_client_cert_type(state.ctx, &raw_key, 1) ~= 1 then
    release(state)
    return nilptr
  end
  state.alpn[0] = (@cuchar)(alpn_len)
  C.memcpy(&state.alpn[1], alpn, alpn_len)
  state.alpn_len = (@cuint)(alpn_len) + 1
  local mode = SSL_VERIFY_PEER
  if server then mode = mode | SSL_VERIFY_FAIL_IF_NO_PEER_CERT end
  SSL_CTX_set_verify(state.ctx, mode, nilptr)
  SSL_CTX_set_cert_verify_callback(state.ctx, (@pointer)(verify), state.expected)
  if server then SSL_CTX_set_alpn_select_cb(state.ctx, (@pointer)(select_alpn), state) end
  return state
end

local function new(e: Env, f: *[0]Term, server: boolean): *Direct
  local secret: *cuchar, peer: *cuchar, alpn: *cuchar
  local secret_len: csize, peer_len: csize, alpn_len: csize
  defer
    if secret ~= nilptr then OPENSSL_cleanse(secret, secret_len) end
    C.free(secret)
    C.free(peer)
    C.free(alpn)
  end
  if not bytes(e, f[2], 32, &secret, &secret_len) or secret_len ~= 32 or
      not bytes(e, f[3], 32, &peer, &peer_len) or peer_len ~= 32 or
      not bytes(e, f[4], 255, &alpn, &alpn_len) or alpn_len == 0 then return nilptr end
  return configure(secret, peer, alpn, alpn_len, server)
end

local function address(e: Env, host: Term, port: uint32, out: *Address): boolean
  if port > 65535 then return false end
  local n: uint64
  local text = io_cstr(e, host, &n)
  defer C.free(text) end
  if io_nul(text, n) then return false end
  local network_port = htons((@uint16)(port))
  if inet_pton(AF_INET, text, &out.v4.sin_addr) == 1 then
    out.family = AF_INET
    out.v4.sin_family = (@uint16)(AF_INET)
    out.v4.sin_port = network_port
    return true
  end
  if inet_pton(AF_INET6, text, &out.v6.sin6_addr) == 1 then
    out.family = AF_INET6
    out.v6.sin6_family = (@uint16)(AF_INET6)
    out.v6.sin6_port = network_port
    return true
  end
  return false
end

local function socket_address(addr: *Address): (pointer, socklen_t)
  if addr.family == AF_INET then return &addr.v4, #sockaddr_in end
  return &addr.v6, #sockaddr_in6
end

local function port_of(addr: *Address): uint16
  if addr.family == AF_INET then return addr.v4.sin_port end
  return addr.v6.sin6_port
end

local function make_peer(peer: *BIO_ADDR, addr: *Address): boolean
  if addr.family == AF_INET then
    return BIO_ADDR_rawmake(peer, AF_INET, &addr.v4.sin_addr, #in_addr, port_of(addr)) == 1
  end
  return BIO_ADDR_rawmake(peer, AF_INET6, &addr.v6.sin6_addr, #in6_addr, port_of(addr)) == 1
end

local function write(stream: *SSL, buf: *[0]cuchar, len: csize): boolean
  local sent: csize = 0
  while sent < len do
    local n: csize = 0
    if SSL_write_ex(stream, &buf[sent], len - sent, &n) ~= 1 or n == 0 then return false end
    sent = sent + n
  end
  return SSL_stream_conclude(stream, 0) == 1
end

local Job = @record{
  state: *Direct, addr: Address, send: *cuchar, recv: *cuchar,
  send_len: csize, recv_len: csize, limit: csize, err: cstring
}
local function make_job(state: *Direct, limit: csize): *Job
  local job = (@*Job)(io_mem(C.calloc(1, #Job)))
  job.state = state
  job.limit = limit
  return job
end
local function free_job(job: *Job)
  release(job.state)
  C.free(job.send)
  C.free(job.recv)
  C.free(job)
end
local function read(job: *Job)
  job.recv = (@*cuchar)(C.malloc(job.limit + 1))
  if job.recv == nilptr then
    job.err = 'cannot allocate QUIC receive buffer'
    return
  end
  local buf = (@*[0]cuchar)(job.recv)
  while job.recv_len <= job.limit do
    local got: csize = 0
    local status = SSL_read_ex(job.state.stream, &buf[job.recv_len], job.limit + 1 - job.recv_len, &got)
    if status ~= 1 then
      if SSL_get_error(job.state.stream, status) ~= SSL_ERROR_ZERO_RETURN then
        job.err = 'QUIC read failed'
      end
      return
    end
    job.recv_len = job.recv_len + got
  end
  job.err = 'QUIC message exceeds receive limit'
end

local function bind_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local addr: Address = {}
  if not address(e, f[0], (@uint32)(f[1]), &addr) then
    return io_fail(e, EINVAL, 'invalid IP listener address')
  end
  local state = new(e, f, true)
  if state == nilptr then return io_fail(e, EINVAL, 'invalid QUIC listener identity or ALPN') end
  local sa, size = socket_address(&addr)
  state.fd = socket(addr.family, SOCK_DGRAM, IPPROTO_UDP)
  state.listener = SSL_new_listener(state.ctx, 0)
  if state.fd < 0 or state.listener == nilptr or
      bind(state.fd, sa, size) ~= 0 or getsockname(state.fd, sa, &size) ~= 0 or
      SSL_set_fd(state.listener, state.fd) ~= 1 or SSL_listen(state.listener) ~= 1 then
    release(state)
    return io_fail(e, EIO, 'cannot start QUIC listener')
  end
  local id = keep(state)
  if id == 0 then
    release(state)
    return io_fail(e, EOVERFLOW, 'QUIC handle space exhausted')
  end
  return io_done(e, io_tup(e, term_pak(iroh_tag_BoundUdp, id), ntohs(port_of(&addr))))
end

local function accept_call(work: *IoWork)
  local job = (@*Job)(work.data)
  local state = job.state
  state.conn = SSL_accept_connection(state.listener, 0)
  if state.conn ~= nilptr and SSL_set_default_stream_mode(state.conn, SSL_DEFAULT_STREAM_MODE_NONE) == 1 then
    state.stream = SSL_accept_stream(state.conn, 0)
  end
  if state.stream == nilptr or SSL_get0_peer_rpk(state.conn) == nilptr then
    job.err = 'QUIC accept or peer authentication failed'
    return
  end
  read(job)
end
local function accept_pack(e: Env, work: *IoWork): Term
  local job = (@*Job)(work.data)
  defer free_job(job) end
  if job.err ~= nilptr then return io_fail(e, EIO, job.err) end
  local id = keep(job.state)
  if id == 0 then return io_fail(e, EOVERFLOW, 'QUIC handle space exhausted') end
  job.state = nilptr
  return io_done(e, io_tup(e, term_pak(iroh_tag_AcceptedStream, id),
    io_list(e, (@cstring)(job.recv), job.recv_len)))
end
local function accept_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = take(e, f[0], false)
  local limit = (@uint32)(f[1])
  if state == nilptr or limit > MAX_MESSAGE then
    release(state)
    return io_fail(e, EINVAL, 'invalid QUIC listener or receive limit')
  end
  work.data = (@cstring)(make_job(state, limit))
  return io_work(work, accept_call, accept_pack)
end

local function finish_pack(e: Env, work: *IoWork): Term
  local job = (@*Job)(work.data)
  defer free_job(job) end
  if job.err ~= nilptr then return io_fail(e, EIO, job.err) end
  return io_done(e, term_pak(iroh_tag_Unit, 0))
end
local function respond_call(work: *IoWork)
  local job = (@*Job)(work.data)
  if not write(job.state.stream, (@*[0]cuchar)(job.send), job.send_len) then
    job.err = 'QUIC response write failed'
  else
    SSL_shutdown(job.state.conn)
  end
end
local function respond_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = take(e, f[0], true)
  if state == nilptr then return io_fail(e, EINVAL, 'invalid QUIC stream') end
  local job = make_job(state, 0)
  if not bytes(e, f[1], MAX_MESSAGE, &job.send, &job.send_len) then
    free_job(job)
    return io_fail(e, EINVAL, 'invalid or oversized QUIC response')
  end
  work.data = (@cstring)(job)
  return io_work(work, respond_call, finish_pack)
end

local function close_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = take(e, f[0], false)
  if state == nilptr then return io_fail(e, EINVAL, 'invalid QUIC listener') end
  release(state)
  return io_done(e, term_pak(iroh_tag_Unit, 0))
end
local function abort_call(work: *IoWork)
  local job = (@*Job)(work.data)
  local reset: SSL_STREAM_RESET_ARGS = {quic_error_code = 1}
  local args: SSL_SHUTDOWN_EX_ARGS = {quic_error_code = 1, quic_reason = 'stream aborted'}
  if SSL_stream_reset(job.state.stream, &reset, #SSL_STREAM_RESET_ARGS) ~= 1 or
      SSL_shutdown_ex(job.state.conn, 0, &args, #SSL_SHUTDOWN_EX_ARGS) < 0 then
    job.err = 'could not abort QUIC connection'
  end
end
local function abort_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = take(e, f[0], true)
  if state == nilptr then return io_fail(e, EINVAL, 'invalid QUIC stream') end
  work.data = (@cstring)(make_job(state, 0))
  return io_work(work, abort_call, finish_pack)
end

local function dial_connection(job: *Job): boolean
  local state = job.state
  local peer = BIO_ADDR_new()
  defer BIO_ADDR_free(peer) end
  state.conn = SSL_new(state.ctx)
  state.fd = socket(job.addr.family, SOCK_DGRAM, IPPROTO_UDP)
  if peer == nilptr or state.conn == nilptr or state.fd < 0 or
      not make_peer(peer, &job.addr) or
      SSL_set_fd(state.conn, state.fd) ~= 1 or SSL_set1_initial_peer_addr(state.conn, peer) ~= 1 or
      SSL_set_alpn_protos(state.conn, &state.alpn[0], state.alpn_len) ~= 0 or
      SSL_set_default_stream_mode(state.conn, SSL_DEFAULT_STREAM_MODE_NONE) ~= 1 or
      SSL_connect(state.conn) ~= 1 or SSL_get0_peer_rpk(state.conn) == nilptr then
    job.err = 'QUIC dial or peer authentication failed'
    return false
  end
  return true
end
local function exchange_call(work: *IoWork)
  local job = (@*Job)(work.data)
  if not dial_connection(job) then return end
  local state = job.state
  state.stream = SSL_new_stream(state.conn, 0)
  if state.stream == nilptr or not write(state.stream, (@*[0]cuchar)(job.send), job.send_len) then
    job.err = 'QUIC request write failed'
  else
    read(job)
    SSL_shutdown(state.conn)
  end
end
local function exchange_pack(e: Env, work: *IoWork): Term
  local job = (@*Job)(work.data)
  defer free_job(job) end
  if job.err ~= nilptr then return io_fail(e, EIO, job.err) end
  return io_done(e, io_list(e, (@cstring)(job.recv), job.recv_len))
end
local function exchange_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local limit = (@uint32)(f[6])
  local addr: Address = {}
  if limit > MAX_MESSAGE or f[1] == 0 or not address(e, f[0], (@uint32)(f[1]), &addr) then
    return io_fail(e, EINVAL, 'invalid QUIC remote address or receive limit')
  end
  local state = new(e, f, false)
  if state == nilptr then return io_fail(e, EINVAL, 'invalid QUIC client identity or ALPN') end
  local job = make_job(state, limit)
  job.addr = addr
  if not bytes(e, f[5], MAX_MESSAGE, &job.send, &job.send_len) then
    free_job(job)
    return io_fail(e, EINVAL, 'invalid or oversized QUIC request')
  end
  work.data = (@cstring)(job)
  return io_work(work, exchange_call, exchange_pack)
end

-- Connections and their independent streams are owned by the event loop
-- after the worker finishes authenticating. No SSL object is shared with
-- a worker after the connection handle has been published.
local Stream = @record{
  next: pointer, id: uint32, state: *Direct, ssl: *SSL,
  pending: *cuchar, length: csize, offset: csize, finished: boolean
}
local streams: pointer

local function active_slot(e: Env, handle: Term): *pointer
  local id = handle_id(e,handle,iroh_tag_LiveConnection)
  local slot = &handles
  while $slot ~= nilptr do
    local state = (@*Direct)($slot)
    if state.id == id and state.active then return slot end
    slot = &state.next
  end
  return nilptr
end

local function stream_slot(e: Env, handle: Term): *pointer
  local id = handle_id(e,handle,iroh_tag_LiveStream)
  local slot = &streams
  while $slot ~= nilptr do
    local stream = (@*Stream)($slot)
    if stream.id == id then return slot end
    slot = &stream.next
  end
  return nilptr
end

local function connection(e: Env, handle: Term): *Direct
  local slot = active_slot(e,handle)
  if slot == nilptr then return nilptr end
  return (@*Direct)($slot)
end

local function io_stream(e: Env, handle: Term): *Stream
  local slot = stream_slot(e,handle)
  if slot == nilptr then return nilptr end
  return (@*Stream)($slot)
end

local function unit(): Term
  return term_pak(iroh_tag_Unit,0)
end
local function ready(e: Env, owner: Term, value: Term): Term
  return io_tup(e,owner,io_box(e,iroh_tag_Ready,value))
end
local function wait(e: Env, owner: Term): Term
  return io_tup(e,owner,io_box(e,iroh_tag_Wait,unit()))
end
local function ready_error(e: Env, owner: Term, message: cstring): Term
  return ready(e,owner,io_fail(e,EIO,message))
end
local function retryable(ssl: *SSL, result: cint): boolean
  local code = SSL_get_error(ssl,result)
  return code == SSL_ERROR_WANT_READ or code == SSL_ERROR_WANT_WRITE
end

local function activate(job: *Job)
  if SSL_set_blocking_mode(job.state.conn,0) ~= 1 then
    job.err = 'cannot set QUIC nonblocking mode'
    return
  end
  job.state.active = true
end
local function connect_call(work: *IoWork)
  local job = (@*Job)(work.data)
  if dial_connection(job) then activate(job) end
end
local function accept_connection_call(work: *IoWork)
  local job = (@*Job)(work.data)
  local state = job.state
  state.conn = SSL_accept_connection(state.listener,0)
  if state.conn == nilptr or SSL_set_default_stream_mode(state.conn,SSL_DEFAULT_STREAM_MODE_NONE) ~= 1 or
      SSL_accept(state.conn) ~= 1 or SSL_get0_peer_rpk(state.conn) == nilptr then
    job.err = 'QUIC accept or peer authentication failed'
    return
  end
  activate(job)
end
local function connection_pack(e: Env, work: *IoWork): Term
  local job = (@*Job)(work.data)
  defer free_job(job) end
  if job.err ~= nilptr then return io_fail(e,EIO,job.err) end
  local id = keep(job.state)
  if id == 0 then return io_fail(e,EOVERFLOW,'QUIC handle space exhausted') end
  job.state = nilptr
  return io_done(e,term_pak(iroh_tag_LiveConnection,id))
end
local function connect_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local addr: Address = {}
  if f[1] == 0 or not address(e,f[0],(@uint32)(f[1]),&addr) then
    return io_fail(e,EINVAL,'invalid QUIC remote address')
  end
  local state = new(e,f,false)
  if state == nilptr then return io_fail(e,EINVAL,'invalid QUIC client identity or ALPN') end
  local job = make_job(state,0)
  job.addr = addr
  work.data = (@cstring)(job)
  return io_work(work,connect_call,connection_pack)
end
local function accept_connection_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = take(e,f[0],false)
  if state == nilptr then return io_fail(e,EINVAL,'invalid QUIC listener') end
  work.data = (@cstring)(make_job(state,0))
  return io_work(work,accept_connection_call,connection_pack)
end

local function keep_stream(e: Env, conn: Term, state: *Direct, ssl: *SSL): Term
  if ssl == nilptr then
    local info: SSL_CONN_CLOSE_INFO
    if SSL_get_conn_close_info(state.conn,&info,#SSL_CONN_CLOSE_INFO) > 0 then
      return ready_error(e,conn,'QUIC connection closed')
    end
    return wait(e,conn)
  end
  if next_id == 0 then
    SSL_free(ssl)
    return ready_error(e,conn,'QUIC handle space exhausted')
  end
  local stream = (@*Stream)(io_mem(C.calloc(1,#Stream)))
  stream.id = next_id
  next_id = next_id + 1
  stream.state = state
  stream.ssl = ssl
  stream.next = streams
  streams = stream
  state.refs = state.refs + 1
  return ready(e,conn,io_done(e,term_pak(iroh_tag_LiveStream,stream.id)))
end

local function open_stream_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = connection(e,f[0])
  if state == nilptr or state.closing or f[1] > 1 then
    return ready_error(e,f[0],'invalid QUIC connection or stream direction')
  end
  local flags = SSL_STREAM_FLAG_NO_BLOCK
  if f[1] == 1 then flags = flags | SSL_STREAM_FLAG_UNI end
  ERR_clear_error()
  if SSL_handle_events(state.conn) ~= 1 then return ready_error(e,f[0],'QUIC connection event processing failed') end
  return keep_stream(e,f[0],state,SSL_new_stream(state.conn,flags))
end
local function accept_stream_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = connection(e,f[0])
  if state == nilptr or state.closing then return ready_error(e,f[0],'invalid QUIC connection') end
  ERR_clear_error()
  if SSL_handle_events(state.conn) ~= 1 then return ready_error(e,f[0],'QUIC connection event processing failed') end
  return keep_stream(e,f[0],state,SSL_accept_stream(state.conn,SSL_ACCEPT_STREAM_NO_BLOCK))
end

local function read_stream_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local stream = io_stream(e,f[0])
  if stream == nilptr or stream.state.closing or f[1] < 1 or f[1] > MAX_MESSAGE then
    return ready_error(e,f[0],'invalid QUIC stream or receive limit')
  end
  local buffer = (@cstring)(io_mem(C.malloc((@csize)(f[1]))))
  defer C.free(buffer) end
  local got: csize
  ERR_clear_error()
  local result = SSL_read_ex(stream.ssl,buffer,(@csize)(f[1]),&got)
  if result == 1 then
    return ready(e,f[0],io_done(e,io_box(e,iroh_tag_Some,io_list(e,buffer,got))))
  end
  local code = SSL_get_error(stream.ssl,result)
  if code == SSL_ERROR_ZERO_RETURN then
    return ready(e,f[0],io_done(e,term_pak(iroh_tag_None,0)))
  end
  if code == SSL_ERROR_WANT_READ or code == SSL_ERROR_WANT_WRITE then return wait(e,f[0]) end
  return ready_error(e,f[0],'QUIC stream read failed')
end
local function writable(stream: *Stream): boolean
  return stream ~= nilptr and not stream.state.closing and not stream.finished and
    (SSL_get_stream_type(stream.ssl) & SSL_STREAM_TYPE_WRITE) ~= 0
end

local function queue_write_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local stream = io_stream(e,f[0])
  if not writable(stream) or stream.pending ~= nilptr then
    return io_tup(e,f[0],io_fail(e,EINVAL,'QUIC stream cannot queue a write'))
  end
  if not bytes(e,f[1],MAX_MESSAGE,&stream.pending,&stream.length) then
    return io_tup(e,f[0],io_fail(e,EINVAL,'invalid or oversized QUIC stream write'))
  end
  return io_tup(e,f[0],io_done(e,unit()))
end
local function clear_write(stream: *Stream)
  C.free(stream.pending)
  stream.pending = nilptr
  stream.length = 0
  stream.offset = 0
end
local function flush_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local stream = io_stream(e,f[0])
  if not writable(stream) then return ready_error(e,f[0],'QUIC stream cannot write') end
  if stream.offset == stream.length then
    clear_write(stream)
    return ready(e,f[0],io_done(e,unit()))
  end
  local count = stream.length - stream.offset
  if count > 16384 then count = 16384 end
  local buf = (@*[0]cuchar)(stream.pending)
  local wrote: csize
  ERR_clear_error()
  local result = SSL_write_ex(stream.ssl,&buf[stream.offset],count,&wrote)
  if result ~= 1 then
    if retryable(stream.ssl,result) then return wait(e,f[0]) end
    clear_write(stream)
    return ready_error(e,f[0],'QUIC stream write failed')
  end
  if wrote == 0 or wrote > count then
    clear_write(stream)
    return ready_error(e,f[0],'QUIC write made invalid progress')
  end
  stream.offset = stream.offset + wrote
  if stream.offset ~= stream.length then return wait(e,f[0]) end
  clear_write(stream)
  return ready(e,f[0],io_done(e,unit()))
end
local function finish_stream_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local stream = io_stream(e,f[0])
  if not writable(stream) or stream.pending ~= nilptr or SSL_stream_conclude(stream.ssl,0) ~= 1 then
    return io_tup(e,f[0],io_fail(e,EINVAL,'QUIC stream cannot send FIN'))
  end
  stream.finished = true
  return io_tup(e,f[0],io_done(e,unit()))
end
local function drop_stream_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local slot = stream_slot(e,f[0])
  if slot ~= nilptr then
    local stream = (@*Stream)($slot)
    $slot = stream.next
    clear_write(stream)
    SSL_free(stream.ssl)
    release(stream.state)
    C.free(stream)
  end
  return unit()
end

local function tick_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = connection(e,f[0])
  if state == nilptr or SSL_handle_events(state.conn) ~= 1 then
    return io_tup(e,f[0],io_fail(e,EIO,'QUIC connection event processing failed'))
  end
  return io_tup(e,f[0],io_done(e,unit()))
end
local function shutdown_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local state = connection(e,f[0])
  if state == nilptr then return ready_error(e,f[0],'invalid QUIC connection') end
  state.closing = true
  local result = SSL_shutdown_ex(state.conn,SSL_SHUTDOWN_FLAG_NO_BLOCK,nilptr,0)
  if result < 0 then return ready_error(e,f[0],'QUIC shutdown failed') end
  if result == 0 then return wait(e,f[0]) end
  return ready(e,f[0],io_done(e,unit()))
end
local function drop_connection_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local slot = active_slot(e,f[0])
  if slot ~= nilptr then
    local state = (@*Direct)($slot)
    $slot = state.next
    if not state.closing then
      state.closing = true
      SSL_shutdown_ex(state.conn,SSL_SHUTDOWN_FLAG_NO_BLOCK,nilptr,0)
    end
    release(state)
  end
  return unit()
end

local function register() <cexport,codename 'iroh_register_direct',cattribute 'constructor'>
  if iroh_tag_bind ~= 0xffffffff then io_eff(iroh_tag_bind, bind_run) end
  if iroh_tag_accept ~= 0xffffffff then io_eff(iroh_tag_accept, accept_run) end
  if iroh_tag_respond ~= 0xffffffff then io_eff(iroh_tag_respond, respond_run) end
  if iroh_tag_close ~= 0xffffffff then io_eff(iroh_tag_close, close_run) end
  if iroh_tag_abort ~= 0xffffffff then io_eff(iroh_tag_abort, abort_run) end
  if iroh_tag_exchange ~= 0xffffffff then io_eff(iroh_tag_exchange, exchange_run) end
  if iroh_tag_quic_connect ~= 0xffffffff then io_eff(iroh_tag_quic_connect,connect_run) end
  if iroh_tag_quic_accept_connection ~= 0xffffffff then io_eff(iroh_tag_quic_accept_connection,accept_connection_run) end
  if iroh_tag_quic_open_stream ~= 0xffffffff then io_eff(iroh_tag_quic_open_stream,open_stream_run) end
  if iroh_tag_quic_accept_stream ~= 0xffffffff then io_eff(iroh_tag_quic_accept_stream,accept_stream_run) end
  if iroh_tag_quic_read ~= 0xffffffff then io_eff(iroh_tag_quic_read,read_stream_run) end
  if iroh_tag_quic_queue_write ~= 0xffffffff then io_eff(iroh_tag_quic_queue_write,queue_write_run) end
  if iroh_tag_quic_flush ~= 0xffffffff then io_eff(iroh_tag_quic_flush,flush_run) end
  if iroh_tag_quic_finish ~= 0xffffffff then io_eff(iroh_tag_quic_finish,finish_stream_run) end
  if iroh_tag_quic_drop_stream ~= 0xffffffff then io_eff(iroh_tag_quic_drop_stream,drop_stream_run) end
  if iroh_tag_quic_tick ~= 0xffffffff then io_eff(iroh_tag_quic_tick,tick_run) end
  if iroh_tag_quic_shutdown ~= 0xffffffff then io_eff(iroh_tag_quic_shutdown,shutdown_run) end
  if iroh_tag_quic_drop_connection ~= 0xffffffff then io_eff(iroh_tag_quic_drop_connection,drop_connection_run) end
end
