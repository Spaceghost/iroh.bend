-- Native effects for Bend 2.0.39.
## pragmas.noentrypoint = true
## pragmas.nogc = true
## cinclude '<arpa/inet.h>'
## cinclude '<openssl/ssl.h>'
## cinclude '<openssl/err.h>'
## cinclude '<openssl/x509_vfy.h>'
## cinclude '<unistd.h>'
## cdefine 'iroh_sockaddr_in struct sockaddr_in'
## cdefine 'iroh_in_addr struct in_addr'
## cdefine 'iroh_sockaddr_in6 struct sockaddr_in6'
## cdefine 'iroh_in6_addr struct in6_addr'
require 'C.stdlib'
require 'C.string'

-- The compiler resolves CID() within the importing Bend module.
##[[
for _, name in ipairs{'bind','accept','respond','close','abort','exchange',
                      'BoundUdp','AcceptedStream','Con','Unit',
                      'quic_connect','quic_accept_connection','quic_open_stream','quic_accept_stream',
                      'quic_read','quic_queue_write','quic_flush','quic_finish',
                      'quic_drop_stream','quic_tick','quic_shutdown','quic_drop_connection',
                      'LiveConnection','LiveStream','Ready','Wait',
                      'Some','None'} do
  cinclude(string.format(
    '#ifdef CID(%s)\n#define iroh_tag_%s CID(%s)\n#else\n#define iroh_tag_%s UINT32_MAX\n#endif',
    name, name, name, name))
end
]]
local iroh_tag_bind: uint32 <cimport,nodecl>
local iroh_tag_accept: uint32 <cimport,nodecl>
local iroh_tag_respond: uint32 <cimport,nodecl>
local iroh_tag_close: uint32 <cimport,nodecl>
local iroh_tag_abort: uint32 <cimport,nodecl>
local iroh_tag_exchange: uint32 <cimport,nodecl>
local iroh_tag_BoundUdp: uint32 <cimport,nodecl>
local iroh_tag_AcceptedStream: uint32 <cimport,nodecl>
local iroh_tag_Con: uint32 <cimport,nodecl>
local iroh_tag_Unit: uint32 <cimport,nodecl>

local iroh_tag_quic_connect: uint32 <cimport,nodecl>
local iroh_tag_quic_accept_connection: uint32 <cimport,nodecl>
local iroh_tag_quic_open_stream: uint32 <cimport,nodecl>
local iroh_tag_quic_accept_stream: uint32 <cimport,nodecl>
local iroh_tag_quic_read: uint32 <cimport,nodecl>
local iroh_tag_quic_queue_write: uint32 <cimport,nodecl>
local iroh_tag_quic_flush: uint32 <cimport,nodecl>
local iroh_tag_quic_finish: uint32 <cimport,nodecl>
local iroh_tag_quic_drop_stream: uint32 <cimport,nodecl>
local iroh_tag_quic_tick: uint32 <cimport,nodecl>
local iroh_tag_quic_shutdown: uint32 <cimport,nodecl>
local iroh_tag_quic_drop_connection: uint32 <cimport,nodecl>
local iroh_tag_LiveConnection: uint32 <cimport,nodecl>
local iroh_tag_LiveStream: uint32 <cimport,nodecl>
local iroh_tag_Ready: uint32 <cimport,nodecl>
local iroh_tag_Wait: uint32 <cimport,nodecl>
local iroh_tag_Some: uint32 <cimport,nodecl>
local iroh_tag_None: uint32 <cimport,nodecl>

local Env <cimport,nodecl> = @record{mem: *[0]uint64}
local IoWork <cimport,nodecl> = @record{data: cstring}
local Term = @uint64
local Effect = @function(Env,*[0]Term,*IoWork): Term
local Call = @function(*IoWork): void
local Pack = @function(Env,*IoWork): Term
local function io_eff(cid: uint32, effect: Effect) <cimport,nodecl> end
local function io_work(work: *IoWork, call: Call, pack: Pack): Term <cimport,nodecl> end
local function io_mem(p: pointer): pointer <cimport,nodecl> end
local function io_cstr(e: Env, t: Term, n: *uint64): cstring <cimport,nodecl> end
local function io_nul(s: cstring, n: uint64): boolean <cimport,nodecl> end
local function io_cbuf(e: Env, t: Term, n: *uint64, tag: uint32): cstring <cimport,nodecl> end
local function io_list(e: Env, data: cstring, n: uint64): Term <cimport,nodecl> end
local function io_fail(e: Env, code: uint32, text: cstring): Term <cimport,nodecl> end
local function io_done(e: Env, data: Term): Term <cimport,nodecl> end
local function io_box(e: Env, tag: uint64, value: Term): Term <cimport,nodecl> end
local function io_tup(e: Env, first: Term, second: Term): Term <cimport,nodecl> end
local function term_pak(tag: uint64, value: uint64): Term <cimport,nodecl> end
local function term_aux(t: Term): uint64 <cimport,nodecl> end
local function term_tag(t: Term): uint64 <cimport,nodecl> end
local function term_loc(t: Term): uint64 <cimport,nodecl> end
local TAG_PAK: uint64 <cimport,nodecl>
local TAG_CTR: uint64 <cimport,nodecl>
local function term_peek(mem: *[0]uint64, t: Term): uint64 <cimport,nodecl> end

local SSL <cimport,nodecl> = @record{}
local SSL_CTX <cimport,nodecl> = @record{}
local SSL_METHOD <cimport,nodecl> = @record{}
local EVP_PKEY <cimport,nodecl> = @record{}
local X509_STORE_CTX <cimport,nodecl> = @record{}
