local IO_CAPACITY: csize <comptime> = 1536
local STREAM_CHUNK: csize <comptime> = 65536
local RX_LIMIT: csize <comptime> = 4 * 1024 * 1024
local TX_LIMIT: uint64 <comptime> = 4 * 1024 * 1024
local PATH_LIMIT: uint32 <comptime> = 8
local STREAM_LIMIT: uint32 <comptime> = 128
local LISTENER_LIMIT: uint32 <comptime> = 64
local SESSION_LIMIT: uint32 <comptime> = 256
local HANDSHAKE_LIMIT: uint64 <comptime> = 10000000
local DATAGRAM_QUEUE_LIMIT: uint32 <comptime> = 64
local NAT_PARAMETER_SIZE: csize <comptime> = 10
local NAT_INBOX_CAPACITY: csize <comptime> = 512
local NAT_PROBE_CAPACITY: csize <comptime> = 255
local NAT_PROBE_LIFETIME: uint64 <comptime> = 30000000
local CHALLENGE_SIZE: csize <comptime> = 9
local ADD_ADDRESS_V4: uint64 <comptime> = 0x3d7f90
local ADD_ADDRESS_V6: uint64 <comptime> = 0x3d7f91
local REMOVE_ADDRESS: uint64 <comptime> = 0x3d7f94
local REACH_OUT_V4: uint64 <comptime> = 0x3d7f92
local REACH_OUT_V6: uint64 <comptime> = 0x3d7f93
local BootstrapTuple = @record{local_addr:storage_t,peer:storage_t}
local Path = @record{
  next: pointer, fd: cint, local_addr: storage_t, peer: storage_t,
  id: uint32, status: uint32, unconnected: boolean, bootstrap: *BootstrapTuple
}
local Stream = @record{
  next: pointer, id: uint32, rx: *[0]uint8, size: csize,
  reset_code: uint64, stop_code: uint64, tx_reset: boolean, rx_stopped: boolean, read_finished: boolean,
  incoming: boolean, accepted: boolean, fin: boolean, sent_fin: boolean, reset: boolean, stop: boolean, early: boolean
}
local Datagram = @record{next:pointer,size:csize}
local Alpn = @record{next:pointer, wire:[258]uint8, size:csize, has_nul:boolean, retained:boolean}
local PeerParameters = @record{bytes:*uint8, size:csize}
local PendingHandshake = @record{alpn:*Alpn, parameters:PeerParameters, extensions:*uint8, nat_enabled:boolean}
local NatFrame = @record{size:csize, bytes:[30]uint8}
local NatProbe = @record{peer:storage_t, challenge:[CHALLENGE_SIZE]uint8, expires:uint64, answered:boolean, claimed:boolean}
local NatAdvertisement = @record{frame:NatFrame, tracked_payload:*uint8, tracked_at:uint64, delivered:boolean}
local NatInbox = @record{
  frames:[NAT_INBOX_CAPACITY]NatFrame, first:csize, count:csize,
  probes:[NAT_PROBE_CAPACITY]NatProbe, advertising:NatAdvertisement
}
local Session = @record{
  next: pointer, id: uint32, ticket: *uint8, length: csize,
  local_key: [32]uint8, peer_key: [32]uint8, alpn: [255]uint8, alpn_length: csize, datagram_limit: uint32,
  max_data:uint64,stream_bidi_local:uint64,stream_bidi_remote:uint64,stream_uni:uint64,streams_bidi:uint64,streams_uni:uint64,
  active_connection_id_limit:uint32,max_packet_size:uint32
}
local QadServer = @record{
  next:*QadServer, quic:*quic_t, id:uint32, fd:cint, local_addr:storage_t
}
local qad_servers: *QadServer
local next_qad_server: uint32 = 1
## cdefine 'iroh_qad_addrinfo struct addrinfo'
local AddrInfo <cimport,nodecl,codename 'iroh_qad_addrinfo'> = @record{
  ai_family:cint, ai_socktype:cint, ai_addrlen:cuint, ai_addr:pointer, ai_next:*AddrInfo
}
local function getaddrinfo(host:cstring, service:cstring, hints:*AddrInfo, out:**AddrInfo):cint <cimport,nodecl> end
local function freeaddrinfo(info:*AddrInfo) <cimport,nodecl> end
local function X509_get_default_cert_file():cstring <cimport,nodecl> end
local AddressDiscovery = @record{
  quic:*quic_t, cnx:*cnx_t, peer:storage_t, started:uint64, ready:boolean, closed:boolean
}
local QadRoute = @record{peer:storage_t, observed:storage_t, running:*AddressDiscovery, retry_at:uint64}
local RoutedDiscovery = @record{host:cstring, handle:uint32, port:uint16, v4:QadRoute, v6:QadRoute}
local Listener = @record{
  next: pointer, id: uint32, fd: cint, ipv4_fd:cint, quic: *quic_t, local_addr: storage_t,
  ipv4_addr:storage_t, dispatch_ipv4:boolean,
  refs: uint32, stopped: boolean, ossl:*mp_ssl_ctx, ossl_peer:*evp_t, resumable:boolean,
  discovery:*RoutedDiscovery, qad_revision:uint32,
  nat_offer: [NAT_PARAMETER_SIZE]uint8, sends_nat_offer: boolean
}
local Connection = @record{
  next: pointer, quic: *quic_t, cnx: *cnx_t, id: uint32,
  paths: *Path, path_count: uint32, last_path_id: uint32, streams: *Stream, stream_count: uint32,
  received: csize, output: [IO_CAPACITY]uint8, output_size: csize, output_path: *Path,
  output_peer: storage_t, output_source:storage_t, output_iface:cint, listener: *Listener, accepted: boolean,
  datagram_first: *Datagram, datagram_last: *Datagram, datagram_count: uint32,
  selected_alpn: *Alpn, peer_parameters: PeerParameters, detached: boolean, ready: boolean, closed: boolean, buffer_error: boolean,
  nat_inbox: *NatInbox, nat_source: *Path, nat_route_v4: *Path, nat_route_v6: *Path, discovery: *AddressDiscovery, routed_discovery: *RoutedDiscovery,
  ticket: *Session, resume: *Session, local_key: [32]uint8, peer_key: [32]uint8,
  early: boolean, early_decided: boolean
}
local connections: *Connection
local next_connection: uint32 = 1
local listeners: *Listener
local next_listener: uint32 = 1
local discarded_stream: uint8
local sessions: *Session
local next_session: uint32 = 1
local active_sessions: uint32

local function free_session(session: *Session)
  if session == nilptr then return end
  OPENSSL_cleanse(session.ticket,session.length)
  C.free(session.ticket)
  C.free(session)
end

local function bytes_from_list(e: Env, item: Term, out: *uint8, limit: csize): isize
  local bytes = (@*[0]uint8)(out)
  local size: csize = 0
  while term_tag(item) == TAG_CTR and term_aux(item) == iroh_mp_Con do
    local cells: [2]Term
    local location = ctr_take(e,item,2,&cells[0])
    if location ~= 0 then spare_free(e,cls_fit(2),location) end
    if size >= limit then return -2 end
    if cells[0] > 255 then return -1 end
    bytes[size] = (@uint8)(cells[0])
    size = size + 1
    item = cells[1]
  end
  if term_aux(item) ~= iroh_mp_Nil then return -1 end
  return (@isize)(size)
end

local function read_alpn(e: Env, term: Term, binary: boolean, out: *uint8): isize
  if binary then return bytes_from_list(e,term,out,255) end
  local size: uint64
  local text = io_cstr(e,term,&size)
  defer C.free(text) end
  if size > 255 then return -1 end
  C.memcpy(out,text,size)
  return (@isize)(size)
end

local function free_alpns(first: *Alpn)
  while first ~= nilptr do
    local next = (@*Alpn)(first.next)
    C.free(first)
    first = next
  end
end

local function make_alpn(e: Env, term: Term, binary: boolean): *Alpn
  local name: [255]uint8
  local len = read_alpn(e,term,binary,&name[0])
  if len <= 0 then return nilptr end
  local alpn = (@*Alpn)(C.calloc(1,#Alpn))
  if alpn == nilptr then return nilptr end
  alpn.size = (@csize)(len)
  -- RFC 7301 wraps one selected name in a two-byte list length and a one-byte name length.
  alpn.wire[0] = (@uint8)((len + 1) >> 8)
  alpn.wire[1] = (@uint8)(len + 1)
  alpn.wire[2] = (@uint8)(len)
  C.memcpy(&alpn.wire[3],&name[0],alpn.size)
  alpn.has_nul = C.memchr(&name[0],0,alpn.size) ~= nilptr
  return alpn
end

local function read_alpns(e: Env, term: Term, mode: uint32): *Alpn
  if mode ~= 2 then return make_alpn(e,term,mode == 1) end
  local first: *Alpn
  local tail: *Alpn
  local total: csize = 0
  while term_tag(term) == TAG_CTR and term_aux(term) == iroh_mp_Con do
    local cells: [2]Term
    local location = ctr_take(e,term,2,&cells[0])
    if location ~= 0 then spare_free(e,cls_fit(2),location) end
    local next = make_alpn(e,cells[0],true)
    if next == nilptr or total + next.size + 1 > 65533 then
      free_alpns(next)
      free_alpns(first)
      return nilptr
    end
    total = total + next.size + 1
    if tail == nilptr then first = next else tail.next = next end
    tail = next
    term = cells[1]
  end
  if term_aux(term) == iroh_mp_Nil then return first end
  free_alpns(first)
  return nilptr
end

local VerifyCallback = @function(*verify_t,*tls_t,cstring,pointer,pointer,*iov_t,csize): cint
local PinnedKey = @record{
  backend: pin_t, original: VerifyCallback, response: [4]ext_t, raw_type: uint8,
  alpns: *Alpn, retired: *Alpn, selected: *Alpn, check_extension: extension_cb_t,
  peer_parameters: PeerParameters, nat_offer: [NAT_PARAMETER_SIZE]uint8, sends_nat_offer:boolean
}

local function pinned(quic: *quic_t): *PinnedKey
  return (@*PinnedKey)((@*context_t)(quic.tls_master_ctx).verify_certificate)
end

local function save_parameters(out: *PeerParameters, data: iov_t): cint
  local copy: *uint8
  if data.len ~= 0 then
    copy = (@*uint8)(C.malloc(data.len))
    if copy == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
    C.memcpy(copy,data.base,data.len)
  end
  C.free(out.bytes)
  $out = {bytes=copy,size=data.len}
  return 0
end

local function pending_handshake(cnx: *cnx_t, listener: pointer): *PendingHandshake
  local context = picoquic_get_callback_context(cnx)
  if context == listener then return nilptr end
  return (@*PendingHandshake)(context)
end

local function ensure_pending(cnx:*cnx_t,listener:pointer):*PendingHandshake
  local pending = pending_handshake(cnx,listener)
  if pending == nilptr then
    pending = (@*PendingHandshake)(C.calloc(1,#PendingHandshake))
    if pending ~= nilptr then
      picoquic_set_callback(cnx,(@pointer)(picoquic_get_callback_function(cnx)),pending)
    end
  end
  return pending
end

local function discard_handshake(cnx: *cnx_t, listener: pointer)
  local pending = pending_handshake(cnx,listener)
  if pending == nilptr then return end
  picoquic_set_callback(cnx,(@pointer)(picoquic_get_callback_function(cnx)),listener)
  C.free(pending.parameters.bytes)
  C.free(pending.extensions)
  C.free(pending)
end

local function select_alpn(quic: *quic_t, offers: *iov_t, count: csize): csize
  local pin = pinned(quic)
  local cnx = (@*cnx_t)(quic.cnx_in_progress)
  if cnx == nilptr then return count end
  local list = (@*[0]iov_t)(offers)
  local name = pin.alpns
  while name ~= nilptr do
    for i = 0,<count do
      if list[i].len == name.size and C.memcmp(list[i].base,&name.wire[3],name.size) == 0 then
        local listener = picoquic_get_default_callback_context(quic)
        local pending = ensure_pending(cnx,listener)
        if pending == nilptr then return count end
        pending.alpn = name
        return i
      end
    end
    name = (@*Alpn)(name.next)
  end
  return count
end

local function check_client_extension(cb: *extension_self, tls: *tls_t, message: uint8, kind: uint16, data: iov_t): cint
  if message ~= PTLS_HANDSHAKE_TYPE_ENCRYPTED_EXTENSIONS then return 0 end
  local pin = (@*PinnedKey)(ptls_get_context(tls).verify_certificate)
  if kind == QUIC_TRANSPORT_EXTENSION and (pin.sends_nat_offer or iroh_mp_peer_multipath_parameters ~= 0xffffffff) then
    return save_parameters(&pin.peer_parameters,data)
  end
  if kind ~= ALPN_EXTENSION then return 0 end
  local name = pin.alpns
  while name ~= nilptr do
    if data.len == name.size + 3 and C.memcmp(data.base,&name.wire[0],data.len) == 0 then
      pin.selected = name
      return 0
    end
    name = (@*Alpn)(name.next)
  end
  return PTLS_ALERT_NO_APPLICATION_PROTOCOL
end

local function verify_raw(self: *verify_t, tls: *tls_t, server: cstring,
    verify_sign: pointer, verify_data: pointer, certs: *iov_t, count: csize): cint
  local pin = (@*PinnedKey)(self)
  if count ~= 1 or pin.original == nilptr then return PTLS_ALERT_BAD_CERTIFICATE end
  return pin.original(self,tls,server,verify_sign,verify_data,certs,count)
end

local function free_pin(verify: *verify_t)
  local pin = (@*PinnedKey)(verify)
  ptls_openssl_raw_pubkey_dispose_verify_certificate(&pin.backend)
  free_alpns(pin.alpns)
  free_alpns(pin.retired)
  C.free(pin.peer_parameters.bytes)
  C.free(pin)
end

local function install_identity(quic: *quic_t, seed: *uint8, peer: *uint8, alpns: **Alpn, public_key: *uint8): boolean
  local private = EVP_PKEY_new_raw_private_key_ex(nilptr,'ED25519',nilptr,seed,32)
  if private == nilptr then return false end
  defer EVP_PKEY_free(private) end
  local ctx = (@*context_t)(quic.tls_master_ctx)
  local signer = (@*signer_t)(C.malloc(IROH_MP_SIGN_SIZE))
  if signer == nilptr then return false end
  if ptls_openssl_init_sign_certificate(signer,private) ~= 0 then
    C.free(signer)
    return false
  end
  ctx.sign_certificate = signer
  local cert = (@*iov_t)(C.malloc(#iov_t))
  if cert == nilptr then return false end
  cert.base = (@*uint8)(C.malloc(44))
  if cert.base == nilptr then
    C.free(cert)
    return false
  end
  local out = cert.base
  if i2d_PUBKEY(private,&out) ~= 44 then
    C.free(cert.base)
    C.free(cert)
    return false
  end
  if public_key ~= nilptr then
    local key_length: csize = 32
    if EVP_PKEY_get_raw_public_key(private,public_key,&key_length) ~= 1 or key_length ~= 32 then
      C.free(cert.base)
      C.free(cert)
      return false
    end
  end
  cert.len = 44
  picoquic_set_tls_certificate_chain(quic,cert,1)
  local public:*evp_t
  if peer ~= nilptr then
    public = EVP_PKEY_new_raw_public_key_ex(nilptr,'ED25519',nilptr,peer,32)
    if public == nilptr then return false end
  end
  defer EVP_PKEY_free(public) end
  local pin = (@*PinnedKey)(C.calloc(1,#PinnedKey))
  if pin == nilptr then return false end
  -- An identity listener always verifies with OpenSSL. The Picotls object
  -- still supplies Picoquic's packet protection and listener ALPN state.
  local shadow_key = public ~= nilptr and public or private
  if ptls_openssl_raw_pubkey_init_verify_certificate(&pin.backend,shadow_key) ~= 0 then
    C.free(pin)
    return false
  end
  if public ~= nilptr then pin.original = (@VerifyCallback)(pin.backend.super.cb) end
  pin.backend.super.cb = (@pointer)(verify_raw)
  pin.alpns = $alpns
  $alpns = nilptr
  pin.check_extension.cb = check_client_extension
  ctx.on_extension = &pin.check_extension
  picoquic_set_verify_certificate_callback(quic,&pin.backend.super,(@pointer)(free_pin))
  picoquic_set_client_cert_verification_policy(quic,1)
  ctx.use_raw_public_keys = 1
  return true
end

local function picoquic_tls_collected_extensions_cb(tls: *tls_t, props: *props_t, slots: *ext_t): cint <cimport> end

local function collect_server_extension(tls: *tls_t, props: *props_t, kind: uint16): cint
  return (kind == 19 or kind == QUIC_TRANSPORT_EXTENSION) and 1 or 0
end

-- Gate the synchronous frame adapter on a valid peer offer before Bend polls.
local function peer_offers_nat(data: iov_t): boolean
  local bytes = (@*[0]uint8)(data.base)
  local at: csize = 0
  local has_offer: boolean
  while at < data.len do
    local kind: uint64, length: uint64
    local width = picoquic_varint_decode((&bytes[at]),data.len - at,&kind)
    if width == 0 then return false end
    at = at + width
    width = picoquic_varint_decode((&bytes[at]),data.len - at,&length)
    if width == 0 then return false end
    at = at + width
    if length > data.len - at then return false end
    if kind == 0x3d7f91120401 then
      if has_offer or length ~= 1 or bytes[at] == 0 then return false end
      has_offer = true
    end
    at = at + (@csize)(length)
  end
  return has_offer
end

local function merge_nat_offer(base:iov_t, offer:*uint8): iov_t
  if base.len > 65535 - NAT_PARAMETER_SIZE then return {base=nilptr,len=0} end
  local merged = (@*uint8)(C.malloc(base.len + NAT_PARAMETER_SIZE))
  if merged == nilptr then return {base=nilptr,len=0} end
  C.memcpy(merged,base.base,base.len)
  C.memcpy(&((@*[0]uint8)(merged))[base.len],offer,NAT_PARAMETER_SIZE)
  return {base=merged,len=base.len + NAT_PARAMETER_SIZE}
end

local function record_server_transport(listener:*Listener,pending:*PendingHandshake,cnx:*cnx_t,
    peer:iov_t,response:*iov_t):cint
  if listener.sends_nat_offer then
    local merged = merge_nat_offer($response,&listener.nat_offer[0])
    if merged.base == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
    C.free(pending.extensions)
    pending.extensions = merged.base
    $response = merged
    pending.nat_enabled = cnx.is_multipath_enabled ~= 0 and peer_offers_nat(peer)
  end
  if iroh_mp_peer_multipath_parameters ~= 0xffffffff then
    local status = save_parameters(&pending.parameters,peer)
    if status ~= 0 then return status end
  end
  return 0
end

local function server_extensions(tls: *tls_t, props: *props_t, slots: *ext_t): cint
  local parsed = picoquic_tls_collected_extensions_cb(tls,props,slots)
  if parsed ~= 0 then return parsed end
  local extensions = (@*[0]ext_t)(slots)
  local transport: *ext_t
  local has_raw: boolean
  local i: csize = 0
  while extensions[i].type ~= 65535 do
    local ext = &extensions[i]
    if ext.type == QUIC_TRANSPORT_EXTENSION then
      transport = ext
    elseif ext.type == 19 and ext.data.len > 0 then
      local offered = (@*[0]uint8)(ext.data.base)
      if offered[0] ~= ext.data.len - 1 then return PTLS_ALERT_UNSUPPORTED_CERTIFICATE end
      for at = 1, < ext.data.len do
        if offered[at] == 2 then has_raw = true end
      end
    end
    i = i + 1
  end
  if transport == nilptr then return 0 end
  if not has_raw then return PTLS_ALERT_UNSUPPORTED_CERTIFICATE end
  if props.additional_extensions == nilptr or props.additional_extensions.type ~= QUIC_TRANSPORT_EXTENSION then
    return PTLS_ALERT_INTERNAL_ERROR
  end
  -- The extension is consumed by picotls during this handshake call.
  local pin = (@*PinnedKey)(ptls_get_context(tls).verify_certificate)
  pin.raw_type = 2
  pin.response[0] = ((@*[0]ext_t)(props.additional_extensions))[0]
  pin.response[1] = {type=19,data={base=&pin.raw_type,len=1}}
  pin.response[2] = {type=65535}
  local data = ptls_get_data_ptr(tls)
  local cnx = (@*cnx_t)($data)
  if cnx == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
  local listener = (@*Listener)(picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx)))
  local pending = pending_handshake(cnx,listener)
  if pending == nilptr then return PTLS_ALERT_NO_APPLICATION_PROTOCOL end
  local recorded = record_server_transport(listener,pending,cnx,transport.data,&pin.response[0].data)
  if recorded ~= 0 then return recorded end
  local name = pending.alpn
  if name.has_nul then
    -- picotls serializes its built-in ALPN with strlen. Supply the selected bytes as an extension.
    local status = ptls_set_negotiated_protocol(tls,nilptr,0)
    if status ~= 0 then return status end
    pin.response[2] = {type=ALPN_EXTENSION,data={base=&name.wire[0],len=name.size + 3}}
    pin.response[3] = {type=65535}
  end
  props.additional_extensions = &pin.response[0]
  return 0
end

local function with_rpk_selection(tls: *tls_t, buf: *buffer_t, offsets: *csize, epoch: csize,
    bytes: pointer, len: csize, props: *props_t): cint
  local collect, collected = props.collect_extension,props.collected_extensions
  local previous = props.additional_extensions
  props.collect_extension = (@pointer)(collect_server_extension)
  props.collected_extensions = (@pointer)(server_extensions)
  local status = real_tls(tls,buf,offsets,epoch,bytes,len,props)
  props.collect_extension = collect
  props.collected_extensions = collected
  props.additional_extensions = previous
  return status
end

local function client_rpk_message(tls:*tls_t, buf:*buffer_t, offsets:*csize, epoch:csize, bytes:pointer,len:csize,
    props:*props_t, conn:*Connection):cint
  if props.additional_extensions == nilptr then return real_tls(tls,buf,offsets,epoch,bytes,len,props) end
  -- Offer the client raw key on every ClientHello, including after HelloRetryRequest.
  -- RFC 7250 client_certificate_type contains a single RawPublicKey entry.
  local offer: [2]uint8 = {1,2}
  local extensions:[3]ext_t
  local original = props.additional_extensions
  local upstream = (@*[0]ext_t)(original)
  if upstream[0].type ~= QUIC_TRANSPORT_EXTENSION or upstream[1].type ~= 65535 then
    return real_tls(tls,buf,offsets,epoch,bytes,len,props)
  end
  extensions[0] = upstream[0]
  local merged: *uint8
  defer C.free(merged) end
  if epoch == 0 and conn ~= nilptr then
    local pin = pinned(conn.quic)
    if pin.sends_nat_offer then
      local data = merge_nat_offer(extensions[0].data,&pin.nat_offer[0])
      if data.base == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
      merged = data.base
      extensions[0].data = data
    end
  end
  extensions[1] = {type=19,data={base=&offer[0],len=2}}
  extensions[2] = {type=65535}
  props.additional_extensions = &extensions[0]
  local result = real_tls(tls,buf,offsets,epoch,bytes,len,props)
  props.additional_extensions = original
  return result
end

local function restore_early_limits(cnx:*cnx_t, session:*Session)
  local remote = &cnx.remote_parameters
  remote.initial_max_data = session.max_data
  remote.initial_max_stream_data_bidi_local = session.stream_bidi_local
  remote.initial_max_stream_data_bidi_remote = session.stream_bidi_remote
  remote.initial_max_stream_data_uni = session.stream_uni
  remote.initial_max_streams_bidi = session.streams_bidi
  remote.initial_max_streams_uni = session.streams_uni
  remote.max_datagram_frame_size = session.datagram_limit
  remote.active_connection_id_limit = session.active_connection_id_limit
  remote.max_packet_size = session.max_packet_size
  local path = ((@*[0]*path_t)(cnx.path))[0]
  if session.max_packet_size < path.send_mtu then path.send_mtu = session.max_packet_size end
end

local function accepted_early_limits(cnx:*cnx_t, session:*Session):boolean
  local remote = &cnx.remote_parameters
  return remote.initial_max_data >= session.max_data and
    remote.initial_max_stream_data_bidi_local >= session.stream_bidi_local and
    remote.initial_max_stream_data_bidi_remote >= session.stream_bidi_remote and
    remote.initial_max_stream_data_uni >= session.stream_uni and
    remote.initial_max_streams_bidi >= session.streams_bidi and remote.initial_max_streams_uni >= session.streams_uni and
    remote.active_connection_id_limit >= session.active_connection_id_limit and
    remote.max_datagram_frame_size >= session.datagram_limit
end

local function reject_early(conn:*Connection, cnx:*cnx_t)
  -- EncryptedExtensions has installed the new transport parameters. The
  -- application packet context still contains only the 0-RTT flight.
  picosplay_empty_tree(&cnx.queue_data_repeat_tree)
  picoquic_reset_packet_context(cnx,&cnx.pkt_ctx[picoquic_packet_context_application])
  conn.output_size = 0
  while conn.streams ~= nilptr do
    local stream = conn.streams
    conn.streams = (@*Stream)(stream.next)
    local native = picoquic_find_stream(cnx,stream.id)
    if native ~= nilptr then picoquic_delete_stream(cnx,native) end
    C.free(stream.rx)
    C.free(stream)
  end
  conn.stream_count = 0
  conn.received = 0
  cnx.next_stream_id[0] = 0
  cnx.next_stream_id[2] = 2
  cnx.nb_bytes_queued = 0
  cnx.data_sent = 0
  cnx.maxdata_remote = cnx.remote_parameters.initial_max_data
end

local MpCryptoInput = @record{next:*MpCryptoInput, size:csize, consumed:csize}
local MpTls = @record{
  next:*MpTls, picotls:*tls_t, ssl:*mp_ssl, cnx:*cnx_t, props:*props_t,
  input:*MpCryptoInput, tail:*MpCryptoInput, buffered:csize,
  output:*buffer_t, offsets:*[0]csize, rx:uint32, tx:uint32, alert:uint8
}
local mp_tls_sessions:*MpTls

local function find_mp_tls(tls:*tls_t):*MpTls
  local state = mp_tls_sessions
  while state ~= nilptr and state.picotls ~= tls do state = state.next end
  return state
end

local function mp_tls_cipher(tls:*tls_t):*mp_cipher <cexport,codename '__wrap_ptls_get_cipher'>
  local state = find_mp_tls(tls)
  if state == nilptr then return real_tls_cipher(tls) end
  local current = SSL_get_current_cipher(state.ssl)
  if current == nilptr then return nilptr end
  local code = SSL_CIPHER_get_protocol_id(current)
  if code == 0x1301 then return &ptls_openssl_aes128gcmsha256 end
  if code == 0x1302 then return &ptls_openssl_aes256gcmsha384 end
  if code == 0x1303 then return &ptls_openssl_chacha20poly1305sha256 end
  return nilptr
end

local function mp_tls_read_epoch(tls:*tls_t):csize <cexport,codename '__wrap_ptls_get_read_epoch'>
  local state = find_mp_tls(tls)
  if state == nilptr then return real_tls_read_epoch(tls) end
  return (@csize)(state.rx)
end

local function mp_tls_complete(tls:*tls_t):cint <cexport,codename '__wrap_ptls_handshake_is_complete'>
  local state = find_mp_tls(tls)
  if state == nilptr then return real_tls_complete(tls) end
  return SSL_is_init_finished(state.ssl)
end

local function mp_tls_psk(tls:*tls_t):cint <cexport,codename '__wrap_ptls_is_psk_handshake'>
  local state = find_mp_tls(tls)
  if state == nilptr then return real_tls_psk(tls) end
  return SSL_session_reused(state.ssl)
end

local function mp_tls_free(tls:*tls_t) <cexport,codename '__wrap_ptls_free'>
  local link = &mp_tls_sessions
  while $link ~= nilptr do
    local state = $link
    if state.picotls == tls then
      $link = state.next
      if SSL_is_init_finished(state.ssl) ~= 0 then SSL_set_shutdown(state.ssl,SSL_SENT_SHUTDOWN) end
      SSL_free(state.ssl)
      while state.input ~= nilptr do
        local head = state.input
        state.input = head.next
        C.free(head)
      end
      C.free(state)
      break
    end
    link = &state.next
  end
  real_tls_free(tls)
end

local function mp_crypto_bytes(record:*MpCryptoInput,offset:csize):*uint8
  return &((@*[0]uint8)(record))[#MpCryptoInput + offset]
end

local function mp_crypto_receive(ssl:*mp_ssl,out:**uint8,size:*csize,arg:pointer):cint
  local state = (@*MpTls)(arg)
  local head = state.input
  if head == nilptr then
    $out = nilptr
    $size = 0
  else
    $out = mp_crypto_bytes(head,head.consumed)
    $size = head.size - head.consumed
  end
  return 1
end

local function mp_crypto_release(ssl:*mp_ssl,size:csize,arg:pointer):cint
  local state = (@*MpTls)(arg)
  local head = state.input
  if head == nilptr or size > head.size - head.consumed then return 0 end
  head.consumed = head.consumed + size
  if head.consumed == head.size then
    state.input = head.next
    if state.input == nilptr then state.tail = nilptr end
    state.buffered = state.buffered - head.size
    C.free(head)
  end
  return 1
end

local function mp_crypto_send(ssl:*mp_ssl,bytes:*uint8,size:csize,consumed:*csize,arg:pointer):cint
  local state = (@*MpTls)(arg)
  local buf = state.output
  if buf == nilptr or state.tx > 3 or ptls_buffer_reserve(buf,size) ~= 0 then return 0 end
  C.memcpy(&((@*[0]uint8)(buf.base))[buf.off],bytes,size)
  buf.off = buf.off + size
  for epoch = state.tx + 1,<=4 do state.offsets[epoch] = buf.off end
  $consumed = size
  return 1
end

local function mp_tls_secret(ssl:*mp_ssl,epoch:uint32,send:cint,secret:*uint8,length:csize,arg:pointer):cint
  local state = (@*MpTls)(arg)
  if epoch > 3 or mp_tls_cipher(state.picotls) == nilptr or
      (epoch == 1 and (send ~= 0 or SSL_session_reused(ssl) == 0)) then return 0 end
  local callback = ptls_get_context(state.picotls).update_traffic_key
  if (@InstallSecret)(callback.cb)(callback,state.picotls,send,epoch,secret) ~= 0 then return 0 end
  if epoch == 1 then
    state.cnx.zero_rtt_data_accepted = 1
  else
    if send ~= 0 then state.tx = epoch else state.rx = epoch end
  end
  return 1
end

local function mp_tls_transport(ssl:*mp_ssl,bytes:*uint8,size:csize,arg:pointer):cint
  local state = (@*MpTls)(arg)
  local slots:[2]ext_t = {{type=QUIC_TRANSPORT_EXTENSION,data={base=bytes,len=size}},{type=65535}}
  if picoquic_tls_collected_extensions_cb(state.picotls,state.props,&slots[0]) ~= 0 then return 0 end
  local local_params = state.props.additional_extensions
  if local_params == nilptr or local_params.type ~= QUIC_TRANSPORT_EXTENSION then return 0 end
  local listener = (@*Listener)(picoquic_get_default_callback_context(picoquic_get_quic_ctx(state.cnx)))
  local pending = ensure_pending(state.cnx,listener)
  if pending == nilptr then return 0 end
  local response = local_params.data
  if record_server_transport(listener,pending,state.cnx,slots[0].data,&response) ~= 0 then return 0 end
  return SSL_set_quic_tls_transport_params(ssl,response.base,response.len)
end

local function mp_tls_alert(ssl:*mp_ssl,alert:uint8,arg:pointer):cint
  local state = (@*MpTls)(arg)
  state.alert = alert
  return 1
end

local function mp_tls_open(tls:*tls_t,cnx:*cnx_t,ctx:*mp_ssl_ctx,props:*props_t,resumable:boolean):*MpTls
  local mp_tls_callbacks:[7]mp_dispatch = {
    {function_id=OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_SEND,iroh_mp_dispatch_fn=(@MpDispatchFn)(mp_crypto_send)},
    {function_id=OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RECV_RCD,iroh_mp_dispatch_fn=(@MpDispatchFn)(mp_crypto_receive)},
    {function_id=OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RELEASE_RCD,iroh_mp_dispatch_fn=(@MpDispatchFn)(mp_crypto_release)},
    {function_id=OSSL_FUNC_SSL_QUIC_TLS_YIELD_SECRET,iroh_mp_dispatch_fn=(@MpDispatchFn)(mp_tls_secret)},
    {function_id=OSSL_FUNC_SSL_QUIC_TLS_GOT_TRANSPORT_PARAMS,iroh_mp_dispatch_fn=(@MpDispatchFn)(mp_tls_transport)},
    {function_id=OSSL_FUNC_SSL_QUIC_TLS_ALERT,iroh_mp_dispatch_fn=(@MpDispatchFn)(mp_tls_alert)},
    {function_id=0,iroh_mp_dispatch_fn=nilptr}
  }
  local state = (@*MpTls)(C.calloc(1,#MpTls))
  if state == nilptr then return nilptr end
  state.ssl = SSL_new(ctx)
  state.picotls = tls
  state.cnx = cnx
  state.props = props
  if state.ssl ~= nilptr then SSL_set_accept_state(state.ssl) end
  if state.ssl == nilptr or SSL_set_quic_tls_cbs(state.ssl,&mp_tls_callbacks[0],state) ~= 1 or
      SSL_set_app_data(state.ssl,state) ~= 1 or
      (resumable and SSL_set_quic_tls_early_data_enabled(state.ssl,1) ~= 1) then
    SSL_free(state.ssl)
    C.free(state)
    return nilptr
  end
  state.next = mp_tls_sessions
  mp_tls_sessions = state
  return state
end

local PTLS_ALERT_UNEXPECTED_MESSAGE:cint <cimport,nodecl>

local function mp_tls_message(state:*MpTls,buf:*buffer_t,offsets:*csize,bytes:pointer,size:csize):cint
  if SSL_is_init_finished(state.ssl) ~= 0 then
    -- QUIC peers never send a TLS KeyUpdate or any other client post-handshake message.
    return size == 0 and 0 or PTLS_ALERT_UNEXPECTED_MESSAGE
  end
  if size > 1024 * 1024 - state.buffered then return PTLS_ALERT_INTERNAL_ERROR end
  if size ~= 0 then
    local record = (@*MpCryptoInput)(C.malloc(#MpCryptoInput + size))
    if record == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
    $record = {size=size}
    C.memcpy(mp_crypto_bytes(record,0),bytes,size)
    if state.tail == nilptr then state.input = record else state.tail.next = record end
    state.tail = record
    state.buffered = state.buffered + size
  end
  state.output = buf
  state.offsets = (@*[0]csize)(offsets)
  defer state.output = nilptr end
  local status = SSL_do_handshake(state.ssl)
  local ssl_error = SSL_get_error(state.ssl,status)
  if status == 1 then return 0 end
  if ssl_error == SSL_ERROR_WANT_READ then
    if state.cnx.zero_rtt_data_accepted ~= 0 and state.cnx.cnx_state < picoquic_state_server_false_start then
      -- The decoder can buffer PSK-authenticated 0-RTT while the server
      -- still waits for Finished. The listener only hands out ready connections.
      state.cnx.cnx_state = picoquic_state_server_false_start
    end
    return PTLS_ERROR_IN_PROGRESS
  end
  return state.alert ~= 0 and (@cint)(state.alert) or PTLS_ALERT_INTERNAL_ERROR
end

local function mp_tls_verify(store:*mp_store,expected:pointer):cint
  local offered = X509_STORE_CTX_get0_rpk(store)
  if offered ~= nilptr and EVP_PKEY_is_a(offered,'ED25519') == 1 and
      (expected == nilptr or EVP_PKEY_eq(offered,(@*evp_t)(expected)) == 1) then
    X509_STORE_CTX_set_error(store,X509_V_OK)
    return 1
  end
  X509_STORE_CTX_set_error(store,X509_V_ERR_APPLICATION_VERIFICATION)
  return 0
end

local function mp_tls_alpn(ssl:*mp_ssl,out:**uint8,length:*uint8,wire:*uint8,size:cuint,arg:pointer):cint
  local state = (@*MpTls)(SSL_get_app_data(ssl))
  local listener = (@*Listener)(arg)
  local pin = pinned(listener.quic)
  local bytes = (@*[0]uint8)(wire)
  local name = pin.alpns
  while name ~= nilptr do
    local offset:csize = 0
    while offset < size do
      local n = bytes[offset]
      offset = offset + 1
      if n == 0 or n > size - offset then return SSL_TLSEXT_ERR_ALERT_FATAL end
      if n == name.size and C.memcmp(&bytes[offset],&name.wire[3],n) == 0 then
        local pending = ensure_pending(state.cnx,listener)
        if pending == nilptr then return SSL_TLSEXT_ERR_ALERT_FATAL end
        pending.alpn = name
        $out = &name.wire[3]
        $length = n
        return SSL_TLSEXT_ERR_OK
      end
      offset = offset + n
    end
    name = (@*Alpn)(name.next)
  end
  return SSL_TLSEXT_ERR_ALERT_FATAL
end

local function mp_tls_listener(listener:*Listener,seed:*uint8,peer:*uint8):boolean
  local private = EVP_PKEY_new_raw_private_key_ex(nilptr,'ED25519',nilptr,seed,32)
  if private == nilptr then return false end
  defer EVP_PKEY_free(private) end
  if peer ~= nilptr then
    listener.ossl_peer = EVP_PKEY_new_raw_public_key_ex(nilptr,'ED25519',nilptr,peer,32)
    if listener.ossl_peer == nilptr then return false end
  end
  listener.ossl = SSL_CTX_new(TLS_method())
  if listener.ossl == nilptr then return false end
  local raw:uint8 = 2
  if SSL_CTX_use_PrivateKey(listener.ossl,private) ~= 1 or
      SSL_CTX_set1_server_cert_type(listener.ossl,&raw,1) ~= 1 or
      SSL_CTX_set1_client_cert_type(listener.ossl,&raw,1) ~= 1 then return false end
  SSL_CTX_set_verify(listener.ossl,SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT,nilptr)
  SSL_CTX_set_cert_verify_callback(listener.ossl,(@pointer)(mp_tls_verify),listener.ossl_peer)
  SSL_CTX_set_alpn_select_cb(listener.ossl,(@pointer)(mp_tls_alpn),listener)
  if not listener.resumable then return SSL_CTX_set_num_tickets(listener.ossl,0) == 1 end
  local realm:[32]uint8
  if RAND_bytes(&realm[0],32) ~= 1 or SSL_CTX_set_session_id_context(listener.ossl,&realm[0],32) ~= 1 or
      SSL_CTX_set_max_early_data(listener.ossl,0xffffffff) ~= 1 or SSL_CTX_set_num_tickets(listener.ossl,2) ~= 1 then return false end
  -- Keep OpenSSL's single-use early-data ticket cache scoped to the listener.
  SSL_CTX_set_session_cache_mode(listener.ossl,SSL_SESS_CACHE_SERVER)
  SSL_CTX_sess_set_cache_size(listener.ossl,1024)
  return true
end

local function with_rpk_offer(tls:*tls_t, buf:*buffer_t, offsets:*csize, epoch:csize, bytes:pointer,len:csize,
    props:*props_t):cint <cexport,codename '__wrap_ptls_handle_message'>
  local context = ptls_get_context(tls)
  if context.verify_certificate == nilptr or context.verify_certificate.cb ~= (@pointer)(verify_raw) or props == nilptr then
    return real_tls(tls,buf,offsets,epoch,bytes,len,props)
  end
  if ptls_is_server(tls) ~= 0 then
    local cnx = (@*cnx_t)($ptls_get_data_ptr(tls))
    local listener = (@*Listener)(picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx)))
    if listener.ossl ~= nilptr then
      local state = find_mp_tls(tls)
      if state == nilptr then state = mp_tls_open(tls,cnx,listener.ossl,props,listener.resumable) end
      if state == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
      return mp_tls_message(state,buf,offsets,bytes,len)
    end
    return with_rpk_selection(tls,buf,offsets,epoch,bytes,len,props)
  end
  local cnx = (@*cnx_t)($ptls_get_data_ptr(tls))
  local conn = cnx ~= nilptr and (@*Connection)(picoquic_get_callback_context(cnx)) or nilptr
  if conn ~= nilptr and conn.resume ~= nilptr and epoch == 0 and len == 0 then
    -- Supply the scoped ticket directly so no SNI or C-string ALPN cache is needed.
    props.client.session_ticket = {base=conn.resume.ticket,len=conn.resume.length}
    props.client.max_early_data_size = conn.early and &cnx.max_early_data_size or nilptr
    if conn.early then restore_early_limits(cnx,conn.resume) end
  end
  local result = client_rpk_message(tls,buf,offsets,epoch,bytes,len,props,conn)
  if conn ~= nilptr and conn.early and not conn.early_decided and epoch == 2 and
      (result == 0 or result == PTLS_ERROR_IN_PROGRESS) then
    local acceptance = props.client.early_data_acceptance
    if acceptance == PTLS_EARLY_DATA_REJECTED or acceptance == PTLS_EARLY_DATA_ACCEPTED then
      -- New flow-control limits are for 1-RTT only. Stop formatting 0-RTT
      -- packets once EncryptedExtensions has passed them to Picoquic.
      picoquic_crypto_context_free(&cnx.crypto_context[picoquic_epoch_0rtt])
      conn.early_decided = true
      if acceptance == PTLS_EARLY_DATA_REJECTED then
        reject_early(conn,cnx)
      elseif not accepted_early_limits(cnx,conn.resume) then
        return PTLS_ALERT_ILLEGAL_PARAMETER
      end
    end
  end
  return result
end

local function address(host: cstring, port: uint16, out: *storage_t): cuint
  local v4 = (@*addr_t)(out)
  if inet_pton(AF_INET,host,&v4.sin_addr) == 1 then
    v4.sin_family = (@uint16)(AF_INET)
    v4.sin_port = htons(port)
    return IROH_MP_V4_SIZE
  end
  local v6 = (@*addr6_t)(out)
  if inet_pton(AF_INET6,host,&v6.sin6_addr) ~= 1 then return 0 end
  v6.sin6_family = (@uint16)(AF_INET6)
  v6.sin6_port = htons(port)
  return IROH_MP_V6_SIZE
end

local function release_path(path: *Path)
  if path.fd >= 0 then close(path.fd) end
  C.free(path.bootstrap)
  C.free(path)
end

local function open_path(peer: *storage_t, size: cuint, source: *storage_t, source_size: cuint): (*Path,uint32)
  local path = (@*Path)(C.calloc(1,#Path))
  if path == nilptr then return nilptr,ENOMEM end
  path.fd = socket((@cint)(peer.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
  local local_size = IROH_MP_STORAGE_SIZE
  if path.fd < 0 or (source ~= nilptr and bind(path.fd,source,source_size) ~= 0) or
      connect(path.fd,peer,size) ~= 0 or getsockname(path.fd,&path.local_addr,&local_size) ~= 0 then
    local error = (@uint32)(errno)
    release_path(path)
    return nilptr,error
  end
  path.peer = (@*[0]storage_t)(peer)[0]
  return path,0
end

local function open_nat_path(peer:*storage_t, size:cuint): (*Path,uint32)
  local route, error = open_path(peer,size,nilptr,0)
  if route == nilptr then return nilptr,error end
  -- Let the OS select the source address for the initial peer. Bind the
  -- socket used by QUIC explicitly so it can receive off-path responses.
  if route.local_addr.ss_family == AF_INET then
    ((@*addr_t)(&route.local_addr)).sin_port = 0
  else
    ((@*addr6_t)(&route.local_addr)).sin6_port = 0
  end
  local fd = socket((@cint)(peer.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
  local bound_size = IROH_MP_STORAGE_SIZE
  if fd < 0 or bind(fd,&route.local_addr,size) ~= 0 or getsockname(fd,&route.local_addr,&bound_size) ~= 0 then
    error = (@uint32)(errno)
    if fd >= 0 then close(fd) end
    release_path(route)
    return nilptr,error
  end
  close(route.fd)
  route.fd = fd
  route.unconnected = true
  return route,0
end

local function find_path(conn: *Connection, id: uint64): *Path
  local path = conn.paths
  while path ~= nilptr and path.id ~= id do path = (@*Path)(path.next) end
  return path
end

local function find_stream(conn: *Connection, id: uint64): *Stream
  local stream = conn.streams
  while stream ~= nilptr and stream.id ~= id do stream = (@*Stream)(stream.next) end
  return stream
end

local function pop_datagram(conn: *Connection)
  local item = conn.datagram_first
  conn.datagram_first = (@*Datagram)(item.next)
  if conn.datagram_first == nilptr then conn.datagram_last = nilptr end
  conn.datagram_count = conn.datagram_count - 1
  C.free(item)
end

local function datagram_bytes(item: *Datagram): *uint8
  return &((@*[0]uint8)(item))[#Datagram]
end

local function receive_datagram(conn: *Connection, bytes: *uint8, size: csize)
  if size > IO_CAPACITY then return end
  local item = (@*Datagram)(C.malloc(#Datagram + size))
  if item == nilptr then return end
  item.next = nilptr
  item.size = size
  if size ~= 0 then C.memcpy(datagram_bytes(item),bytes,size) end
  if conn.datagram_count >= DATAGRAM_QUEUE_LIMIT then pop_datagram(conn) end
  if conn.datagram_last == nilptr then conn.datagram_first = item else conn.datagram_last.next = item end
  conn.datagram_last = item
  conn.datagram_count = conn.datagram_count + 1
end

local function free_discovery(discovery:*AddressDiscovery)
  if discovery == nilptr then return end
  if discovery.quic ~= nilptr then picoquic_free(discovery.quic) end
  C.free(discovery)
end

local function release_discovery(conn:*Connection)
  free_discovery(conn.discovery)
  conn.discovery = nilptr
end

local function free_routed_discovery(config:*RoutedDiscovery)
  if config == nilptr then return end
  free_discovery(config.v4.running)
  free_discovery(config.v6.running)
  C.free(config.host)
  C.free(config)
end

local function release_listener(listener: *Listener)
  listener.refs = listener.refs - 1
  if listener.refs ~= 0 then return end
  free_routed_discovery(listener.discovery)
  if listener.quic ~= nilptr then picoquic_free(listener.quic) end
  if listener.fd >= 0 then close(listener.fd) end
  if listener.ipv4_fd >= 0 then close(listener.ipv4_fd) end
  SSL_CTX_free(listener.ossl)
  EVP_PKEY_free(listener.ossl_peer)
  C.free(listener)
end

local function destroy(conn: *Connection)
  release_discovery(conn)
  free_routed_discovery(conn.routed_discovery)
  if conn.listener ~= nilptr then
    picoquic_set_callback(conn.cnx,nilptr,nilptr)
    picoquic_delete_cnx(conn.cnx)
    release_listener(conn.listener)
  elseif conn.quic ~= nilptr then
    picoquic_free(conn.quic)
  end
  while conn.paths ~= nilptr do
    local path = conn.paths
    conn.paths = (@*Path)(path.next)
    release_path(path)
  end
  while conn.streams ~= nilptr do
    local stream = conn.streams
    conn.streams = (@*Stream)(stream.next)
    C.free(stream.rx)
    C.free(stream)
  end
  while conn.datagram_first ~= nilptr do pop_datagram(conn) end
  free_session(conn.ticket)
  free_session(conn.resume)
  C.free(conn.peer_parameters.bytes)
  C.free(conn.nat_inbox)
  if conn.nat_source ~= nilptr then release_path(conn.nat_source) end
  if conn.nat_route_v4 ~= nilptr then release_path(conn.nat_route_v4) end
  if conn.nat_route_v6 ~= nilptr then release_path(conn.nat_route_v6) end
  C.free(conn)
end

local function remove_connection(conn: *Connection)
  if conn == connections then
    connections = (@*Connection)(conn.next)
  else
    local previous = connections
    while previous.next ~= conn do previous = (@*Connection)(previous.next) end
    previous.next = conn.next
  end
  destroy(conn)
end

local function register_connection(conn: *Connection)
  conn.id = next_connection
  next_connection = next_connection + 1
  conn.next = connections
  connections = conn
end

local function save_session(self: *save_ticket_t, tls: *tls_t, input: iov_t, properties: *ticket_props_t): cint
  local cnx = (@*cnx_t)($ptls_get_data_ptr(tls))
  if cnx == nilptr then return 0 end
  local conn = (@*Connection)(picoquic_get_callback_context(cnx))
  if conn == nilptr or conn.listener ~= nilptr or conn.closed or input.len == 0 or input.len > 65535 then
    return 0
  end
  local selected = pinned(conn.quic).selected
  if selected == nilptr then return 0 end
  local captured = (@*Session)(C.calloc(1,#Session))
  if captured == nilptr then return 0 end
  captured.ticket = (@*uint8)(C.malloc(input.len))
  if captured.ticket == nilptr then
    C.free(captured)
    return 0
  end
  C.memcpy(captured.ticket,input.base,input.len)
  captured.length = input.len
  C.memcpy(&captured.local_key[0],&conn.local_key[0],32)
  C.memcpy(&captured.peer_key[0],&conn.peer_key[0],32)
  C.memcpy(&captured.alpn[0],&selected.wire[3],selected.size)
  captured.alpn_length = selected.size
  local remote = &cnx.remote_parameters
  captured.datagram_limit = remote.max_datagram_frame_size
  captured.max_data = remote.initial_max_data
  captured.stream_bidi_local = remote.initial_max_stream_data_bidi_local
  captured.stream_bidi_remote = remote.initial_max_stream_data_bidi_remote
  captured.stream_uni = remote.initial_max_stream_data_uni
  captured.streams_bidi = remote.initial_max_streams_bidi
  captured.streams_uni = remote.initial_max_streams_uni
  captured.active_connection_id_limit = remote.active_connection_id_limit
  captured.max_packet_size = remote.max_packet_size ~= 0 and remote.max_packet_size or 65527
  free_session(conn.ticket)
  conn.ticket = captured
  return 0
end

local function install_session_capture(conn: *Connection): boolean
  if iroh_mp_take_multipath_session == 0xffffffff then return true end
  local callback = (@*save_ticket_t)(C.calloc(1,#save_ticket_t))
  if callback == nilptr then return false end
  callback.cb = (@pointer)(save_session)
  -- picoquic disposes this callback with the owning TLS context.
  local ctx = (@*context_t)(conn.quic.tls_master_ctx)
  ctx.save_ticket = callback
  return true
end

local function create_stream(conn: *Connection, id: uint64, incoming: boolean): *Stream
  if id > 0xffffffff or conn.stream_count >= STREAM_LIMIT then return nilptr end
  local stream = (@*Stream)(C.calloc(1,#Stream))
  if stream == nilptr then return nilptr end
  stream.id = (@uint32)(id)
  stream.incoming = incoming
  stream.accepted = not incoming
  stream.next = conn.streams
  conn.streams = stream
  conn.stream_count = conn.stream_count + 1
  return stream
end

local function discard_received(conn: *Connection, stream: *Stream)
  conn.received = conn.received - stream.size
  C.free(stream.rx)
  stream.rx = nilptr
  stream.size = 0
end

local function receive_stream(conn: *Connection, stream: *Stream, bytes: *uint8, size: csize): cint
  if size == 0 or stream.rx_stopped or stream.reset then return 0 end
  if size > RX_LIMIT - conn.received then
    conn.buffer_error = true
    return -1
  end
  local expanded = (@*[0]uint8)(C.realloc(stream.rx,stream.size + size))
  if expanded == nilptr then
    conn.buffer_error = true
    return -1
  end
  stream.rx = expanded
  C.memcpy(&stream.rx[stream.size],bytes,size)
  stream.size = stream.size + size
  conn.received = conn.received + size
  return 0
end

local function remember_shared_path(conn: *Connection, id: uint64): *Path
  if id >= 0xffffffff or conn.path_count >= PATH_LIMIT then return nilptr end
  local path = (@*Path)(C.calloc(1,#Path))
  if path == nilptr then return nilptr end
  path.fd = -1
  if picoquic_get_path_addr(conn.cnx,id,1,&path.local_addr) ~= 0 or
      picoquic_get_path_addr(conn.cnx,id,2,&path.peer) ~= 0 then
    release_path(path)
    return nilptr
  end
  path.id = (@uint32)(id)
  path.status = 1
  path.next = conn.paths
  conn.paths = path
  conn.path_count = conn.path_count + 1
  if conn.last_path_id < id then conn.last_path_id = (@uint32)(id) end
  return path
end

-- The QUIC engine sees one path while Bend tries the same handshake on
-- several sockets. Keep that tuple for path zero when a different socket wins.
local function bootstrap_tuple(path:*Path, source:*storage_t, peer:*storage_t):boolean
  return path.bootstrap ~= nilptr and (source.ss_family == 0 or
    picoquic_compare_addr(source,&path.bootstrap.local_addr) == 0) and
    picoquic_compare_addr(peer,&path.bootstrap.peer) == 0
end

local function update_path(conn: *Connection, id: uint64, kind: cint)
  local path = find_path(conn,id)
  if path == nilptr and conn.listener ~= nilptr and kind == picoquic_callback_path_available then
    path = remember_shared_path(conn,id)
  end
  if path == nilptr then return end
  if kind == picoquic_callback_path_available then
    if conn.listener ~= nilptr then
      path.status = 1
      return
    end
    local local_addr: storage_t, peer: storage_t
    if picoquic_get_path_addr(conn.cnx,id,1,&local_addr) ~= 0 or
        picoquic_get_path_addr(conn.cnx,id,2,&peer) ~= 0 then return end
    while path ~= nilptr do
      if path.id == id then
        local same_local = picoquic_compare_addr(&path.local_addr,&local_addr) == 0
        if bootstrap_tuple(path,&local_addr,&peer) then
          path.status = 1
        elseif same_local and path.unconnected then
          path.peer = peer
          path.status = 1
        else
          path.status = same_local and picoquic_compare_addr(&path.peer,&peer) == 0 and 1 or 3
        end
      end
      path = (@*Path)(path.next)
    end
    return
  end
  while path ~= nilptr do
    if path.id == id and path.status ~= 3 then
      path.status = kind == picoquic_callback_path_deleted and 3 or 2
    end
    path = (@*Path)(path.next)
  end
end

local function authenticated_peer_key(conn:*Connection):*evp_t
  if conn.listener == nilptr or conn.listener.ossl == nilptr then
    return pinned(conn.quic).backend.expected_pubkey
  end
  local tls = (@*client_tls_t)(conn.cnx.tls_ctx)
  if tls == nilptr then return nilptr end
  local state = find_mp_tls(tls.tls)
  if state == nilptr or SSL_is_init_finished(state.ssl) == 0 then return nilptr end
  return SSL_get0_peer_rpk(state.ssl)
end

local function on_event(cnx: *cnx_t, id: uint64, bytes: *uint8, size: csize, kind: cint,
    user: pointer, stream_user: pointer): cint
  local conn = (@*Connection)(user)
  if kind == picoquic_callback_request_alpn_list then
    local tls = (@*client_tls_t)(bytes)
    local pin = pinned(conn.quic)
    local name = pin.alpns
    while name ~= nilptr do
      if tls.alpn_count >= tls.alpn_vec_size then return -1 end
      tls.alpn_vec[tls.alpn_count] = {base=&name.wire[3],len=name.size}
      tls.alpn_count = tls.alpn_count + 1
      name = (@*Alpn)(name.next)
    end
  elseif kind == picoquic_callback_ready then
    if conn.listener == nilptr then
      local pin = pinned(conn.quic)
      conn.selected_alpn = pin.selected
      if conn.nat_inbox == nilptr and pin.sends_nat_offer and cnx.is_multipath_enabled ~= 0 and
          peer_offers_nat({base=pin.peer_parameters.bytes,len=pin.peer_parameters.size}) then
        conn.nat_inbox = (@*NatInbox)(C.calloc(1,#NatInbox))
        if conn.nat_inbox == nilptr then
          conn.closed = true
          return -1
        end
      end
    end
    local peer = authenticated_peer_key(conn)
    if conn.selected_alpn == nilptr or peer == nilptr or EVP_PKEY_is_a(peer,'ED25519') ~= 1 then
      conn.closed = true
      return -1
    end
    conn.ready = true
  elseif kind == picoquic_callback_datagram then
    receive_datagram(conn,bytes,size)
  elseif conn.nat_inbox ~= nilptr and bytes ~= nilptr and
      (kind == picoquic_callback_datagram_acked or kind == picoquic_callback_datagram_lost or
       kind == picoquic_callback_datagram_spurious) then
    local advertising = &conn.nat_inbox.advertising
    -- This pointer belongs to the stored packet, so application datagrams
    -- cannot match on identical payload bytes or overlapping timestamps.
    if advertising.tracked_payload == bytes and advertising.tracked_at == id and
        advertising.frame.size == size + 2 then
      advertising.tracked_payload = nilptr
      advertising.delivered = kind ~= picoquic_callback_datagram_lost
    end
  elseif kind == picoquic_callback_path_available or kind == picoquic_callback_path_suspended or
      kind == picoquic_callback_path_deleted then
    update_path(conn,id,kind)
  elseif kind == picoquic_callback_stream_fin or kind == picoquic_callback_stream_data or
      kind == picoquic_callback_stream_reset or kind == picoquic_callback_stop_sending then
    local stream = find_stream(conn,id)
    if stream == nilptr then
      local peer_side: uint64 = conn.listener == nilptr and 1 or 0
      if stream_user == &discarded_stream or (id & 1) ~= peer_side then return 0 end
      stream = create_stream(conn,id,true)
      if stream == nilptr then
        conn.buffer_error = true
        return -1
      end
    end
    if kind == picoquic_callback_stream_reset or kind == picoquic_callback_stop_sending then
      local native = picoquic_find_stream(cnx,id)
      if native == nilptr then return -1 end
      if kind == picoquic_callback_stream_reset then
        stream.reset = true
        stream.reset_code = native.remote_error
        discard_received(conn,stream)
      else
        stream.stop = true
        stream.stop_code = native.remote_stop_error
        -- Picoquic leaves the RESET_STREAM response to its application.
        return picoquic_reset_stream(cnx,id,stream.stop_code)
      end
    else
      if kind == picoquic_callback_stream_fin then stream.fin = true end
      return receive_stream(conn,stream,bytes,size)
    end
  elseif kind == picoquic_callback_close or kind == picoquic_callback_application_close or
      kind == picoquic_callback_stateless_reset then
    conn.closed = true
  end
  return 0
end

local function server_event(cnx: *cnx_t, id: uint64, bytes: *uint8, size: csize, kind: cint,
    user: pointer, stream_user: pointer): cint
  local listener = (@*Listener)(picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx)))
  if kind == picoquic_callback_close or kind == picoquic_callback_application_close or
      kind == picoquic_callback_stateless_reset then
    discard_handshake(cnx,listener)
    return 0
  end
  local early = listener.ossl ~= nilptr and cnx.zero_rtt_data_accepted ~= 0 and
    (kind == picoquic_callback_stream_data or kind == picoquic_callback_stream_fin or kind == picoquic_callback_datagram)
  if kind ~= picoquic_callback_ready and kind ~= picoquic_callback_almost_ready and not early then return 0 end
  if listener.stopped or next_connection == 0 or listener.refs > LISTENER_LIMIT then return -1 end
  if user == nilptr or user == listener then return -1 end
  local conn = (@*Connection)(C.calloc(1,#Connection))
  if conn == nilptr then return -1 end
  conn.quic = listener.quic
  conn.cnx = cnx
  conn.listener = listener
  local pending = (@*PendingHandshake)(user)
  conn.selected_alpn = pending.alpn
  if pending.nat_enabled then
    conn.nat_inbox = (@*NatInbox)(C.calloc(1,#NatInbox))
    if conn.nat_inbox == nilptr then
      C.free(conn)
      return -1
    end
  end
  if remember_shared_path(conn,0) == nilptr then
    C.free(conn.nat_inbox)
    C.free(conn)
    return -1
  end
  listener.refs = listener.refs + 1
  register_connection(conn)
  conn.peer_parameters = pending.parameters
  picoquic_set_callback(cnx,(@pointer)(on_event),conn)
  C.free(pending.extensions)
  C.free(pending)
  return on_event(cnx,id,bytes,size,kind,conn,stream_user)
end

local function nat_probe_socket(conn:*Connection): *Path
  if conn.nat_source ~= nilptr then return conn.nat_source end
  return find_path(conn,0)
end

local function nat_local_address(conn:*Connection): *storage_t
  if conn.listener ~= nilptr then return &conn.listener.local_addr end
  local path = nat_probe_socket(conn)
  if path == nilptr or not path.unconnected then return nilptr end
  return &path.local_addr
end

local function has_nat_routes(conn:*Connection): boolean
  return conn.nat_route_v4 ~= nilptr or conn.nat_route_v6 ~= nilptr
end

local function routed_nat_socket(conn:*Connection, family:uint16): *Path
  if family == AF_INET then return conn.nat_route_v4 end
  if family == AF_INET6 then return conn.nat_route_v6 end
  return nilptr
end

local function nat_socket_for_peer(conn:*Connection, family:uint16): *Path
  if has_nat_routes(conn) then return routed_nat_socket(conn,family) end
  return nat_probe_socket(conn)
end

local function matches_nat_destination(conn:*Connection, destination:*storage_t, family:uint16):boolean
  local listener = conn.listener
  if listener ~= nilptr and listener.ipv4_fd >= 0 then
    if destination.ss_family ~= family then return false end
    if family == AF_INET then
      return ((@*addr_t)(destination)).sin_port == ((@*addr_t)(&listener.ipv4_addr)).sin_port
    end
    return family == AF_INET6 and
      ((@*addr6_t)(destination)).sin6_port == ((@*addr6_t)(&listener.local_addr)).sin6_port
  end
  local local_addr = nat_local_address(conn)
  if has_nat_routes(conn) then
    local udp = routed_nat_socket(conn,family)
    local_addr = udp ~= nilptr and &udp.local_addr or nilptr
  end
  return local_addr ~= nilptr and picoquic_compare_addr(destination,local_addr) == 0
end

local function match_nat_response(conn:*Connection, source:pointer, destination:pointer, frame:*uint8, now:uint64): csize
  if source == nilptr or destination == nilptr then return 0 end
  if not matches_nat_destination(conn,(@*storage_t)(destination),((@*storage_t)(source)).ss_family) then return 0 end
  local bytes = (@*[0]uint8)(frame)
  for i = 0,<NAT_PROBE_CAPACITY do
    local probe = &conn.nat_inbox.probes[i]
    if probe.expires > now and picoquic_compare_addr(source,&probe.peer) == 0 and
        C.memcmp(&bytes[1],&probe.challenge[1],CHALLENGE_SIZE - 1) == 0 then
      return i + 1
    end
  end
  return 0
end

local function nat_body_size(kind:uint64, server:boolean): isize
  if server then
    if kind == REACH_OUT_V4 then return 6 end
    if kind == REACH_OUT_V6 then return 18 end
  else
    if kind == ADD_ADDRESS_V4 then return 6 end
    if kind == ADD_ADDRESS_V6 then return 18 end
    if kind == REMOVE_ADDRESS then return 0 end
  end
  return -1
end

local function decode_frames(cnx:*cnx_t, path:*path_t, bytes:*uint8, size:csize, node:*receive_node_t,
    epoch:cint, src:pointer, dst:pointer, pn:uint64, unallocated:cint, cid:*cid_t, now:uint64):cint
    <cexport,codename '__wrap_picoquic_decode_frames'>
  if epoch ~= picoquic_epoch_1rtt or (@pointer)(picoquic_get_callback_function(cnx)) ~= (@pointer)(on_event) then
    return real_decode_frames(cnx,path,bytes,size,node,epoch,src,dst,pn,unallocated,cid,now)
  end
  local conn = (@*Connection)(picoquic_get_callback_context(cnx))
  if conn == nilptr or not conn.ready or conn.nat_inbox == nilptr then
    return real_decode_frames(cnx,path,bytes,size,node,epoch,src,dst,pn,unallocated,cid,now)
  end
  local inbox = conn.nat_inbox
  local input = (@*[0]uint8)(bytes)
  local patch: *[0]uint8
  defer C.free(patch) end
  local received: [NAT_PROBE_CAPACITY]boolean
  local has_response: boolean
  local count: csize = 0
  local at: csize = 0
  while at < size do
    local remaining = size - at
    local kind: uint64
    local tag_size = picoquic_varint_decode(&input[at],remaining,&kind)
    local body_size = nat_body_size(kind,conn.listener ~= nilptr)
    if body_size >= 0 then
      local sequence: uint64
      if tag_size ~= 4 then return picoquic_connection_error(cnx,PICOQUIC_TRANSPORT_FRAME_FORMAT_ERROR,kind) end
      local sequence_size = picoquic_varint_decode(&input[at + tag_size],remaining - tag_size,&sequence)
      local frame_size = tag_size + sequence_size + (@csize)(body_size)
      if sequence_size == 0 or frame_size > remaining then
        return picoquic_connection_error(cnx,PICOQUIC_TRANSPORT_FRAME_FORMAT_ERROR,kind)
      end
      if inbox.count + count == NAT_INBOX_CAPACITY then
        return picoquic_connection_error(cnx,PICOQUIC_TRANSPORT_INTERNAL_ERROR,kind)
      end
      if patch == nilptr then
        patch = (@*[0]uint8)(C.malloc(size))
        if patch == nilptr then return picoquic_connection_error(cnx,PICOQUIC_TRANSPORT_INTERNAL_ERROR,kind) end
        C.memcpy(patch,bytes,size)
      end
      local item = &inbox.frames[(inbox.first + inbox.count + count) % NAT_INBOX_CAPACITY]
      item.size = frame_size
      C.memcpy(&item.bytes[0],&input[at],frame_size)
      count = count + 1
      -- NAT address and reach-out frames are ack-eliciting and non-probing, like PING.
      -- Keep all vanilla frame offsets and the payload length intact.
      C.memset(&patch[at],0,frame_size)
      patch[at] = 1
      at = at + frame_size
    else
      local consumed: csize
      local pure_ack: cint
      if picoquic_skip_frame(&input[at],remaining,&consumed,&pure_ack) ~= 0 or consumed == 0 or consumed > remaining then
        break
      end
      if input[at] == picoquic_frame_type_path_response and consumed == CHALLENGE_SIZE then
        local match = match_nat_response(conn,src,dst,&input[at],now)
        if match ~= 0 then
          received[match - 1] = true
          has_response = true
        end
      end
      at = at + consumed
    end
  end
  -- The temporary packet cannot back an out-of-order data node.
  local result: cint
  if patch ~= nilptr then
    result = real_decode_frames(cnx,path,&patch[0],size,nilptr,epoch,src,dst,pn,unallocated,cid,now)
  else
    result = real_decode_frames(cnx,path,bytes,size,node,epoch,src,dst,pn,unallocated,cid,now)
  end
  if result ~= 0 then return result end
  inbox.count = inbox.count + count
  if has_response then
    for i = 0,<NAT_PROBE_CAPACITY do
      if received[i] then inbox.probes[i].answered = true end
    end
  end
  return result
end

local function handle_id(e: Env, handle: Term, tag: uint32): uint64
  if term_aux(handle) ~= tag then return 0 end
  if term_tag(handle) == TAG_PAK then return term_loc(handle) end
  if term_tag(handle) == TAG_CTR then return e.mem[term_peek(e.mem,handle)] end
  return 0
end

local function find_connection(e: Env, handle: Term): *Connection
  local id = handle_id(e,handle,iroh_mp_MultipathConnection)
  local conn = connections
  while conn ~= nilptr and conn.id ~= id do conn = (@*Connection)(conn.next) end
  return conn
end

local function find_listener(e: Env, handle: Term): *Listener
  local id = handle_id(e,handle,iroh_mp_MultipathListener)
  local listener = listeners
  while listener ~= nilptr and listener.id ~= id do listener = (@*Listener)(listener.next) end
  return listener
end

local function closed_error(e: Env, conn: *Connection): Term
  if conn == nilptr then return io_fail(e,EBADF,'multipath connection closed') end
  if conn.buffer_error then return io_fail(e,ENOBUFS,'multipath stream receive buffer exhausted') end
  if picoquic_get_local_error(conn.cnx) == IROH_MP_PIN_MISMATCH then
    return io_fail(e,EACCES,'QUIC peer endpoint key mismatch')
  end
  if conn.detached and conn.ready and conn.cnx.is_multipath_enabled == 0 then
    return io_fail(e,ENOTSUP,'peer did not negotiate QUIC multipath')
  end
  return io_fail(e,ECONNRESET,'multipath connection closed')
end

local function take_session_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if conn.listener ~= nilptr or not conn.ready or conn.ticket == nilptr then
    return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_None,0)))
  end
  if active_sessions == SESSION_LIMIT or next_session == 0 then
    return io_tup(e,args[0],io_fail(e,ENOBUFS,'multipath session handles exhausted'))
  end
  local ticket = conn.ticket
  conn.ticket = nilptr
  ticket.id = next_session
  next_session = next_session + 1
  active_sessions = active_sessions + 1
  ticket.next = sessions
  sessions = ticket
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,term_pak(iroh_mp_MultipathSession,ticket.id))))
end

local function remove_session(id: uint64): *Session
  local ticket = sessions
  local previous: *Session
  while ticket ~= nilptr and ticket.id ~= id do
    previous = ticket
    ticket = (@*Session)(ticket.next)
  end
  if ticket ~= nilptr then
    if previous == nilptr then sessions = (@*Session)(ticket.next)
    else previous.next = ticket.next end
    active_sessions = active_sessions - 1
    ticket.next = nilptr
  end
  return ticket
end

local function drop_session_run(e: Env, args: *[0]Term, work: *IoWork): Term
  free_session(remove_session(handle_id(e,args[0],iroh_mp_MultipathSession)))
  return term_pak(iroh_mp_Unit,0)
end

local function resumption_status_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready then return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_None,0))) end
  local resumed: uint32 = picoquic_tls_is_psk_handshake(conn.cnx) ~= 0 and 1 or 0
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,resumed)))
end

local function early_status_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready then return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_None,0))) end
  local accepted: uint32 = (conn.early or (conn.listener ~= nilptr and conn.listener.ossl ~= nilptr)) and
    conn.cnx.zero_rtt_data_accepted ~= 0 and 1 or 0
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,accepted)))
end

local function start_client(e: Env, args: *[0]Term, mode: uint32, session: *Session, early: boolean, advertise_nat: boolean, detached: boolean): Term
  defer free_session(session) end
  local host_size: uint64
  local host = io_cstr(e,args[0],&host_size)
  defer C.free(host) end
  local alpns = read_alpns(e,args[4],mode)
  defer free_alpns(alpns) end
  local seed: [32]uint8
  local key: [32]uint8
  local seed_size = bytes_from_list(e,args[2],&seed[0],32)
  local key_size = bytes_from_list(e,args[3],&key[0],32)
  if seed_size ~= 32 or key_size ~= 32 or args[1] == 0 or args[1] > 65535 or alpns == nilptr or
      io_nul(host,host_size) then
    return io_fail(e,EINVAL,'invalid numeric address, Ed25519 key, or ALPN')
  end
  local peer: storage_t
  local peer_size = address(host,(@uint16)(args[1]),&peer)
  if peer_size == 0 then return io_fail(e,EINVAL,'invalid numeric peer address') end
  if next_connection == 0 then return io_fail(e,ENOMEM,'multipath handles exhausted') end
  local conn = (@*Connection)(C.calloc(1,#Connection))
  if conn == nilptr then return io_fail(e,ENOMEM,nilptr) end
  local initial: *Path, error: uint32
  -- Routed endpoints bind separate IPv4 and IPv6 sockets for NAT probes.
  -- Explicit fixed-socket NAT dials also receive off-path probes on path zero.
  if advertise_nat and not detached then initial,error = open_nat_path(&peer,peer_size)
  else initial,error = open_path(&peer,peer_size,nilptr,0) end
  if initial == nilptr then
    destroy(conn)
    return io_fail(e,error,nilptr)
  end
  conn.paths = initial
  conn.path_count = 1
  initial.status = 1
  local save_identity = iroh_mp_take_multipath_session ~= 0xffffffff or session ~= nilptr
  if save_identity then C.memcpy(&conn.peer_key[0],&key[0],32) end
  if session ~= nilptr and (C.memcmp(&session.peer_key[0],&key[0],32) ~= 0 or
      session.alpn_length ~= alpns.size or C.memcmp(&session.alpn[0],&alpns.wire[3],alpns.size) ~= 0) then
    destroy(conn)
    return io_fail(e,EACCES,'session ticket belongs to a different peer or ALPN')
  end
  local now = picoquic_current_time()
  conn.quic = picoquic_create(1,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,now,nilptr,nilptr,nilptr,0)
  local public = save_identity and &conn.local_key[0] or nilptr
  if conn.quic == nilptr or not install_identity(conn.quic,&seed[0],&key[0],&alpns,public) or
      not install_session_capture(conn) or
      picoquic_set_default_tp_value(conn.quic,picoquic_tp_max_datagram_frame_size,IO_CAPACITY) ~= 0 then
    destroy(conn)
    return io_fail(e,EIO,'could not configure pinned QUIC raw public keys')
  end
  if session ~= nilptr and C.memcmp(&session.local_key[0],&conn.local_key[0],32) ~= 0 then
    destroy(conn)
    return io_fail(e,EACCES,'session ticket belongs to a different local key')
  end
  if advertise_nat then
    local pin = pinned(conn.quic)
    if bytes_from_list(e,args[5],&pin.nat_offer[0],NAT_PARAMETER_SIZE) ~= NAT_PARAMETER_SIZE then
      destroy(conn)
      return io_fail(e,EINVAL,'invalid encoded NAT traversal parameter')
    end
    pin.sends_nat_offer = true
  end
  conn.resume = session
  conn.early = early
  session = nilptr
  picoquic_set_default_multipath_option(conn.quic,1)
  conn.cnx = picoquic_create_client_cnx(conn.quic,&peer,now,1,nilptr,nilptr,(@pointer)(on_event),conn)
  if conn.cnx == nilptr then
    destroy(conn)
    return io_fail(e,EIO,'could not start the QUIC handshake')
  end
  picoquic_enable_path_callbacks(conn.cnx,1)
  register_connection(conn)
  local handle = term_pak(iroh_mp_MultipathConnection,conn.id)
  if detached then
    local fd = initial.fd
    initial.fd = -1
    conn.detached = true
    return io_done(e,io_tup(e,handle,io_hand((@uint64)(fd))))
  end
  return io_done(e,handle)
end

local function start_multipath_route_handshake_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,1,nilptr,false,false,true)
end

local function start_multipath_nat_route_handshake_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,1,nilptr,false,true,true)
end

local function start_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,0,nilptr,false,false,false)
end

local function start_nat_offer_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,0,nilptr,false,true,false)
end

local function start_nat_offer_bytes_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,1,nilptr,false,true,false)
end

local function start_bytes_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,1,nilptr,false,false,false)
end

local function start_alpns_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,2,nilptr,false,false,false)
end

local function start_resume(e: Env, args: *[0]Term, early: boolean): Term
  local session = remove_session(handle_id(e,args[5],iroh_mp_MultipathSession))
  if session == nilptr then return io_fail(e,EBADF,'multipath session is no longer available') end
  return start_client(e,args,1,session,early,false,false)
end

local function start_resume_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_resume(e,args,false)
end

local function start_early_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_resume(e,args,true)
end

local function remote_id_run(e:Env, args:*[0]Term, work:*IoWork):Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready then return io_tup(e,args[0],io_fail(e,EAGAIN,'QUIC handshake is incomplete')) end
  local bytes:[32]uint8
  local length:csize = #bytes
  local key = authenticated_peer_key(conn)
  if key == nilptr or EVP_PKEY_get_raw_public_key(key,&bytes[0],&length) ~= 1 or length ~= #bytes then
    return io_tup(e,args[0],io_fail(e,EIO,'authenticated QUIC peer identity unavailable'))
  end
  return io_tup(e,args[0],io_done(e,io_list(e,(@cstring)(&bytes[0]),length)))
end

local function negotiated_alpn_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local name = conn.selected_alpn
  if not conn.ready or name == nilptr then
    return io_tup(e,args[0],io_fail(e,EAGAIN,'QUIC handshake is incomplete'))
  end
  return io_tup(e,args[0],io_done(e,io_list(e,(@cstring)(&name.wire[3]),name.size)))
end

local function peer_parameters_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready then return io_tup(e,args[0],io_fail(e,EAGAIN,'QUIC handshake is incomplete')) end
  local source = conn.peer_parameters
  if conn.listener == nilptr then source = pinned(conn.quic).peer_parameters end
  local parameters = io_list(e,(@cstring)(source.bytes),source.size)
  return io_tup(e,args[0],io_done(e,parameters))
end

local function socket_unreachable(code: cint): boolean
  return code == ECONNREFUSED or code == ENETUNREACH or code == EHOSTUNREACH
end

local function address_size(addr: *storage_t): cuint
  return addr.ss_family == AF_INET and IROH_MP_V4_SIZE or IROH_MP_V6_SIZE
end

local function listener_socket(listener:*Listener, source:*storage_t, peer:*storage_t):cint
  if listener.ipv4_fd >= 0 then
    if source.ss_family == AF_INET or (source.ss_family == 0 and peer.ss_family == AF_INET) then
      return listener.ipv4_fd
    end
  elseif source.ss_family ~= 0 and picoquic_compare_addr(&listener.local_addr,source) ~= 0 then
    return -1
  end
  return listener.fd
end

local function send_listener(listener:*Listener, peer:*storage_t, source:*storage_t, iface:cint,
    bytes:*uint8, size:csize):isize
  local fd = listener_socket(listener,source,peer)
  if fd < 0 then
    -- A packet scheduled on a retired local path should be retransmitted.
    return (@isize)(size)
  end
  if listener.ipv4_fd < 0 or source.ss_family == 0 then
    return sendto(fd,bytes,size,0,peer,address_size(peer))
  end
  local code:cint
  local sent = picoquic_sendmsg(fd,peer,source,iface,(@cstring)(bytes),(@cint)(size),0,&code)
  if sent < 0 then errno = code end
  return (@isize)(sent)
end

local function local_path_error(conn:*Connection, code:cint):boolean
  return conn.ready and conn.cnx.is_multipath_enabled ~= 0 and conn.cnx.nb_paths > 1 and
    (code == EPERM or code == EACCES or code == EADDRNOTAVAIL or code == ENETDOWN)
end

local function flush_output(conn: *Connection): uint32
  if conn.output_size == 0 then return 0 end
  local path = conn.output_path
  if path ~= nilptr and path.status == 3 then
    conn.output_size = 0
    return 0
  end
  local sent: isize
  if path == nilptr or path.fd < 0 then
    local peer = &conn.output_peer
    sent = send_listener(conn.listener,peer,&conn.output_source,conn.output_iface,&conn.output[0],conn.output_size)
  elseif path.unconnected then
    local peer = &conn.output_peer
    sent = sendto(path.fd,&conn.output[0],conn.output_size,0,peer,address_size(peer))
  else
    sent = send(path.fd,&conn.output[0],conn.output_size,0)
  end
  -- The frame is already queued in Picoquic for loss detection. Clearing
  -- the staged packet lets QUIC retransmit its stream bytes on another path.
  if sent == (@isize)(conn.output_size) or
      (sent < 0 and (socket_unreachable(errno) or local_path_error(conn,errno))) then
    conn.output_size = 0
    return 0
  end
  if sent < 0 and (errno == EAGAIN or errno == EINTR) then return 0 end
  return sent < 0 and (@uint32)(errno) or EIO
end

local function route_packet(conn: *Connection, src: *storage_t, dst: *storage_t): *Path
  local path = conn.paths
  local candidate: *Path
  while path ~= nilptr do
    if path.status ~= 3 and bootstrap_tuple(path,src,dst) then return path end
    if path.status ~= 3 and (src.ss_family == 0 and path.id == 0 or
        picoquic_compare_addr(&path.local_addr,src) == 0) then
      if picoquic_compare_addr(&path.peer,dst) == 0 then return path end
      if path.unconnected then candidate = path end
    end
    path = (@*Path)(path.next)
  end
  return candidate
end

local function prepare_server_early_packet(cnx:*cnx_t,now:uint64,out:*uint8,cap:csize,length:*csize,
    peer:*storage_t,source:*storage_t,iface:*cint):cint
  if cnx.zero_rtt_data_accepted ~= 0 and cnx.cnx_state == picoquic_state_server_false_start and
      (cnx.tls_stream[0].send_queue ~= nilptr or cnx.tls_stream[2].send_queue ~= nilptr) then
    -- False start permits receiving coalesced 0-RTT. Picoquic's false-start
    -- sender skips new Initial CRYPTO, so send the handshake flight first.
    cnx.cnx_state = picoquic_state_server_handshake
    local status = picoquic_prepare_packet(cnx,now,out,cap,length,peer,source,iface)
    if cnx.cnx_state == picoquic_state_server_handshake then
      cnx.cnx_state = picoquic_state_server_false_start
    end
    return status
  end
  return picoquic_prepare_packet(cnx,now,out,cap,length,peer,source,iface)
end

local function write_packet(conn: *Connection, now: uint64): uint32
  local error = flush_output(conn)
  if error ~= 0 or conn.output_size ~= 0 then return error end
  local size: csize
  local from: storage_t, to: storage_t
  local iface: cint
  if prepare_server_early_packet(conn.cnx,now,&conn.output[0],IO_CAPACITY,&size,&to,&from,&iface) ~= 0 then
    return EIO
  end
  if size == 0 then return 0 end
  local path = route_packet(conn,&from,&to)
  if path == nilptr and conn.listener == nilptr then return 0 end
  conn.output_path = path
  if path ~= nilptr and bootstrap_tuple(path,&from,&to) then
    conn.output_peer = path.peer
  else
    conn.output_peer = to
  end
  conn.output_source = from
  conn.output_iface = iface
  conn.output_size = size
  return flush_output(conn)
end

local function numeric_argument(e: Env, item: Term, port: Term, out: *storage_t): cuint
  if port > 65535 then return 0 end
  local size: uint64
  local host = io_cstr(e,item,&size)
  defer C.free(host) end
  if io_nul(host,size) then return 0 end
  return address(host,(@uint16)(port),out)
end

local function open_multipath_handshake_socket_run(e:Env, args:*[0]Term, work:*IoWork):Term
  local peer:storage_t
  local size = numeric_argument(e,args[0],args[1],&peer)
  if size == 0 or args[1] == 0 then return io_fail(e,EINVAL,'invalid numeric peer address') end
  local path,error = open_path(&peer,size,nilptr,0)
  if path == nilptr then return io_fail(e,error,nilptr) end
  local fd = path.fd
  path.fd = -1
  release_path(path)
  return io_done(e,io_hand((@uint64)(fd)))
end

local function handshake_failed(conn:*Connection):boolean
  local state = conn.cnx.cnx_state
  return conn.closed or state == picoquic_state_handshake_failure or
    state == picoquic_state_handshake_failure_resend or state >= picoquic_state_disconnecting
end

local function prepare_handshake(conn:*Connection, bytes:*uint8, length:*csize):cint
  local source:storage_t, peer:storage_t
  local iface:cint
  return picoquic_prepare_packet(conn.cnx,picoquic_current_time(),bytes,IO_CAPACITY,length,&peer,&source,&iface)
end

-- Send a pending TLS alert or CONNECTION_CLOSE on the actual candidate socket.
local function send_handshake_close(conn:*Connection, fd:cint, bytes:*uint8)
  local length:csize
  if prepare_handshake(conn,bytes,&length) == 0 and length > 0 then send(fd,bytes,length,0) end
end

local function handshake_input(e:Env, conn:*Connection, fd:cint):Term
  if conn == nilptr or not conn.detached then return io_fail(e,EBADF,'no pending multipath handshake') end
  if handshake_failed(conn) then return closed_error(e,conn) end
  local bytes:[65536]uint8
  local n = recv(fd,&bytes[0],#bytes,0)
  if n < 0 and errno ~= EAGAIN and errno ~= EINTR then return io_fail(e,(@uint32)(errno),nilptr) end
  if n <= 0 then return io_done(e,0) end
  local count = conn.cnx.nb_packets_received
  picoquic_incoming_packet(conn.quic,&bytes[0],(@csize)(n),&conn.paths.peer,&conn.paths.local_addr,0,0,picoquic_current_time())
  if handshake_failed(conn) then
    send_handshake_close(conn,fd,&bytes[0])
    return closed_error(e,conn)
  end
  if not conn.ready or count == conn.cnx.nb_packets_received then return io_done(e,0) end
  if conn.cnx.is_multipath_enabled == 0 then
    if picoquic_close(conn.cnx,0) == 0 then send_handshake_close(conn,fd,&bytes[0]) end
    return closed_error(e,conn)
  end
  return io_done(e,1)
end

local function read_multipath_handshake_socket_run(e:Env, args:*[0]Term, work:*IoWork):Term
  local result = handshake_input(e,find_connection(e,args[0]),(@cint)(io_hand_v(args[1])))
  return io_tup(e,args[0],io_tup(e,args[1],result))
end

local function multipath_handshake_output_run(e:Env, args:*[0]Term, work:*IoWork):Term
  local conn = find_connection(e,args[0])
  local result:Term
  if conn == nilptr or not conn.detached then
    result = io_fail(e,EBADF,'no pending multipath handshake')
  elseif handshake_failed(conn) then
    result = closed_error(e,conn)
  else
    local bytes:[IO_CAPACITY]uint8
    local size:csize
    if prepare_handshake(conn,&bytes[0],&size) ~= 0 then
      result = closed_error(e,conn)
    else
      result = io_done(e,io_list(e,(@cstring)(&bytes[0]),size))
    end
  end
  return io_tup(e,args[0],result)
end

local function adopt_handshake(e:Env, conn:*Connection, fd:cint):Term
  defer if fd >= 0 then close(fd) end end
  if conn == nilptr or not conn.detached or not conn.ready or handshake_failed(conn) then
    return io_fail(e,EBADF,'no authenticated multipath handshake')
  end
  local path = conn.paths
  local actual:storage_t, peer:storage_t
  local size = IROH_MP_STORAGE_SIZE
  local peer_size = IROH_MP_STORAGE_SIZE
  if getsockname(fd,&actual,&size) ~= 0 or getpeername(fd,&peer,&peer_size) ~= 0 then
    return io_fail(e,(@uint32)(errno),nilptr)
  end
  if picoquic_compare_addr(&actual,&path.local_addr) ~= 0 or picoquic_compare_addr(&peer,&path.peer) ~= 0 then
    path.bootstrap = (@*BootstrapTuple)(C.malloc(#BootstrapTuple))
    if path.bootstrap == nilptr then return io_fail(e,ENOMEM,nilptr) end
    path.bootstrap.local_addr = path.local_addr
    path.bootstrap.peer = path.peer
  end
  path.peer = peer
  path.local_addr = actual
  path.fd = fd
  fd = -1
  conn.detached = false
  local error = write_packet(conn,picoquic_current_time())
  if error ~= 0 then return io_fail(e,error,'QUIC packet I/O failed') end
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function adopt_multipath_handshake_socket_run(e:Env, args:*[0]Term, work:*IoWork):Term
  local result = adopt_handshake(e,find_connection(e,args[0]),(@cint)(io_hand_v(args[1])))
  return io_tup(e,args[0],result)
end

local function close_retired_sockets(conn: *Connection)
  local path = conn.paths
  local previous: *Path
  while path ~= nilptr do
    local next = (@*Path)(path.next)
    if path.status == 3 then
      if conn.output_path == path then
        conn.output_path = nilptr
        conn.output_size = 0
      end
      if previous == nilptr then conn.paths = next else previous.next = next end
      release_path(path)
      conn.path_count = conn.path_count - 1
    else
      previous = path
    end
    path = next
  end
end

local function same_probe_socket(path:*Path, probe:*Path): boolean
  return probe ~= nilptr and (path == probe or
    picoquic_compare_addr(&path.local_addr,&probe.local_addr) == 0)
end

local function path_discovery(conn:*Connection, path:*Path): *AddressDiscovery
  if same_probe_socket(path,conn.nat_source) then return conn.discovery end
  local config = conn.routed_discovery
  if config ~= nilptr then
    if same_probe_socket(path,conn.nat_route_v4) then return config.v4.running end
    if same_probe_socket(path,conn.nat_route_v6) then return config.v6.running end
  end
  return nilptr
end

local function read_from_path(conn: *Connection, path: *Path, bytes: *uint8, capacity: csize, now: uint64): uint32
  if path.status == 3 or path.fd < 0 then return 0 end
  local size: isize
  local source: storage_t
  local name = &path.peer
  if path.unconnected then
    local length = IROH_MP_STORAGE_SIZE
    size = recvfrom(path.fd,bytes,capacity,0,&source,&length)
    name = &source
  else
    size = recv(path.fd,bytes,capacity,0)
  end
  if size > 0 then
    local quic = conn.quic
    local destination = &path.local_addr
    local discovery = path_discovery(conn,path)
    if discovery ~= nilptr and picoquic_compare_addr(name,&discovery.peer) == 0 then
      quic = discovery.quic
    elseif path.bootstrap ~= nilptr and picoquic_compare_addr(name,&path.peer) == 0 then
      name = &path.bootstrap.peer
      destination = &path.bootstrap.local_addr
    end
    picoquic_incoming_packet(quic,bytes,(@csize)(size),name,destination,0,0,now)
  elseif size < 0 and errno ~= EAGAIN and errno ~= EINTR and not socket_unreachable(errno) then
    return (@uint32)(errno)
  end
  return 0
end

local function read_packets(conn: *Connection, now: uint64): uint32
  local bytes: [65536]uint8
  local path = conn.paths
  while path ~= nilptr and not conn.closed do
    local error = read_from_path(conn,path,&bytes[0],#bytes,now)
    if error ~= 0 then return error end
    path = (@*Path)(path.next)
  end
  local probes: [3]*Path = {conn.nat_source,conn.nat_route_v4,conn.nat_route_v6}
  for i = 0,<3 do
    if probes[i] ~= nilptr and not conn.closed then
      local error = read_from_path(conn,probes[i],&bytes[0],#bytes,now)
      if error ~= 0 then return error end
    end
  end
  return 0
end

local function discovery_event(cnx:*cnx_t, id:uint64, bytes:*uint8, size:csize, kind:cint, ctx:pointer,
    stream_user:pointer): cint
  local discovery = (@*AddressDiscovery)(ctx)
  if kind == picoquic_callback_ready then
    discovery.ready = true
  elseif kind == picoquic_callback_close or kind == picoquic_callback_application_close or
      kind == picoquic_callback_stateless_reset then
    discovery.closed = true
  end
  return 0
end

local function create_discovery(peer:*storage_t, name:cstring, roots:cstring): *AddressDiscovery
  local discovery = (@*AddressDiscovery)(C.calloc(1,#AddressDiscovery))
  if discovery == nilptr then return nilptr end
  discovery.peer = $peer
  local now = picoquic_current_time()
  discovery.started = now
  discovery.quic = picoquic_create(1,nilptr,nilptr,roots,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,now,nilptr,nilptr,nilptr,0)
  if discovery.quic ~= nilptr then
    picoquic_set_client_cert_verification_policy(discovery.quic,1)
    picoquic_set_default_address_discovery_mode(discovery.quic,2)
    discovery.cnx = picoquic_create_client_cnx(discovery.quic,peer,now,1,name,'/iroh-qad/0',
      (@pointer)(discovery_event),discovery)
  end
  if discovery.cnx == nilptr then
    free_discovery(discovery)
    return nilptr
  end
  return discovery
end

local function send_discovery(path:*Path, discovery:*AddressDiscovery): uint32
  local data: [IO_CAPACITY]uint8
  local from: storage_t, to: storage_t
  local length: csize
  local iface: cint
  local now = picoquic_current_time()
  if picoquic_prepare_packet(discovery.cnx,now,&data[0],#data,&length,&to,&from,&iface) ~= 0 then return EIO end
  if length == 0 then return 0 end
  local written = sendto(path.fd,&data[0],length,0,&discovery.peer,address_size(&discovery.peer))
  if written == (@isize)(length) then return 0 end
  if written < 0 and (errno == EAGAIN or errno == EINTR) then return 0 end
  return written < 0 and (@uint32)(errno) or EIO
end

local function unspecified_address(addr:*storage_t): boolean
  local zero: [16]uint8
  if addr.ss_family == AF_INET then return ((@*addr_t)(addr)).sin_addr.s_addr == 0 end
  return C.memcmp(&((@*addr6_t)(addr)).sin6_addr,&zero[0],16) == 0
end

local function observed_address(discovery:*AddressDiscovery, output:*storage_t): boolean
  if not discovery.ready or picoquic_get_path_addr(discovery.cnx,0,3,output) ~= 0 then return false end
  if output.ss_family == AF_INET then
    return not unspecified_address(output) and ((@*addr_t)(output)).sin_port ~= 0
  end
  return output.ss_family == AF_INET6 and not unspecified_address(output) and ((@*addr6_t)(output)).sin6_port ~= 0
end

local function default_qad_roots(): cstring
  local roots = C.getenv('CURL_CA_BUNDLE')
  if roots == nilptr then roots = C.getenv('SSL_CERT_FILE') end
  if roots == nilptr then roots = X509_get_default_cert_file() end
  return roots
end

local function poll_qad_route(path:*Path, route:*QadRoute, host:cstring, previous:*storage_t): boolean
  if path == nilptr or route.peer.ss_family == 0 then return false end
  local now = picoquic_current_time()
  if route.running == nilptr and now >= route.retry_at then
    -- Keep each address family independent and leave the last authenticated
    -- observation in use if the relay is temporarily unreachable.
    route.retry_at = now + 25000000
    local roots = default_qad_roots()
    if roots ~= nilptr and C.strlen(roots) ~= 0 then route.running = create_discovery(&route.peer,host,roots) end
  end
  local discovery = route.running
  if discovery == nilptr then return false end
  local observed: storage_t
  if observed_address(discovery,&observed) then
    $previous = route.observed
    route.observed = observed
    picoquic_close(discovery.cnx,0)
    send_discovery(path,discovery)
    free_discovery(discovery)
    route.running = nilptr
    return previous.ss_family == 0 or picoquic_compare_addr(previous,&observed) ~= 0
  end
  if discovery.closed or picoquic_get_cnx_state(discovery.cnx) == picoquic_state_disconnected or
      now >= discovery.started + 3000000 or send_discovery(path,discovery) ~= 0 then
    free_discovery(discovery)
    route.running = nilptr
  end
  return false
end

local PacketHeader <cimport,nodecl,codename 'picoquic_packet_header'> = @record{}
local function picoquic_parse_packet_header(quic:*quic_t, bytes:*uint8, size:csize, peer:*storage_t,
    header:*PacketHeader, cnx:**cnx_t, receiving:cint):cint <cimport,nodecl> end

local function listener_packet_context(listener:*Listener, bytes:*uint8, size:csize, peer:*storage_t): *quic_t
  local config = listener.discovery
  if config == nilptr then return listener.quic end
  local discovery = peer.ss_family == AF_INET and config.v4.running or config.v6.running
  if discovery ~= nilptr and picoquic_compare_addr(peer,&discovery.peer) == 0 then
    local header:PacketHeader
    local cnx:*cnx_t
    picoquic_parse_packet_header(discovery.quic,bytes,size,peer,&header,&cnx,1)
    if cnx == discovery.cnx then return discovery.quic end
  end
  return listener.quic
end

local function pump_listener_qad(listener:*Listener)
  local config = listener.discovery
  if config == nilptr then return end
  local v4:Path = {fd=listener.ipv4_fd,local_addr=listener.ipv4_addr}
  local v6:Path = {fd=listener.fd,local_addr=listener.local_addr}
  local previous:storage_t
  local changed_v4 = v4.fd >= 0 and config.v4.observed.ss_family == 0 and
    poll_qad_route(&v4,&config.v4,config.host,&previous)
  local changed_v6 = config.v6.observed.ss_family == 0 and
    poll_qad_route(&v6,&config.v6,config.host,&previous)
  if changed_v4 or changed_v6 then
    listener.qad_revision = listener.qad_revision + 1
  end
end

local function receive_listener(listener: *Listener, now: uint64): uint32
  local bytes: [65536]uint8
  local peer: storage_t
  local destination: storage_t
  local iface:cint
  local ecn:uint8
  local count:isize
  if listener.ipv4_fd >= 0 then
    listener.dispatch_ipv4 = not listener.dispatch_ipv4
    local fd = listener.dispatch_ipv4 and listener.ipv4_fd or listener.fd
    count = picoquic_recvmsg(fd,&peer,&destination,&iface,&ecn,&bytes[0],#bytes)
    if count > 0 then
      if destination.ss_family == AF_INET then
        local ipv4 = (@*addr_t)(&destination)
        ipv4.sin_port = ((@*addr_t)(&listener.ipv4_addr)).sin_port
      elseif destination.ss_family == AF_INET6 then
        local ipv6 = (@*addr6_t)(&destination)
        ipv6.sin6_port = ((@*addr6_t)(&listener.local_addr)).sin6_port
      else
        return 0
      end
    end
  else
    local length = IROH_MP_STORAGE_SIZE
    count = recvfrom(listener.fd,&bytes[0],#bytes,0,&peer,&length)
    destination = listener.local_addr
  end
  if count > 0 then
    local size = (@csize)(count)
    local quic = listener_packet_context(listener,&bytes[0],size,&peer)
    picoquic_incoming_packet(quic,&bytes[0],size,&peer,&destination,iface,ecn,now)
  elseif count < 0 and errno ~= EAGAIN and errno ~= EINTR then
    return (@uint32)(errno)
  end
  return 0
end

local function handshake_packet(listener: *Listener, cnx: *cnx_t, now: uint64)
  local out: [IO_CAPACITY]uint8
  local size: csize
  local from: storage_t, to: storage_t
  local iface: cint
  if prepare_server_early_packet(cnx,now,&out[0],IO_CAPACITY,&size,&to,&from,&iface) == 0 and size > 0 then
    send_listener(listener,&to,&from,iface,&out[0],size)
  end
end

local function pump_listener(listener: *Listener, now: uint64): uint32
  local error = receive_listener(listener,now)
  if error ~= 0 then return error end
  pump_listener_qad(listener)
  local packet = picoquic_dequeue_stateless_packet(listener.quic)
  if packet ~= nilptr then
    if not listener.stopped then
      send_listener(listener,&packet.addr_to,&packet.addr_local,packet.if_index_local,&packet.bytes[0],packet.length)
    end
    picoquic_delete_stateless_packet(packet)
  end
  local cnx = picoquic_get_first_cnx(listener.quic)
  while cnx ~= nilptr do
    local next = picoquic_get_next_cnx(cnx)
    local ctx = picoquic_get_callback_context(cnx)
    local expired = now - picoquic_get_cnx_start_time(cnx) > HANDSHAKE_LIMIT
    if (@pointer)(picoquic_get_callback_function(cnx)) == (@pointer)(server_event) then
      if expired or listener.stopped or picoquic_get_cnx_state(cnx) == picoquic_state_disconnected then
        discard_handshake(cnx,listener)
        picoquic_delete_cnx(cnx)
      else
        handshake_packet(listener,cnx,now)
      end
    elseif ctx ~= nilptr then
      local conn = (@*Connection)(ctx)
      if not conn.accepted then
        if conn.closed or expired or listener.stopped or write_packet(conn,now) ~= 0 then
          remove_connection(conn)
        end
      end
    end
    cnx = next
  end
  return 0
end

local function step(e: Env, conn: *Connection): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local now = picoquic_current_time()
  local error: uint32 = 0
  if conn.listener ~= nilptr then error = pump_listener(conn.listener,now) end
  if error == 0 then error = read_packets(conn,now) end
  if error == 0 then error = write_packet(conn,now) end
  close_retired_sockets(conn)
  if conn.closed or conn.buffer_error then return closed_error(e,conn) end
  if error ~= 0 then return io_fail(e,error,'QUIC packet I/O failed') end
  local state: Term = 0
  if conn.ready then state = conn.cnx.is_multipath_enabled ~= 0 and 2 or 1 end
  return io_done(e,state)
end

local function step_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],step(e,find_connection(e,args[0])))
end

local function optional_id(e: Env, id: uint64): Term
  return io_done(e,io_box(e,iroh_mp_Some,id))
end

local function none(e: Env): Term
  return io_done(e,term_pak(iroh_mp_None,0))
end

local function read_nat_frame_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local inbox = conn.nat_inbox
  if inbox == nilptr or inbox.count == 0 then return io_tup(e,args[0],none(e)) end
  local frame = &inbox.frames[inbox.first]
  local bytes = io_list(e,(@cstring)(&frame.bytes[0]),frame.size)
  inbox.first = (inbox.first + 1) % NAT_INBOX_CAPACITY
  inbox.count = inbox.count - 1
  return io_tup(e,args[0],optional_id(e,bytes))
end


local function bind_listener(e: Env, args: *[0]Term, mode: uint32, advertise_nat: boolean, resumable: boolean, discover_peer: boolean, dual:boolean): Term
  local local_addr: storage_t
  local size = numeric_argument(e,args[0],args[1],&local_addr)
  local alpn_term = args[discover_peer and 3 or 4]
  local alpns = read_alpns(e,alpn_term,mode)
  defer free_alpns(alpns) end
  local seed: [32]uint8
  local key: [32]uint8
  local seed_size = bytes_from_list(e,args[2],&seed[0],32)
  local peer:*uint8
  if not discover_peer and bytes_from_list(e,args[3],&key[0],32) == 32 then peer = &key[0] end
  local empty = mode == 2 and term_aux(alpn_term) == iroh_mp_Nil
  if size == 0 or seed_size ~= 32 or (not discover_peer and peer == nilptr) or (alpns == nilptr and not empty) then
    return io_fail(e,EINVAL,'invalid numeric listen address, Ed25519 key, or ALPN')
  end
  local wildcard = unspecified_address(&local_addr)
  if dual and (not wildcard or local_addr.ss_family ~= AF_INET6) then
    return io_fail(e,EINVAL,'dual-stack multipath listener requires the IPv6 wildcard address')
  elseif not dual and wildcard then
    return io_fail(e,EINVAL,'multipath listener requires a concrete IP address')
  end
  if next_listener == 0 then return io_fail(e,ENOMEM,'multipath listener handles exhausted') end
  local listener = (@*Listener)(C.calloc(1,#Listener))
  if listener == nilptr then return io_fail(e,ENOMEM,nilptr) end
  listener.refs = 1
  listener.ipv4_fd = -1
  listener.fd = socket((@cint)(local_addr.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
  local bound_size = IROH_MP_STORAGE_SIZE
  if listener.fd < 0 or (dual and picoquic_socket_set_pkt_info(listener.fd,AF_INET6) ~= 0) or
      bind(listener.fd,&local_addr,size) ~= 0 or
      getsockname(listener.fd,&listener.local_addr,&bound_size) ~= 0 then
    local code = (@uint32)(errno)
    release_listener(listener)
    return io_fail(e,code,nilptr)
  end
  if dual then
    local port = ntohs(((@*addr6_t)(&listener.local_addr)).sin6_port)
    local ipv4_size = address('0.0.0.0',port,&local_addr)
    listener.ipv4_fd = socket(AF_INET,SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
    bound_size = IROH_MP_STORAGE_SIZE
    if listener.ipv4_fd < 0 or picoquic_socket_set_pkt_info(listener.ipv4_fd,AF_INET) ~= 0 or
        bind(listener.ipv4_fd,&local_addr,ipv4_size) ~= 0 or
        getsockname(listener.ipv4_fd,&listener.ipv4_addr,&bound_size) ~= 0 then
      local code = (@uint32)(errno)
      release_listener(listener)
      return io_fail(e,code,'could not bind IPv4 socket for the dual-stack multipath listener')
    end
  end
  if advertise_nat then
    if bytes_from_list(e,args[5],&listener.nat_offer[0],NAT_PARAMETER_SIZE) ~= NAT_PARAMETER_SIZE then
      release_listener(listener)
      return io_fail(e,EINVAL,'invalid encoded NAT traversal parameter')
    end
    listener.sends_nat_offer = true
  end
  local now = picoquic_current_time()
  listener.quic = picoquic_create(LISTENER_LIMIT,nilptr,nilptr,nilptr,nilptr,(@pointer)(server_event),listener,
    nilptr,nilptr,nilptr,now,nilptr,nilptr,nilptr,0)
  if listener.quic == nilptr or not install_identity(listener.quic,&seed[0],peer,&alpns,nilptr) or
      picoquic_set_default_tp_value(listener.quic,picoquic_tp_max_datagram_frame_size,IO_CAPACITY) ~= 0 then
    release_listener(listener)
    return io_fail(e,EIO,'could not configure pinned QUIC listener')
  end
  listener.resumable = resumable
  if (resumable or discover_peer) and not mp_tls_listener(listener,&seed[0],peer) then
    release_listener(listener)
    return io_fail(e,EIO,'could not configure OpenSSL server TLS')
  end
  picoquic_set_alpn_select_fn(listener.quic,select_alpn)
  picoquic_set_client_authentication(listener.quic,1)
  picoquic_enforce_client_only(listener.quic,0)
  picoquic_set_accept_0rtt(listener.quic,0)
  picoquic_set_default_multipath_option(listener.quic,1)
  picoquic_enable_path_callbacks_default(listener.quic,1)
  picoquic_set_max_half_open_retry_threshold(listener.quic,LISTENER_LIMIT)
  listener.id = next_listener
  next_listener = next_listener + 1
  listener.next = listeners
  listeners = listener
  local port = listener.local_addr.ss_family == AF_INET and
    ((@*addr_t)(&listener.local_addr)).sin_port or ((@*addr6_t)(&listener.local_addr)).sin6_port
  return io_done(e,io_tup(e,term_pak(iroh_mp_MultipathListener,listener.id),ntohs(port)))
end

local function accept_connection(e: Env, listener: *Listener): Term
  if listener == nilptr then return io_fail(e,EBADF,'multipath listener closed') end
  local code = pump_listener(listener,picoquic_current_time())
  if code ~= 0 then return io_fail(e,code,'QUIC listener I/O failed') end
  local conn = connections
  local ready: *Connection
  while conn ~= nilptr do
    if conn.listener == listener and not conn.accepted and conn.ready and not conn.closed and
        (ready == nilptr or conn.id < ready.id) then
      ready = conn
    end
    conn = (@*Connection)(conn.next)
  end
  if ready == nilptr then return none(e) end
  ready.accepted = true
  return io_done(e,io_box(e,iroh_mp_Some,term_pak(iroh_mp_MultipathConnection,ready.id)))
end

local function bind_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,0,false,false,false,false)
end

local function bind_nat_offer_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,0,true,false,false,false)
end

local function bind_bytes_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,1,false,false,false,false)
end

local function bind_alpns_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,2,false,false,false,false)
end

local function bind_resumable_run(e:Env, args:*[0]Term, work:*IoWork):Term
  return bind_listener(e,args,1,false,true,false,false)
end

local function bind_identity_run(e:Env,args:*[0]Term,work:*IoWork):Term
  if args[4] > 1 then return io_fail(e,EINVAL,'invalid QUIC early-data setting') end
  return bind_listener(e,args,2,false,args[4] == 1,true,false)
end

local function bind_dual_identity_run(e:Env,args:*[0]Term,work:*IoWork):Term
  if args[4] > 1 then return io_fail(e,EINVAL,'invalid QUIC early-data setting') end
  return bind_listener(e,args,2,false,args[4] == 1,true,true)
end

local function bind_dual_nat_identity_run(e:Env,args:*[0]Term,work:*IoWork):Term
  if args[4] > 1 then return io_fail(e,EINVAL,'invalid QUIC early-data setting') end
  return bind_listener(e,args,2,true,args[4] == 1,true,true)
end

local function bind_nat_alpns_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,2,true,false,false,false)
end

local function used_alpns(listener: *Listener)
  local cnx = picoquic_get_first_cnx(listener.quic)
  while cnx ~= nilptr do
    local callback = (@pointer)(picoquic_get_callback_function(cnx))
    local ctx = picoquic_get_callback_context(cnx)
    local name: *Alpn
    if ctx ~= nilptr then
      if callback == (@pointer)(server_event) and ctx ~= listener then
        name = ((@*PendingHandshake)(ctx)).alpn
      elseif callback == (@pointer)(on_event) then
        name = ((@*Connection)(ctx)).selected_alpn
      end
    end
    if name ~= nilptr then name.retained = true end
    cnx = picoquic_get_next_cnx(cnx)
  end
end

local function retain_alpns(first: *Alpn, kept: *Alpn): *Alpn
  while first ~= nilptr do
    local next = (@*Alpn)(first.next)
    if first.retained then
      first.retained = false
      first.next = kept
      kept = first
    else
      C.free(first)
    end
    first = next
  end
  return kept
end

local function replace_alpns(e: Env, listener: *Listener, term: Term): Term
  if listener == nilptr then return io_fail(e,EBADF,'multipath listener closed') end
  local alpns = read_alpns(e,term,2)
  if alpns == nilptr and term_aux(term) ~= iroh_mp_Nil then
    return io_fail(e,EINVAL,'invalid QUIC ALPN list')
  end
  -- Native listener operations are serialized. Keep entries referenced by
  -- in-progress handshakes or active connections across configuration changes.
  local pin = pinned(listener.quic)
  used_alpns(listener)
  pin.retired = retain_alpns(pin.alpns,retain_alpns(pin.retired,nilptr))
  pin.alpns = alpns
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function set_alpns_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],replace_alpns(e,find_listener(e,args[0]),args[1]))
end

local function accept_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],accept_connection(e,find_listener(e,args[0])))
end

local function close_listener_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local listener = find_listener(e,args[0])
  if listener == nilptr then return term_pak(iroh_mp_Unit,0) end
  listener.stopped = true
  picoquic_enforce_client_only(listener.quic,1)
  if listener == listeners then
    listeners = (@*Listener)(listener.next)
  else
    local previous = listeners
    while previous.next ~= listener do previous = (@*Listener)(previous.next) end
    previous.next = listener.next
  end
  local conn = connections
  while conn ~= nilptr do
    local next = (@*Connection)(conn.next)
    if conn.listener == listener and not conn.accepted then remove_connection(conn) end
    conn = next
  end
  release_listener(listener)
  return term_pak(iroh_mp_Unit,0)
end

local function register_probed_path(e:Env, conn:*Connection, path:*Path): Term
  local previous = conn.cnx.nb_paths
  local status = picoquic_probe_new_path(conn.cnx,&path.peer,&path.local_addr,picoquic_current_time())
  if status ~= 0 then
    release_path(path)
    if status == PICOQUIC_ERROR_PATH_ID_BLOCKED or status == PICOQUIC_ERROR_PATH_CID_BLOCKED or
        status == PICOQUIC_ERROR_PATH_NOT_READY then return none(e) end
    return io_fail(e,EIO,picoquic_error_name((@uint64)(status)))
  end
  if conn.cnx.nb_paths ~= previous + 1 then
    release_path(path)
    return io_fail(e,EIO,'QUIC did not allocate a new path')
  end
  local paths = (@*[0]*path_t)(conn.cnx.path)
  local id = paths[previous].unique_path_id
  if id >= 0xffffffff then
    picoquic_abandon_path(conn.cnx,id,0,picoquic_current_time())
    release_path(path)
    return io_fail(e,ENOBUFS,'QUIC path IDs exhausted')
  end
  path.id = (@uint32)(id)
  path.next = conn.paths
  conn.paths = path
  conn.path_count = conn.path_count + 1
  if conn.last_path_id < id then conn.last_path_id = (@uint32)(id) end
  return optional_id(e,id)
end

local function probe(e: Env, conn: *Connection, args: *[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if conn.listener ~= nilptr then return io_fail(e,ENOTSUP,'only a QUIC dialer can open a new path') end
  if not conn.ready then return none(e) end
  if conn.cnx.is_multipath_enabled == 0 then return io_fail(e,ENOTSUP,'peer did not negotiate QUIC multipath') end
  if conn.path_count >= PATH_LIMIT then return io_fail(e,ENOBUFS,'too many active QUIC paths') end
  local source: storage_t, peer: storage_t
  local bind_len: uint64
  local bind_host = io_cstr(e,args[1],&bind_len)
  defer C.free(bind_host) end
  local peer_size = numeric_argument(e,args[3],args[4],&peer)
  local source_size: cuint = 0
  if bind_len ~= 0 and args[2] <= 65535 and not io_nul(bind_host,bind_len) then
    source_size = address(bind_host,(@uint16)(args[2]),&source)
  end
  if peer_size == 0 or args[4] == 0 or (bind_len == 0 and args[2] ~= 0) or
      (bind_len ~= 0 and (source_size == 0 or source.ss_family ~= peer.ss_family)) then
    return io_fail(e,EINVAL,'invalid local or remote QUIC path address')
  end
  local path,error = open_path(&peer,peer_size,source_size ~= 0 and &source or nilptr,source_size)
  if path == nilptr then return io_fail(e,error,nilptr) end
  return register_probed_path(e,conn,path)
end

local function probe_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],probe(e,find_connection(e,args[0]),args))
end

local function packed_nat_address(e:Env, args:*[0]Term, family:uint16, output:*storage_t): boolean
  local ip: [16]uint8
  local length = bytes_from_list(e,args[1],&ip[0],16)
  if args[2] == 0 or args[2] > 65535 then return false end
  if (family == 0 or family == AF_INET) and length == 4 then
    local v4 = (@*addr_t)(output)
    v4.sin_family = (@uint16)(AF_INET)
    v4.sin_port = htons((@uint16)(args[2]))
    C.memcpy(&v4.sin_addr,&ip[0],4)
    return true
  end
  if family ~= 0 and family ~= AF_INET6 then return false end
  local v6 = (@*addr6_t)(output)
  v6.sin6_family = (@uint16)(AF_INET6)
  v6.sin6_port = htons((@uint16)(args[2]))
  if length == 16 then
    C.memcpy(&v6.sin6_addr,&ip[0],16)
  elseif length == 4 then
    local bytes = (@*[0]uint8)(&v6.sin6_addr)
    bytes[10] = 255
    bytes[11] = 255
    C.memcpy(&bytes[12],&ip[0],4)
  else
    return false
  end
  return true
end

local function nat_address(e:Env, args:*[0]Term, conn:*Connection, output:*storage_t): boolean
  if conn.listener ~= nilptr and conn.listener.ipv4_fd >= 0 then
    if not packed_nat_address(e,args,0,output) then return false end
    if output.ss_family == AF_INET6 then
      local ipv6 = (@*addr6_t)(output)
      local bytes = (@*[0]uint8)(&ipv6.sin6_addr)
      local prefix:[10]uint8
      if bytes[10] == 255 and bytes[11] == 255 and C.memcmp(bytes,&prefix[0],10) == 0 then
        local ipv4:addr_t = {sin_family=(@uint16)(AF_INET),sin_port=ipv6.sin6_port}
        C.memcpy(&ipv4.sin_addr,&bytes[12],4)
        C.memset(output,0,IROH_MP_STORAGE_SIZE)
        C.memcpy(output,&ipv4,IROH_MP_V4_SIZE)
      end
    end
    return true
  end
  if has_nat_routes(conn) then
    return packed_nat_address(e,args,0,output) and routed_nat_socket(conn,output.ss_family) ~= nilptr
  end
  local local_addr = nat_local_address(conn)
  return local_addr ~= nilptr and packed_nat_address(e,args,local_addr.ss_family,output)
end

local function nat_probe(inbox:*NatInbox, peer:*storage_t, raw:*uint8, now:uint64): (*NatProbe, *NatProbe)
  local available: *NatProbe
  for i = 0,<NAT_PROBE_CAPACITY do
    local probe = &inbox.probes[i]
    if probe.expires <= now then
      if available == nilptr then available = probe end
    elseif picoquic_compare_addr(&probe.peer,peer) == 0 and C.memcmp(&probe.challenge[0],raw,CHALLENGE_SIZE) == 0 then
      return probe,available
    end
  end
  return nilptr,available
end

local function send_nat_packet(conn:*Connection, path:*path_t, fd:cint, peer:*storage_t, source:*storage_t, frame:*uint8,
    size:csize, now:uint64, tracking:**uint8): uint32
  local cnx = conn.cnx
  local length = picoquic_predict_packet_header_length(cnx,picoquic_packet_1rtt_protected,&path.pkt_ctx)
  local checksum = picoquic_get_checksum_length(cnx,picoquic_epoch_1rtt)
  local output: [IO_CAPACITY]uint8
  if length + size + checksum > #output then return EMSGSIZE end
  local packet = picoquic_create_packet(conn.quic)
  if packet == nilptr then return ENOMEM end
  packet.ptype = picoquic_packet_1rtt_protected
  packet.pc = picoquic_packet_context_application
  packet.offset = length
  packet.send_path = path
  packet.send_time = now
  packet.is_ack_eliciting = 1
  local payload = (@*[0]uint8)(&packet.bytes[0])
  C.memcpy(&payload[length],frame,size)
  local sent: csize
  -- Consume the active path's packet number and apply its 1-RTT protection.
  picoquic_finalize_and_protect_packet(cnx,packet,0,length + size,length,checksum,
    &sent,&output[0],#output,path,now,1)
  if sent == 0 then
    picoquic_recycle_packet(conn.quic,packet)
    return EIO
  end
  if tracking ~= nilptr then
    -- The encrypted payload already contains the actual extension frame.
    -- Describe its plaintext entry as a length-bearing datagram only in
    -- Picoquic's retransmission queue. Its ACK/loss callbacks let Bend retry
    -- the extension without exposing an unknown tag to Picoquic's ACK parser.
    payload[length] = picoquic_frame_type_datagram_l
    payload[length + 1] = (@uint8)(size - 2)
  end
  local written:isize
  if source ~= nilptr and conn.listener ~= nilptr and conn.listener.ipv4_fd >= 0 then
    written = send_listener(conn.listener,peer,source,0,&output[0],sent)
  else
    written = sendto(fd,&output[0],sent,0,peer,address_size(peer))
  end
  if written < 0 then return (@uint32)(errno) end
  if written ~= (@isize)(sent) then return EIO end
  if tracking ~= nilptr then $tracking = &payload[length + 2] end
  return 0
end

local function nat_challenge_effect(e:Env, args:*[0]Term, send_probe:boolean): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not conn.ready or conn.nat_inbox == nilptr then
    return io_fail(e,ENOTSUP,'operation requires negotiated NAT traversal')
  end
  local peer: storage_t
  local raw: [CHALLENGE_SIZE]uint8
  if not nat_address(e,args,conn,&peer) or
      bytes_from_list(e,args[3],&raw[0],CHALLENGE_SIZE) ~= CHALLENGE_SIZE or raw[0] ~= picoquic_frame_type_path_challenge then
    return io_fail(e,EINVAL,'invalid NAT traversal challenge')
  end
  local now = picoquic_current_time()
  local found, available = nat_probe(conn.nat_inbox,&peer,&raw[0],now)
  if not send_probe then
    if found == nilptr or not found.answered or found.claimed then return io_done(e,0) end
    if conn.listener ~= nilptr then found.expires = 0
    else found.claimed = true end
    return io_done(e,1)
  end
  if found ~= nilptr then return io_done(e,1) end
  if available == nilptr then return io_fail(e,ENOBUFS,'too many outstanding NAT challenges') end
  -- Short probes use the current CID but never register or validate a tuple.
  local fd:cint
  if conn.listener ~= nilptr then
    fd = conn.listener.fd
    if conn.listener.ipv4_fd >= 0 and peer.ss_family == AF_INET then fd = conn.listener.ipv4_fd end
  else
    local udp = nat_socket_for_peer(conn,peer.ss_family)
    if udp == nilptr or not udp.unconnected or udp.status == 3 then
      return io_fail(e,ENOTSUP,'the UDP probe socket is unavailable')
    end
    fd = udp.fd
  end
  local path = ((@*[0]*path_t)(conn.cnx.path))[0]
  local error = send_nat_packet(conn,path,fd,&peer,nilptr,&raw[0],CHALLENGE_SIZE,now,nilptr)
  if error == EAGAIN or error == EINTR then return io_done(e,0) end
  if error ~= 0 then return io_fail(e,error,'could not send NAT traversal challenge') end
  available.peer = peer
  C.memcpy(&available.challenge[0],&raw[0],CHALLENGE_SIZE)
  available.expires = now + NAT_PROBE_LIFETIME
  available.answered = false
  available.claimed = false
  return io_done(e,1)
end

local function send_nat_challenge_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],nat_challenge_effect(e,args,true))
end

local function take_nat_response_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],nat_challenge_effect(e,args,false))
end

local function valid_nat_control(bytes:*uint8, size:csize, dialer:boolean): boolean
  local tag: uint64
  if picoquic_varint_decode(bytes,size,&tag) ~= 4 or size < 5 then return false end
  local frame = (@*[0]uint8)(bytes)
  local seq: uint64
  local width = picoquic_varint_decode(&frame[4],size - 4,&seq)
  if width == 0 then return false end
  local body = nat_body_size(tag,dialer)
  return body >= 0 and (@csize)(body) == size - 4 - width
end

local function nat_control_route(conn:*Connection, peer:*storage_t, source:*storage_t): (*path_t,cint)
  local paths = (@*[0]*path_t)(conn.cnx.path)
  for i = 0,<conn.cnx.nb_paths do
    local path = paths[i]
    if picoquic_get_path_addr(conn.cnx,path.unique_path_id,2,peer) == 0 and
        picoquic_get_path_addr(conn.cnx,path.unique_path_id,1,source) == 0 then
      if conn.listener ~= nilptr then
        local fd = listener_socket(conn.listener,source,peer)
        if fd >= 0 then return path,fd end
      else
        -- A tuple can change while its original descriptor is retired.
        -- Use the same address lookup as the normal QUIC send path.
        local route = route_packet(conn,source,peer)
        if route ~= nilptr and route.status == 1 and route.fd >= 0 then return path,route.fd end
      end
    end
  end
  return nilptr,-1
end

local function advertise_nat(e:Env, conn:*Connection, value:Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not conn.ready or conn.nat_inbox == nilptr then
    return io_fail(e,ENOTSUP,'operation requires negotiated NAT traversal')
  end
  local raw: NatFrame
  local size = bytes_from_list(e,value,&raw.bytes[0],#raw.bytes)
  if size < 0 or not valid_nat_control(&raw.bytes[0],(@csize)(size),conn.listener == nilptr) then
    return io_fail(e,EINVAL,'invalid outbound NAT traversal control frame')
  end
  raw.size = (@csize)(size)
  local state = &conn.nat_inbox.advertising
  if state.frame.size == 0 then
    state.frame = raw
  elseif state.frame.size ~= raw.size or C.memcmp(&state.frame.bytes[0],&raw.bytes[0],raw.size) ~= 0 then
    return io_fail(e,EBUSY,'another NAT traversal control frame is awaiting acknowledgement')
  end
  if state.delivered then
    state.delivered = false
    state.frame.size = 0
    return io_done(e,1)
  end
  if state.tracked_payload ~= nilptr then return io_done(e,0) end
  local peer: storage_t
  local source:storage_t
  local path,fd = nat_control_route(conn,&peer,&source)
  if path == nilptr then return io_done(e,0) end
  local now = picoquic_current_time()
  local error = send_nat_packet(conn,path,fd,&peer,&source,&raw.bytes[0],raw.size,now,&state.tracked_payload)
  if error == 0 then
    state.tracked_at = now
    return io_done(e,0)
  end
  if error == EAGAIN or error == EINTR then return io_done(e,0) end
  state.frame.size = 0
  return io_fail(e,error,'could not send NAT traversal control frame')
end

local function advertise_nat_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],advertise_nat(e,find_connection(e,args[0]),args[1]))
end

local function adopt_nat_source(conn:*Connection, path:*Path)
  -- Responses tied to the old socket cannot authorize a path on this one.
  for i = 0,<NAT_PROBE_CAPACITY do
    conn.nat_inbox.probes[i].expires = 0
  end
  conn.nat_source = path
end

local function bind_nat_source(e:Env, conn:*Connection, args:*[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if conn.listener ~= nilptr or not conn.ready then
    return io_fail(e,ENOTSUP,'NAT source requires an authenticated QUIC dial')
  end
  if conn.nat_inbox == nilptr then return io_done(e,term_pak(iroh_mp_Unit,0)) end
  if conn.nat_source ~= nilptr or has_nat_routes(conn) then return io_fail(e,EINVAL,'NAT source is already bound') end
  local addr: storage_t
  local size = numeric_argument(e,args[1],args[2],&addr)
  if size == 0 or unspecified_address(&addr) then
    return io_fail(e,EINVAL,'NAT source requires a concrete numeric address')
  end
  local path = (@*Path)(C.calloc(1,#Path))
  if path == nilptr then return io_fail(e,ENOMEM,nilptr) end
  path.fd = socket((@cint)(addr.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
  local bound_size = IROH_MP_STORAGE_SIZE
  if path.fd < 0 or bind(path.fd,&addr,size) ~= 0 or getsockname(path.fd,&path.local_addr,&bound_size) ~= 0 then
    local error = (@uint32)(errno)
    release_path(path)
    return io_fail(e,error,'could not bind the direct NAT source')
  end
  path.unconnected = true
  adopt_nat_source(conn,path)
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function bind_nat_source_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],bind_nat_source(e,find_connection(e,args[0]),args))
end

local function socket_candidate(e:Env, addr:*storage_t): Term
  if addr.ss_family == AF_INET then
    local v4 = (@*addr_t)(addr)
    return io_tup(e,io_list(e,(@cstring)(&v4.sin_addr),4),ntohs(v4.sin_port))
  end
  local v6 = (@*addr6_t)(addr)
  return io_tup(e,io_list(e,(@cstring)(&v6.sin6_addr),16),ntohs(v6.sin6_port))
end

local function route_nat_source(e:Env, conn:*Connection, args:*[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if conn.listener ~= nilptr or not conn.ready or conn.nat_inbox == nilptr then
    return io_fail(e,ENOTSUP,'NAT source selection requires an authenticated NAT dial')
  end
  if conn.nat_source ~= nilptr then return io_fail(e,EINVAL,'an explicit NAT source is already bound') end
  local peer: storage_t
  if not packed_nat_address(e,args,0,&peer) or unspecified_address(&peer) then
    return io_fail(e,EINVAL,'invalid NAT route address')
  end
  local path = routed_nat_socket(conn,peer.ss_family)
  if path == nilptr then
    local error: uint32
    path,error = open_nat_path(&peer,address_size(&peer))
    if path == nilptr then return io_fail(e,error,'could not select a direct NAT source') end
    if peer.ss_family == AF_INET then conn.nat_route_v4 = path
    else conn.nat_route_v6 = path end
    if conn.nat_route_v4 == nilptr or conn.nat_route_v6 == nilptr then
      -- The first routed source replaces any probes made on the bootstrap socket.
      for i = 0,<NAT_PROBE_CAPACITY do
        conn.nat_inbox.probes[i].expires = 0
      end
    end
  end
  local config = conn.routed_discovery
  if config ~= nilptr then
    local route = peer.ss_family == AF_INET and &config.v4 or &config.v6
    if route.observed.ss_family ~= 0 then return io_done(e,socket_candidate(e,&route.observed)) end
  end
  return io_done(e,socket_candidate(e,&path.local_addr))
end

local function route_nat_source_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],route_nat_source(e,find_connection(e,args[0]),args))
end

local function release_qad_server(server:*QadServer)
  if server.quic ~= nilptr then picoquic_free(server.quic) end
  if server.fd >= 0 then close(server.fd) end
  C.free(server)
end

local function qad_server_event(cnx:*cnx_t, id:uint64, bytes:*uint8, size:csize, kind:cint, ctx:pointer,
    stream_user:pointer): cint
  -- Picoquic needs an application callback to accept the TLS handshake.
  -- The transport itself generates all address reports.
  return 0
end

local function bind_qad_server(e:Env, args:*[0]Term): Term
  local addr: storage_t
  local size = numeric_argument(e,args[0],args[1],&addr)
  local cert_size: uint64, key_size: uint64
  local cert = io_cstr(e,args[2],&cert_size)
  defer C.free(cert) end
  local key = io_cstr(e,args[3],&key_size)
  defer C.free(key) end
  if size == 0 or unspecified_address(&addr) or cert_size == 0 or key_size == 0 or
      io_nul(cert,cert_size) or io_nul(key,key_size) then
    return io_fail(e,EINVAL,'QAD requires a concrete UDP address and PEM certificate and key files')
  end
  if next_qad_server == 0 then return io_fail(e,ENOBUFS,'QAD server handles exhausted') end
  local server = (@*QadServer)(C.calloc(1,#QadServer))
  if server == nilptr then return io_fail(e,ENOMEM,nilptr) end
  server.fd = socket((@cint)(addr.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
  local bound_size = IROH_MP_STORAGE_SIZE
  if server.fd < 0 or bind(server.fd,&addr,size) ~= 0 or getsockname(server.fd,&server.local_addr,&bound_size) ~= 0 then
    local error = (@uint32)(errno)
    release_qad_server(server)
    return io_fail(e,error,nilptr)
  end
  local now = picoquic_current_time()
  server.quic = picoquic_create(LISTENER_LIMIT,cert,key,nilptr,'/iroh-qad/0',(@pointer)(qad_server_event),nilptr,nilptr,nilptr,nilptr,
    now,nilptr,nilptr,nilptr,0)
  if server.quic == nilptr or
      picoquic_set_default_tp_value(server.quic,picoquic_tp_initial_max_streams_bidi,0) ~= 0 or
      picoquic_set_default_tp_value(server.quic,picoquic_tp_initial_max_streams_uni,0) ~= 0 then
    release_qad_server(server)
    return io_fail(e,EIO,'could not configure the QAD TLS server')
  end
  picoquic_set_default_address_discovery_mode(server.quic,1)
  picoquic_set_accept_0rtt(server.quic,0)
  picoquic_set_max_half_open_retry_threshold(server.quic,LISTENER_LIMIT)
  server.id = next_qad_server
  next_qad_server = next_qad_server + 1
  server.next = qad_servers
  qad_servers = server
  local port = addr.ss_family == AF_INET and ((@*addr_t)(&server.local_addr)).sin_port or
    ((@*addr6_t)(&server.local_addr)).sin6_port
  return io_done(e,io_tup(e,term_pak(iroh_mp_QadServer,server.id),ntohs(port)))
end

local function find_qad_server(e:Env, term:Term): *QadServer
  local id = handle_id(e,term,iroh_mp_QadServer)
  local server = qad_servers
  while server ~= nilptr and server.id ~= id do server = server.next end
  return server
end

local function pump_qad_server(server:*QadServer): uint32
  local bytes: [65536]uint8
  local peer: storage_t
  local source: storage_t
  local capacity = IROH_MP_STORAGE_SIZE
  local now = picoquic_current_time()
  local count = recvfrom(server.fd,&bytes[0],#bytes,0,&peer,&capacity)
  if count > 0 then
    picoquic_incoming_packet(server.quic,&bytes[0],(@csize)(count),&peer,&server.local_addr,0,0,now)
  elseif count < 0 and errno ~= EAGAIN and errno ~= EINTR and not socket_unreachable(errno) then
    return (@uint32)(errno)
  end
  local size: csize
  local iface: cint
  if picoquic_prepare_next_packet(server.quic,now,&bytes[0],IO_CAPACITY,&size,&peer,&source,&iface,nilptr,nilptr) ~= 0 then
    return EIO
  end
  if size == 0 then return 0 end
  count = sendto(server.fd,&bytes[0],size,0,&peer,address_size(&peer))
  if count == (@isize)(size) then return 0 end
  if count < 0 and (errno == EAGAIN or errno == EINTR or socket_unreachable(errno)) then return 0 end
  return count < 0 and (@uint32)(errno) or EIO
end

local function bind_qad_server_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return bind_qad_server(e,args)
end

local function step_qad_server_run(e:Env, args:*[0]Term, work:*IoWork): Term
  local server = find_qad_server(e,args[0])
  if server == nilptr then return io_tup(e,args[0],io_fail(e,EBADF,'QAD server closed')) end
  local error = pump_qad_server(server)
  if error ~= 0 then return io_tup(e,args[0],io_fail(e,error,'QAD server UDP I/O failed')) end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_Unit,0)))
end

local function close_qad_server_run(e:Env, args:*[0]Term, work:*IoWork): Term
  local server = find_qad_server(e,args[0])
  if server ~= nilptr then
    if qad_servers == server then qad_servers = server.next
    else
      local prev = qad_servers
      while prev.next ~= server do prev = prev.next end
      prev.next = server.next
    end
    release_qad_server(server)
  end
  return term_pak(iroh_mp_Unit,0)
end

local function start_discovery(e:Env, conn:*Connection, args:*[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if conn.nat_source == nilptr then return io_fail(e,ENOTSUP,'address discovery requires an independent UDP source') end
  if conn.discovery ~= nilptr then return io_fail(e,EBUSY,'address discovery is in progress') end
  local peer: storage_t
  local size = numeric_argument(e,args[1],args[2],&peer)
  local name_size: uint64, roots_size: uint64
  local name = io_cstr(e,args[3],&name_size)
  defer C.free(name) end
  local roots = io_cstr(e,args[4],&roots_size)
  defer C.free(roots) end
  if size == 0 or args[2] == 0 or peer.ss_family ~= conn.nat_source.local_addr.ss_family or
      name_size == 0 or roots_size == 0 or io_nul(name,name_size) or io_nul(roots,roots_size) then
    return io_fail(e,EINVAL,'invalid address discovery server, TLS name, or CA bundle')
  end
  conn.discovery = create_discovery(&peer,name,roots)
  if conn.discovery == nilptr then
    return io_fail(e,EACCES,'could not start authenticated address discovery')
  end
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function start_discovery_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],start_discovery(e,find_connection(e,args[0]),args))
end

local function poll_discovery(e:Env, conn:*Connection): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local discovery = conn.discovery
  if discovery == nilptr then return io_fail(e,EINVAL,'address discovery has not started') end
  if discovery.closed or picoquic_get_cnx_state(discovery.cnx) == picoquic_state_disconnected then
    release_discovery(conn)
    return io_fail(e,EACCES,'address discovery closed before an authenticated report')
  end
  local observed: storage_t
  if observed_address(discovery,&observed) then
    local candidate = socket_candidate(e,&observed)
    picoquic_close(discovery.cnx,0)
    send_discovery(conn.nat_source,discovery)
    release_discovery(conn)
    return io_done(e,io_box(e,iroh_mp_Some,candidate))
  end
  local error = send_discovery(conn.nat_source,discovery)
  if error == 0 then return none(e) end
  release_discovery(conn)
  return io_fail(e,error,'address discovery UDP I/O failed')
end

local function poll_discovery_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],poll_discovery(e,find_connection(e,args[0])))
end

local function resolve_qad_routes(work:*IoWork)
  local config = (@*RoutedDiscovery)(work.data)
  local hints: AddrInfo
  hints.ai_socktype = SOCK_DGRAM
  local head:*AddrInfo
  if getaddrinfo(config.host,nilptr,&hints,&head) ~= 0 then return end
  defer freeaddrinfo(head) end
  local entry = head
  while entry ~= nilptr do
    if entry.ai_family == AF_INET and entry.ai_addrlen == IROH_MP_V4_SIZE and config.v4.peer.ss_family == 0 then
      C.memcpy(&config.v4.peer,entry.ai_addr,entry.ai_addrlen)
      local peer = (@*addr_t)(&config.v4.peer)
      peer.sin_port = htons(config.port)
    elseif entry.ai_family == AF_INET6 and entry.ai_addrlen == IROH_MP_V6_SIZE and config.v6.peer.ss_family == 0 then
      C.memcpy(&config.v6.peer,entry.ai_addr,entry.ai_addrlen)
      local peer = (@*addr6_t)(&config.v6.peer)
      peer.sin6_port = htons(config.port)
    end
    entry = entry.ai_next
  end
end

local function accept_qad_routes(e:Env, work:*IoWork): Term
  local config = (@*RoutedDiscovery)(work.data)
  local handle = term_pak(iroh_mp_MultipathConnection,config.handle)
  local conn = find_connection(e,handle)
  if conn == nilptr or conn.closed or conn.routed_discovery ~= nilptr or
      (config.v4.peer.ss_family == 0 and config.v6.peer.ss_family == 0) then
    free_routed_discovery(config)
  else
    conn.routed_discovery = config
  end
  return handle
end

local function make_qad_routes(e:Env, args:*[0]Term, handle:uint32): *RoutedDiscovery
  if args[2] == 0 or args[2] > 65535 then return nilptr end
  local size:uint64
  local host = io_cstr(e,args[1],&size)
  if size == 0 or io_nul(host,size) then
    C.free(host)
    return nilptr
  end
  local config = (@*RoutedDiscovery)(C.calloc(1,#RoutedDiscovery))
  if config == nilptr then
    C.free(host)
    return nilptr
  end
  config.host = host
  config.handle = handle
  config.port = (@uint16)(args[2])
  return config
end

local function configure_routed_qad_run(e:Env, args:*[0]Term, work:*IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed or conn.nat_inbox == nilptr or conn.routed_discovery ~= nilptr then return args[0] end
  local config = make_qad_routes(e,args,conn.id)
  if config == nilptr then return args[0] end
  work.data = (@cstring)(config)
  return io_work(work,resolve_qad_routes,accept_qad_routes)
end

local function accept_listener_qad_routes(e:Env, work:*IoWork): Term
  local config = (@*RoutedDiscovery)(work.data)
  local handle = term_pak(iroh_mp_MultipathListener,config.handle)
  local listener = find_listener(e,handle)
  if listener == nilptr or listener.discovery ~= nilptr or
      (config.v4.peer.ss_family == 0 and config.v6.peer.ss_family == 0) then
    free_routed_discovery(config)
  else
    listener.discovery = config
  end
  return handle
end

local function configure_listener_qad_run(e:Env, args:*[0]Term, work:*IoWork): Term
  local listener = find_listener(e,args[0])
  if listener == nilptr or listener.ipv4_fd < 0 or listener.discovery ~= nilptr then return args[0] end
  local config = make_qad_routes(e,args,listener.id)
  if config == nilptr then return args[0] end
  work.data = (@cstring)(config)
  return io_work(work,resolve_qad_routes,accept_listener_qad_routes)
end

local function optional_observation(e:Env, addr:*storage_t): Term
  if addr.ss_family == 0 then return term_pak(iroh_mp_None,0) end
  return io_box(e,iroh_mp_Some,socket_candidate(e,addr))
end

local function listener_qad_addresses_run(e:Env, args:*[0]Term, work:*IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local listener = conn.listener
  if listener == nilptr or listener.discovery == nilptr or listener.qad_revision == args[1] then
    return io_tup(e,args[0],none(e))
  end
  local config = listener.discovery
  local addresses = io_tup(e,optional_observation(e,&config.v4.observed),optional_observation(e,&config.v6.observed))
  return io_tup(e,args[0],optional_id(e,io_tup(e,listener.qad_revision,addresses)))
end

local function qad_mapping_result(e:Env, previous:*storage_t, current:*storage_t): Term
  local old = term_pak(iroh_mp_None,0)
  if previous.ss_family ~= 0 then old = io_box(e,iroh_mp_Some,socket_candidate(e,previous)) end
  return optional_id(e,io_tup(e,old,socket_candidate(e,current)))
end

local function poll_routed_qad_run(e:Env, args:*[0]Term, work:*IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local config = conn.routed_discovery
  if config ~= nilptr then
    local previous:storage_t
    if poll_qad_route(conn.nat_route_v4,&config.v4,config.host,&previous) then
      return io_tup(e,args[0],qad_mapping_result(e,&previous,&config.v4.observed))
    end
    if poll_qad_route(conn.nat_route_v6,&config.v6,config.host,&previous) then
      return io_tup(e,args[0],qad_mapping_result(e,&previous,&config.v6.observed))
    end
  end
  return io_tup(e,args[0],none(e))
end

local function local_nat_candidate_run(e:Env, args:*[0]Term, work:*IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local addr = nat_local_address(conn)
  if addr == nilptr then return io_tup(e,args[0],io_fail(e,ENOTSUP,'no UDP source address is available')) end
  return io_tup(e,args[0],io_done(e,socket_candidate(e,addr)))
end

local function verified_nat_peer(conn:*Connection, peer:*storage_t, now:uint64): boolean
  for i = 0,<NAT_PROBE_CAPACITY do
    local probe = &conn.nat_inbox.probes[i]
    if probe.claimed and probe.expires > now and picoquic_compare_addr(&probe.peer,peer) == 0 then return true end
  end
  return false
end

local function open_nat_candidate(e:Env, conn:*Connection, args:*[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if conn.listener ~= nilptr or conn.nat_inbox == nilptr or not conn.ready then
    return io_fail(e,ENOTSUP,'a negotiated NAT traversal dialer is required')
  end
  local peer: storage_t
  if not nat_address(e,args,conn,&peer) then return io_fail(e,EINVAL,'invalid NAT candidate address') end
  local source = nat_socket_for_peer(conn,peer.ss_family)
  if source == nilptr or not source.unconnected or source.status == 3 then
    return io_fail(e,ENOTSUP,'the UDP probe socket is unavailable')
  end
  if not verified_nat_peer(conn,&peer,picoquic_current_time()) then
    return io_fail(e,EACCES,'NAT candidate has no recent authenticated response')
  end
  local existing = conn.paths
  while existing ~= nilptr do
    if existing.id ~= 0 and existing.status ~= 3 and existing.unconnected and
        picoquic_compare_addr(&source.local_addr,&existing.local_addr) == 0 and
        picoquic_compare_addr(&peer,&existing.peer) == 0 then return optional_id(e,existing.id) end
    existing = (@*Path)(existing.next)
  end
  if conn.path_count >= PATH_LIMIT then return io_fail(e,ENOBUFS,'too many active QUIC paths') end
  local path = (@*Path)(C.calloc(1,#Path))
  if path == nilptr then return io_fail(e,ENOMEM,nilptr) end
  -- Duplicate the descriptor so both logical paths retain the same UDP
  -- port and receive queue even when one path is retired.
  path.fd = fcntl(source.fd,F_DUPFD_CLOEXEC,0)
  if path.fd < 0 then
    local error = (@uint32)(errno)
    release_path(path)
    return io_fail(e,error,'could not retain the punched UDP socket')
  end
  path.unconnected = true
  path.local_addr = source.local_addr
  path.peer = peer
  return register_probed_path(e,conn,path)
end

local function open_nat_path_run(e:Env, args:*[0]Term, work:*IoWork): Term
  return io_tup(e,args[0],open_nat_candidate(e,find_connection(e,args[0]),args))
end

local function status_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = find_path(conn,args[1])
  if path == nilptr then
    local result = args[1] <= conn.last_path_id and io_done(e,3) or io_fail(e,EINVAL,'unknown QUIC path')
    return io_tup(e,args[0],result)
  end
  return io_tup(e,args[0],io_done(e,path.status))
end

local function path_timeouts_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local paths = (@*[0]*path_t)(conn.cnx.path)
  for i = 0,<conn.cnx.nb_paths do
    if paths[i].unique_path_id == args[1] then
      local count = paths[i].nb_retransmit
      return io_tup(e,args[0],io_done(e,count > 0xffffffff and 0xffffffff or count))
    end
  end
  return io_tup(e,args[0],io_fail(e,EINVAL,'unknown QUIC path'))
end

local function keepalive_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if args[1] == 0 then picoquic_disable_keep_alive(conn.cnx)
  else picoquic_enable_keep_alive(conn.cnx,args[1] * 1000) end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_Unit,0)))
end

local function probe_alternate(e: Env, conn: *Connection, args: *[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local current = find_path(conn,args[1])
  if conn.listener ~= nilptr or current == nilptr or current.status ~= 0 or conn.path_count >= PATH_LIMIT then
    return io_fail(e,EINVAL,'no unvalidated dialer path is available for another address')
  end
  local peer: storage_t
  local peer_size = numeric_argument(e,args[2],args[3],&peer)
  if peer_size == 0 or args[3] == 0 then return io_fail(e,EINVAL,'invalid alternate peer address') end
  local paths = (@*[0]*path_t)(conn.cnx.path)
  for i = 0,<conn.cnx.nb_paths do
    if paths[i].unique_path_id == current.id then
      local path,error = open_path(&peer,peer_size,nilptr,0)
      if path == nilptr then return io_fail(e,error,nilptr) end
      local status = picoquic_probe_new_tuple(conn.cnx,paths[i],&path.peer,&path.local_addr,0,picoquic_current_time(),0)
      if status ~= 0 then
        release_path(path)
        return io_fail(e,EIO,picoquic_error_name((@uint64)(status)))
      end
      path.id = current.id
      path.next = conn.paths
      conn.paths = path
      conn.path_count = conn.path_count + 1
      return io_done(e,term_pak(iroh_mp_Unit,0))
    end
  end
  return io_fail(e,EINVAL,'unknown QUIC path')
end

local function alternate_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],probe_alternate(e,find_connection(e,args[0]),args))
end

local function standby_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = find_path(conn,args[1])
  if path == nilptr or path.status == 3 or args[2] > 1 or conn.cnx.is_multipath_enabled == 0 then
    return io_tup(e,args[0],io_fail(e,EINVAL,'invalid QUIC standby path'))
  end
  local status = args[2] == 0 and picoquic_path_status_available or picoquic_path_status_backup
  if picoquic_set_path_status(conn.cnx,args[1],status) ~= 0 then
    return io_tup(e,args[0],io_fail(e,EIO,'could not update QUIC path preference'))
  end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_Unit,0)))
end

local function retire_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = find_path(conn,args[1])
  if path ~= nilptr and path.status ~= 3 and
      picoquic_abandon_path(conn.cnx,args[1],0,picoquic_current_time()) ~= 0 then
    return io_tup(e,args[0],io_fail(e,EIO,'could not retire QUIC path'))
  end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_Unit,0)))
end

local function micros_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return picoquic_current_time() & 0xffffffff
end

local function millis_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return (@uint32)(io_tick() // 1000000)
end

local function next_path_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = conn.paths
  local next: *Path
  while path ~= nilptr do
    if path.status == 1 and path.id > args[1] and (next == nilptr or path.id < next.id) then next = path end
    path = (@*Path)(path.next)
  end
  return io_tup(e,args[0],next == nilptr and none(e) or optional_id(e,next.id))
end

local function datagram_frame_limit(conn: *Connection): csize
  if not conn.ready then return 0 end
  local mtu = IO_CAPACITY
  local paths = (@*[0]*path_t)(conn.cnx.path)
  for i = 0, < conn.cnx.nb_paths do
    if paths[i].send_mtu < mtu then mtu = paths[i].send_mtu end
  end
  -- Reserve the short header, maximum connection ID and packet number, and AEAD tag.
  if mtu <= 41 then return 0 end
  local frame = mtu - 41
  local remote = conn.cnx.remote_parameters.max_datagram_frame_size
  if remote < frame then frame = remote end
  return frame
end

local function limit_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local frame = datagram_frame_limit(conn)
  local payload: Term = 0
  if frame >= 67 then
    payload = frame - 3
  elseif frame >= 65 then
    payload = 63
  elseif frame >= 2 then
    payload = frame - 2
  end
  return io_tup(e,args[0],io_done(e,payload))
end

local function write_datagram(e: Env, conn: *Connection, payload: Term): Term
  local bytes: [IO_CAPACITY]uint8
  local size = bytes_from_list(e,payload,&bytes[0],IO_CAPACITY)
  if size == -1 then return io_fail(e,EINVAL,'invalid QUIC datagram bytes') end
  if size < 0 then return io_fail(e,EMSGSIZE,'QUIC datagram exceeds packet capacity') end
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not conn.ready then return io_done(e,0) end
  if conn.cnx.remote_parameters.max_datagram_frame_size == 0 then
    return io_fail(e,ENOTSUP,'peer did not negotiate QUIC datagrams')
  end
  local overhead: csize = size >= 64 and 3 or 2
  if (@csize)(size) + overhead > datagram_frame_limit(conn) then
    return io_fail(e,EMSGSIZE,'QUIC datagram exceeds the negotiated path limit')
  end
  local item = conn.cnx.first_datagram
  local queued: uint32 = 0
  while item ~= nilptr do
    queued = queued + 1
    if queued >= DATAGRAM_QUEUE_LIMIT then return io_done(e,0) end
    item = (@*frame_t)(item.next_misc_frame)
  end
  local status = picoquic_queue_datagram_frame(conn.cnx,(@csize)(size),&bytes[0])
  if status == PICOQUIC_ERROR_DATAGRAM_TOO_LONG then return io_fail(e,EMSGSIZE,'QUIC datagram exceeds path size') end
  if status ~= 0 then return io_fail(e,EIO,picoquic_error_name((@uint64)(status))) end
  return io_done(e,1)
end

local function write_datagram_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write_datagram(e,find_connection(e,args[0]),args[1]))
end

local function early_window(conn: *Connection): boolean
  if not conn.early or conn.early_decided or conn.ready then return false end
  local state = picoquic_get_cnx_state(conn.cnx)
  return (state == picoquic_state_client_init or state == picoquic_state_client_init_sent) and
    picoquic_is_0rtt_available(conn.cnx) ~= 0
end

local function write_early_frame(e: Env, conn: *Connection, payload: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not early_window(conn) then return io_done(e,0) end
  local cnx = conn.cnx
  if cnx.first_misc_frame ~= nilptr then return io_done(e,0) end
  if conn.resume.datagram_limit == 0 then
    return io_fail(e,ENOTSUP,'session peer did not negotiate QUIC datagrams')
  end
  local bytes: [IO_CAPACITY]uint8
  local size = bytes_from_list(e,payload,&bytes[0],IO_CAPACITY)
  if size == -1 or (size >= 0 and size < 2) then
    return io_fail(e,EINVAL,'invalid early QUIC datagram frame')
  end
  -- Reserve room for the 0-RTT long header, both connection IDs, and the AEAD tag.
  if size < 0 or (@uint64)(size) > conn.resume.datagram_limit or
      (@csize)(size) + 80 > ((@*[0]*path_t)(cnx.path))[0].send_mtu then
    return io_fail(e,EMSGSIZE,'early QUIC datagram exceeds the remembered path limit')
  end
  local frame = (@*[0]uint8)(&bytes[0])
  local frame_type: uint8
  local length: uint64
  local limit = &frame[size]
  local body = picoquic_decode_datagram_frame_header(&bytes[0],limit,&frame_type,&length)
  if body == nilptr or frame_type ~= 49 or (@usize)(limit) - (@usize)(body) ~= length then
    return io_fail(e,EINVAL,'invalid early QUIC datagram frame')
  end
  local queued = picoquic_queue_misc_frame(cnx,&bytes[0],(@csize)(size),0,picoquic_packet_context_application)
  if queued ~= 0 then return io_fail(e,EIO,picoquic_error_name((@uint64)(queued))) end
  -- Packetize without reading a peer response. Remove the frame if it did not
  -- fit so a later handshake flight can never send it as a 1-RTT datagram.
  local error = write_packet(conn,picoquic_current_time())
  local sent: Term = 1
  if cnx.first_misc_frame ~= nilptr then
    picoquic_delete_misc_or_dg(&cnx.first_misc_frame,&cnx.last_misc_frame,cnx.first_misc_frame)
    sent = 0
  end
  if error ~= 0 then return io_fail(e,error,'QUIC early packet I/O failed') end
  return io_done(e,sent)
end

local function write_early_frame_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write_early_frame(e,find_connection(e,args[0]),args[1]))
end

local function read_datagram_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready or conn.datagram_first == nilptr then
    return io_tup(e,args[0],conn.closed and closed_error(e,conn) or none(e))
  end
  local item = conn.datagram_first
  local bytes = io_list(e,(@cstring)(datagram_bytes(item)),item.size)
  pop_datagram(conn)
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,bytes)))
end

local function open_stream(e: Env, conn: *Connection, direction: Term, early: boolean): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if early then
    if not early_window(conn) then return none(e) end
  elseif not conn.ready then
    return none(e)
  end
  if direction > 1 then return io_fail(e,EINVAL,'invalid QUIC stream direction') end
  if conn.stream_count >= STREAM_LIMIT then return io_fail(e,ENOBUFS,'too many open QUIC streams') end
  local id = picoquic_get_next_local_stream_id(conn.cnx,(@cint)(direction))
  if id > 0xffffffff then return io_fail(e,ENOBUFS,'QUIC stream IDs exhausted') end
  if early then
    local limit = direction == 0 and conn.resume.streams_bidi or conn.resume.streams_uni
    if id // 4 >= limit then return none(e) end
  end
  local stream = (@*Stream)(C.calloc(1,#Stream))
  if stream == nilptr then return io_fail(e,ENOMEM,nilptr) end
  if picoquic_set_app_stream_ctx(conn.cnx,id,stream) ~= 0 then
    C.free(stream)
    return none(e)
  end
  stream.id = (@uint32)(id)
  stream.early = early
  stream.accepted = not early
  stream.next = conn.streams
  conn.streams = stream
  conn.stream_count = conn.stream_count + 1
  return optional_id(e,early and term_pak(iroh_mp_MultipathEarlyStream,id) or id)
end

local function open_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],open_stream(e,find_connection(e,args[0]),args[1],false))
end

local function open_early_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],open_stream(e,find_connection(e,args[0]),args[1],true))
end

local function resolve_early_stream(e: Env, conn: *Connection, id: uint64): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not conn.ready then return io_fail(e,EAGAIN,'QUIC handshake is incomplete') end
  local stream = find_stream(conn,id)
  if conn.cnx.zero_rtt_data_accepted == 0 or stream == nilptr or not stream.early then return none(e) end
  stream.accepted = true
  return optional_id(e,id)
end

local function resolve_early_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],resolve_early_stream(e,find_connection(e,args[0]),
    handle_id(e,args[1],iroh_mp_MultipathEarlyStream)))
end

local function accept_stream(e: Env, conn: *Connection, direction: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if direction > 1 then return io_fail(e,EINVAL,'invalid QUIC stream direction') end
  if not conn.ready then return none(e) end
  local stream = conn.streams
  local ready: *Stream
  while stream ~= nilptr do
    if stream.incoming and not stream.accepted and (stream.id & 2) == direction * 2 and
        (ready == nilptr or stream.id < ready.id) then
      ready = stream
    end
    stream = (@*Stream)(stream.next)
  end
  if ready == nilptr then return none(e) end
  ready.accepted = true
  return optional_id(e,ready.id)
end

local function accept_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],accept_stream(e,find_connection(e,args[0]),args[1]))
end

local function assign(e: Env, conn: *Connection, stream_id: Term, path_id: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local stream = find_stream(conn,stream_id)
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  local selected: uint64 = 0xffffffffffffffff
  if path_id ~= 0xffffffff then
    local path = find_path(conn,path_id)
    if path == nilptr or path.status ~= 1 then return io_fail(e,EINVAL,'QUIC path is unavailable') end
    selected = path_id
  end
  if picoquic_set_stream_path_affinity(conn.cnx,stream_id,selected) ~= 0 then
    return io_fail(e,EPIPE,'could not assign the QUIC stream to the path')
  end
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function assign_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],assign(e,find_connection(e,args[0]),args[1],args[2]))
end

local function write_stream(e: Env, conn: *Connection, id: Term, payload: Term, fin: Term, early: boolean): Term
  local bytes: [STREAM_CHUNK]uint8
  local size = bytes_from_list(e,payload,&bytes[0],STREAM_CHUNK)
  if size < 0 or fin > 1 then return io_fail(e,EINVAL,'invalid or oversized QUIC stream write') end
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local stream = find_stream(conn,id)
  if early then
    if stream == nilptr or not stream.early then return io_fail(e,EBADF,'unknown early QUIC stream') end
    if not early_window(conn) then return io_done(e,0) end
  elseif stream == nilptr or not stream.accepted then
    return io_fail(e,EBADF,'unknown QUIC stream')
  end
  if stream.incoming and (id & 2) ~= 0 then return io_fail(e,EPIPE,'QUIC stream is receive-only') end
  if stream.sent_fin or stream.stop or stream.tx_reset then return io_fail(e,EPIPE,'QUIC stream send half closed') end
  if conn.cnx.nb_bytes_queued + (@uint64)(size) > TX_LIMIT then return io_done(e,0) end
  if picoquic_add_to_stream_with_ctx(conn.cnx,id,&bytes[0],(@csize)(size),(@cint)(fin),stream) ~= 0 then
    return io_fail(e,EPIPE,'could not queue QUIC stream bytes')
  end
  stream.sent_fin = fin == 1
  return io_done(e,1)
end

local function write_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write_stream(e,find_connection(e,args[0]),args[1],args[2],args[3],false))
end

local function write_early_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local result = write_stream(e,find_connection(e,args[0]),handle_id(e,args[1],iroh_mp_MultipathEarlyStream),
    args[2],args[3],true)
  return io_tup(e,args[0],io_tup(e,args[1],result))
end

local function read_stream(e: Env, conn: *Connection, id: Term, max: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if max == 0 then return io_fail(e,EINVAL,'QUIC stream read limit must be positive') end
  local stream = find_stream(conn,id)
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  if not stream.incoming and (id & 2) ~= 0 then return io_fail(e,EPIPE,'QUIC stream is send-only') end
  if stream.rx_stopped or stream.read_finished then return io_done(e,term_pak(iroh_mp_MultipathReadFin,0)) end
  if stream.reset then
    stream.read_finished = true
    return io_fail(e,ECONNRESET,'QUIC stream reset by peer')
  end
  if stream.size == 0 then
    stream.read_finished = stream.fin
    return io_done(e,term_pak(stream.fin and iroh_mp_MultipathReadFin or iroh_mp_MultipathReadPending,0))
  end
  local size = stream.size
  if size > max then size = (@csize)(max) end
  local bytes = io_list(e,(@cstring)(stream.rx),size)
  stream.size = stream.size - size
  conn.received = conn.received - size
  if stream.size > 0 then
    C.memmove(stream.rx,&stream.rx[size],stream.size)
  else
    C.free(stream.rx)
    stream.rx = nilptr
  end
  return io_done(e,io_box(e,iroh_mp_MultipathReadBytes,bytes))
end

local function read_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],read_stream(e,find_connection(e,args[0]),args[1],args[2]))
end

local function has_stream_half(stream: *Stream, half: Term): boolean
  return (stream.id & 2) == 0 or stream.incoming == (half == 1)
end

local function cancel_half(e: Env, conn: *Connection, id: Term, half: Term, high: Term, low: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if half > 1 or high > 0x3fffffff then return io_fail(e,EINVAL,'invalid QUIC stream cancellation') end
  local stream = find_stream(conn,id)
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  if not has_stream_half(stream,half) then return io_fail(e,EPIPE,'QUIC stream has no such half') end
  local code = (high << 32) | low
  if half == 0 then
    if stream.tx_reset or stream.stop or picoquic_reset_stream(conn.cnx,id,code) ~= 0 then
      return io_fail(e,EPIPE,'QUIC stream send half is closed')
    end
    stream.tx_reset = true
  else
    if stream.rx_stopped or stream.read_finished then return io_fail(e,EPIPE,'QUIC stream receive half is closed') end
    if not stream.reset and not stream.fin and picoquic_stop_sending(conn.cnx,id,code) ~= 0 then
      return io_fail(e,EPIPE,'could not stop the QUIC stream')
    end
    stream.rx_stopped = true
    discard_received(conn,stream)
  end
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function cancel_half_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],cancel_half(e,find_connection(e,args[0]),args[1],args[2],args[3],args[4]))
end

local function peer_code(e: Env, conn: *Connection, id: Term, half: Term): Term
  if conn == nilptr then return closed_error(e,conn) end
  local stream = find_stream(conn,id)
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  if half > 1 or not has_stream_half(stream,half) then return io_fail(e,EPIPE,'QUIC stream has no such half') end
  if (half == 0 and stream.stop) or (half == 1 and stream.reset) then
    local code = half == 0 and stream.stop_code or stream.reset_code
    local value = io_tup(e,code >> 32,(@uint32)(code))
    return io_done(e,io_box(e,iroh_mp_Some,value))
  end
  if conn.closed then return closed_error(e,conn) end
  return none(e)
end

local function peer_code_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],peer_code(e,find_connection(e,args[0]),args[1],args[2]))
end

local function drop_stream(e: Env, conn: *Connection, id: Term): Term
  if conn == nilptr then return closed_error(e,conn) end
  local stream = conn.streams
  local previous: *Stream
  while stream ~= nilptr and stream.id ~= id do
    previous = stream
    stream = (@*Stream)(stream.next)
  end
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  if not conn.closed then
    local bidi = (id & 2) == 0
    if (bidi or not stream.incoming) and not stream.sent_fin and not stream.stop and not stream.tx_reset then
      picoquic_reset_stream(conn.cnx,id,0)
    end
    if (bidi or stream.incoming) and not stream.fin and not stream.reset and not stream.rx_stopped then picoquic_stop_sending(conn.cnx,id,0) end
    local native = picoquic_find_stream(conn.cnx,id)
    if native ~= nilptr then native.app_stream_ctx = &discarded_stream end
  end
  if previous == nilptr then conn.streams = (@*Stream)(stream.next) else previous.next = stream.next end
  conn.stream_count = conn.stream_count - 1
  discard_received(conn,stream)
  C.free(stream)
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function drop_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],drop_stream(e,find_connection(e,args[0]),args[1]))
end

local function close_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn ~= nilptr then
    if not conn.detached and not conn.closed and picoquic_close(conn.cnx,0) == 0 then write_packet(conn,picoquic_current_time()) end
    remove_connection(conn)
  end
  return term_pak(iroh_mp_Unit,0)
end

