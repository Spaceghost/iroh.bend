local iroh_mp_resolve_multipath_early_stream: uint32 <cimport,nodecl>
local iroh_mp_assign_stream_path: uint32 <cimport,nodecl>
local iroh_mp_write_multipath_stream: uint32 <cimport,nodecl>
local iroh_mp_read_multipath_stream: uint32 <cimport,nodecl>
local iroh_mp_drop_multipath_stream: uint32 <cimport,nodecl>
local iroh_mp_close_multipath: uint32 <cimport,nodecl>
local iroh_mp_bind_multipath: uint32 <cimport,nodecl>
local iroh_mp_bind_multipath_nat_offer: uint32 <cimport,nodecl>
local iroh_mp_bind_multipath_bytes: uint32 <cimport,nodecl>
local iroh_mp_bind_multipath_alpns: uint32 <cimport,nodecl>
local iroh_mp_set_multipath_alpns: uint32 <cimport,nodecl>
local iroh_mp_accept_multipath: uint32 <cimport,nodecl>
local iroh_mp_close_multipath_listener: uint32 <cimport,nodecl>
local iroh_mp_accept_multipath_stream: uint32 <cimport,nodecl>
local iroh_mp_next_multipath_path: uint32 <cimport,nodecl>
local iroh_mp_multipath_datagram_limit: uint32 <cimport,nodecl>
local iroh_mp_write_multipath_datagram: uint32 <cimport,nodecl>
local iroh_mp_write_multipath_early_frame: uint32 <cimport,nodecl>
local iroh_mp_read_multipath_datagram: uint32 <cimport,nodecl>
local iroh_mp_MultipathConnection: uint32 <cimport,nodecl>
local iroh_mp_MultipathListener: uint32 <cimport,nodecl>
local iroh_mp_MultipathReadPending: uint32 <cimport,nodecl>
local iroh_mp_MultipathReadFin: uint32 <cimport,nodecl>
local iroh_mp_MultipathReadBytes: uint32 <cimport,nodecl>
local iroh_mp_Some: uint32 <cimport,nodecl>
local iroh_mp_None: uint32 <cimport,nodecl>
local iroh_mp_Unit: uint32 <cimport,nodecl>
local iroh_mp_Con: uint32 <cimport,nodecl>
local iroh_mp_Nil: uint32 <cimport,nodecl>

local Env <cimport,nodecl> = @record{mem: *[0]uint64}
local IoWork <cimport,nodecl> = @record{}
local Term = @uint64
local Effect = @function(Env,*[0]Term,*IoWork): Term
local function io_eff(tag: uint32, run: Effect) <cimport,nodecl> end
local function io_tick(): uint64 <cimport,nodecl> end
local function io_cstr(e: Env, term: Term, size: *uint64): cstring <cimport,nodecl> end
local function io_nul(value: cstring, size: uint64): boolean <cimport,nodecl> end
local function io_done(e: Env, value: Term): Term <cimport,nodecl> end
local function io_fail(e: Env, code: uint32, message: cstring): Term <cimport,nodecl> end
local function io_tup(e: Env, a: Term, b: Term): Term <cimport,nodecl> end
local function io_box(e: Env, tag: uint64, value: Term): Term <cimport,nodecl> end
local function io_list(e: Env, bytes: cstring, size: uint64): Term <cimport,nodecl> end
local function term_pak(tag: uint64, value: uint64): Term <cimport,nodecl> end
local function term_aux(t: Term): uint64 <cimport,nodecl> end
local function term_loc(t: Term): uint64 <cimport,nodecl> end
local function term_tag(t: Term): uint64 <cimport,nodecl> end
local function term_peek(mem: *[0]Term, t: Term): uint64 <cimport,nodecl> end
local function ctr_take(e: Env, t: Term, size: uint32, fields: *Term): uint64 <cimport,nodecl> end
local function spare_free(e: Env, class: uint32, loc: uint64) <cimport,nodecl> end
local function cls_fit(size: uint32): uint32 <cimport,nodecl> end
local TAG_CTR: uint64 <cimport,nodecl>
local TAG_PAK: uint64 <cimport,nodecl>

local IO_CAPACITY: csize <comptime> = 1536
local STREAM_CHUNK: csize <comptime> = 65536
local RX_LIMIT: csize <comptime> = 4 * 1024 * 1024
local TX_LIMIT: uint64 <comptime> = 4 * 1024 * 1024
local PATH_LIMIT: uint32 <comptime> = 8
local STREAM_LIMIT: uint32 <comptime> = 128
local LISTENER_LIMIT: uint32 <comptime> = 64
local SESSION_LIMIT: uint32 <comptime> = 256
local HANDSHAKE_LIMIT: uint64 <comptime> = 10000000
local DATAGRAM_QUEUE_LIMIT: uint32 <comptime> = 64
local NAT_PARAMETER_SIZE: csize <comptime> = 10
local Listener = @record{
  next: pointer, id: uint32, fd: cint, quic: *quic_t, local_addr: storage_t,
  refs: uint32, stopped: boolean,
  nat_offer: [NAT_PARAMETER_SIZE]uint8, sends_nat_offer: boolean
}
local Path = @record{
  next: pointer, fd: cint, local_addr: storage_t, peer: storage_t,
  id: uint32, status: uint32
}
local Stream = @record{
  next: pointer, id: uint32, rx: *[0]uint8, size: csize,
  incoming: boolean, accepted: boolean, fin: boolean, sent_fin: boolean, reset: boolean, stop: boolean, early: boolean
}
local Datagram = @record{next:pointer,size:csize}
local Alpn = @record{next:pointer, wire:[258]uint8, size:csize, has_nul:boolean, retained:boolean}
local PeerParameters = @record{bytes:*uint8, size:csize}
local PendingHandshake = @record{alpn:*Alpn, parameters:PeerParameters, extensions:*uint8}
local Session = @record{
  next: pointer, id: uint32, ticket: *uint8, length: csize,
  local_key: [32]uint8, peer_key: [32]uint8, alpn: [255]uint8, alpn_length: csize, datagram_limit: uint32,
  max_data:uint64,stream_bidi_local:uint64,stream_bidi_remote:uint64,stream_uni:uint64,streams_bidi:uint64,streams_uni:uint64,
  active_connection_id_limit:uint32,max_packet_size:uint32
}
local Connection = @record{
  next: pointer, quic: *quic_t, cnx: *cnx_t, id: uint32,
  paths: *Path, path_count: uint32, last_path_id: uint32, streams: *Stream, stream_count: uint32,
  received: csize, output: [IO_CAPACITY]uint8, output_size: csize, output_path: *Path,
  output_peer: storage_t, listener: *Listener, accepted: boolean,
  datagram_first: *Datagram, datagram_last: *Datagram, datagram_count: uint32,
  selected_alpn: *Alpn, peer_parameters: PeerParameters, ready: boolean, closed: boolean, buffer_error: boolean,
  ticket: *Session, resume: *Session, local_key: [32]uint8, peer_key: [32]uint8,
  early: boolean, early_decided: boolean
}
local connections: *Connection
local next_connection: uint32 = 1
local listeners: *Listener
local next_listener: uint32 = 1
local discarded_stream: uint8
local sessions: *Session
local next_session: uint32 = 1
local active_sessions: uint32

local function free_session(session: *Session)
  if session == nilptr then return end
  OPENSSL_cleanse(session.ticket,session.length)
  C.free(session.ticket)
  C.free(session)
end

local function bytes_from_list(e: Env, item: Term, out: *uint8, limit: csize): isize
  local bytes = (@*[0]uint8)(out)
  local size: csize = 0
  while term_tag(item) == TAG_CTR and term_aux(item) == iroh_mp_Con do
    local cells: [2]Term
    local location = ctr_take(e,item,2,&cells[0])
    if location ~= 0 then spare_free(e,cls_fit(2),location) end
    if size >= limit then return -2 end
    if cells[0] > 255 then return -1 end
    bytes[size] = (@uint8)(cells[0])
    size = size + 1
    item = cells[1]
  end
  if term_aux(item) ~= iroh_mp_Nil then return -1 end
  return (@isize)(size)
end

local function read_alpn(e: Env, term: Term, binary: boolean, out: *uint8): isize
  if binary then return bytes_from_list(e,term,out,255) end
  local size: uint64
  local text = io_cstr(e,term,&size)
  defer C.free(text) end
  if size > 255 then return -1 end
  C.memcpy(out,text,size)
  return (@isize)(size)
end

local function free_alpns(first: *Alpn)
  while first ~= nilptr do
    local next = (@*Alpn)(first.next)
    C.free(first)
    first = next
  end
end

local function make_alpn(e: Env, term: Term, binary: boolean): *Alpn
  local name: [255]uint8
  local len = read_alpn(e,term,binary,&name[0])
  if len <= 0 then return nilptr end
  local alpn = (@*Alpn)(C.calloc(1,#Alpn))
  if alpn == nilptr then return nilptr end
  alpn.size = (@csize)(len)
  -- RFC 7301 wraps one selected name in a two-byte list length and a one-byte name length.
  alpn.wire[0] = (@uint8)((len + 1) >> 8)
  alpn.wire[1] = (@uint8)(len + 1)
  alpn.wire[2] = (@uint8)(len)
  C.memcpy(&alpn.wire[3],&name[0],alpn.size)
  alpn.has_nul = C.memchr(&name[0],0,alpn.size) ~= nilptr
  return alpn
end

local function read_alpns(e: Env, term: Term, mode: uint32): *Alpn
  if mode ~= 2 then return make_alpn(e,term,mode == 1) end
  local first: *Alpn
  local tail: *Alpn
  local total: csize = 0
  while term_tag(term) == TAG_CTR and term_aux(term) == iroh_mp_Con do
    local cells: [2]Term
    local location = ctr_take(e,term,2,&cells[0])
    if location ~= 0 then spare_free(e,cls_fit(2),location) end
    local next = make_alpn(e,cells[0],true)
    if next == nilptr or total + next.size + 1 > 65533 then
      free_alpns(next)
      free_alpns(first)
      return nilptr
    end
    total = total + next.size + 1
    if tail == nilptr then first = next else tail.next = next end
    tail = next
    term = cells[1]
  end
  if term_aux(term) == iroh_mp_Nil then return first end
  free_alpns(first)
  return nilptr
end

local VerifyCallback = @function(*verify_t,*tls_t,cstring,pointer,pointer,*iov_t,csize): cint
local PinnedKey = @record{
  backend: pin_t, original: VerifyCallback, response: [4]ext_t, raw_type: uint8,
  alpns: *Alpn, retired: *Alpn, selected: *Alpn, check_extension: extension_cb_t,
  peer_parameters: PeerParameters
}

local function pinned(quic: *quic_t): *PinnedKey
  return (@*PinnedKey)((@*context_t)(quic.tls_master_ctx).verify_certificate)
end

local function save_parameters(out: *PeerParameters, data: iov_t): cint
  local copy: *uint8
  if data.len ~= 0 then
    copy = (@*uint8)(C.malloc(data.len))
    if copy == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
    C.memcpy(copy,data.base,data.len)
  end
  C.free(out.bytes)
  $out = {bytes=copy,size=data.len}
  return 0
end

local function pending_handshake(cnx: *cnx_t, listener: pointer): *PendingHandshake
  local context = picoquic_get_callback_context(cnx)
  if context == listener then return nilptr end
  return (@*PendingHandshake)(context)
end

local function discard_handshake(cnx: *cnx_t, listener: pointer)
  local pending = pending_handshake(cnx,listener)
  if pending == nilptr then return end
  picoquic_set_callback(cnx,(@pointer)(picoquic_get_callback_function(cnx)),listener)
  C.free(pending.parameters.bytes)
  C.free(pending.extensions)
  C.free(pending)
end

local function select_alpn(quic: *quic_t, offers: *iov_t, count: csize): csize
  local pin = pinned(quic)
  local cnx = (@*cnx_t)(quic.cnx_in_progress)
  if cnx == nilptr then return count end
  local list = (@*[0]iov_t)(offers)
  local name = pin.alpns
  while name ~= nilptr do
    for i = 0,<count do
      if list[i].len == name.size and C.memcmp(list[i].base,&name.wire[3],name.size) == 0 then
        local listener = picoquic_get_default_callback_context(quic)
        local pending = pending_handshake(cnx,listener)
        if pending == nilptr then
          pending = (@*PendingHandshake)(C.calloc(1,#PendingHandshake))
          if pending == nilptr then return count end
          picoquic_set_callback(cnx,(@pointer)(picoquic_get_callback_function(cnx)),pending)
        end
        pending.alpn = name
        return i
      end
    end
    name = (@*Alpn)(name.next)
  end
  return count
end

local function check_client_extension(cb: *extension_self, tls: *tls_t, message: uint8, kind: uint16, data: iov_t): cint
  if message ~= PTLS_HANDSHAKE_TYPE_ENCRYPTED_EXTENSIONS then return 0 end
  local pin = (@*PinnedKey)(ptls_get_context(tls).verify_certificate)
  if kind == QUIC_TRANSPORT_EXTENSION and iroh_mp_peer_multipath_parameters ~= 0xffffffff then
    return save_parameters(&pin.peer_parameters,data)
  end
  if kind ~= ALPN_EXTENSION then return 0 end
  local name = pin.alpns
  while name ~= nilptr do
    if data.len == name.size + 3 and C.memcmp(data.base,&name.wire[0],data.len) == 0 then
      pin.selected = name
      return 0
    end
    name = (@*Alpn)(name.next)
  end
  return PTLS_ALERT_NO_APPLICATION_PROTOCOL
end

local function verify_raw(self: *verify_t, tls: *tls_t, server: cstring,
    verify_sign: pointer, verify_data: pointer, certs: *iov_t, count: csize): cint
  if count ~= 1 then return PTLS_ALERT_BAD_CERTIFICATE end
  local pin = (@*PinnedKey)(self)
  return pin.original(self,tls,server,verify_sign,verify_data,certs,count)
end

local function free_pin(verify: *verify_t)
  local pin = (@*PinnedKey)(verify)
  ptls_openssl_raw_pubkey_dispose_verify_certificate(&pin.backend)
  free_alpns(pin.alpns)
  free_alpns(pin.retired)
  C.free(pin.peer_parameters.bytes)
  C.free(pin)
end

local function install_identity(quic: *quic_t, seed: *uint8, peer: *uint8, alpns: **Alpn, public_key: *uint8): boolean
  local private = EVP_PKEY_new_raw_private_key_ex(nilptr,'ED25519',nilptr,seed,32)
  if private == nilptr then return false end
  defer EVP_PKEY_free(private) end
  local ctx = (@*context_t)(quic.tls_master_ctx)
  local signer = (@*signer_t)(C.malloc(IROH_MP_SIGN_SIZE))
  if signer == nilptr then return false end
  if ptls_openssl_init_sign_certificate(signer,private) ~= 0 then
    C.free(signer)
    return false
  end
  ctx.sign_certificate = signer
  local cert = (@*iov_t)(C.malloc(#iov_t))
  if cert == nilptr then return false end
  cert.base = (@*uint8)(C.malloc(44))
  if cert.base == nilptr then
    C.free(cert)
    return false
  end
  local out = cert.base
  if i2d_PUBKEY(private,&out) ~= 44 then
    C.free(cert.base)
    C.free(cert)
    return false
  end
  if public_key ~= nilptr then
    local key_length: csize = 32
    if EVP_PKEY_get_raw_public_key(private,public_key,&key_length) ~= 1 or key_length ~= 32 then
      C.free(cert.base)
      C.free(cert)
      return false
    end
  end
  cert.len = 44
  picoquic_set_tls_certificate_chain(quic,cert,1)
  local public = EVP_PKEY_new_raw_public_key_ex(nilptr,'ED25519',nilptr,peer,32)
  if public == nilptr then return false end
  defer EVP_PKEY_free(public) end
  local pin = (@*PinnedKey)(C.calloc(1,#PinnedKey))
  if pin == nilptr then return false end
  if ptls_openssl_raw_pubkey_init_verify_certificate(&pin.backend,public) ~= 0 then
    C.free(pin)
    return false
  end
  pin.original = (@VerifyCallback)(pin.backend.super.cb)
  pin.backend.super.cb = (@pointer)(verify_raw)
  pin.alpns = $alpns
  $alpns = nilptr
  pin.check_extension.cb = check_client_extension
  ctx.on_extension = &pin.check_extension
  picoquic_set_verify_certificate_callback(quic,&pin.backend.super,(@pointer)(free_pin))
  picoquic_set_client_cert_verification_policy(quic,1)
  ctx.use_raw_public_keys = 1
  return true
end

local function picoquic_tls_collected_extensions_cb(tls: *tls_t, props: *props_t, slots: *ext_t): cint <cimport> end

local function collect_server_extension(tls: *tls_t, props: *props_t, kind: uint16): cint
  return (kind == 19 or kind == QUIC_TRANSPORT_EXTENSION) and 1 or 0
end

local function server_extensions(tls: *tls_t, props: *props_t, slots: *ext_t): cint
  local parsed = picoquic_tls_collected_extensions_cb(tls,props,slots)
  if parsed ~= 0 then return parsed end
  local extensions = (@*[0]ext_t)(slots)
  local transport: *ext_t
  local has_raw: boolean
  local i: csize = 0
  while extensions[i].type ~= 65535 do
    local ext = &extensions[i]
    if ext.type == QUIC_TRANSPORT_EXTENSION then
      transport = ext
    elseif ext.type == 19 and ext.data.len > 0 then
      local offered = (@*[0]uint8)(ext.data.base)
      if offered[0] ~= ext.data.len - 1 then return PTLS_ALERT_UNSUPPORTED_CERTIFICATE end
      for at = 1, < ext.data.len do
        if offered[at] == 2 then has_raw = true end
      end
    end
    i = i + 1
  end
  if transport == nilptr then return 0 end
  if not has_raw then return PTLS_ALERT_UNSUPPORTED_CERTIFICATE end
  if props.additional_extensions == nilptr or props.additional_extensions.type ~= QUIC_TRANSPORT_EXTENSION then
    return PTLS_ALERT_INTERNAL_ERROR
  end
  -- The extension is consumed by picotls during this handshake call.
  local pin = (@*PinnedKey)(ptls_get_context(tls).verify_certificate)
  pin.raw_type = 2
  pin.response[0] = ((@*[0]ext_t)(props.additional_extensions))[0]
  pin.response[1] = {type=19,data={base=&pin.raw_type,len=1}}
  pin.response[2] = {type=65535}
  local data = ptls_get_data_ptr(tls)
  local cnx = (@*cnx_t)($data)
  if cnx == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
  local listener = (@*Listener)(picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx)))
  local pending = pending_handshake(cnx,listener)
  if pending == nilptr then return PTLS_ALERT_NO_APPLICATION_PROTOCOL end
  if listener.sends_nat_offer then
    local base = pin.response[0].data
    if base.len > 65535 - NAT_PARAMETER_SIZE then return PTLS_ALERT_INTERNAL_ERROR end
    local merged = (@*uint8)(C.malloc(base.len + NAT_PARAMETER_SIZE))
    if merged == nilptr then return PTLS_ALERT_INTERNAL_ERROR end
    C.memcpy(merged,base.base,base.len)
    C.memcpy(&((@*[0]uint8)(merged))[base.len],&listener.nat_offer[0],NAT_PARAMETER_SIZE)
    C.free(pending.extensions)
    pending.extensions = merged
    pin.response[0].data = {base=merged,len=base.len + NAT_PARAMETER_SIZE}
  end
  if iroh_mp_peer_multipath_parameters ~= 0xffffffff then
    local status = save_parameters(&pending.parameters,transport.data)
    if status ~= 0 then return status end
  end
  local name = pending.alpn
  if name.has_nul then
    -- picotls serializes its built-in ALPN with strlen. Supply the selected bytes as an extension.
    local status = ptls_set_negotiated_protocol(tls,nilptr,0)
    if status ~= 0 then return status end
    pin.response[2] = {type=ALPN_EXTENSION,data={base=&name.wire[0],len=name.size + 3}}
    pin.response[3] = {type=65535}
  end
  props.additional_extensions = &pin.response[0]
  return 0
end

local function with_rpk_selection(tls: *tls_t, buf: *buffer_t, offsets: *csize, epoch: csize,
    bytes: pointer, len: csize, props: *props_t): cint
  local collect, collected = props.collect_extension,props.collected_extensions
  local previous = props.additional_extensions
  props.collect_extension = (@pointer)(collect_server_extension)
  props.collected_extensions = (@pointer)(server_extensions)
  local status = real_tls(tls,buf,offsets,epoch,bytes,len,props)
  props.collect_extension = collect
  props.collected_extensions = collected
  props.additional_extensions = previous
  return status
end

local function client_rpk_message(tls:*tls_t, buf:*buffer_t, offsets:*csize, epoch:csize, bytes:pointer,len:csize,
    props:*props_t):cint
  if props.additional_extensions == nilptr then return real_tls(tls,buf,offsets,epoch,bytes,len,props) end
  -- Offer the client raw key on every ClientHello, including after HelloRetryRequest.
  -- RFC 7250 client_certificate_type contains a single RawPublicKey entry.
  local offer: [2]uint8 = {1,2}
  local extensions:[3]ext_t
  local original = props.additional_extensions
  local upstream = (@*[0]ext_t)(original)
  if upstream[0].type ~= QUIC_TRANSPORT_EXTENSION or upstream[1].type ~= 65535 then
    return real_tls(tls,buf,offsets,epoch,bytes,len,props)
  end
  extensions[0] = upstream[0]
  extensions[1] = {type=19,data={base=&offer[0],len=2}}
  extensions[2] = {type=65535}
  props.additional_extensions = &extensions[0]
  local result = real_tls(tls,buf,offsets,epoch,bytes,len,props)
  props.additional_extensions = original
  return result
end

local function restore_early_limits(cnx:*cnx_t, session:*Session)
  local remote = &cnx.remote_parameters
  remote.initial_max_data = session.max_data
  remote.initial_max_stream_data_bidi_local = session.stream_bidi_local
  remote.initial_max_stream_data_bidi_remote = session.stream_bidi_remote
  remote.initial_max_stream_data_uni = session.stream_uni
  remote.initial_max_streams_bidi = session.streams_bidi
  remote.initial_max_streams_uni = session.streams_uni
  remote.max_datagram_frame_size = session.datagram_limit
  remote.active_connection_id_limit = session.active_connection_id_limit
  remote.max_packet_size = session.max_packet_size
  local path = ((@*[0]*path_t)(cnx.path))[0]
  if session.max_packet_size < path.send_mtu then path.send_mtu = session.max_packet_size end
end

local function accepted_early_limits(cnx:*cnx_t, session:*Session):boolean
  local remote = &cnx.remote_parameters
  return remote.initial_max_data >= session.max_data and
    remote.initial_max_stream_data_bidi_local >= session.stream_bidi_local and
    remote.initial_max_stream_data_bidi_remote >= session.stream_bidi_remote and
    remote.initial_max_stream_data_uni >= session.stream_uni and
    remote.initial_max_streams_bidi >= session.streams_bidi and remote.initial_max_streams_uni >= session.streams_uni and
    remote.active_connection_id_limit >= session.active_connection_id_limit and
    remote.max_datagram_frame_size >= session.datagram_limit
end

local function reject_early(conn:*Connection, cnx:*cnx_t)
  -- EncryptedExtensions has installed the new transport parameters. The
  -- application packet context still contains only the 0-RTT flight.
  picosplay_empty_tree(&cnx.queue_data_repeat_tree)
  picoquic_reset_packet_context(cnx,&cnx.pkt_ctx[picoquic_packet_context_application])
  conn.output_size = 0
  while conn.streams ~= nilptr do
    local stream = conn.streams
    conn.streams = (@*Stream)(stream.next)
    local native = picoquic_find_stream(cnx,stream.id)
    if native ~= nilptr then picoquic_delete_stream(cnx,native) end
    C.free(stream.rx)
    C.free(stream)
  end
  conn.stream_count = 0
  conn.received = 0
  cnx.next_stream_id[0] = 0
  cnx.next_stream_id[2] = 2
  cnx.nb_bytes_queued = 0
  cnx.data_sent = 0
  cnx.maxdata_remote = cnx.remote_parameters.initial_max_data
end

local function with_rpk_offer(tls:*tls_t, buf:*buffer_t, offsets:*csize, epoch:csize, bytes:pointer,len:csize,
    props:*props_t):cint <cexport,codename '__wrap_ptls_handle_message'>
  local context = ptls_get_context(tls)
  if context.verify_certificate == nilptr or context.verify_certificate.cb ~= (@pointer)(verify_raw) or props == nilptr then
    return real_tls(tls,buf,offsets,epoch,bytes,len,props)
  end
  if ptls_is_server(tls) ~= 0 then return with_rpk_selection(tls,buf,offsets,epoch,bytes,len,props) end
  local cnx = (@*cnx_t)($ptls_get_data_ptr(tls))
  local conn = cnx ~= nilptr and (@*Connection)(picoquic_get_callback_context(cnx)) or nilptr
  if conn ~= nilptr and conn.resume ~= nilptr and epoch == 0 and len == 0 then
    -- Supply the scoped ticket directly so no SNI or C-string ALPN cache is needed.
    props.client.session_ticket = {base=conn.resume.ticket,len=conn.resume.length}
    props.client.max_early_data_size = conn.early and &cnx.max_early_data_size or nilptr
    if conn.early then restore_early_limits(cnx,conn.resume) end
  end
  local result = client_rpk_message(tls,buf,offsets,epoch,bytes,len,props)
  if conn ~= nilptr and conn.early and not conn.early_decided and epoch == 2 and
      (result == 0 or result == PTLS_ERROR_IN_PROGRESS) then
    local acceptance = props.client.early_data_acceptance
    if acceptance == PTLS_EARLY_DATA_REJECTED or acceptance == PTLS_EARLY_DATA_ACCEPTED then
      -- New flow-control limits are for 1-RTT only. Stop formatting 0-RTT
      -- packets once EncryptedExtensions has passed them to Picoquic.
      picoquic_crypto_context_free(&cnx.crypto_context[picoquic_epoch_0rtt])
      conn.early_decided = true
      if acceptance == PTLS_EARLY_DATA_REJECTED then
        reject_early(conn,cnx)
      elseif not accepted_early_limits(cnx,conn.resume) then
        return PTLS_ALERT_ILLEGAL_PARAMETER
      end
    end
  end
  return result
end

local function address(host: cstring, port: uint16, out: *storage_t): cuint
  local v4 = (@*addr_t)(out)
  if inet_pton(AF_INET,host,&v4.sin_addr) == 1 then
    v4.sin_family = (@uint16)(AF_INET)
    v4.sin_port = htons(port)
    return IROH_MP_V4_SIZE
  end
  local v6 = (@*addr6_t)(out)
  if inet_pton(AF_INET6,host,&v6.sin6_addr) ~= 1 then return 0 end
  v6.sin6_family = (@uint16)(AF_INET6)
  v6.sin6_port = htons(port)
  return IROH_MP_V6_SIZE
end

local function release_path(path: *Path)
  if path.fd >= 0 then close(path.fd) end
  C.free(path)
end

local function open_path(peer: *storage_t, size: cuint, source: *storage_t, source_size: cuint): (*Path,uint32)
  local path = (@*Path)(C.calloc(1,#Path))
  if path == nilptr then return nilptr,ENOMEM end
  path.fd = socket((@cint)(peer.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
  local local_size = IROH_MP_STORAGE_SIZE
  if path.fd < 0 or (source ~= nilptr and bind(path.fd,source,source_size) ~= 0) or
      connect(path.fd,peer,size) ~= 0 or getsockname(path.fd,&path.local_addr,&local_size) ~= 0 then
    local error = (@uint32)(errno)
    release_path(path)
    return nilptr,error
  end
  path.peer = (@*[0]storage_t)(peer)[0]
  return path,0
end

local function find_path(conn: *Connection, id: uint64): *Path
  local path = conn.paths
  while path ~= nilptr and path.id ~= id do path = (@*Path)(path.next) end
  return path
end

local function find_stream(conn: *Connection, id: uint64): *Stream
  local stream = conn.streams
  while stream ~= nilptr and stream.id ~= id do stream = (@*Stream)(stream.next) end
  return stream
end

local function release_listener(listener: *Listener)
  listener.refs = listener.refs - 1
  if listener.refs ~= 0 then return end
  if listener.quic ~= nilptr then picoquic_free(listener.quic) end
  if listener.fd >= 0 then close(listener.fd) end
  C.free(listener)
end

local function pop_datagram(conn: *Connection)
  local item = conn.datagram_first
  conn.datagram_first = (@*Datagram)(item.next)
  if conn.datagram_first == nilptr then conn.datagram_last = nilptr end
  conn.datagram_count = conn.datagram_count - 1
  C.free(item)
end

local function datagram_bytes(item: *Datagram): *uint8
  return &((@*[0]uint8)(item))[#Datagram]
end

local function receive_datagram(conn: *Connection, bytes: *uint8, size: csize)
  if size > IO_CAPACITY then return end
  local item = (@*Datagram)(C.malloc(#Datagram + size))
  if item == nilptr then return end
  item.next = nilptr
  item.size = size
  if size ~= 0 then C.memcpy(datagram_bytes(item),bytes,size) end
  if conn.datagram_count >= DATAGRAM_QUEUE_LIMIT then pop_datagram(conn) end
  if conn.datagram_last == nilptr then conn.datagram_first = item else conn.datagram_last.next = item end
  conn.datagram_last = item
  conn.datagram_count = conn.datagram_count + 1
end

local function destroy(conn: *Connection)
  if conn.listener ~= nilptr then
    picoquic_set_callback(conn.cnx,nilptr,nilptr)
    picoquic_delete_cnx(conn.cnx)
    release_listener(conn.listener)
  elseif conn.quic ~= nilptr then
    picoquic_free(conn.quic)
  end
  while conn.paths ~= nilptr do
    local path = conn.paths
    conn.paths = (@*Path)(path.next)
    release_path(path)
  end
  while conn.streams ~= nilptr do
    local stream = conn.streams
    conn.streams = (@*Stream)(stream.next)
    C.free(stream.rx)
    C.free(stream)
  end
  while conn.datagram_first ~= nilptr do pop_datagram(conn) end
  free_session(conn.ticket)
  free_session(conn.resume)
  C.free(conn.peer_parameters.bytes)
  C.free(conn)
end

local function remove_connection(conn: *Connection)
  if conn == connections then
    connections = (@*Connection)(conn.next)
  else
    local previous = connections
    while previous.next ~= conn do previous = (@*Connection)(previous.next) end
    previous.next = conn.next
  end
  destroy(conn)
end

local function register_connection(conn: *Connection)
  conn.id = next_connection
  next_connection = next_connection + 1
  conn.next = connections
  connections = conn
end

local function save_session(self: *save_ticket_t, tls: *tls_t, input: iov_t, properties: *ticket_props_t): cint
  local cnx = (@*cnx_t)($ptls_get_data_ptr(tls))
  if cnx == nilptr then return 0 end
  local conn = (@*Connection)(picoquic_get_callback_context(cnx))
  if conn == nilptr or conn.listener ~= nilptr or conn.closed or input.len == 0 or input.len > 65535 then
    return 0
  end
  local selected = pinned(conn.quic).selected
  if selected == nilptr then return 0 end
  local captured = (@*Session)(C.calloc(1,#Session))
  if captured == nilptr then return 0 end
  captured.ticket = (@*uint8)(C.malloc(input.len))
  if captured.ticket == nilptr then
    C.free(captured)
    return 0
  end
  C.memcpy(captured.ticket,input.base,input.len)
  captured.length = input.len
  C.memcpy(&captured.local_key[0],&conn.local_key[0],32)
  C.memcpy(&captured.peer_key[0],&conn.peer_key[0],32)
  C.memcpy(&captured.alpn[0],&selected.wire[3],selected.size)
  captured.alpn_length = selected.size
  local remote = &cnx.remote_parameters
  captured.datagram_limit = remote.max_datagram_frame_size
  captured.max_data = remote.initial_max_data
  captured.stream_bidi_local = remote.initial_max_stream_data_bidi_local
  captured.stream_bidi_remote = remote.initial_max_stream_data_bidi_remote
  captured.stream_uni = remote.initial_max_stream_data_uni
  captured.streams_bidi = remote.initial_max_streams_bidi
  captured.streams_uni = remote.initial_max_streams_uni
  captured.active_connection_id_limit = remote.active_connection_id_limit
  captured.max_packet_size = remote.max_packet_size ~= 0 and remote.max_packet_size or 65527
  free_session(conn.ticket)
  conn.ticket = captured
  return 0
end

local function install_session_capture(conn: *Connection): boolean
  if iroh_mp_take_multipath_session == 0xffffffff then return true end
  local callback = (@*save_ticket_t)(C.calloc(1,#save_ticket_t))
  if callback == nilptr then return false end
  callback.cb = (@pointer)(save_session)
  -- picoquic disposes this callback with the owning TLS context.
  local ctx = (@*context_t)(conn.quic.tls_master_ctx)
  ctx.save_ticket = callback
  return true
end

local function create_stream(conn: *Connection, id: uint64, incoming: boolean): *Stream
  if id > 0xffffffff or conn.stream_count >= STREAM_LIMIT then return nilptr end
  local stream = (@*Stream)(C.calloc(1,#Stream))
  if stream == nilptr then return nilptr end
  stream.id = (@uint32)(id)
  stream.incoming = incoming
  stream.accepted = not incoming
  stream.next = conn.streams
  conn.streams = stream
  conn.stream_count = conn.stream_count + 1
  return stream
end

local function receive_stream(conn: *Connection, stream: *Stream, bytes: *uint8, size: csize): cint
  if size == 0 then return 0 end
  if size > RX_LIMIT - conn.received then
    conn.buffer_error = true
    return -1
  end
  local expanded = (@*[0]uint8)(C.realloc(stream.rx,stream.size + size))
  if expanded == nilptr then
    conn.buffer_error = true
    return -1
  end
  stream.rx = expanded
  C.memcpy(&stream.rx[stream.size],bytes,size)
  stream.size = stream.size + size
  conn.received = conn.received + size
  return 0
end

local function remember_shared_path(conn: *Connection, id: uint64): *Path
  if id >= 0xffffffff or conn.path_count >= PATH_LIMIT then return nilptr end
  local path = (@*Path)(C.calloc(1,#Path))
  if path == nilptr then return nilptr end
  path.fd = -1
  if picoquic_get_path_addr(conn.cnx,id,1,&path.local_addr) ~= 0 or
      picoquic_get_path_addr(conn.cnx,id,2,&path.peer) ~= 0 then
    release_path(path)
    return nilptr
  end
  path.id = (@uint32)(id)
  path.status = 1
  path.next = conn.paths
  conn.paths = path
  conn.path_count = conn.path_count + 1
  if conn.last_path_id < id then conn.last_path_id = (@uint32)(id) end
  return path
end

local function update_path(conn: *Connection, id: uint64, kind: cint)
  local path = find_path(conn,id)
  if path == nilptr and conn.listener ~= nilptr and kind == picoquic_callback_path_available then
    path = remember_shared_path(conn,id)
  end
  if path == nilptr then return end
  if kind == picoquic_callback_path_available then
    if conn.listener ~= nilptr then
      path.status = 1
      return
    end
    local local_addr: storage_t, peer: storage_t
    if picoquic_get_path_addr(conn.cnx,id,1,&local_addr) ~= 0 or
        picoquic_get_path_addr(conn.cnx,id,2,&peer) ~= 0 then return end
    while path ~= nilptr do
      if path.id == id then
        path.status = picoquic_compare_addr(&path.local_addr,&local_addr) == 0 and
          picoquic_compare_addr(&path.peer,&peer) == 0 and 1 or 3
      end
      path = (@*Path)(path.next)
    end
    return
  end
  while path ~= nilptr do
    if path.id == id and path.status ~= 3 then
      path.status = kind == picoquic_callback_path_deleted and 3 or 2
    end
    path = (@*Path)(path.next)
  end
end

local function on_event(cnx: *cnx_t, id: uint64, bytes: *uint8, size: csize, kind: cint,
    user: pointer, stream_user: pointer): cint
  local conn = (@*Connection)(user)
  if kind == picoquic_callback_request_alpn_list then
    local tls = (@*client_tls_t)(bytes)
    local pin = pinned(conn.quic)
    local name = pin.alpns
    while name ~= nilptr do
      if tls.alpn_count >= tls.alpn_vec_size then return -1 end
      tls.alpn_vec[tls.alpn_count] = {base=&name.wire[3],len=name.size}
      tls.alpn_count = tls.alpn_count + 1
      name = (@*Alpn)(name.next)
    end
  elseif kind == picoquic_callback_ready then
    if conn.listener == nilptr then conn.selected_alpn = pinned(conn.quic).selected end
    if conn.selected_alpn == nilptr then
      conn.closed = true
      return -1
    end
    conn.ready = true
  elseif kind == picoquic_callback_datagram then
    receive_datagram(conn,bytes,size)
  elseif kind == picoquic_callback_path_available or kind == picoquic_callback_path_suspended or
      kind == picoquic_callback_path_deleted then
    update_path(conn,id,kind)
  elseif kind == picoquic_callback_stream_fin or kind == picoquic_callback_stream_data or
      kind == picoquic_callback_stream_reset or kind == picoquic_callback_stop_sending then
    local stream = find_stream(conn,id)
    if stream == nilptr then
      local peer_side: uint64 = conn.listener == nilptr and 1 or 0
      if stream_user == &discarded_stream or (id & 1) ~= peer_side then return 0 end
      stream = create_stream(conn,id,true)
      if stream == nilptr then
        conn.buffer_error = true
        return -1
      end
    end
    if kind == picoquic_callback_stream_reset then
      stream.reset = true
    elseif kind == picoquic_callback_stop_sending then
      stream.stop = true
    else
      if kind == picoquic_callback_stream_fin then stream.fin = true end
      return receive_stream(conn,stream,bytes,size)
    end
  elseif kind == picoquic_callback_close or kind == picoquic_callback_application_close or
      kind == picoquic_callback_stateless_reset then
    conn.closed = true
  end
  return 0
end

local function server_event(cnx: *cnx_t, id: uint64, bytes: *uint8, size: csize, kind: cint,
    user: pointer, stream_user: pointer): cint
  local listener = (@*Listener)(picoquic_get_default_callback_context(picoquic_get_quic_ctx(cnx)))
  if kind == picoquic_callback_close or kind == picoquic_callback_application_close or
      kind == picoquic_callback_stateless_reset then
    discard_handshake(cnx,listener)
    return 0
  end
  if kind ~= picoquic_callback_ready and kind ~= picoquic_callback_almost_ready then return 0 end
  if listener.stopped or next_connection == 0 or listener.refs > LISTENER_LIMIT then return -1 end
  if user == nilptr or user == listener then return -1 end
  local conn = (@*Connection)(C.calloc(1,#Connection))
  if conn == nilptr then return -1 end
  conn.quic = listener.quic
  conn.cnx = cnx
  conn.listener = listener
  local pending = (@*PendingHandshake)(user)
  conn.selected_alpn = pending.alpn
  if remember_shared_path(conn,0) == nilptr then
    C.free(conn)
    return -1
  end
  listener.refs = listener.refs + 1
  register_connection(conn)
  conn.peer_parameters = pending.parameters
  picoquic_set_callback(cnx,(@pointer)(on_event),conn)
  C.free(pending.extensions)
  C.free(pending)
  return on_event(cnx,id,bytes,size,kind,conn,stream_user)
end

local function handle_id(e: Env, handle: Term, tag: uint32): uint64
  if term_aux(handle) ~= tag then return 0 end
  if term_tag(handle) == TAG_PAK then return term_loc(handle) end
  if term_tag(handle) == TAG_CTR then return e.mem[term_peek(e.mem,handle)] end
  return 0
end

local function find_connection(e: Env, handle: Term): *Connection
  local id = handle_id(e,handle,iroh_mp_MultipathConnection)
  local conn = connections
  while conn ~= nilptr and conn.id ~= id do conn = (@*Connection)(conn.next) end
  return conn
end

local function find_listener(e: Env, handle: Term): *Listener
  local id = handle_id(e,handle,iroh_mp_MultipathListener)
  local listener = listeners
  while listener ~= nilptr and listener.id ~= id do listener = (@*Listener)(listener.next) end
  return listener
end

local function closed_error(e: Env, conn: *Connection): Term
  if conn == nilptr then return io_fail(e,EBADF,'multipath connection closed') end
  if conn.buffer_error then return io_fail(e,ENOBUFS,'multipath stream receive buffer exhausted') end
  if picoquic_get_local_error(conn.cnx) == IROH_MP_PIN_MISMATCH then
    return io_fail(e,EACCES,'QUIC peer endpoint key mismatch')
  end
  return io_fail(e,ECONNRESET,'multipath connection closed')
end

local function take_session_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if conn.listener ~= nilptr or not conn.ready or conn.ticket == nilptr then
    return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_None,0)))
  end
  if active_sessions == SESSION_LIMIT or next_session == 0 then
    return io_tup(e,args[0],io_fail(e,ENOBUFS,'multipath session handles exhausted'))
  end
  local ticket = conn.ticket
  conn.ticket = nilptr
  ticket.id = next_session
  next_session = next_session + 1
  active_sessions = active_sessions + 1
  ticket.next = sessions
  sessions = ticket
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,term_pak(iroh_mp_MultipathSession,ticket.id))))
end

local function remove_session(id: uint64): *Session
  local ticket = sessions
  local previous: *Session
  while ticket ~= nilptr and ticket.id ~= id do
    previous = ticket
    ticket = (@*Session)(ticket.next)
  end
  if ticket ~= nilptr then
    if previous == nilptr then sessions = (@*Session)(ticket.next)
    else previous.next = ticket.next end
    active_sessions = active_sessions - 1
    ticket.next = nilptr
  end
  return ticket
end

local function drop_session_run(e: Env, args: *[0]Term, work: *IoWork): Term
  free_session(remove_session(handle_id(e,args[0],iroh_mp_MultipathSession)))
  return term_pak(iroh_mp_Unit,0)
end

local function resumption_status_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready then return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_None,0))) end
  local resumed: uint32 = picoquic_tls_is_psk_handshake(conn.cnx) ~= 0 and 1 or 0
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,resumed)))
end

local function early_status_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready then return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_None,0))) end
  local accepted: uint32 = conn.early and conn.cnx.zero_rtt_data_accepted ~= 0 and 1 or 0
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,accepted)))
end

local function start_client(e: Env, args: *[0]Term, mode: uint32, session: *Session, early: boolean): Term
  defer free_session(session) end
  local host_size: uint64
  local host = io_cstr(e,args[0],&host_size)
  defer C.free(host) end
  local alpns = read_alpns(e,args[4],mode)
  defer free_alpns(alpns) end
  local seed: [32]uint8
  local key: [32]uint8
  local seed_size = bytes_from_list(e,args[2],&seed[0],32)
  local key_size = bytes_from_list(e,args[3],&key[0],32)
  if seed_size ~= 32 or key_size ~= 32 or args[1] == 0 or args[1] > 65535 or alpns == nilptr or
      io_nul(host,host_size) then
    return io_fail(e,EINVAL,'invalid numeric address, Ed25519 key, or ALPN')
  end
  local peer: storage_t
  local peer_size = address(host,(@uint16)(args[1]),&peer)
  if peer_size == 0 then return io_fail(e,EINVAL,'invalid numeric peer address') end
  if next_connection == 0 then return io_fail(e,ENOMEM,'multipath handles exhausted') end
  local conn = (@*Connection)(C.calloc(1,#Connection))
  if conn == nilptr then return io_fail(e,ENOMEM,nilptr) end
  local initial,error = open_path(&peer,peer_size,nilptr,0)
  if initial == nilptr then
    destroy(conn)
    return io_fail(e,error,nilptr)
  end
  conn.paths = initial
  conn.path_count = 1
  initial.status = 1
  local save_identity = iroh_mp_take_multipath_session ~= 0xffffffff or session ~= nilptr
  if save_identity then C.memcpy(&conn.peer_key[0],&key[0],32) end
  if session ~= nilptr and (C.memcmp(&session.peer_key[0],&key[0],32) ~= 0 or
      session.alpn_length ~= alpns.size or C.memcmp(&session.alpn[0],&alpns.wire[3],alpns.size) ~= 0) then
    destroy(conn)
    return io_fail(e,EACCES,'session ticket belongs to a different peer or ALPN')
  end
  local now = picoquic_current_time()
  conn.quic = picoquic_create(1,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,nilptr,now,nilptr,nilptr,nilptr,0)
  local public = save_identity and &conn.local_key[0] or nilptr
  if conn.quic == nilptr or not install_identity(conn.quic,&seed[0],&key[0],&alpns,public) or
      not install_session_capture(conn) or
      picoquic_set_default_tp_value(conn.quic,picoquic_tp_max_datagram_frame_size,IO_CAPACITY) ~= 0 then
    destroy(conn)
    return io_fail(e,EIO,'could not configure pinned QUIC raw public keys')
  end
  if session ~= nilptr and C.memcmp(&session.local_key[0],&conn.local_key[0],32) ~= 0 then
    destroy(conn)
    return io_fail(e,EACCES,'session ticket belongs to a different local key')
  end
  conn.resume = session
  conn.early = early
  session = nilptr
  picoquic_set_default_multipath_option(conn.quic,1)
  conn.cnx = picoquic_create_client_cnx(conn.quic,&peer,now,1,nilptr,nilptr,(@pointer)(on_event),conn)
  if conn.cnx == nilptr then
    destroy(conn)
    return io_fail(e,EIO,'could not start the QUIC handshake')
  end
  picoquic_enable_path_callbacks(conn.cnx,1)
  register_connection(conn)
  return io_done(e,term_pak(iroh_mp_MultipathConnection,conn.id))
end

local function start_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,0,nilptr,false)
end

local function start_bytes_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,1,nilptr,false)
end

local function start_alpns_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_client(e,args,2,nilptr,false)
end

local function start_resume(e: Env, args: *[0]Term, early: boolean): Term
  local session = remove_session(handle_id(e,args[5],iroh_mp_MultipathSession))
  if session == nilptr then return io_fail(e,EBADF,'multipath session is no longer available') end
  return start_client(e,args,1,session,early)
end

local function start_resume_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_resume(e,args,false)
end

local function start_early_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return start_resume(e,args,true)
end

local function negotiated_alpn_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local name = conn.selected_alpn
  if not conn.ready or name == nilptr then
    return io_tup(e,args[0],io_fail(e,EAGAIN,'QUIC handshake is incomplete'))
  end
  return io_tup(e,args[0],io_done(e,io_list(e,(@cstring)(&name.wire[3]),name.size)))
end

local function peer_parameters_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready then return io_tup(e,args[0],io_fail(e,EAGAIN,'QUIC handshake is incomplete')) end
  local source = conn.peer_parameters
  if conn.listener == nilptr then source = pinned(conn.quic).peer_parameters end
  local parameters = io_list(e,(@cstring)(source.bytes),source.size)
  return io_tup(e,args[0],io_done(e,parameters))
end

local function socket_unreachable(code: cint): boolean
  return code == ECONNREFUSED or code == ENETUNREACH or code == EHOSTUNREACH
end

local function address_size(addr: *storage_t): cuint
  return addr.ss_family == AF_INET and IROH_MP_V4_SIZE or IROH_MP_V6_SIZE
end

local function flush_output(conn: *Connection): uint32
  if conn.output_size == 0 then return 0 end
  local path = conn.output_path
  if path ~= nilptr and path.status == 3 then
    conn.output_size = 0
    return 0
  end
  local sent: isize
  if path == nilptr or path.fd < 0 then
    local peer = &conn.output_peer
    sent = sendto(conn.listener.fd,&conn.output[0],conn.output_size,0,peer,address_size(peer))
  else
    sent = send(path.fd,&conn.output[0],conn.output_size,0)
  end
  if sent == (@isize)(conn.output_size) or (sent < 0 and socket_unreachable(errno)) then
    conn.output_size = 0
    return 0
  end
  if sent < 0 and (errno == EAGAIN or errno == EINTR) then return 0 end
  return sent < 0 and (@uint32)(errno) or EIO
end

local function route_packet(conn: *Connection, src: *storage_t, dst: *storage_t): *Path
  local path = conn.paths
  while path ~= nilptr do
    if path.status ~= 3 and (src.ss_family == 0 and path.id == 0 or
        picoquic_compare_addr(&path.local_addr,src) == 0) and picoquic_compare_addr(&path.peer,dst) == 0 then
      return path
    end
    path = (@*Path)(path.next)
  end
  return nilptr
end

local function write_packet(conn: *Connection, now: uint64): uint32
  local error = flush_output(conn)
  if error ~= 0 or conn.output_size ~= 0 then return error end
  local size: csize
  local from: storage_t, to: storage_t
  local iface: cint
  if picoquic_prepare_packet(conn.cnx,now,&conn.output[0],IO_CAPACITY,&size,&to,&from,&iface) ~= 0 then
    return EIO
  end
  if size == 0 then return 0 end
  local path = route_packet(conn,&from,&to)
  if path == nilptr and (conn.listener == nilptr or (from.ss_family ~= 0 and
      picoquic_compare_addr(&conn.listener.local_addr,&from) ~= 0)) then return 0 end
  conn.output_path = path
  conn.output_peer = to
  conn.output_size = size
  return flush_output(conn)
end

local function close_retired_sockets(conn: *Connection)
  local path = conn.paths
  local previous: *Path
  while path ~= nilptr do
    local next = (@*Path)(path.next)
    if path.status == 3 then
      if conn.output_path == path then
        conn.output_path = nilptr
        conn.output_size = 0
      end
      if previous == nilptr then conn.paths = next else previous.next = next end
      release_path(path)
      conn.path_count = conn.path_count - 1
    else
      previous = path
    end
    path = next
  end
end

local function read_packets(conn: *Connection, now: uint64): uint32
  local bytes: [65536]uint8
  local path = conn.paths
  while path ~= nilptr and not conn.closed do
    if path.status ~= 3 and path.fd >= 0 then
      local size = recv(path.fd,&bytes[0],#bytes,0)
      if size > 0 then
        picoquic_incoming_packet(conn.quic,&bytes[0],(@csize)(size),&path.peer,&path.local_addr,0,0,now)
      elseif size < 0 and errno ~= EAGAIN and errno ~= EINTR and not socket_unreachable(errno) then
        return (@uint32)(errno)
      end
    end
    path = (@*Path)(path.next)
  end
  return 0
end

local function receive_listener(listener: *Listener, now: uint64): uint32
  local bytes: [65536]uint8
  local peer: storage_t
  local length = IROH_MP_STORAGE_SIZE
  local count = recvfrom(listener.fd,&bytes[0],#bytes,0,&peer,&length)
  if count > 0 then
    picoquic_incoming_packet(listener.quic,&bytes[0],(@csize)(count),&peer,&listener.local_addr,0,0,now)
  elseif count < 0 and errno ~= EAGAIN and errno ~= EINTR then
    return (@uint32)(errno)
  end
  return 0
end

local function handshake_packet(listener: *Listener, cnx: *cnx_t, now: uint64)
  local out: [IO_CAPACITY]uint8
  local size: csize
  local from: storage_t, to: storage_t
  local iface: cint
  if picoquic_prepare_packet(cnx,now,&out[0],IO_CAPACITY,&size,&to,&from,&iface) == 0 and size > 0 then
    sendto(listener.fd,&out[0],size,0,&to,address_size(&to))
  end
end

local function pump_listener(listener: *Listener, now: uint64): uint32
  local error = receive_listener(listener,now)
  if error ~= 0 then return error end
  local packet = picoquic_dequeue_stateless_packet(listener.quic)
  if packet ~= nilptr then
    if not listener.stopped then
      sendto(listener.fd,&packet.bytes[0],packet.length,0,&packet.addr_to,address_size(&packet.addr_to))
    end
    picoquic_delete_stateless_packet(packet)
  end
  local cnx = picoquic_get_first_cnx(listener.quic)
  while cnx ~= nilptr do
    local next = picoquic_get_next_cnx(cnx)
    local ctx = picoquic_get_callback_context(cnx)
    local expired = now - picoquic_get_cnx_start_time(cnx) > HANDSHAKE_LIMIT
    if (@pointer)(picoquic_get_callback_function(cnx)) == (@pointer)(server_event) then
      if expired or listener.stopped or picoquic_get_cnx_state(cnx) == picoquic_state_disconnected then
        discard_handshake(cnx,listener)
        picoquic_delete_cnx(cnx)
      else
        handshake_packet(listener,cnx,now)
      end
    elseif ctx ~= nilptr then
      local conn = (@*Connection)(ctx)
      if not conn.accepted then
        if conn.closed or expired or listener.stopped or write_packet(conn,now) ~= 0 then
          remove_connection(conn)
        end
      end
    end
    cnx = next
  end
  return 0
end

local function step(e: Env, conn: *Connection): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local now = picoquic_current_time()
  local error: uint32 = 0
  if conn.listener ~= nilptr then error = pump_listener(conn.listener,now) end
  if error == 0 then error = read_packets(conn,now) end
  if error == 0 then error = write_packet(conn,now) end
  close_retired_sockets(conn)
  if conn.closed or conn.buffer_error then return closed_error(e,conn) end
  if error ~= 0 then return io_fail(e,error,'QUIC packet I/O failed') end
  local state: Term = 0
  if conn.ready then state = conn.cnx.is_multipath_enabled ~= 0 and 2 or 1 end
  return io_done(e,state)
end

local function step_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],step(e,find_connection(e,args[0])))
end

local function optional_id(e: Env, id: uint64): Term
  return io_done(e,io_box(e,iroh_mp_Some,id))
end

local function none(e: Env): Term
  return io_done(e,term_pak(iroh_mp_None,0))
end

local function numeric_argument(e: Env, item: Term, port: Term, out: *storage_t): cuint
  if port > 65535 then return 0 end
  local size: uint64
  local host = io_cstr(e,item,&size)
  defer C.free(host) end
  if io_nul(host,size) then return 0 end
  return address(host,(@uint16)(port),out)
end

local function bind_listener(e: Env, args: *[0]Term, mode: uint32, advertise_nat: boolean): Term
  local local_addr: storage_t
  local size = numeric_argument(e,args[0],args[1],&local_addr)
  local alpns = read_alpns(e,args[4],mode)
  defer free_alpns(alpns) end
  local seed: [32]uint8
  local key: [32]uint8
  local seed_size = bytes_from_list(e,args[2],&seed[0],32)
  local key_size = bytes_from_list(e,args[3],&key[0],32)
  local empty = mode == 2 and term_aux(args[4]) == iroh_mp_Nil
  if size == 0 or seed_size ~= 32 or key_size ~= 32 or (alpns == nilptr and not empty) then
    return io_fail(e,EINVAL,'invalid numeric listen address, Ed25519 key, or ALPN')
  end
  local v4 = (@*addr_t)(&local_addr)
  local v6 = (@*addr6_t)(&local_addr)
  local zero: [16]uint8
  if (local_addr.ss_family == AF_INET and v4.sin_addr.s_addr == 0) or
      (local_addr.ss_family == AF_INET6 and C.memcmp(&v6.sin6_addr,&zero[0],16) == 0) then
    return io_fail(e,EINVAL,'multipath listener requires a concrete IP address')
  end
  if next_listener == 0 then return io_fail(e,ENOMEM,'multipath listener handles exhausted') end
  local listener = (@*Listener)(C.calloc(1,#Listener))
  if listener == nilptr then return io_fail(e,ENOMEM,nilptr) end
  listener.refs = 1
  listener.fd = socket((@cint)(local_addr.ss_family),SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC,0)
  local bound_size = IROH_MP_STORAGE_SIZE
  if listener.fd < 0 or bind(listener.fd,&local_addr,size) ~= 0 or
      getsockname(listener.fd,&listener.local_addr,&bound_size) ~= 0 then
    local code = (@uint32)(errno)
    release_listener(listener)
    return io_fail(e,code,nilptr)
  end
  if advertise_nat then
    if bytes_from_list(e,args[5],&listener.nat_offer[0],NAT_PARAMETER_SIZE) ~= NAT_PARAMETER_SIZE then
      release_listener(listener)
      return io_fail(e,EINVAL,'invalid encoded NAT traversal parameter')
    end
    listener.sends_nat_offer = true
  end
  local now = picoquic_current_time()
  listener.quic = picoquic_create(LISTENER_LIMIT,nilptr,nilptr,nilptr,nilptr,(@pointer)(server_event),listener,
    nilptr,nilptr,nilptr,now,nilptr,nilptr,nilptr,0)
  if listener.quic == nilptr or not install_identity(listener.quic,&seed[0],&key[0],&alpns,nilptr) or
      picoquic_set_default_tp_value(listener.quic,picoquic_tp_max_datagram_frame_size,IO_CAPACITY) ~= 0 then
    release_listener(listener)
    return io_fail(e,EIO,'could not configure pinned QUIC listener')
  end
  picoquic_set_alpn_select_fn(listener.quic,select_alpn)
  picoquic_set_client_authentication(listener.quic,1)
  picoquic_enforce_client_only(listener.quic,0)
  picoquic_set_accept_0rtt(listener.quic,0)
  picoquic_set_default_multipath_option(listener.quic,1)
  picoquic_enable_path_callbacks_default(listener.quic,1)
  picoquic_set_max_half_open_retry_threshold(listener.quic,LISTENER_LIMIT)
  listener.id = next_listener
  next_listener = next_listener + 1
  listener.next = listeners
  listeners = listener
  local port = listener.local_addr.ss_family == AF_INET and
    ((@*addr_t)(&listener.local_addr)).sin_port or ((@*addr6_t)(&listener.local_addr)).sin6_port
  return io_done(e,io_tup(e,term_pak(iroh_mp_MultipathListener,listener.id),ntohs(port)))
end

local function accept_connection(e: Env, listener: *Listener): Term
  if listener == nilptr then return io_fail(e,EBADF,'multipath listener closed') end
  local code = pump_listener(listener,picoquic_current_time())
  if code ~= 0 then return io_fail(e,code,'QUIC listener I/O failed') end
  local conn = connections
  local ready: *Connection
  while conn ~= nilptr do
    if conn.listener == listener and not conn.accepted and conn.ready and not conn.closed and
        (ready == nilptr or conn.id < ready.id) then
      ready = conn
    end
    conn = (@*Connection)(conn.next)
  end
  if ready == nilptr then return none(e) end
  ready.accepted = true
  return io_done(e,io_box(e,iroh_mp_Some,term_pak(iroh_mp_MultipathConnection,ready.id)))
end

local function bind_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,0,false)
end

local function bind_nat_offer_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,0,true)
end

local function bind_bytes_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,1,false)
end

local function bind_alpns_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return bind_listener(e,args,2,false)
end

local function used_alpns(listener: *Listener)
  local cnx = picoquic_get_first_cnx(listener.quic)
  while cnx ~= nilptr do
    local callback = (@pointer)(picoquic_get_callback_function(cnx))
    local ctx = picoquic_get_callback_context(cnx)
    local name: *Alpn
    if ctx ~= nilptr then
      if callback == (@pointer)(server_event) and ctx ~= listener then
        name = ((@*PendingHandshake)(ctx)).alpn
      elseif callback == (@pointer)(on_event) then
        name = ((@*Connection)(ctx)).selected_alpn
      end
    end
    if name ~= nilptr then name.retained = true end
    cnx = picoquic_get_next_cnx(cnx)
  end
end

local function retain_alpns(first: *Alpn, kept: *Alpn): *Alpn
  while first ~= nilptr do
    local next = (@*Alpn)(first.next)
    if first.retained then
      first.retained = false
      first.next = kept
      kept = first
    else
      C.free(first)
    end
    first = next
  end
  return kept
end

local function replace_alpns(e: Env, listener: *Listener, term: Term): Term
  if listener == nilptr then return io_fail(e,EBADF,'multipath listener closed') end
  local alpns = read_alpns(e,term,2)
  if alpns == nilptr and term_aux(term) ~= iroh_mp_Nil then
    return io_fail(e,EINVAL,'invalid QUIC ALPN list')
  end
  -- Native listener operations are serialized. Keep entries referenced by
  -- in-progress handshakes or active connections across configuration changes.
  local pin = pinned(listener.quic)
  used_alpns(listener)
  pin.retired = retain_alpns(pin.alpns,retain_alpns(pin.retired,nilptr))
  pin.alpns = alpns
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function set_alpns_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],replace_alpns(e,find_listener(e,args[0]),args[1]))
end

local function accept_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],accept_connection(e,find_listener(e,args[0])))
end

local function close_listener_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local listener = find_listener(e,args[0])
  if listener == nilptr then return term_pak(iroh_mp_Unit,0) end
  listener.stopped = true
  picoquic_enforce_client_only(listener.quic,1)
  if listener == listeners then
    listeners = (@*Listener)(listener.next)
  else
    local previous = listeners
    while previous.next ~= listener do previous = (@*Listener)(previous.next) end
    previous.next = listener.next
  end
  local conn = connections
  while conn ~= nilptr do
    local next = (@*Connection)(conn.next)
    if conn.listener == listener and not conn.accepted then remove_connection(conn) end
    conn = next
  end
  release_listener(listener)
  return term_pak(iroh_mp_Unit,0)
end

local function probe(e: Env, conn: *Connection, args: *[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if conn.listener ~= nilptr then return io_fail(e,ENOTSUP,'only a QUIC dialer can open a new path') end
  if not conn.ready then return none(e) end
  if conn.cnx.is_multipath_enabled == 0 then return io_fail(e,ENOTSUP,'peer did not negotiate QUIC multipath') end
  if conn.path_count >= PATH_LIMIT then return io_fail(e,ENOBUFS,'too many active QUIC paths') end
  local source: storage_t, peer: storage_t
  local bind_len: uint64
  local bind_host = io_cstr(e,args[1],&bind_len)
  defer C.free(bind_host) end
  local peer_size = numeric_argument(e,args[3],args[4],&peer)
  local source_size: cuint = 0
  if bind_len ~= 0 and args[2] <= 65535 and not io_nul(bind_host,bind_len) then
    source_size = address(bind_host,(@uint16)(args[2]),&source)
  end
  if peer_size == 0 or args[4] == 0 or (bind_len == 0 and args[2] ~= 0) or
      (bind_len ~= 0 and (source_size == 0 or source.ss_family ~= peer.ss_family)) then
    return io_fail(e,EINVAL,'invalid local or remote QUIC path address')
  end
  local path,error = open_path(&peer,peer_size,source_size ~= 0 and &source or nilptr,source_size)
  if path == nilptr then return io_fail(e,error,nilptr) end
  local previous = conn.cnx.nb_paths
  local status = picoquic_probe_new_path(conn.cnx,&path.peer,&path.local_addr,picoquic_current_time())
  if status ~= 0 then
    release_path(path)
    if status == PICOQUIC_ERROR_PATH_ID_BLOCKED or status == PICOQUIC_ERROR_PATH_CID_BLOCKED or
        status == PICOQUIC_ERROR_PATH_NOT_READY then return none(e) end
    return io_fail(e,EIO,picoquic_error_name((@uint64)(status)))
  end
  if conn.cnx.nb_paths ~= previous + 1 then
    release_path(path)
    return io_fail(e,EIO,'QUIC did not allocate a new path')
  end
  local paths = (@*[0]*path_t)(conn.cnx.path)
  local id = paths[previous].unique_path_id
  if id >= 0xffffffff then
    picoquic_abandon_path(conn.cnx,id,0,picoquic_current_time())
    release_path(path)
    return io_fail(e,ENOBUFS,'QUIC path IDs exhausted')
  end
  path.id = (@uint32)(id)
  path.next = conn.paths
  conn.paths = path
  conn.path_count = conn.path_count + 1
  if conn.last_path_id < id then conn.last_path_id = (@uint32)(id) end
  return optional_id(e,id)
end

local function probe_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],probe(e,find_connection(e,args[0]),args))
end

local function status_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = find_path(conn,args[1])
  if path == nilptr then
    local result = args[1] <= conn.last_path_id and io_done(e,3) or io_fail(e,EINVAL,'unknown QUIC path')
    return io_tup(e,args[0],result)
  end
  return io_tup(e,args[0],io_done(e,path.status))
end

local function path_timeouts_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local paths = (@*[0]*path_t)(conn.cnx.path)
  for i = 0,<conn.cnx.nb_paths do
    if paths[i].unique_path_id == args[1] then
      local count = paths[i].nb_retransmit
      return io_tup(e,args[0],io_done(e,count > 0xffffffff and 0xffffffff or count))
    end
  end
  return io_tup(e,args[0],io_fail(e,EINVAL,'unknown QUIC path'))
end

local function keepalive_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  if args[1] == 0 then picoquic_disable_keep_alive(conn.cnx)
  else picoquic_enable_keep_alive(conn.cnx,args[1] * 1000) end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_Unit,0)))
end

local function probe_alternate(e: Env, conn: *Connection, args: *[0]Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local current = find_path(conn,args[1])
  if conn.listener ~= nilptr or current == nilptr or current.status ~= 0 or conn.path_count >= PATH_LIMIT then
    return io_fail(e,EINVAL,'no unvalidated dialer path is available for another address')
  end
  local peer: storage_t
  local peer_size = numeric_argument(e,args[2],args[3],&peer)
  if peer_size == 0 or args[3] == 0 then return io_fail(e,EINVAL,'invalid alternate peer address') end
  local paths = (@*[0]*path_t)(conn.cnx.path)
  for i = 0,<conn.cnx.nb_paths do
    if paths[i].unique_path_id == current.id then
      local path,error = open_path(&peer,peer_size,nilptr,0)
      if path == nilptr then return io_fail(e,error,nilptr) end
      local status = picoquic_probe_new_tuple(conn.cnx,paths[i],&path.peer,&path.local_addr,0,picoquic_current_time(),0)
      if status ~= 0 then
        release_path(path)
        return io_fail(e,EIO,picoquic_error_name((@uint64)(status)))
      end
      path.id = current.id
      path.next = conn.paths
      conn.paths = path
      conn.path_count = conn.path_count + 1
      return io_done(e,term_pak(iroh_mp_Unit,0))
    end
  end
  return io_fail(e,EINVAL,'unknown QUIC path')
end

local function alternate_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],probe_alternate(e,find_connection(e,args[0]),args))
end

local function standby_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = find_path(conn,args[1])
  if path == nilptr or path.status == 3 or args[2] > 1 or conn.cnx.is_multipath_enabled == 0 then
    return io_tup(e,args[0],io_fail(e,EINVAL,'invalid QUIC standby path'))
  end
  local status = args[2] == 0 and picoquic_path_status_available or picoquic_path_status_backup
  if picoquic_set_path_status(conn.cnx,args[1],status) ~= 0 then
    return io_tup(e,args[0],io_fail(e,EIO,'could not update QUIC path preference'))
  end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_Unit,0)))
end

local function retire_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = find_path(conn,args[1])
  if path ~= nilptr and path.status ~= 3 and
      picoquic_abandon_path(conn.cnx,args[1],0,picoquic_current_time()) ~= 0 then
    return io_tup(e,args[0],io_fail(e,EIO,'could not retire QUIC path'))
  end
  return io_tup(e,args[0],io_done(e,term_pak(iroh_mp_Unit,0)))
end

local function millis_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return (@uint32)(io_tick() // 1000000)
end

local function next_path_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local path = conn.paths
  local next: *Path
  while path ~= nilptr do
    if path.status == 1 and path.id > args[1] and (next == nilptr or path.id < next.id) then next = path end
    path = (@*Path)(path.next)
  end
  return io_tup(e,args[0],next == nilptr and none(e) or optional_id(e,next.id))
end

local function datagram_frame_limit(conn: *Connection): csize
  if not conn.ready then return 0 end
  local mtu = IO_CAPACITY
  local paths = (@*[0]*path_t)(conn.cnx.path)
  for i = 0, < conn.cnx.nb_paths do
    if paths[i].send_mtu < mtu then mtu = paths[i].send_mtu end
  end
  -- Reserve the short header, maximum connection ID and packet number, and AEAD tag.
  if mtu <= 41 then return 0 end
  local frame = mtu - 41
  local remote = conn.cnx.remote_parameters.max_datagram_frame_size
  if remote < frame then frame = remote end
  return frame
end

local function limit_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr or conn.closed then return io_tup(e,args[0],closed_error(e,conn)) end
  local frame = datagram_frame_limit(conn)
  local payload: Term = 0
  if frame >= 67 then
    payload = frame - 3
  elseif frame >= 65 then
    payload = 63
  elseif frame >= 2 then
    payload = frame - 2
  end
  return io_tup(e,args[0],io_done(e,payload))
end

local function write_datagram(e: Env, conn: *Connection, payload: Term): Term
  local bytes: [IO_CAPACITY]uint8
  local size = bytes_from_list(e,payload,&bytes[0],IO_CAPACITY)
  if size == -1 then return io_fail(e,EINVAL,'invalid QUIC datagram bytes') end
  if size < 0 then return io_fail(e,EMSGSIZE,'QUIC datagram exceeds packet capacity') end
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not conn.ready then return io_done(e,0) end
  if conn.cnx.remote_parameters.max_datagram_frame_size == 0 then
    return io_fail(e,ENOTSUP,'peer did not negotiate QUIC datagrams')
  end
  local overhead: csize = size >= 64 and 3 or 2
  if (@csize)(size) + overhead > datagram_frame_limit(conn) then
    return io_fail(e,EMSGSIZE,'QUIC datagram exceeds the negotiated path limit')
  end
  local item = conn.cnx.first_datagram
  local queued: uint32 = 0
  while item ~= nilptr do
    queued = queued + 1
    if queued >= DATAGRAM_QUEUE_LIMIT then return io_done(e,0) end
    item = (@*frame_t)(item.next_misc_frame)
  end
  local status = picoquic_queue_datagram_frame(conn.cnx,(@csize)(size),&bytes[0])
  if status == PICOQUIC_ERROR_DATAGRAM_TOO_LONG then return io_fail(e,EMSGSIZE,'QUIC datagram exceeds path size') end
  if status ~= 0 then return io_fail(e,EIO,picoquic_error_name((@uint64)(status))) end
  return io_done(e,1)
end

local function write_datagram_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write_datagram(e,find_connection(e,args[0]),args[1]))
end

local function early_window(conn: *Connection): boolean
  if not conn.early or conn.early_decided or conn.ready then return false end
  local state = picoquic_get_cnx_state(conn.cnx)
  return (state == picoquic_state_client_init or state == picoquic_state_client_init_sent) and
    picoquic_is_0rtt_available(conn.cnx) ~= 0
end

local function write_early_frame(e: Env, conn: *Connection, payload: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not early_window(conn) then return io_done(e,0) end
  local cnx = conn.cnx
  if cnx.first_misc_frame ~= nilptr then return io_done(e,0) end
  if conn.resume.datagram_limit == 0 then
    return io_fail(e,ENOTSUP,'session peer did not negotiate QUIC datagrams')
  end
  local bytes: [IO_CAPACITY]uint8
  local size = bytes_from_list(e,payload,&bytes[0],IO_CAPACITY)
  if size == -1 or (size >= 0 and size < 2) then
    return io_fail(e,EINVAL,'invalid early QUIC datagram frame')
  end
  -- Reserve room for the 0-RTT long header, both connection IDs, and the AEAD tag.
  if size < 0 or (@uint64)(size) > conn.resume.datagram_limit or
      (@csize)(size) + 80 > ((@*[0]*path_t)(cnx.path))[0].send_mtu then
    return io_fail(e,EMSGSIZE,'early QUIC datagram exceeds the remembered path limit')
  end
  local frame = (@*[0]uint8)(&bytes[0])
  local frame_type: uint8
  local length: uint64
  local limit = &frame[size]
  local body = picoquic_decode_datagram_frame_header(&bytes[0],limit,&frame_type,&length)
  if body == nilptr or frame_type ~= 49 or (@usize)(limit) - (@usize)(body) ~= length then
    return io_fail(e,EINVAL,'invalid early QUIC datagram frame')
  end
  local queued = picoquic_queue_misc_frame(cnx,&bytes[0],(@csize)(size),0,picoquic_packet_context_application)
  if queued ~= 0 then return io_fail(e,EIO,picoquic_error_name((@uint64)(queued))) end
  -- Packetize without reading a peer response. Remove the frame if it did not
  -- fit so a later handshake flight can never send it as a 1-RTT datagram.
  local error = write_packet(conn,picoquic_current_time())
  local sent: Term = 1
  if cnx.first_misc_frame ~= nilptr then
    picoquic_delete_misc_or_dg(&cnx.first_misc_frame,&cnx.last_misc_frame,cnx.first_misc_frame)
    sent = 0
  end
  if error ~= 0 then return io_fail(e,error,'QUIC early packet I/O failed') end
  return io_done(e,sent)
end

local function write_early_frame_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write_early_frame(e,find_connection(e,args[0]),args[1]))
end

local function read_datagram_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn == nilptr then return io_tup(e,args[0],closed_error(e,conn)) end
  if not conn.ready or conn.datagram_first == nilptr then
    return io_tup(e,args[0],conn.closed and closed_error(e,conn) or none(e))
  end
  local item = conn.datagram_first
  local bytes = io_list(e,(@cstring)(datagram_bytes(item)),item.size)
  pop_datagram(conn)
  return io_tup(e,args[0],io_done(e,io_box(e,iroh_mp_Some,bytes)))
end

local function open_stream(e: Env, conn: *Connection, direction: Term, early: boolean): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if early then
    if not early_window(conn) then return none(e) end
  elseif not conn.ready then
    return none(e)
  end
  if direction > 1 then return io_fail(e,EINVAL,'invalid QUIC stream direction') end
  if conn.stream_count >= STREAM_LIMIT then return io_fail(e,ENOBUFS,'too many open QUIC streams') end
  local id = picoquic_get_next_local_stream_id(conn.cnx,(@cint)(direction))
  if id > 0xffffffff then return io_fail(e,ENOBUFS,'QUIC stream IDs exhausted') end
  if early then
    local limit = direction == 0 and conn.resume.streams_bidi or conn.resume.streams_uni
    if id // 4 >= limit then return none(e) end
  end
  local stream = (@*Stream)(C.calloc(1,#Stream))
  if stream == nilptr then return io_fail(e,ENOMEM,nilptr) end
  if picoquic_set_app_stream_ctx(conn.cnx,id,stream) ~= 0 then
    C.free(stream)
    return none(e)
  end
  stream.id = (@uint32)(id)
  stream.early = early
  stream.accepted = not early
  stream.next = conn.streams
  conn.streams = stream
  conn.stream_count = conn.stream_count + 1
  return optional_id(e,early and term_pak(iroh_mp_MultipathEarlyStream,id) or id)
end

local function open_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],open_stream(e,find_connection(e,args[0]),args[1],false))
end

local function open_early_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],open_stream(e,find_connection(e,args[0]),args[1],true))
end

local function resolve_early_stream(e: Env, conn: *Connection, id: uint64): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if not conn.ready then return io_fail(e,EAGAIN,'QUIC handshake is incomplete') end
  local stream = find_stream(conn,id)
  if conn.cnx.zero_rtt_data_accepted == 0 or stream == nilptr or not stream.early then return none(e) end
  stream.accepted = true
  return optional_id(e,id)
end

local function resolve_early_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],resolve_early_stream(e,find_connection(e,args[0]),
    handle_id(e,args[1],iroh_mp_MultipathEarlyStream)))
end

local function accept_stream(e: Env, conn: *Connection, direction: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if direction > 1 then return io_fail(e,EINVAL,'invalid QUIC stream direction') end
  if not conn.ready then return none(e) end
  local stream = conn.streams
  local ready: *Stream
  while stream ~= nilptr do
    if stream.incoming and not stream.accepted and (stream.id & 2) == direction * 2 and
        (ready == nilptr or stream.id < ready.id) then
      ready = stream
    end
    stream = (@*Stream)(stream.next)
  end
  if ready == nilptr then return none(e) end
  ready.accepted = true
  return optional_id(e,ready.id)
end

local function accept_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],accept_stream(e,find_connection(e,args[0]),args[1]))
end

local function assign(e: Env, conn: *Connection, stream_id: Term, path_id: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local stream = find_stream(conn,stream_id)
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  local selected: uint64 = 0xffffffffffffffff
  if path_id ~= 0xffffffff then
    local path = find_path(conn,path_id)
    if path == nilptr or path.status ~= 1 then return io_fail(e,EINVAL,'QUIC path is unavailable') end
    selected = path_id
  end
  if picoquic_set_stream_path_affinity(conn.cnx,stream_id,selected) ~= 0 then
    return io_fail(e,EPIPE,'could not assign the QUIC stream to the path')
  end
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function assign_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],assign(e,find_connection(e,args[0]),args[1],args[2]))
end

local function write_stream(e: Env, conn: *Connection, id: Term, payload: Term, fin: Term, early: boolean): Term
  local bytes: [STREAM_CHUNK]uint8
  local size = bytes_from_list(e,payload,&bytes[0],STREAM_CHUNK)
  if size < 0 or fin > 1 then return io_fail(e,EINVAL,'invalid or oversized QUIC stream write') end
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  local stream = find_stream(conn,id)
  if early then
    if stream == nilptr or not stream.early then return io_fail(e,EBADF,'unknown early QUIC stream') end
    if not early_window(conn) then return io_done(e,0) end
  elseif stream == nilptr or not stream.accepted then
    return io_fail(e,EBADF,'unknown QUIC stream')
  end
  if stream.incoming and (id & 2) ~= 0 then return io_fail(e,EPIPE,'QUIC stream is receive-only') end
  if stream.sent_fin or stream.stop then return io_fail(e,EPIPE,'QUIC stream send half closed') end
  if conn.cnx.nb_bytes_queued + (@uint64)(size) > TX_LIMIT then return io_done(e,0) end
  if picoquic_add_to_stream_with_ctx(conn.cnx,id,&bytes[0],(@csize)(size),(@cint)(fin),stream) ~= 0 then
    return io_fail(e,EPIPE,'could not queue QUIC stream bytes')
  end
  stream.sent_fin = fin == 1
  return io_done(e,1)
end

local function write_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],write_stream(e,find_connection(e,args[0]),args[1],args[2],args[3],false))
end

local function write_early_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local result = write_stream(e,find_connection(e,args[0]),handle_id(e,args[1],iroh_mp_MultipathEarlyStream),
    args[2],args[3],true)
  return io_tup(e,args[0],io_tup(e,args[1],result))
end

local function read_stream(e: Env, conn: *Connection, id: Term, max: Term): Term
  if conn == nilptr or conn.closed then return closed_error(e,conn) end
  if max == 0 then return io_fail(e,EINVAL,'QUIC stream read limit must be positive') end
  local stream = find_stream(conn,id)
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  if not stream.incoming and (id & 2) ~= 0 then return io_fail(e,EPIPE,'QUIC stream is send-only') end
  if stream.reset then return io_fail(e,ECONNRESET,'QUIC stream reset by peer') end
  if stream.size == 0 then
    return io_done(e,term_pak(stream.fin and iroh_mp_MultipathReadFin or iroh_mp_MultipathReadPending,0))
  end
  local size = stream.size
  if size > max then size = (@csize)(max) end
  local bytes = io_list(e,(@cstring)(stream.rx),size)
  stream.size = stream.size - size
  conn.received = conn.received - size
  if stream.size > 0 then
    C.memmove(stream.rx,&stream.rx[size],stream.size)
  else
    C.free(stream.rx)
    stream.rx = nilptr
  end
  return io_done(e,io_box(e,iroh_mp_MultipathReadBytes,bytes))
end

local function read_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],read_stream(e,find_connection(e,args[0]),args[1],args[2]))
end

local function drop_stream(e: Env, conn: *Connection, id: Term): Term
  if conn == nilptr then return closed_error(e,conn) end
  local stream = conn.streams
  local previous: *Stream
  while stream ~= nilptr and stream.id ~= id do
    previous = stream
    stream = (@*Stream)(stream.next)
  end
  if stream == nilptr or not stream.accepted then return io_fail(e,EBADF,'unknown QUIC stream') end
  if not conn.closed then
    local bidi = (id & 2) == 0
    if (bidi or not stream.incoming) and not stream.sent_fin and not stream.stop then
      picoquic_reset_stream(conn.cnx,id,0)
    end
    if (bidi or stream.incoming) and not stream.fin and not stream.reset then picoquic_stop_sending(conn.cnx,id,0) end
    local native = picoquic_find_stream(conn.cnx,id)
    if native ~= nilptr then native.app_stream_ctx = &discarded_stream end
  end
  if previous == nilptr then conn.streams = (@*Stream)(stream.next) else previous.next = stream.next end
  conn.stream_count = conn.stream_count - 1
  conn.received = conn.received - stream.size
  C.free(stream.rx)
  C.free(stream)
  return io_done(e,term_pak(iroh_mp_Unit,0))
end

local function drop_stream_run(e: Env, args: *[0]Term, work: *IoWork): Term
  return io_tup(e,args[0],drop_stream(e,find_connection(e,args[0]),args[1]))
end

local function close_run(e: Env, args: *[0]Term, work: *IoWork): Term
  local conn = find_connection(e,args[0])
  if conn ~= nilptr then
    if not conn.closed and picoquic_close(conn.cnx,0) == 0 then write_packet(conn,picoquic_current_time()) end
    remove_connection(conn)
  end
  return term_pak(iroh_mp_Unit,0)
end

local function register_multipath() <cexport,codename 'iroh_register_multipath',cattribute 'constructor'>
  if iroh_mp_start_multipath ~= 0xffffffff then io_eff(iroh_mp_start_multipath,start_run) end
  if iroh_mp_start_multipath_bytes ~= 0xffffffff then io_eff(iroh_mp_start_multipath_bytes,start_bytes_run) end
  if iroh_mp_start_multipath_alpns ~= 0xffffffff then io_eff(iroh_mp_start_multipath_alpns,start_alpns_run) end
  if iroh_mp_negotiated_multipath_alpn ~= 0xffffffff then io_eff(iroh_mp_negotiated_multipath_alpn,negotiated_alpn_run) end
  if iroh_mp_peer_multipath_parameters ~= 0xffffffff then io_eff(iroh_mp_peer_multipath_parameters,peer_parameters_run) end
  if iroh_mp_take_multipath_session ~= 0xffffffff then io_eff(iroh_mp_take_multipath_session,take_session_run) end
  if iroh_mp_drop_multipath_session ~= 0xffffffff then io_eff(iroh_mp_drop_multipath_session,drop_session_run) end
  if iroh_mp_start_multipath_resume ~= 0xffffffff then io_eff(iroh_mp_start_multipath_resume,start_resume_run) end
  if iroh_mp_multipath_resumption_status ~= 0xffffffff then io_eff(iroh_mp_multipath_resumption_status,resumption_status_run) end
  if iroh_mp_start_multipath_early ~= 0xffffffff then io_eff(iroh_mp_start_multipath_early,start_early_run) end
  if iroh_mp_multipath_early_status ~= 0xffffffff then io_eff(iroh_mp_multipath_early_status,early_status_run) end
  if iroh_mp_step_multipath ~= 0xffffffff then io_eff(iroh_mp_step_multipath,step_run) end
  if iroh_mp_probe_multipath ~= 0xffffffff then io_eff(iroh_mp_probe_multipath,probe_run) end
  if iroh_mp_multipath_status ~= 0xffffffff then io_eff(iroh_mp_multipath_status,status_run) end
  if iroh_mp_multipath_path_timeouts ~= 0xffffffff then io_eff(iroh_mp_multipath_path_timeouts,path_timeouts_run) end
  if iroh_mp_set_multipath_keepalive ~= 0xffffffff then io_eff(iroh_mp_set_multipath_keepalive,keepalive_run) end
  if iroh_mp_set_multipath_standby ~= 0xffffffff then io_eff(iroh_mp_set_multipath_standby,standby_run) end
  if iroh_mp_retire_multipath_path ~= 0xffffffff then io_eff(iroh_mp_retire_multipath_path,retire_run) end
  if iroh_mp_multipath_millis ~= 0xffffffff then io_eff(iroh_mp_multipath_millis,millis_run) end
  if iroh_mp_probe_multipath_alternate ~= 0xffffffff then io_eff(iroh_mp_probe_multipath_alternate,alternate_run) end
  if iroh_mp_open_multipath_stream ~= 0xffffffff then io_eff(iroh_mp_open_multipath_stream,open_stream_run) end
  if iroh_mp_open_multipath_early_stream ~= 0xffffffff then io_eff(iroh_mp_open_multipath_early_stream,open_early_stream_run) end
  if iroh_mp_write_multipath_early_stream ~= 0xffffffff then io_eff(iroh_mp_write_multipath_early_stream,write_early_stream_run) end
  if iroh_mp_resolve_multipath_early_stream ~= 0xffffffff then io_eff(iroh_mp_resolve_multipath_early_stream,resolve_early_stream_run) end
  if iroh_mp_assign_stream_path ~= 0xffffffff then io_eff(iroh_mp_assign_stream_path,assign_run) end
  if iroh_mp_write_multipath_stream ~= 0xffffffff then io_eff(iroh_mp_write_multipath_stream,write_run) end
  if iroh_mp_read_multipath_stream ~= 0xffffffff then io_eff(iroh_mp_read_multipath_stream,read_run) end
  if iroh_mp_drop_multipath_stream ~= 0xffffffff then io_eff(iroh_mp_drop_multipath_stream,drop_stream_run) end
  if iroh_mp_close_multipath ~= 0xffffffff then io_eff(iroh_mp_close_multipath,close_run) end
  if iroh_mp_bind_multipath ~= 0xffffffff then io_eff(iroh_mp_bind_multipath,bind_run) end
  if iroh_mp_bind_multipath_nat_offer ~= 0xffffffff then io_eff(iroh_mp_bind_multipath_nat_offer,bind_nat_offer_run) end
  if iroh_mp_bind_multipath_bytes ~= 0xffffffff then io_eff(iroh_mp_bind_multipath_bytes,bind_bytes_run) end
  if iroh_mp_bind_multipath_alpns ~= 0xffffffff then io_eff(iroh_mp_bind_multipath_alpns,bind_alpns_run) end
  if iroh_mp_set_multipath_alpns ~= 0xffffffff then io_eff(iroh_mp_set_multipath_alpns,set_alpns_run) end
  if iroh_mp_accept_multipath ~= 0xffffffff then io_eff(iroh_mp_accept_multipath,accept_run) end
  if iroh_mp_close_multipath_listener ~= 0xffffffff then io_eff(iroh_mp_close_multipath_listener,close_listener_run) end
  if iroh_mp_accept_multipath_stream ~= 0xffffffff then io_eff(iroh_mp_accept_multipath_stream,accept_stream_run) end
  if iroh_mp_next_multipath_path ~= 0xffffffff then io_eff(iroh_mp_next_multipath_path,next_path_run) end
  if iroh_mp_multipath_datagram_limit ~= 0xffffffff then io_eff(iroh_mp_multipath_datagram_limit,limit_run) end
  if iroh_mp_write_multipath_datagram ~= 0xffffffff then io_eff(iroh_mp_write_multipath_datagram,write_datagram_run) end
  if iroh_mp_write_multipath_early_frame ~= 0xffffffff then io_eff(iroh_mp_write_multipath_early_frame,write_early_frame_run) end
  if iroh_mp_read_multipath_datagram ~= 0xffffffff then io_eff(iroh_mp_read_multipath_datagram,read_datagram_run) end
end
