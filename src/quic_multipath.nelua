local extension_cb_t <cimport,nodecl,codename 'ptls_on_extension_t'> = @record{cb:AlpnCheck}
local pin_t <cimport,nodecl,codename 'ptls_openssl_raw_pubkey_verify_certificate_t'> = @record{
  super:verify_t,expected_pubkey:*evp_t
}
