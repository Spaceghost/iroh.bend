##[[
local names = {
  'start_multipath', 'start_multipath_bytes', 'start_multipath_alpns', 'negotiated_multipath_alpn',
  'peer_multipath_parameters', 'take_multipath_session', 'drop_multipath_session', 'MultipathSession',
  'start_multipath_resume', 'multipath_resumption_status', 'start_multipath_early', 'multipath_early_status',
  'step_multipath', 'probe_multipath', 'multipath_status', 'multipath_path_timeouts', 'set_multipath_keepalive',
  'set_multipath_standby', 'retire_multipath_path', 'multipath_millis', 'probe_multipath_alternate',
  'open_multipath_stream', 'assign_stream_path', 'write_multipath_stream',
  'MultipathEarlyStream', 'open_multipath_early_stream', 'write_multipath_early_stream', 'resolve_multipath_early_stream',
  'read_multipath_stream', 'drop_multipath_stream', 'close_multipath',
  'bind_multipath', 'bind_multipath_nat_offer', 'bind_multipath_bytes', 'bind_multipath_alpns', 'set_multipath_alpns',
  'accept_multipath', 'close_multipath_listener',
  'accept_multipath_stream', 'next_multipath_path',
  'multipath_datagram_limit', 'write_multipath_datagram', 'read_multipath_datagram', 'write_multipath_early_frame',
  'MultipathConnection', 'MultipathListener', 'MultipathReadPending', 'MultipathReadFin', 'MultipathReadBytes',
  'Some', 'None', 'Unit', 'Con', 'Nil'
}
for _, name in ipairs(names) do
  cinclude(string.format(
    '#ifdef CID(%s)\n#define iroh_mp_%s CID(%s)\n#else\n#define iroh_mp_%s UINT32_MAX\n#endif',
    name,name,name,name))
end
]]
