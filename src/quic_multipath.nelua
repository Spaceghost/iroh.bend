require 'C.stdlib'
require 'C.string'
local quic_t <cimport,nodecl,codename 'picoquic_quic_t'> = @record{tls_master_ctx: pointer, cnx_in_progress:pointer}
local transport_t <cimport,nodecl,codename 'picoquic_tp_t'> = @record{
  initial_max_data:uint64,initial_max_stream_data_bidi_local:uint64,initial_max_stream_data_bidi_remote:uint64,
  initial_max_stream_data_uni:uint64,initial_max_streams_bidi:uint64,initial_max_streams_uni:uint64,
  max_datagram_frame_size:uint32,active_connection_id_limit:uint32,max_packet_size:uint32
}
local frame_t <cimport,nodecl,codename 'picoquic_misc_frame_header_t'> = @record{next_misc_frame:pointer}
local native_stream_t <cimport,nodecl,codename 'picoquic_stream_head_t'> = @record{app_stream_ctx:pointer,send_queue:pointer,remote_error:uint64,remote_stop_error:uint64}
local packet_context_t <cimport,nodecl,codename 'picoquic_packet_context_t'> = @record{}
local path_t <cimport,nodecl,codename 'picoquic_path_t'> = @record{
  unique_path_id:uint64,send_mtu:csize,nb_retransmit:uint64,pkt_ctx:packet_context_t
}
local probe_packet_t <cimport,nodecl,codename 'picoquic_packet_t'> = @record{
  send_path:*path_t,send_time:uint64,offset:csize,ptype:cint,pc:cint,is_ack_eliciting:cuint,bytes:[1536]uint8
}
local crypto_context_t <cimport,nodecl,codename 'picoquic_crypto_context_t'> = @record{}
local tree_t <cimport,nodecl,codename 'picosplay_tree_t'> = @record{}
local cnx_t <cimport,nodecl,codename 'picoquic_cnx_t'> = @record{
  is_multipath_enabled:cuint,nb_paths:cint,path:**path_t,nb_bytes_queued:uint64,cnx_state:cint,tls_stream:[4]native_stream_t,tls_ctx:pointer,
  remote_parameters:transport_t,first_datagram:*frame_t,
  max_early_data_size:csize,zero_rtt_data_accepted:cuint,first_misc_frame:*frame_t,last_misc_frame:*frame_t,
  nb_packets_received:uint64,maxdata_remote:uint64,max_streams_bidir_remote:uint64,max_streams_unidir_remote:uint64,data_sent:uint64,
  next_stream_id:[4]uint64,pkt_ctx:[3]packet_context_t,queue_data_repeat_tree:tree_t,crypto_context:[4]crypto_context_t
}
local tls_t <cimport,nodecl,codename 'ptls_t'> = @record{}
local buffer_t <cimport,nodecl,codename 'ptls_buffer_t'> = @record{base:*uint8,off:csize}
local iov_t <cimport,nodecl,codename 'ptls_iovec_t'> = @record{base:*uint8,len:csize}
local client_tls_t <cimport,nodecl,codename 'picoquic_tls_ctx_t'> = @record{
  alpn_vec:*[0]iov_t, alpn_vec_size:csize, alpn_count:csize, tls:*tls_t
}
local ext_t <cimport,nodecl,codename 'ptls_raw_extension_t'> = @record{type:uint16,data:iov_t}
## cdefine 'iroh_mp_client_props __typeof__(((ptls_handshake_properties_t*)0)->client)'
local client_props_t <cimport,nodecl,codename 'iroh_mp_client_props'> = @record{
  session_ticket:iov_t, max_early_data_size:*csize, early_data_acceptance:cint
}
local props_t <cimport,nodecl,codename 'ptls_handshake_properties_t'> = @record{
  additional_extensions:*ext_t,collect_extension:pointer,collected_extensions:pointer,client:client_props_t
}
local evp_t <cimport,nodecl,codename 'EVP_PKEY'> = @record{}
local verify_t <cimport,nodecl,codename 'ptls_verify_certificate_t'> = @record{cb:pointer,algos:pointer}
local save_ticket_t <cimport,nodecl,codename 'ptls_save_ticket_t'> = @record{cb:pointer}
## cdefine 'iroh_mp_ticket_properties const ptls_save_ticket_properties_t'
local ticket_props_t <cimport,nodecl,codename 'iroh_mp_ticket_properties'> = @record{}
local mp_traffic <cimport,nodecl,codename 'ptls_update_traffic_key_t'> = @record{cb:pointer}
local context_t <cimport,nodecl,codename 'ptls_context_t'> = @record{
  use_raw_public_keys:cuint,sign_certificate:pointer,verify_certificate:*verify_t,on_extension:pointer,
  save_ticket:*save_ticket_t, update_traffic_key:*mp_traffic
}
