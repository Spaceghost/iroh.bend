  'set_multipath_standby', 'retire_multipath_path', 'multipath_millis', 'multipath_micros', 'probe_multipath_alternate',
  'open_multipath_stream', 'assign_stream_path', 'write_multipath_stream',
  'MultipathEarlyStream', 'open_multipath_early_stream', 'write_multipath_early_stream', 'resolve_multipath_early_stream',
  'read_multipath_stream', 'cancel_multipath_stream_half', 'peer_multipath_stream_code', 'drop_multipath_stream', 'close_multipath',
  'read_multipath_nat_frame', 'send_multipath_nat_challenge', 'take_multipath_nat_response', 'send_multipath_nat_address', 'bind_multipath_nat_source', 'route_multipath_nat_source', 'start_multipath_qad', 'poll_multipath_qad', 'configure_routed_qad', 'poll_routed_qad', 'configure_listener_qad', 'listener_qad_addresses', 'multipath_nat_local_candidate', 'open_multipath_nat_path', 'bind_multipath', 'bind_multipath_nat_offer', 'bind_multipath_alpns_nat_offer', 'bind_multipath_bytes', 'bind_multipath_alpns', 'set_multipath_alpns',
  'bind_resumable_multipath', 'bind_multipath_identity', 'bind_dual_multipath_identity', 'bind_dual_multipath_nat_identity', 'multipath_remote_id', 'accept_multipath', 'close_multipath_listener',
  'QadServer', 'bind_qad_server', 'step_qad_server', 'close_qad_server',
