local bend_lws_protocol_size: csize <cimport,nodecl>
require 'C.stdlib'
require 'C.string'

##[[
for _, name in ipairs{'relay_bind','relay_poll','relay_millis','relay_queue','relay_authorized_with_meter',
                      'relay_resume_rx','relay_reconfigure_rx','relay_kick','relay_stop',
                      'relay_nonce','RelayListener','RelayIdle','RelayJoined','RelayBytes','RelayBufferedBytes','RelayLeft',
                      'Con','True','False','Unit','Some','None',
                      'relay_client_auth_header','relay_export_keying_material',
                      'relay_request_raw','relay_enable_request_details','Nil'} do
  cinclude(string.format(
    '#ifdef CID(%s)\n#define iroh_srv_%s CID(%s)\n#else\n#define iroh_srv_%s UINT32_MAX\n#endif',
    name,name,name,name))
end
]]
local iroh_srv_relay_bind: uint32 <cimport,nodecl>
local iroh_srv_relay_poll: uint32 <cimport,nodecl>
local iroh_srv_relay_queue: uint32 <cimport,nodecl>
