-- libwebsockets owns HTTP upgrades, WS framing and TLS. Bend owns relay state.
## pragmas.noentrypoint = true
## pragmas.nogc = true
## cinclude '<libwebsockets.h>'
## cinclude '<openssl/rand.h>'
## cinclude '<openssl/ssl.h>'
## cinclude '<errno.h>'
## cdefine 'bend_lws_info struct lws_context_creation_info'
