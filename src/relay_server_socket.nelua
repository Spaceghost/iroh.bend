  name: cstring, callback: Callback, per_session_data_size: csize, rx_buffer_size: csize, id: cuint
}
local Info <cimport,nodecl,codename 'bend_lws_info'> = @record{
  port: cint, iface: cstring, protocols: *Protocol, options: uint64, user: pointer,
  vhost_name: cstring, ssl_cert_filepath: cstring, ssl_private_key_filepath: cstring, timeout_secs: cuint
}
local LWS_CALLBACK_FILTER_PROTOCOL_CONNECTION: cint <cimport,nodecl>
local LWS_CALLBACK_ESTABLISHED: cint <cimport,nodecl>
local LWS_CALLBACK_RECEIVE: cint <cimport,nodecl>
local LWS_CALLBACK_CLOSED: cint <cimport,nodecl>
local LWS_CALLBACK_SERVER_WRITEABLE: cint <cimport,nodecl>
local LWS_CALLBACK_HTTP: cint <cimport,nodecl>
local LWS_CALLBACK_HTTP_WRITEABLE: cint <cimport,nodecl>
local SSL <cimport,nodecl> = @record{}
local function lws_get_ssl(wsi: *lws): *SSL <cimport,nodecl> end
local function SSL_export_keying_material(ssl: *SSL, out: *cuchar, len: csize,
    label: cstring, label_len: csize, context: *cuchar, context_len: csize, use_context: cint): cint <cimport,nodecl> end
local function lws_hdr_custom_length(ws: *lws, name: cstring, len: cint): cint <cimport,nodecl> end
local function lws_hdr_custom_copy(ws: *lws, dst: cstring, cap: cint, name: cstring, len: cint): cint <cimport,nodecl> end
local WSI_TOKEN_GET_URI: cint <cimport,nodecl>
local WSI_TOKEN_COUNT: cint <cimport,nodecl>
local WSI_TOKEN_HTTP_AUTHORIZATION: cint <cimport,nodecl>
local WSI_TOKEN_HTTP_URI_ARGS: cint <cimport,nodecl>
local LWS_WRITE_BINARY: cint <cimport,nodecl>
local LWS_WRITE_HTTP_FINAL: cint <cimport,nodecl>
local LWS_PRE: csize <cimport,nodecl>
local LWS_SERVER_OPTION_DO_SSL_GLOBAL_INIT: uint64 <cimport,nodecl>
local PENDING_TIMEOUT_USER_OK: cint <cimport,nodecl>
local LWS_TO_KILL_ASYNC: cint <cimport,nodecl>
local function lws_create_context(info: *Info): *lws_context <cimport,nodecl> end
local function lws_context_destroy(ctx: *lws_context) <cimport,nodecl> end
