local function lws_hdr_copy_fragment(wsi: *lws, text: cstring, max: cint, token: cint, index: cint): cint <cimport,nodecl> end
local function lws_token_to_string(token: cint): pointer <cimport,nodecl> end
## cdefine 'bend_lws_header_name const char'
local HeaderName <cimport,nodecl,codename 'bend_lws_header_name'> = @record{}
local HeaderVisitor = @function(*HeaderName,cint,pointer): void
local function lws_hdr_custom_name_foreach(wsi: *lws, visitor: HeaderVisitor, context: pointer): cint <cimport,nodecl> end
local function lws_frame_is_binary(wsi: *lws): cint <cimport,nodecl> end
local function lws_is_final_fragment(wsi: *lws): cint <cimport,nodecl> end
local function lws_rx_flow_control(wsi: *lws, enable: cint): cint <cimport,nodecl> end
local LWS_RXFLOW_REASON_FLAG_PROCESS_NOW: cint <cimport,nodecl>
local function lws_remaining_packet_payload(wsi: *lws): csize <cimport,nodecl> end
local function lws_callback_on_writable(wsi: *lws): cint <cimport,nodecl> end
local function lws_write(wsi: *lws, bytes: *cuchar, size: csize, kind: cint): cint <cimport,nodecl> end
local function lws_cancel_service(ctx: *lws_context) <cimport,nodecl> end
local function lws_service(ctx: *lws_context, timeout: cint): cint <cimport,nodecl> end
local function lws_set_timeout(wsi: *lws, reason: cint, seconds: cint) <cimport,nodecl> end
local function lws_add_http_header_status(wsi: *lws, code: cuint, p: **cuchar, stop: *cuchar): cint <cimport,nodecl> end
local function lws_add_http_header_content_length(wsi: *lws, len: uint64, p: **cuchar, stop: *cuchar): cint <cimport,nodecl> end
local function lws_add_http_header_by_name(wsi: *lws, name: *cuchar, value: *cuchar, len: cint,
    p: **cuchar, stop: *cuchar): cint <cimport,nodecl> end
local function lws_finalize_write_http_header(wsi: *lws, start: *cuchar, p: **cuchar, stop: *cuchar): cint <cimport,nodecl> end
local function lws_http_transaction_completed(wsi: *lws): cint <cimport,nodecl> end

local MAX_FRAME <comptime> = 65544
local MAX_PEERS <comptime> = 128
local MAX_EVENTS <comptime> = 512
local MAX_SEND <comptime> = 32
local MAX_METADATA <comptime> = 8192

local Frame = @record{next: pointer, data: *cuchar, size: csize}
local Field = @record{next: pointer, value: cstring, size: csize}
local Header = @record{next: pointer, name: cstring, size: csize, values: pointer, repeated: boolean}
local HeaderCapture = @record{ws: *lws, text: cstring, headers: pointer, used: csize, failed: boolean}
local Peer = @record{
  next: pointer, ws: *lws, id: uint32, deadline: uint64, authorized: boolean, closing: boolean,
  metered: boolean, rx_held: boolean,
  auth_header: [152]cchar, auth_len: cint,
  path: [24]cchar, path_len: cint, authorization: pointer, query: pointer, headers: pointer,
  body: pointer, length: csize, capacity: csize, queued: cuint, outgoing: pointer, tail: pointer,
  http_body: cstring
}
local Event = @record{next: pointer, tag: uint32, id: uint32, version: uint32, body: cstring, size: csize}
local Server = @record{
  next: pointer, id: uint32, ctx: *lws_context, iface: cstring, cert: cstring, key: cstring,
  protocols: *[0]Protocol, peers: pointer, peer_count: cuint,
  events: pointer, event_tail: pointer, event_count: cuint, request_details: boolean
}
local servers: pointer
local next_id: uint32 = 1

local function find_slot(e: Env, handle: Term): *pointer
  if term_aux(handle) ~= iroh_srv_RelayListener then return nilptr end
  local id: uint32
  if term_tag(handle) == TAG_PAK then id = (@uint32)(term_loc(handle))
  elseif term_tag(handle) == TAG_CTR then id = (@uint32)(e.mem[term_peek(e.mem,handle)])
  else return nilptr end
  local slot = &servers
  while $slot ~= nilptr do
    local server = (@*Server)($slot)
    if server.id == id then return slot end
    slot = &server.next
  end
  return nilptr
end
local function find_server(e: Env, handle: Term): *Server
  local slot = find_slot(e,handle)
  if slot ~= nilptr then return (@*Server)($slot) end
  return nilptr
end
local function find_peer(server: *Server, id: uint32): *Peer
  if server == nilptr then return nilptr end
  local at = server.peers
  while at ~= nilptr do
    local peer = (@*Peer)(at)
    if peer.id == id then return peer end
    at = peer.next
  end
  return nilptr
end

local function post(server: *Server, tag: uint32, id: uint32): *Event
  if server.event_count >= MAX_EVENTS then return nilptr end
  local ev = (@*Event)(io_mem(C.calloc(1,#Event)))
  ev.tag = tag
  ev.id = id
  if server.event_tail == nilptr then server.events = ev
  else (@*Event)(server.event_tail).next = ev end
  server.event_tail = ev
  server.event_count = server.event_count + 1
  return ev
end
local function free_frame(frame: *Frame)
  C.free(frame.data)
  C.free(frame)
end
local function free_fields(fields: pointer)
  while fields ~= nilptr do
    local field = (@*Field)(fields)
    fields = field.next
    cleanse(field.value,field.size)
    C.free(field.value)
    C.free(field)
  end
end
local function clear_request(peer: *Peer)
  free_fields(peer.authorization)
  free_fields(peer.query)
  peer.authorization = nilptr
  peer.query = nilptr
  while peer.headers ~= nilptr do
    local header = (@*Header)(peer.headers)
    peer.headers = header.next
    free_fields(header.values)
    C.free(header.name)
    C.free(header)
  end
  peer.path_len = -1
end
local function remove_peer(server: *Server, peer: *Peer)
  local slot = &server.peers
  while $slot ~= nilptr and $slot ~= peer do
    slot = &(@*Peer)($slot).next
  end
  if $slot ~= peer then return end
  $slot = peer.next
  server.peer_count = server.peer_count - 1
  clear_request(peer)
  C.free(peer.body)
  while peer.outgoing ~= nilptr do
    local frame = (@*Frame)(peer.outgoing)
    peer.outgoing = frame.next
    free_frame(frame)
  end
  post(server,iroh_srv_RelayLeft,peer.id)
end

local function receive(server: *Server, peer: *Peer, bytes: pointer, len: csize): cint
  if not peer.authorized and peer.length + len > 128 then return -1 end
  if lws_frame_is_binary(peer.ws) == 0 or len > MAX_FRAME - peer.length then return -1 end
  local required = peer.length + len
  if required > peer.capacity then
    local capacity = peer.capacity * 2
    if capacity < required then capacity = required end
    if capacity > MAX_FRAME then capacity = MAX_FRAME end
    local data = C.realloc(peer.body,capacity)
    if data == nilptr then return -1 end
    peer.body = data
    peer.capacity = capacity
  end
  if len > 0 then C.memcpy(&(@*[0]cuchar)(peer.body)[peer.length],bytes,len) end
  peer.length = required
  if lws_is_final_fragment(peer.ws) == 0 or lws_remaining_packet_payload(peer.ws) ~= 0 then return 0 end
  local ev = post(server,iroh_srv_RelayBytes,peer.id)
  if ev == nilptr then return -1 end
  ev.body = (@cstring)(peer.body)
  ev.size = peer.length
  peer.body = nilptr
  peer.length = 0
  peer.capacity = 0
  if peer.metered then
    peer.rx_held = true
    return lws_rx_flow_control(peer.ws,0)
  end
  return 0
end
local function send(peer: *Peer): cint
  local frame = (@*Frame)(peer.outgoing)
  if frame == nilptr then
    if peer.closing then return -1 end
    return 0
  end
  local data = (@*[0]cuchar)(frame.data)
  if lws_write(peer.ws,&data[LWS_PRE],frame.size,LWS_WRITE_BINARY) ~= (@cint)(frame.size) then return -1 end
  peer.outgoing = frame.next
  peer.queued = peer.queued - 1
  free_frame(frame)
  if peer.outgoing == nilptr then peer.tail = nilptr end
  if peer.outgoing ~= nilptr or peer.closing then lws_callback_on_writable(peer.ws) end
  return 0
end

local function capture_auth_header(peer: *Peer, ws: *lws)
  local header: cstring = 'x-iroh-relay-client-auth-v1:'
  local name_len = (@cint)(C.strlen(header))
  local len = lws_hdr_custom_length(ws,header,name_len)
  -- Keep absence distinct from a present header with invalid length.
  peer.auth_len = len
  if len ~= 151 then
    if len >= 0 then peer.auth_len = 0 end
    return
  end
  if lws_hdr_custom_copy(ws,(@cstring)(&peer.auth_header[0]),152,header,name_len) ~= len then
    peer.auth_len = 0
  end
end

local function append_field(fields: *pointer, text: cstring, len: csize, used: *csize): boolean
  if len + 1 > MAX_METADATA - $used then return false end
  local entry = (@*Field)(io_mem(C.calloc(1,#Field)))
  entry.size = len
  entry.value = (@cstring)(io_mem(C.malloc(len + 1)))
  C.memcpy(entry.value,text,len + 1)
  entry.next = $fields
  $fields = entry
  $used = $used + len + 1
  return true
end

local function capture_fields(ws: *lws, token: cint, fields: *pointer, used: *csize, text: cstring): boolean
  local index: cint = 0
  while true do
    local len = lws_hdr_copy_fragment(ws,text,MAX_METADATA,token,index)
    if len == -1 then return true end
    if len < 0 or not append_field(fields,text,(@csize)(len),used) then return false end
    index = index + 1
  end
end

local function add_header(capture: *HeaderCapture, name: cstring, len: csize): *Header
  if len + 1 > MAX_METADATA - capture.used then return nilptr end
  local header = (@*Header)(io_mem(C.calloc(1,#Header)))
  header.name = (@cstring)(io_mem(C.calloc(1,len + 1)))
  C.memcpy(header.name,name,len)
  header.size = len
  header.next = capture.headers
  capture.headers = header
  capture.used = capture.used + len + 1
  return header
end

local function capture_custom(source: *HeaderName, n: cint, context: pointer)
  local capture = (@*HeaderCapture)(context)
  if capture.failed or n <= 1 then return end
  local name = (@cstring)(source)
  local len = (@csize)(n - 1)
  local next_header = capture.headers
  while next_header ~= nilptr do
    local header = (@*Header)(next_header)
    if header.size == len and C.strncmp(header.name,name,len) == 0 then
      -- The public custom-header lookup returns the first value only.
      -- Preserve the ambiguity instead of publishing a partial value list.
      header.repeated = true
      free_fields(header.values)
      header.values = nilptr
      return
    end
    next_header = header.next
  end
  local header = add_header(capture,name,len)
  local copied = lws_hdr_custom_copy(capture.ws,capture.text,MAX_METADATA,name,n)
  capture.failed = header == nilptr or copied < 0 or
    not append_field(&header.values,capture.text,(@csize)(copied),&capture.used)
end

local function capture_headers(capture: *HeaderCapture): boolean
  for token: cint = 0,<WSI_TOKEN_COUNT do
    local name = (@cstring)(lws_token_to_string(token))
    if name ~= nilptr and token ~= WSI_TOKEN_HTTP_URI_ARGS then
      local len = C.strlen(name)
      local bytes = (@*[0]cchar)(name)
      if len > 1 and bytes[0] ~= 58 and bytes[len - 1] == 58 then
        local values: pointer
        if not capture_fields(capture.ws,token,&values,&capture.used,capture.text) then
          free_fields(values)
          return false
        end
        if values ~= nilptr then
          local header = add_header(capture,name,len - 1)
          if header == nilptr then
            free_fields(values)
            return false
          end
          header.values = values
        end
      end
    end
  end
  return lws_hdr_custom_name_foreach(capture.ws,capture_custom,capture) == 0 and not capture.failed
end

local function capture_request(peer: *Peer, ws: *lws)
  peer.path_len = lws_hdr_copy(ws,(@cstring)(&peer.path[0]),24,WSI_TOKEN_GET_URI)
  local text: [MAX_METADATA]cchar
  defer cleanse(&text[0],MAX_METADATA) end
  local bytes = (@cstring)(&text[0])
  local used: csize = 0
  if peer.path_len < 0 or not capture_fields(ws,WSI_TOKEN_HTTP_AUTHORIZATION,&peer.authorization,&used,bytes) or
      not capture_fields(ws,WSI_TOKEN_HTTP_URI_ARGS,&peer.query,&used,bytes) then
    clear_request(peer)
    return
  end
  local captured: HeaderCapture = {ws = ws, text = bytes}
  local ok = capture_headers(&captured)
  peer.headers = captured.headers
  if not ok then clear_request(peer) end
end

local function http_header(ws: *lws, name: cstring, value: cstring, p: **cuchar, stop: *cuchar): cint
  return lws_add_http_header_by_name(ws,(@*cuchar)(name),(@*cuchar)(value),(@cint)(C.strlen(value)),p,stop)
end

local function portal_challenge(ws: *lws, response: cstring): boolean
  local challenge: [64]cchar
  local size = lws_hdr_custom_copy(ws,(@cstring)(&challenge[0]),64,'x-iroh-challenge:',17)
  if size < 1 then return false end
  for i = 0,<size do
    local ch = challenge[i]
    if not ((ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or
        (ch >= 97 and ch <= 122) or ch == 45 or ch == 46 or ch == 95) then return false end
  end
  C.memcpy(response,(@cstring)('response '),9)
  local bytes = (@*[0]cchar)(response)
  C.memcpy(&bytes[9],&challenge[0],(@csize)(size + 1))
  return true
end

local function http_response(ws: *lws, peer: *Peer): cint
  local path: [32]cchar
  local uri = (@cstring)(&path[0])
  local status: cuint = 404
  local body: cstring = 'Not Found'
  local content_type: cstring
  local probe = false
  if lws_hdr_copy(ws,uri,32,WSI_TOKEN_GET_URI) >= 0 then
    if C.strcmp(uri,'/ping') == 0 then
      status = 200
      body = ''
      probe = true
    elseif C.strcmp(uri,'/generate_204') == 0 and lws_get_ssl(ws) == nilptr then
      status = 204
      body = ''
    elseif C.strcmp(uri,'/healthz') == 0 then
      status = 200
      body = '{"status":"ok","version":"iroh.bend","git_hash":"unknown"}'
      content_type = 'application/json'
    elseif C.strcmp(uri,'/robots.txt') == 0 then
      status = 200
      body = 'User-agent: *\nDisallow: /\n'
    elseif C.strcmp(uri,'/') == 0 or C.strcmp(uri,'/index.html') == 0 then
      status = 200
      body = '<html><body><h1>Iroh Relay</h1><p><a href="https://iroh.computer/">Iroh</a></p></body></html>'
      content_type = 'text/html'
    end
  end
  local buffer: [1024]cuchar
  local start = &buffer[LWS_PRE]
  local p = start
  local stop = &buffer[1023]
  if lws_add_http_header_status(ws,status,&p,stop) ~= 0 or
      http_header(ws,'strict-transport-security:','max-age=63072000; includeSubDomains',&p,stop) ~= 0 or
      http_header(ws,'content-security-policy:',"default-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'",&p,stop) ~= 0 or
      (content_type ~= nilptr and http_header(ws,'content-type:',content_type,&p,stop) ~= 0) or
      (probe and http_header(ws,'access-control-allow-origin:','*',&p,stop) ~= 0) or
      (status ~= 204 and lws_add_http_header_content_length(ws,C.strlen(body),&p,stop) ~= 0) then return -1 end
  if status == 204 then
    local response: [73]cchar
    local value = (@cstring)(&response[0])
    if portal_challenge(ws,value) and http_header(ws,'x-iroh-response:',value,&p,stop) ~= 0 then return -1 end
  end
  if lws_finalize_write_http_header(ws,start,&p,stop) ~= 0 then return -1 end
  if C.strlen(body) == 0 then return -lws_http_transaction_completed(ws) end
  peer.http_body = body
  lws_callback_on_writable(ws)
  return 0
end

local function http_write(ws: *lws, peer: *Peer): cint
  if peer == nilptr or peer.http_body == nilptr then return 0 end
  local len = C.strlen(peer.http_body)
  local buffer: [128]cuchar
  if len + LWS_PRE > 128 then return -1 end
  local start = &buffer[LWS_PRE]
  C.memcpy(start,peer.http_body,len)
  peer.http_body = nilptr
  if lws_write(ws,start,len,LWS_WRITE_HTTP_FINAL) < (@cint)(len) then return -1 end
  return -lws_http_transaction_completed(ws)
end

local function callback(ws: *lws, reason: cint, user: pointer, bytes: pointer, len: csize): cint
  if reason == LWS_CALLBACK_HTTP then
    if user == nilptr then return -1 end
    return http_response(ws,(@*Peer)(user))
  end
  if reason == LWS_CALLBACK_HTTP_WRITEABLE then return http_write(ws,(@*Peer)(user)) end
  if reason == LWS_CALLBACK_FILTER_PROTOCOL_CONNECTION then
    local uri: [24]cchar
    if lws_hdr_copy(ws,(@cstring)(&uri[0]),24,WSI_TOKEN_GET_URI) < 0 or
        (C.strcmp((@cstring)(&uri[0]),'/relay') ~= 0 and C.strcmp((@cstring)(&uri[0]),'/derp') ~= 0) then
      return 1
    end
    return 0
  end
  if reason ~= LWS_CALLBACK_ESTABLISHED and reason ~= LWS_CALLBACK_RECEIVE and
      reason ~= LWS_CALLBACK_CLOSED and reason ~= LWS_CALLBACK_SERVER_WRITEABLE then return 0 end
  if user == nilptr then return -1 end
  local peer = (@*Peer)(user)
  local server = (@*Server)(lws_context_user(lws_get_context(ws)))
  if reason == LWS_CALLBACK_ESTABLISHED then
    local version = lws_get_protocol(ws).id
    if server.peer_count >= MAX_PEERS or next_id == 0 or version == 0 or
        server.event_count >= MAX_EVENTS - MAX_PEERS then return -1 end
    local ev = post(server,iroh_srv_RelayJoined,next_id)
    ev.version = version
    peer.id = next_id
    next_id = next_id + 1
    peer.ws = ws
    capture_auth_header(peer,ws)
    if server.request_details then capture_request(peer,ws) end
    peer.next = server.peers
    server.peers = peer
    server.peer_count = server.peer_count + 1
    peer.deadline = io_tick() + 10000000000
    return 0
  end
  if peer.id == 0 then return 0 end
  if reason == LWS_CALLBACK_RECEIVE then
    if peer.closing or server.event_count >= MAX_EVENTS - MAX_PEERS then return -1 end
    return receive(server,peer,bytes,len)
  end
  if reason == LWS_CALLBACK_SERVER_WRITEABLE then return send(peer) end
  remove_peer(server,peer)
  return 0
end

local function free_server(server: *Server)
  if server.ctx ~= nilptr then lws_context_destroy(server.ctx) end
  while server.events ~= nilptr do
    local ev = (@*Event)(server.events)
    server.events = ev.next
    C.free(ev.body)
    C.free(ev)
  end
  C.free(server.protocols)
  C.free(server.iface)
  C.free(server.cert)
  C.free(server.key)
  C.free(server)
end
local function bind_run(e: Env, f: *[0]Term, work: *IoWork): Term
  if f[1] > 65535 or next_id == 0 then return io_fail(e,EINVAL,'invalid relay port or listener handle') end
  local server = (@*Server)(io_mem(C.calloc(1,#Server)))
  local n: uint64, cert_len: uint64, key_len: uint64
  server.iface = io_cstr(e,f[0],&n)
  server.cert = io_cstr(e,f[2],&cert_len)
  server.key = io_cstr(e,f[3],&key_len)
  if io_nul(server.iface,n) or io_nul(server.cert,cert_len) or io_nul(server.key,key_len) or
      (cert_len == 0) ~= (key_len == 0) then
    free_server(server)
    return io_fail(e,EINVAL,'invalid relay interface or TLS paths')
  end
  server.protocols = (@*[0]Protocol)(io_mem(C.calloc(4,bend_lws_protocol_size)))
  server.protocols[0] = {name = 'http', callback = callback, per_session_data_size = #Peer}
  server.protocols[1] = {name = 'iroh-relay-v2', callback = callback, per_session_data_size = #Peer,
    rx_buffer_size = 4096, id = 2}
  server.protocols[2] = {name = 'iroh-relay-v1', callback = callback, per_session_data_size = #Peer,
    rx_buffer_size = 4096, id = 1}
  local info: Info = {port = (@cint)(f[1]), iface = server.iface, protocols = &server.protocols[0],
    user = server, timeout_secs = 10, vhost_name = 'iroh'}
  if cert_len > 0 then
    info.options = LWS_SERVER_OPTION_DO_SSL_GLOBAL_INIT
    info.ssl_cert_filepath = server.cert
    info.ssl_private_key_filepath = server.key
  end
  server.ctx = lws_create_context(&info)
  if server.ctx == nilptr then
    free_server(server)
    return io_fail(e,EIO,'could not bind relay WebSocket server')
  end
  local vhost = lws_get_vhost_by_name(server.ctx,'iroh')
  local port: cint = -1
  if vhost ~= nilptr then port = lws_get_vhost_listen_port(vhost) end
  if port <= 0 then
    free_server(server)
    return io_fail(e,EIO,'could not determine relay listener port')
  end
  server.id = next_id
  next_id = next_id + 1
  server.next = servers
  servers = server
  return io_done(e,io_tup(e,term_pak(iroh_srv_RelayListener,server.id),(@uint32)(port)))
end
local function kick(peer: *Peer)
  peer.closing = true
  lws_set_timeout(peer.ws,PENDING_TIMEOUT_USER_OK,LWS_TO_KILL_ASYNC)
end
local function poll_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local server = find_server(e,f[0])
  local result = term_pak(iroh_srv_RelayIdle,0)
  if server == nilptr then return io_tup(e,f[0],result) end
  local now = io_tick()
  local p = server.peers
  while p ~= nilptr do
    local peer = (@*Peer)(p)
    if not peer.authorized and not peer.closing and now >= peer.deadline then kick(peer) end
    p = peer.next
  end
  if server.events == nilptr then
    lws_cancel_service(server.ctx)
    lws_service(server.ctx,0)
  end
  local ev = (@*Event)(server.events)
  if ev ~= nilptr then
    server.events = ev.next
    if server.events == nilptr then server.event_tail = nilptr end
    server.event_count = server.event_count - 1
    if ev.tag == iroh_srv_RelayJoined then
      result = io_node(e,ev.tag,ev.id,ev.version)
    elseif ev.tag == iroh_srv_RelayBytes or ev.tag == iroh_srv_RelayBufferedBytes then
      result = io_node(e,ev.tag,ev.id,io_list(e,ev.body,ev.size))
    else
      result = term_pak(ev.tag,ev.id)
    end
    C.free(ev.body)
    C.free(ev)
  end
  return io_tup(e,f[0],result)
end

local function size_bytes(e: Env, item: Term): csize
  local count: csize = 0
  while term_aux(item) == iroh_srv_Con do
    local at = term_peek(e.mem,item)
    if count == MAX_FRAME or e.mem[at] > 255 then return MAX_FRAME + 1 end
    count = count + 1
    item = e.mem[at + 1]
  end
  return count
end
local function queue_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local peer = find_peer(find_server(e,f[0]),(@uint32)(f[1]))
  if peer == nilptr or peer.closing or peer.queued >= MAX_SEND then
    return io_tup(e,f[0],term_pak(iroh_srv_False,0))
  end
  local n = size_bytes(e,f[2])
  if n > MAX_FRAME then return io_tup(e,f[0],term_pak(iroh_srv_False,0)) end
  local frame = (@*Frame)(io_mem(C.calloc(1,#Frame)))
  frame.size = n
  frame.data = (@*cuchar)(io_mem(C.malloc(n + LWS_PRE)))
  local buf = (@*[0]cuchar)(frame.data)
  local item = f[2]
  for i: csize = 0,<n do
    local at = term_peek(e.mem,item)
    buf[LWS_PRE + i] = (@cuchar)(e.mem[at])
    item = e.mem[at + 1]
  end
  if peer.tail == nilptr then peer.outgoing = frame
  else (@*Frame)(peer.tail).next = frame end
  peer.tail = frame
  peer.queued = peer.queued + 1
  lws_callback_on_writable(peer.ws)
  return io_tup(e,f[0],term_pak(iroh_srv_True,0))
end

local function auth_header_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local peer = find_peer(find_server(e,f[0]),(@uint32)(f[1]))
  if peer == nilptr or peer.auth_len < 0 then
    return io_tup(e,f[0],term_pak(iroh_srv_None,0))
  end
  local bytes = io_list(e,(@cstring)(&peer.auth_header[0]),(@uint64)(peer.auth_len))
  return io_tup(e,f[0],io_box(e,iroh_srv_Some,bytes))
end

local function list_fields(e: Env, fields: pointer): Term
  local list = term_pak(iroh_srv_Nil,0)
  while fields ~= nilptr do
    local field = (@*Field)(fields)
    list = io_node(e,iroh_srv_Con,io_list(e,field.value,field.size),list)
    fields = field.next
  end
  return list
end
local function list_headers(e: Env, headers: pointer): Term
  local list = term_pak(iroh_srv_Nil,0)
  while headers ~= nilptr do
    local header = (@*Header)(headers)
    local flag: cchar = 0
    if header.repeated then flag = 1 end
    local name = io_list(e,header.name,header.size)
    local values = io_node(e,iroh_srv_Con,io_list(e,(@cstring)(&flag),1),list_fields(e,header.values))
    list = io_node(e,iroh_srv_Con,io_node(e,iroh_srv_Con,name,values),list)
    headers = header.next
  end
  return list
end
local function request_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local server = find_server(e,f[0])
  local peer = find_peer(server,(@uint32)(f[1]))
  local empty = term_pak(iroh_srv_Nil,0)
  if peer == nilptr or not server.request_details or peer.path_len < 0 or peer.closing then
    return io_tup(e,f[0],empty)
  end
  local path = io_list(e,(@cstring)(&peer.path[0]),(@uint64)(peer.path_len))
  -- The native bridge uses the runtime's generic list representation.
  -- Bend constructs and flattens the public RequestDetails record.
  local query = io_node(e,iroh_srv_Con,list_fields(e,peer.query),list_headers(e,peer.headers))
  local fields = io_node(e,iroh_srv_Con,list_fields(e,peer.authorization),query)
  local raw = io_node(e,iroh_srv_Con,io_node(e,iroh_srv_Con,path,empty),fields)
  clear_request(peer)
  return io_tup(e,f[0],raw)
end
local function enable_request_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local server = find_server(e,f[0])
  if server ~= nilptr then server.request_details = true end
  return f[0]
end

local function export_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local peer = find_peer(find_server(e,f[0]),(@uint32)(f[1]))
  local none = term_pak(iroh_srv_None,0)
  if peer == nilptr or peer.closing or peer.authorized or size_bytes(e,f[2]) ~= 32 then
    return io_tup(e,f[0],none)
  end
  local ssl = lws_get_ssl(peer.ws)
  if ssl == nilptr then return io_tup(e,f[0],none) end
  local key: [32]cchar, material: [32]cchar
  local item = f[2]
  for i: csize = 0,<32 do
    local at = term_peek(e.mem,item)
    key[i] = (@cchar)(e.mem[at])
    item = e.mem[at + 1]
  end
  local label: cstring = 'iroh-relay handshake v1'
  if SSL_export_keying_material(ssl,(@*cuchar)(&material[0]),32,label,C.strlen(label),
      (@*cuchar)(&key[0]),32,1) ~= 1 then
    return io_tup(e,f[0],none)
  end
  return io_tup(e,f[0],io_box(e,iroh_srv_Some,io_list(e,&material[0],32)))
end

local function authorized_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local peer = find_peer(find_server(e,f[0]),(@uint32)(f[1]))
  if peer ~= nilptr then
    peer.authorized = true
    peer.metered = term_aux(f[2]) == iroh_srv_True
    clear_request(peer)
  end
  return f[0]
end
local function resume_rx(peer: *Peer)
  if peer.rx_held and not peer.closing then
    peer.rx_held = false
    if lws_rx_flow_control(peer.ws,1 | LWS_RXFLOW_REASON_FLAG_PROCESS_NOW) < 0 then kick(peer) end
  end
end
local function resume_rx_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local peer = find_peer(find_server(e,f[0]),(@uint32)(f[1]))
  if peer ~= nilptr then resume_rx(peer) end
  return f[0]
end
local function reconfigure_rx_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local server = find_server(e,f[0])
  if server == nilptr then return f[0] end
  -- Queued frames were read before this update. Keep them out of the new
  -- buckets and drain them before servicing sockets again.
  local at = server.events
  while at ~= nilptr do
    local event = (@*Event)(at)
    if event.tag == iroh_srv_RelayBytes then event.tag = iroh_srv_RelayBufferedBytes end
    at = event.next
  end
  local metered = term_aux(f[1]) == iroh_srv_True
  at = server.peers
  while at ~= nilptr do
    local peer = (@*Peer)(at)
    if peer.authorized and not peer.closing then
      peer.metered = metered
      resume_rx(peer)
    end
    at = peer.next
  end
  return f[0]
end
local function kick_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local peer = find_peer(find_server(e,f[0]),(@uint32)(f[1]))
  if peer ~= nilptr then
    if f[2] == 1 then
      peer.closing = true
      lws_callback_on_writable(peer.ws)
    else
      kick(peer)
    end
  end
  return f[0]
end
local function stop_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local slot = find_slot(e,f[0])
  if slot ~= nilptr then
    local server = (@*Server)($slot)
    $slot = server.next
    free_server(server)
  end
  return term_pak(iroh_srv_Unit,0)
end
local function nonce_run(e: Env, f: *[0]Term, work: *IoWork): Term
  local nonce: [16]cuchar
  if RAND_bytes(&nonce[0],16) ~= 1 then return io_fail(e,EIO,'could not generate relay challenge') end
  return io_done(e,io_list(e,(@cstring)(&nonce[0]),16))
end

local function millis_run(e: Env, f: *[0]Term, work: *IoWork): Term
  return (@uint32)(io_tick() // 1000000)
end

local function register() <cexport,codename 'iroh_register_relay_server',cattribute 'constructor'>
  if iroh_srv_relay_client_auth_header ~= 0xffffffff then
    io_eff(iroh_srv_relay_client_auth_header,auth_header_run)
  end
  if iroh_srv_relay_export_keying_material ~= 0xffffffff then
    io_eff(iroh_srv_relay_export_keying_material,export_run)
  end
  if iroh_srv_relay_request_raw ~= 0xffffffff then
    io_eff(iroh_srv_relay_request_raw,request_run)
  end
  if iroh_srv_relay_enable_request_details ~= 0xffffffff then
    io_eff(iroh_srv_relay_enable_request_details,enable_request_run)
  end
  if iroh_srv_relay_bind ~= 0xffffffff then io_eff(iroh_srv_relay_bind,bind_run) end
  if iroh_srv_relay_poll ~= 0xffffffff then io_eff(iroh_srv_relay_poll,poll_run) end
  if iroh_srv_relay_millis ~= 0xffffffff then io_eff(iroh_srv_relay_millis,millis_run) end
  if iroh_srv_relay_queue ~= 0xffffffff then io_eff(iroh_srv_relay_queue,queue_run) end
  if iroh_srv_relay_authorized_with_meter ~= 0xffffffff then io_eff(iroh_srv_relay_authorized_with_meter,authorized_run) end
  if iroh_srv_relay_resume_rx ~= 0xffffffff then io_eff(iroh_srv_relay_resume_rx,resume_rx_run) end
  if iroh_srv_relay_reconfigure_rx ~= 0xffffffff then io_eff(iroh_srv_relay_reconfigure_rx,reconfigure_rx_run) end
  if iroh_srv_relay_kick ~= 0xffffffff then io_eff(iroh_srv_relay_kick,kick_run) end
  if iroh_srv_relay_stop ~= 0xffffffff then io_eff(iroh_srv_relay_stop,stop_run) end
  if iroh_srv_relay_nonce ~= 0xffffffff then io_eff(iroh_srv_relay_nonce,nonce_run) end
end
