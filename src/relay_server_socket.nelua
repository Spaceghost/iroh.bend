local iroh_srv_relay_nonce: uint32 <cimport,nodecl>
local iroh_srv_RelayListener: uint32 <cimport,nodecl>
local iroh_srv_RelayIdle: uint32 <cimport,nodecl>
local iroh_srv_RelayJoined: uint32 <cimport,nodecl>
local iroh_srv_RelayBytes: uint32 <cimport,nodecl>
local iroh_srv_RelayBufferedBytes: uint32 <cimport,nodecl>
